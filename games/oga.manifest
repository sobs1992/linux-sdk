; oga.manifest: games of the GO Ultra's games.manifest for the ODROID-GO
; Advance's card, for scripts/games-image.py. The keys are those of
; games.manifest (explained there); the games come from the same sources,
; with the GO Advance's own settings: a screen of 480x320, one stick, A35
; cores and 1 GB of memory (Wine games: the 2D ones only).
;
; The GO Advance keeps its games on p4 of its only SD card (FAT32 "GAMES",
; /games, mounted read-only): put together in <work>/games (--card the same: nothing
; copied twice), then onto the board:
;
;   scripts/games-image.py -m games/oga.manifest --card lab/images/work-oga/games
;   ssh root@BOARD mount -o remount,rw /games
;   tar -C lab/images/work-oga/games -cf - GAME... | ssh root@BOARD tar -xf - -C /games
;   ssh root@BOARD mount -o remount,ro /games
;
; Heroes III (VCMI), Half-Life and Doom were put on the card by
; scripts/homm3-install.sh, scripts/halflife-install.sh and the image.

[image]
fw = oga
work = lab/images/work-oga

[rtcw]
; Return to Castle Wolfenstein (iortcw, bare-app.RTCW=y), the files of
; games.manifest's [rtcw]; game.ini and main/gamepad-device.cfg of the GO
; Advance: the stick looks, the D-pad walks
install = none
file = lab/games/Return to Castle Wolfenstein/Main/pak0.pk3 -> main/
file = lab/games/Return to Castle Wolfenstein/Main/sp_pak*.pk3 -> main/
file = lab/games/Return to Castle Wolfenstein/Main/z_*.pk3 -> main/
overlay = games/rtcw/overlay-oga
cover = lab/games/Return to Castle Wolfenstein/2.ico
cover_crop = fit

[fallout]
; Fallout (FE) under Wine: the hi-res patch at 720x480 with the original
; 640-wide interface (two thirds of it fill the screen)
source = lab/games/FalloutFE/game_info/data
exclude = uninstall
exclude = DirectX_9.0c_Full.exe
exclude = *.pdf
overlay = games/fallout/overlay-oga
run = games/fallout/prepare.sh
env = FALLOUT_SCREEN=720x480
env = FALLOUT_BAR=640
cover = lab/games/FalloutFE/game_info/data/Icon_I.ico
cover_crop = fit

[fallout2]
; Fallout 2 (FE) under Wine, the same way
source = lab/games/Fallout2FE/game_info/data
exclude = uninstall
exclude = DirectX_9.0c_Full.exe
exclude = !docs
exclude = sfall-log.txt
overlay = games/fallout2/overlay-oga
run = games/fallout/prepare.sh
env = FALLOUT_SCREEN=720x480
env = FALLOUT_BAR=640
cover = lab/games/Fallout2FE/game_info/data/Icon_I.ico
cover_crop = fit

[neighbours]
; Neighbours from Hell under Wine: its interface in the top 480 rows of
; 800x600 (prepare.sh) as on the GO Ultra, shown at 0.6
source = lab/games/NeighborsFromHell
overlay = games/neighbours/overlay-oga
run = games/neighbours/prepare.sh

[neighbours2]
; Neighbours from Hell 2, the same way
source = lab/games/NeighborsFromHell2
overlay = games/neighbours2/overlay-oga
run = games/neighbours2/prepare.sh

[ssam1]
; as games.manifest's [ssam1], with the GO Advance's game.ini (overlay-oga)
; and controls
; Serious Sam: The First Encounter, the Russian edition (1C) patched to
; 1.05 (the game's own .gro files carry the Russian text and voices), by
; Serious Engine 1.10 (bare-app.SERIOUSSAM=y). Without the Windows
; programs (Bin), the editors' help, the uninstaller, the mods (their
; libraries are Windows ones), the PC's saved games and players' controls
; (the engine keeps those in the game's data directory). prepare.sh: the
; gamepad's controls and the aim assist option (games/serioussam)
source = lab/games/Serious Sam - The First Encounter
exclude = Bin
exclude = Backup
exclude = Uninstall
exclude = Help
exclude = Mods
exclude = SaveGame
exclude = Controls/Controls?.ctl
exclude = *.log
overlay = games/ssam1/overlay-oga
run = games/serioussam/prepare.sh
; one stick: it looks, the D-pad walks (controls.py)
env = SSAM_LAYOUT=oga
; cover: the game's splash screen as the engine draws it on the GO Ultra
cover = lab/games/Serious Sam - The First Encounter/cover.png
; the bomb and Sam whole (a 1024x768 start of the engine: no title cut)
cover_crop = 236 60 420

[ssam2]
; as games.manifest's [ssam2], with the GO Advance's game.ini (overlay-oga)
; and controls
; Serious Sam: The Second Encounter, the Russian edition patched to 1.07,
; as [ssam1] (the mod Warped left out with the other mods; Steam's shader
; cache too)
source = lab/games/Serious Sam - The Second Encounter
exclude = Bin
exclude = Backup
exclude = Uninstall
exclude = Help
exclude = Mods
exclude = SaveGame
exclude = steam_shader_cache
exclude = Controls/Controls?.ctl
exclude = *.log
overlay = games/ssam2/overlay-oga
run = games/serioussam/prepare.sh
; one stick: it looks, the D-pad walks (controls.py)
env = SSAM_LAYOUT=oga
cover = lab/games/Serious Sam - The Second Encounter/cover.png
; the bomb and Sam (the title, cut by the 16:9 screen, left out)
cover_crop = 215 85 360

[syberia]
; as games.manifest's [syberia] (its wine.ini: the stick is the cursor,
; the GO Advance's one stick too)
source = lab/games/Syberia
exclude = Uninstall
exclude = debug.log
overlay = games/syberia/overlay
cover = lab/games/Syberia/cover.png
cover_crop = 200 70 340
