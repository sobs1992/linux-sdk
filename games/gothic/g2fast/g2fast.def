; BugslayerUtil.dll: Gothic's crash report library (renamed BugslayerUtil_orig.dll)
; does its work through these forwarded exports; g2fast.c adds the rest.
LIBRARY BugslayerUtil.dll
EXPORTS
AddClientDV=BugslayerUtil_orig.AddClientDV
AddCrashHandlerLimitModule=BugslayerUtil_orig.AddCrashHandlerLimitModule
AddDiagAssertModule=BugslayerUtil_orig.AddDiagAssertModule
AllocAndFillProcessModuleList=BugslayerUtil_orig.AllocAndFillProcessModuleList
BSUGetModuleBaseName=BugslayerUtil_orig.BSUGetModuleBaseName
DiagAssert=BugslayerUtil_orig.DiagAssert
DiagOutput=BugslayerUtil_orig.DiagOutput
GetFaultReason=BugslayerUtil_orig.GetFaultReason
GetFaultReasonVB=BugslayerUtil_orig.GetFaultReasonVB
GetFirstStackTraceString=BugslayerUtil_orig.GetFirstStackTraceString
GetFirstStackTraceStringVB=BugslayerUtil_orig.GetFirstStackTraceStringVB
GetLimitModuleCount=BugslayerUtil_orig.GetLimitModuleCount
GetLimitModulesArray=BugslayerUtil_orig.GetLimitModulesArray
GetLoadedModules=BugslayerUtil_orig.GetLoadedModules
GetNextStackTraceString=BugslayerUtil_orig.GetNextStackTraceString
GetNextStackTraceStringVB=BugslayerUtil_orig.GetNextStackTraceStringVB
GetRegisterString=BugslayerUtil_orig.GetRegisterString
GetRegisterStringVB=BugslayerUtil_orig.GetRegisterStringVB
HookImportedFunctionsByName=BugslayerUtil_orig.HookImportedFunctionsByName
IsNT=BugslayerUtil_orig.IsNT
SetCrashHandlerFilter=BugslayerUtil_orig.SetCrashHandlerFilter
SetDiagAssertOptions=BugslayerUtil_orig.SetDiagAssertOptions
ValidateAllBlocks=BugslayerUtil_orig.ValidateAllBlocks
