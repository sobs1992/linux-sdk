; games.manifest: the games of the GO Ultra's games card, for
; scripts/games-image.py.
;
;   scripts/games-image.py --card /media/$USER/GAMES --board root@192.168.7.2
;   scripts/games-image.py --card /media/$USER/GAMES --reuse --games pirates
;
; The script puts a directory per game below onto the card's /games
; (exFAT "GAMES"), and the files of the "data" lines onto the board's
; /data (ext4 "data") over ssh. See games/README.md.
; Paths not starting with / are the SDK's; globs work in "file", "data",
; "cover". ${key} is that key of [image] (set above its use). Comments
; start with ";" or "#".
;
; lab/ is the SDK's link (not in git) to the project's data outside it,
; /media/D/OdroidLab: games/ (the games of this manifest), redist/ (DLLs
; and fonts of Windows), images/, backups/, wip/. See games/README.md.

[image]
; The Steam library: its games stay there for Steam
steam = /media/D/Games/Steam
; Installers and translations as downloaded (kept there, not in lab/)
installers = /media/D/Games/Install
; Firmware: the GO Ultra keeps its games on an SD card (exFAT "GAMES"):
;   scripts/games-image.py --card /media/$USER/GAMES --board root@192.168.7.2
; The games are put together in <work> first (a disk with room), then
; rsync copies what changed onto the card.
fw = ogu
work = lab/images/work
; A full image (a firmware with a games partition of its own, IMAGE_DATA_SIZE_MB
; of configs/<fw>_defconfig) takes base, base_emmc, out, name, games_free_mb

; ---------------------------------------------------------------------------
; A game: [id] with
;   dir        its directory on /games (default: the id)
;   install    copy (default): "source" copied whole, without "exclude";
;              homm3, halflife: the SDK's scripts/<x>-install.sh from "source"
;              (only what the engine reads; "options" passed to it);
;              none: only the files below
;   source     the game on this PC
;   exclude    glob of what not to copy (relative path or name), may repeat
;   file       SRC [-> DST]: a file more, into the game's directory (DST
;              relative to it, ending in / for a directory), may repeat
;   overlay    a directory copied over the game (wine.ini, settings)
;   run        a program run afterwards with GAME_DIR, SOURCE, SDK_DIR,
;              DATA_DIR set (patches the game's files)
;   env        NAME=VALUE: one more variable for "run", may repeat
;   data       SRC -> DST: files onto /data (DST relative to it), may repeat
;   cover      a picture for bare_app's home screen: a picture file (game:PATH:
;              one of the game as installed), or
;              ARCHIVE:ENTRY, a picture inside the game's .lod (Heroes III)
;              or .wad (Doom), PROGRAM.exe:icon, its biggest icon, or
;              VIDEO.bik:SECONDS, a frame of a video (ffmpeg), see
;              scripts/game_pictures.py; cropped square (cover_crop: center,
;              top, bottom, left, right, "X Y SIZE" in the picture's
;              pixels, or fit: all of it on a blurred copy), 240x240, saved
;              as cover.png in the game's directory
;   cover_back a picture (as cover) blurred and darker under the cover, which
;              is then put whole on it: for an icon
; ---------------------------------------------------------------------------

[heroes3]
; Heroes of Might and Magic III: Data, Maps, MP3 of an installation (here a
; HotA one), the VCMI mods Horn of the Abyss and the Russian translation
; (downloaded once into dl/hota)
install = homm3
source = lab/games/HoMM3_HotA/game_info/data
; the main menu's background with the two heroes (HotA.lod is encrypted)
cover = lab/games/HoMM3_HotA/game_info/data/Data/H3bitmap.lod:gamselb1.pcx
cover_crop = left

[hota]
; Heroes III: Horn of the Abyss as it is (HotA 1.8 + HD mod 5), Wine, from
; the same installation as heroes3 (its own copy: Wine runs the HD mod's exe).
; prepare.sh sets the HD mod's resolution and renderer for wine.ini's mode.
source = lab/games/HoMM3_HotA/game_info/data
exclude = Uninstall_HotA
exclude = HotA_logs
exclude = HD_CRASH_LOG.txt
exclude = patcher_x86 log.txt
exclude = patcher_x86 dump.txt
overlay = games/hota/overlay
run = games/hota/prepare.sh
; HotA's horn (the HD exe's icon) on the original's dark game selection
; background (HotA.lod, with HotA's own pictures, is encrypted)
cover = lab/games/HoMM3_HotA/game_info/data/h3hota HD.exe:icon
cover_back = lab/games/HoMM3_HotA/game_info/data/Data/H3bitmap.lod:GamSelBk.pcx

[doom]
; Doom: the firmware has doom1.wad (bare-app.DOOM_WAD=y); /games/doom gets
; only the cover, its title screen (an IWAD put here would be played)
install = none
cover = output/ogu/buildroot/target/usr/share/games/doom/doom1.wad:TITLEPIC
cover_crop = fit

[halflife]
; Half-Life from Steam: valve/ and valve_russian/ (scripts/halflife-install.sh)
install = halflife
source = ${steam}/steamapps/common/Half-Life
cover = ${steam}/appcache/librarycache/70/library_600x900.jpg
cover_crop = top

[pirates]
; Sid Meier's Pirates! (2004, Steam), Wine: bare_app_wine's wine.ini is
; this game's
source = ${steam}/steamapps/common/Sid Meier's Pirates!
exclude = *.log
file = apps/bare_app/ports/wine/wine.ini -> wine.ini
cover = ${steam}/appcache/librarycache/3920/library_600x900.jpg
cover_crop = top

[daemonica]
; Daemonica (2006, Russian edition), Wine. Left out: the installer's
; leftovers and GameRus.exe (283 MB: the Russian files, already unpacked).
; The engine wants OpenAL from Windows' SysWOW64 next to it, its text the
; Arial and Palatino fonts in the Wine prefix (a new prefix keeps them).
source = lab/games/Daemonica
exclude = GameRus.exe
exclude = UNWISE.EXE
exclude = UNWISE.INI
exclude = INSTALL.LOG
exclude = *.url
exclude = Data/daemonica.log
exclude = Data/Savedgames/*
file = lab/redist/SysWOW64/OpenAL32.dll
file = lab/redist/SysWOW64/wrap_oal.dll
overlay = games/daemonica/overlay
run = games/daemonica/prepare.sh
data = lab/redist/Fonts/arial*.ttf -> wine/prefix/drive_c/windows/Fonts/
data = lab/redist/Fonts/pala*.ttf -> wine/prefix/drive_c/windows/Fonts/
data = lab/redist/Fonts/Meatcm__.ttf -> wine/prefix/drive_c/windows/Fonts/
cover = lab/games/Daemonica/Bitmaps/Externals/MMenubcg.png
cover_crop = center

[doom3]
; DOOM 3 BFG Edition (GOG), RBDOOM-3-BFG (bare-app.DOOM3=y): base/ only,
; without the multiplayer maps (about 0.6 GB). All three campaigns are
; 6.4 GB; Resurrection of Evil (erebus*, phobos*, deltax, hell) and The Lost
; Mission (le_*) can be left out the same way when /games is small.
source = lab/games/DOOM 3 BFG Edition
exclude = *.exe
exclude = *.dll
exclude = *.ico
exclude = goggame-*
exclude = webcache.zip
exclude = EULA.txt
exclude = Uninstall
exclude = base/maps/d3ctf*
exclude = base/maps/d3dm*
exclude = base/maps/d3xpdm*
; game.ini: the entry of bare_app's menu (the engine is in the image)
overlay = games/doom3/overlay
cover = lab/games/DOOM 3 BFG Edition/2.ico
cover_crop = fit

[neighbours]
; Neighbours from Hell (2003), the Russian GOG release: game_info/data of
; NeighborsFromHell_Linux.tar.gz (bin/, data/; its own Wine left out).
; prepare.sh moves its 800x600 interface into the top 480 rows and makes
; cover.png: Woody of the end screen's picture (NfH 2: the neighbour of
; its outro), not the main menu's, two pictures meeting across its middle
source = lab/games/NeighborsFromHell
overlay = games/neighbours/overlay
run = games/neighbours/prepare.sh

[neighbours2]
; Neighbours from Hell 2: On Vacation (2004), the same way
source = lab/games/NeighborsFromHell2
overlay = games/neighbours2/overlay
run = games/neighbours2/prepare.sh

[templar]
; Knights of the Temple: Infernal Crusade (2004), 1C's Russian edition
; ("Тамплиеры: Крестовый поход"), as installed (games/templar/README.md).
; The cover: the templar of its intro's last painting
source = lab/games/Tampliers
exclude = Manual.pdf
exclude = unins000.*
exclude = *.URL
exclude = KillSave.exe
exclude = protect.dll
overlay = games/templar/overlay
cover = lab/games/Tampliers/Sbz1/Videos/bd_05.bik:4
cover_crop = 200 0 360

[monkey1]
; Tales of Monkey Island (2009): the GOG edition with the Russian
; translation and Buka's voices in it, five chapters, each its own game
; (games/monkey1/README.md). Not its Launcher.exe (a page to pick a
; chapter): each chapter starts its own program. The engine's D3DX 9.41
; comes from Windows. Chapter 1's program has only Telltale's logo for an
; icon: its cover is GOG's icon of the game, Flotsam Island.
dir = monkey1
source = lab/games/Tales of Monkey Island/Tales of Monkey Island 1
overlay = games/monkey1/overlay
file = lab/redist/SysWOW64/D3DX9_41.dll
cover = lab/games/Tales of Monkey Island/goggame-1207659066.ico
cover_crop = fit

[monkey2]
dir = monkey2
source = lab/games/Tales of Monkey Island/Tales of Monkey Island 2
overlay = games/monkey2/overlay
file = lab/redist/SysWOW64/D3DX9_41.dll
cover = lab/games/Tales of Monkey Island/Tales of Monkey Island 2/MonkeyIsland102.exe:icon
cover_crop = fit

[monkey3]
dir = monkey3
source = lab/games/Tales of Monkey Island/Tales of Monkey Island 3
overlay = games/monkey3/overlay
file = lab/redist/SysWOW64/D3DX9_41.dll
cover = lab/games/Tales of Monkey Island/Tales of Monkey Island 3/MonkeyIsland103.exe:icon
cover_crop = fit

[monkey4]
dir = monkey4
source = lab/games/Tales of Monkey Island/Tales of Monkey Island 4
overlay = games/monkey4/overlay
file = lab/redist/SysWOW64/D3DX9_41.dll
cover = lab/games/Tales of Monkey Island/Tales of Monkey Island 4/MonkeyIsland104.exe:icon
cover_crop = fit

[monkey5]
dir = monkey5
source = lab/games/Tales of Monkey Island/Tales of Monkey Island 5
overlay = games/monkey5/overlay
file = lab/redist/SysWOW64/D3DX9_41.dll
cover = lab/games/Tales of Monkey Island/Tales of Monkey Island 5/MonkeyIsland105.exe:icon
cover_crop = fit

[rtcw]
; Return to Castle Wolfenstein (the Russian edition, patched to 1.41),
; iortcw (bare-app.RTCW=y): single player, main/ only with what it reads:
; pak0, sp_pak1-4 (sp_pak4 of patch 1.41) and the translation's pk3s (text
; and voices), about 0.95 GB. Not the multiplayer's mp_*.pk3, the Windows
; programs, nor the unofficial 1.42d patch (its menus are for its own
; WolfSP.exe).
install = none
file = lab/games/Return to Castle Wolfenstein/Main/pak0.pk3 -> main/
file = lab/games/Return to Castle Wolfenstein/Main/sp_pak*.pk3 -> main/
file = lab/games/Return to Castle Wolfenstein/Main/z_*.pk3 -> main/
; game.ini: the entry of bare_app's menu (the engine is in the image)
overlay = games/rtcw/overlay
cover = lab/games/Return to Castle Wolfenstein/2.ico
cover_crop = fit

[pop]
; Prince of Persia: The Sands of Time (2003), the GOG edition (181 GOG v2,
; English) as installed. Not the uninstaller, the manual, GOG's leftovers,
; the logs and the profile of its first start on Windows. prepare.sh
; puts in the Russian edition's text, voices and videos from POP_RUS (the
; PC menus stay English; games/pop/README.md)
source = lab/games/Prince of Persia - The Sands of Time
exclude = unins000.*
exclude = manual.pdf
exclude = webcache.zip
exclude = *.lnk
exclude = Detection.*
exclude = POP.LOG
exclude = Profiles/fd
overlay = games/pop/overlay
cover = lab/games/Prince of Persia - The Sands of Time/goggame-1207658747.ico
cover_crop = fit
run = games/pop/prepare.sh
env = POP_RUS=${installers}/Prince of Persia - The Sands of Time/pop1_rus_full.exe

[ut2004]
; Unreal Tournament 2004 as the DVD's own Linux installer (linux-installer.sh)
; leaves it: English, version 3186, the x86_64 System/ut2004-bin, the CD key
; of the copy in System/cdkey (~5.3 GB); run by Box64 (bare-app.UT2004=y).
; game.ini: the entry of bare_app's menu.
source = /home/sobs/Documents/UT2004
; the installer's own: its list, uninstaller and start script, the sources
; of SDL and OpenAL, the game's x86_64 SDL 1.2 and OpenAL (Box64 runs it
; with the system's: BOX64_PREFER_WRAPPED), UT2004.exe (Windows)
exclude = .manifest
exclude = uninstall
exclude = ut2004
exclude = ut2004.xpm
exclude = *_sources.tar.bz2
exclude = System/libSDL-1.2.so.0
exclude = System/openal.so
exclude = System/UT2004.exe
overlay = games/ut2004/overlay
; the logo in the game's Help
cover = game:Help/UT2004Logo.bmp
cover_crop = fit

[fallout]
; Fallout (1997), the Russian "Fixed Edition" 3.6.1 (games/fallout/README.md):
; game_info/data of FalloutFE.tar.xz (its own Wine left out), without the
; uninstaller, DirectX's installer and the manuals (PDF). prepare.sh sets
; the hi-res patch to the screen's 854x480
source = lab/games/FalloutFE/game_info/data
exclude = uninstall
exclude = DirectX_9.0c_Full.exe
exclude = *.pdf
overlay = games/fallout/overlay
run = games/fallout/prepare.sh
cover = lab/games/FalloutFE/game_info/data/Icon_I.ico
cover_crop = fit

[fallout2]
; Fallout 2 (1998), the Russian "Fixed Edition" 5.0.5.4, the same way
; (sfall's log and the edition's documents left out too)
source = lab/games/Fallout2FE/game_info/data
exclude = uninstall
exclude = DirectX_9.0c_Full.exe
exclude = !docs
exclude = sfall-log.txt
overlay = games/fallout2/overlay
run = games/fallout/prepare.sh
cover = lab/games/Fallout2FE/game_info/data/Icon_I.ico
cover_crop = fit

[shade]
; Shade: Wrath of Angels (2004), 1C's Russian edition 1.2 ("Гнев
; ангелов"): game_info/data of Kron4ek's "Shade Wrath of Angels.zip" (its
; own Wine left out), without the uninstaller, KillSave.exe, the links and
; the logs of its last start. prepare.sh sets settings.cfg to the screen's
; 854x480 (games/shade/README.md)
source = lab/games/Shade Wrath of Angels/game_info/data
exclude = unins000.*
exclude = KillSave.exe
exclude = *.url
exclude = *.log
overlay = games/shade/overlay
run = games/shade/prepare.sh
cover = lab/games/Shade Wrath of Angels/cover.jpg
; the box art from below its "PC CD-ROM" corner: the title whole
cover_crop = 110 45 530

[nfsu]
; Need for Speed: Underground (2003) 1.4: game_info/data of NFSU_Linux.tar.xz
; (its own Wine left out), without EA's uninstaller and the US patch's
; installer; prepare.sh puts the Russian edition's files (rus/ of the same
; archive) over it and sets the widescreen fix (games/nfsu/README.md)
source = lab/games/NFSU/game_info/data
exclude = US_PATCH_4.exe
exclude = eauninstall.exe
overlay = games/nfsu/overlay
run = games/nfsu/prepare.sh
; the logo of its CD's autorun window
cover = lab/games/NFSU/game_info/data/AutoRun/autorun.bmp
cover_crop = center

[ssam1]
; Serious Sam: The First Encounter, the Russian edition (1C) patched to
; 1.05 (the game's own .gro files carry the Russian text and voices), by
; Serious Engine 1.10 (bare-app.SERIOUSSAM=y). Without the Windows
; programs (Bin), the editors' help, the uninstaller, the mods (their
; libraries are Windows ones), the PC's saved games and players' controls
; (the engine keeps those in the game's data directory). prepare.sh: the
; gamepad's controls and the aim assist option (games/serioussam)
source = lab/games/Serious Sam - The First Encounter
exclude = Bin
exclude = Backup
exclude = Uninstall
exclude = Help
exclude = Mods
exclude = SaveGame
exclude = Controls/Controls?.ctl
exclude = *.log
overlay = games/ssam1/overlay
run = games/serioussam/prepare.sh
; cover: the game's splash screen as the engine draws it on the GO Ultra
cover = lab/games/Serious Sam - The First Encounter/cover.png
; the bomb and Sam whole (a 1024x768 start of the engine: no title cut)
cover_crop = 236 60 420

[ssam2]
; Serious Sam: The Second Encounter, the Russian edition patched to 1.07,
; as [ssam1] (the mod Warped left out with the other mods; Steam's shader
; cache too)
source = lab/games/Serious Sam - The Second Encounter
exclude = Bin
exclude = Backup
exclude = Uninstall
exclude = Help
exclude = Mods
exclude = SaveGame
exclude = steam_shader_cache
exclude = Controls/Controls?.ctl
exclude = *.log
overlay = games/ssam2/overlay
run = games/serioussam/prepare.sh
cover = lab/games/Serious Sam - The Second Encounter/cover.png
; the bomb and Sam (the title, cut by the 16:9 screen, left out)
cover_crop = 215 85 360

[syberia]
; Syberia (2002), the Russian edition 1.0 (Nival) as installed, without
; the uninstaller and the log of its last start on the PC; under Wine
; (games/syberia/README.md)
source = lab/games/Syberia
exclude = Uninstall
exclude = debug.log
overlay = games/syberia/overlay
; cover: a frame of its opening cinematic as the GO Ultra shows it
cover = lab/games/Syberia/cover.png
; the drummer automaton, without the cinematic's black bars
cover_crop = 200 70 340

[corsairs]
; Pirates of the Caribbean ("Корсары: Пираты Карибского моря", 2003),
; the fan-patched Russian-English edition (no CD check, dialogues in
; Russian), with the Intel Fix (the sea's simpler shaders); under Wine.
; prepare.sh puts the Russian voices and videos in place
; (games/corsairs/README.md). Without the uninstallers and the logs.
source = lab/games/Corsairs/Пираты Карибского Моря
exclude = Uninstall*.exe
exclude = Uninst.ico
overlay = games/corsairs/overlay
run = games/corsairs/prepare.sh
; cover: its loading screen (the title and a ship) as the GO Ultra shows it
cover = lab/games/Corsairs/cover.png
cover_crop = 230 70 400

[bardstale]
; The Bard's Tale ARPG: Remastered and Resnarkled (GOG, 2018 edition of
; the 2004 game) under Wine, in Russian (prepare.sh: the GOG minimanifest's
; language), the gamepad on (wine.ini profile: settings.bin). Without the
; German voices and videos (*_ge: the game plays English or German, the
; Russian is text only), GOG's uninstaller, web cache and link
; (games/bardstale/README.md)
source = lab/games/The Bard's Tale
exclude = Res/Sounds/*_ge.*
exclude = Res/Movies/*_ge.*
exclude = unins000.*
exclude = webcache.zip
exclude = *.lnk
overlay = games/bardstale/overlay
run = games/bardstale/prepare.sh
; cover: the Bard on the game's character page, as the GO Ultra shows it
cover = lab/games/The Bard's Tale/cover.png
cover_crop = 160 60 240

[bout]
; The Book of Unwritten Tales (2009), the Russian edition of 1C-SoftClub
; (Russian text and voices) from a Linux repack (its Wine not used); under
; Wine (games/bout/README.md). Ogre's Direct3D 9 render system imports
; D3DX 9.42. Without the uninstaller and the Windows redistributables.
source = lab/games/BookOfUnwrittenTales
exclude = unins000.*
exclude = support
exclude = clientpm.old
exclude = cover-art.jpg
overlay = games/bout/overlay
; readable on 854x480: in-game text x1.3 and the settings' 854x480 (bout.exe),
; the menu book darker and x1.2 (its .kad): games/bout/README.md "Text size"
run = games/bout/textsize.py
file = lab/redist/SysWOW64/d3dx9_42.dll
; OpenAL Soft (LGPL, openal-soft.org) for the game's OpenAL: Creative's
; router (Daemonica's) reported a device here, but the game stayed
; silent: wrap_oal was unloaded again, DirectSound never loaded, the sound
; card never opened
file = lab/redist/openal-soft-1.23.1/soft_oal.dll -> OpenAL32.dll
; cover: the game's key art (Nate and Critter; the title on the right and its
; first letter's curl left out), the user's choice
cover = lab/games/BookOfUnwrittenTales/cover-art.jpg
cover_crop = 0 40 630

[coldfear]
; Cold Fear (2005, Darkworks), GOG's edition 1.0 v3 (2025: widescreen,
; modern pads), unpacked from its installer with innoextract (--gog
; --language en-US: every language's files are in that set); prepare.sh
; picks Russian (and the English copyright page, the Russian one crashed),
; the device's 854x480 (also where the options rewrite res.bin) and the
; shadows low in the options file in saves/ (games/coldfear/README.md).
; Without DirectX's redistributables, the installer's temporaries, GOG's
; own metadata and the manual.
source = lab/games/Cold Fear
exclude = __redist
exclude = tmp
exclude = commonappdata
exclude = app
exclude = goggame-*
exclude = Manual.pdf
overlay = games/coldfear/overlay
run = games/coldfear/prepare.sh
; the whaler in the storm, the helicopter over it (concept art of the bonus videos)
cover = lab/games/Cold Fear/data/movie/Bonus01.bik:5
cover_crop = right

[nfsmw]
; Need for Speed: Most Wanted (2005) 1.3, the Russian edition as installed,
; with ThirteenAG's widescreen fix, the Extra Options and MWFixes (their
; ASI loader dinput8.dll) and its user files in SAVES/; prepare.sh skips the
; intro videos, turns on the fix's gamepad support and sets the lowest
; graphics; the overlay's profile "player" lays the pad out as NFSU's
; (games/nfsmw/README.md). Without EA's uninstaller, the manual, the
; installers of the Windows shell and safe mode and the old exe.
source = lab/games/Need for Speed Most Wanted
exclude = UNINSTALL
exclude = manual.pdf
exclude = safemode_inst.exe
exclude = shell_inst.exe
exclude = speed.old
overlay = games/nfsmw/overlay
run = games/nfsmw/prepare.sh
; cover: its title page as the GO Ultra shows it
cover = lab/games/Need for Speed Most Wanted/cover.png
cover_crop = 150 0 480

[gun]
; GUN (2005), the Russian edition as installed, with ThirteenAG's widescreen
; fix unpacked into data/; prepare.sh moves the fix where Gun.exe loads it
; and leaves out its online updater (games/gun/README.md). Without the
; manuals.
source = lab/games/GUN
exclude = docs
overlay = games/gun/overlay
run = games/gun/prepare.sh
; cover: the title of its attract video as the GO Ultra shows it
cover = lab/games/GUN/cover.png
cover_crop = fit

[cod2]
; Call of Duty 2 (2005), 1C's Russian edition as installed, single player;
; prepare.sh leaves out the safe-mode question after a quit by F6, the
; overlay's profile "player" holds the device's settings and the gamepad's
; keys (games/cod2/README.md). Without the multiplayer exe and renderer,
; the profile of the PC it was installed on, the docs and the shop link.
source = lab/games/CoD2
exclude = CoD2MP_s.exe
exclude = gfx_d3d_mp_x86_s.dll
exclude = main/players
exclude = Docs
exclude = 1C.url
overlay = games/cod2/overlay
run = games/cod2/prepare.sh
cover = lab/games/CoD2/cod.bmp
cover_crop = fit

[swash]
; Swashbucklers: Blue vs. Grey (2007), 1C's Russian edition «Головорезы:
; Корсары XIX века» as installed; the overlay's profile holds its
; settings file (854x480, no post effects; games/swash/README.md). Without
; the uninstaller and the developers' tools (level importer, texture
; packers).
source = lab/games/Swashbucklers — Blue vs. Grey
exclude = unins000.*
exclude = LevelImp.exe
exclude = txdmake.exe
exclude = txdgen_*.dll
overlay = games/swash/overlay
; cover: a ship and its title on the main menu as the GO Ultra shows it
cover = lab/games/Swashbucklers — Blue vs. Grey/cover.png
