# Firmware: ODROID-GO Ultra (Amlogic S922X: 4x A73 + 2x A53, arm64).
# The BootROM loads the bootloader from sector 1 of the eMMC, or of the SD
# card if the eMMC holds none. This image carries both ways to boot:
#  - our own: mainline U-Boot packed as BL33 with Amlogic's BL2/BL30/BL31
#    (the FIP, u-boot-fip.bin at sector 1), used once the factory
#    bootloader on the eMMC is erased;
#  - the factory bootloader on the eMMC (Amlogic BL2/BL31 + Hardkernel
#    U-Boot 2015.01) sources boot.ini from the first card that has one, in
#    the order of its ${mmc_list} env (mmc 0 = eMMC, mmc 1 = SD card), and
#    boot.ini chainloads mainline U-Boot (u-boot.bin). For the card to win
#    over the eMMC it needs "setenv mmc_list 1 0; saveenv" once (UART).
# Either way mainline U-Boot boots extlinux.conf from the SD card.
# With our FIP on the eMMC (images/ogu-emmc.img, see "eMMC image" below)
# U-Boot comes from the eMMC and Linux from the SD card if it has one,
# else from the eMMC.
#
# See configs/oga_defconfig for the meaning of the variables.

BOARD_DIR     := board/ogu
CROSS_COMPILE := aarch64-linux-gnu-

# --- U-Boot ---
UBOOT_SRC       := src/u-boot
UBOOT_DEFCONFIG := odroid-go-ultra_defconfig
UBOOT_FRAGMENTS := $(BOARD_DIR)/u-boot/ogu.config
# U-Boot patches (*.patch, in name order), applied to a copy of UBOOT_SRC:
# woken by USB power, wait for the power key while charging
UBOOT_PATCHES   := $(BOARD_DIR)/u-boot/patches
UBOOT_IMAGES    := u-boot.bin

# --- Amlogic FIP (LibreELEC amlogic-boot-fip, odroid-go-ultra) ---
# Hardkernel's blobs: the same BL2 / BL31 builds and DDR settings (acs.bin)
# as the factory bootloader. Amlogic's licence forbids redistributing them,
# so they are fetched at build time and checked against AML_FIP_HASH.
AML_FIP_COMMIT := b6600f2857fdf81d11f18ea7a2e44aa989e7bcc4
AML_FIP_NAME   := amlogic-boot-fip-$(AML_FIP_COMMIT)-odroid-go-ultra
AML_FIP_URL    := https://github.com/LibreELEC/amlogic-boot-fip/raw/$(AML_FIP_COMMIT)/odroid-go-ultra
AML_FIP_FILES  := aml_encrypt_g12b bl2.bin acs.bin bl30.bin bl301.bin bl31.img \
                  ddr4_1d.fw ddr4_2d.fw ddr3_1d.fw piei.fw lpddr4_1d.fw \
                  lpddr4_2d.fw diag_lpddr4.fw aml_ddr.fw
AML_FIP_HASH   := $(BOARD_DIR)/fip/amlogic-boot-fip.sha256

# --- Linux ---
LINUX_SRC       := src/linux
LINUX_ARCH      := arm64
LINUX_IMAGE     := Image
LINUX_DEFCONFIG := defconfig
LINUX_FRAGMENTS := $(BOARD_DIR)/linux/ogu.config
# Kernel patches (*.patch, in name order), applied to a copy of LINUX_SRC
LINUX_PATCHES   := $(BOARD_DIR)/linux/patches
LINUX_DTBS      := amlogic/meson-g12b-odroid-go-ultra.dtb
# The CPU clusters stay within the factory limits (A73 1908 MHz, A53 1800
# MHz): the dts patch turns off the A53 points above that.
LINUX_CMDLINE   := rootwait rw console=ttyAML0,115200n8 console=tty1 fbcon=rotate:3 consoleblank=0

# --- Root filesystem (Buildroot) ---
BUILDROOT_SRC       := src/buildroot
BUILDROOT_EXTERNAL  := board/common/buildroot
BUILDROOT_DEFCONFIG := $(BOARD_DIR)/buildroot/defconfig

# --- Applications (apps/, see "make apps-list") ---
# Built into the rootfs; the board's Buildroot defconfig does not list them
APPS           := bare-app
# Started at boot (from APPS). bare-app takes over the screen; F6 held for
# 2 s quits it to the console, Quit in its menu turns the device off.
APPS_AUTOSTART := bare-app
# bare_app's own Kconfig defconfig (platform ogu), the shareware doom1.wad,
# the Heroes III engine VCMI (game data on /games, see README), Wine for
# Windows games (a wine.ini per game on /games)
APPS_CONFIG    := bare-app.DEFCONFIG=ogu_defconfig bare-app.DOOM_WAD=y \
                  bare-app.HOMM3=y bare-app.HALFLIFE=y bare-app.WINE=y

# --- SD card image ---
# Layout: [MBR + FIP boot code][FIP @512][p1 FAT32 BOOT @16M: boot.ini,
#          u-boot.bin, Image, dtbs, extlinux][p2 ext4 rootfs]
IMAGE_NAME := ogu
IMAGE_RAW      := $(IMAGES_DIR)/u-boot-fip.bin@1
IMAGE_MBR_CODE := $(IMAGES_DIR)/u-boot-fip-mbr.bin
IMAGE_BOOT_FILES := $(IMAGES_DIR)/u-boot.bin $(BOARD_DIR)/boot/boot.ini
# U-Boot builds fdtfile as amlogic/<name>.dtb
IMAGE_DTB_LAYOUT := tree
IMAGE_BOOT_SIZE_MB   := 128
IMAGE_ROOTFS_FREE_MB := 256
# Data partitions, made on the first boot as on the OGA: p3 ext4 "data" on
# /data, p4 FAT32 "GAMES" on /games to the end of the card. The rootfs
# (p2 from 144 MiB) must end before p3: up to 2 GiB, room for Wine.
# p4 stays at 5120 MiB, where it was when p3 was 1 GiB at 4096 MiB, so
# moving p3 here kept the games and formatted a new "data".
IMAGE_DATA_START_MB := 2192
IMAGE_DATA_SIZE_MB  := 2928
# MBR disk identifier; root= is passed as PARTUUID=<id>-02
IMAGE_DISK_ID := 0x4f475531

# --- eMMC image ---
# The same layout with its own disk identifier ("OGUE"): images/ogu-emmc.img.
# The BootROM always takes the FIP from the eMMC once it holds one; that
# U-Boot then boots Linux from the SD card if the card has extlinux.conf
# (mmc0 comes first in boot_targets), else from the eMMC.
# Writing it: VOLUME-UP held at power-on makes U-Boot show the eMMC as a
# USB disk (U-Boot patch 0012), then "make flash-emmc" (or
# flash-emmc-boot); the disk is found by U-Boot's gadget USB id.
IMAGE_EMMC_DISK_ID := 0x4f475545
EMMC_UMS_USB_ID    := 1b8e:fada
