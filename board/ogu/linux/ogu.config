# ODROID-GO Ultra: options on top of arm64 defconfig.
# Display stack is built in so the boot console shows up on the panel
# without waiting for modules.

CONFIG_LOCALVERSION="-ogu"
# CONFIG_LOCALVERSION_AUTO is not set

# Display: VPU + MIPI-DSI + Elida KD50T048A (ST7701), PWM backlight
CONFIG_DRM=y
CONFIG_DRM_MESON=y
CONFIG_DRM_MESON_DW_MIPI_DSI=y
CONFIG_PHY_MESON_G12A_MIPI_DPHY_ANALOG=y
CONFIG_PHY_MESON_AXG_MIPI_DPHY=y
CONFIG_DRM_PANEL_SITRONIX_ST7701=y
CONFIG_PWM_MESON=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_PWM=y
CONFIG_FRAMEBUFFER_CONSOLE=y
# Without it fbcon=rotate: on the command line is silently ignored
CONFIG_FRAMEBUFFER_CONSOLE_ROTATION=y

# GPU: Mali-G52 (Bifrost)
CONFIG_DRM_PANFROST=m

# Gamepad: gpio-keys-polled + two analog sticks on SARADC
CONFIG_INPUT_JOYSTICK=y
CONFIG_JOYSTICK_ADC=y
CONFIG_MESON_SARADC=y
CONFIG_KEYBOARD_GPIO_POLLED=y

# CPU temperature for the thermal zones (cooling: cpufreq)
CONFIG_AMLOGIC_THERMAL=y

# PMICs RK818 (vddcpu_a, vdd_ee, ...) and RK817 (vddcpu_b, audio codec)
CONFIG_MFD_RK8XX_I2C=y
CONFIG_REGULATOR_RK808=y
CONFIG_RTC_DRV_RK808=m
CONFIG_SND_SOC_RK817=m
CONFIG_SND_MESON_AXG_SOUND_CARD=m
CONFIG_SND_SOC_SIMPLE_AMPLIFIER=m

# Battery and charger: RK818 (rk818_battery, patches 0007-0013)
CONFIG_CHARGER_RK818=y

# Power-off: both PMICs must be switched off; PSCI SYSTEM_OFF alone leaves
# the board powered (red LED stays on). Patch 0016: as the vendor kernel,
# DEV_OFF on the RK818 only, the RK817 goes off by its SLEEP pin, so the
# board powers up cleanly again with USB plugged in
CONFIG_POWER_RESET_ODROID_GO_ULTRA_POWEROFF=y
# /dev/ntsync: Wine (11+) keeps NT events, mutexes and semaphores in the
# kernel instead of asking wineserver for every wait and signal; a Windows
# game loading a scene does that thousands of times a second
CONFIG_NTSYNC=y

# Wi-Fi: the GO Ultra has no chip of its own. Common USB adapters on the
# USB-A port, as modules (mdev loads them by modalias, linux-firmware has
# their firmware): Realtek (rtw88/rtw89/rtl8xxxu), MediaTek, Atheros,
# Ralink, Broadcom
CONFIG_RTW88=m
CONFIG_RTW88_8821CU=m
CONFIG_RTW88_8822BU=m
CONFIG_RTW88_8822CU=m
CONFIG_RTW88_8723DU=m
CONFIG_RTW88_8821AU=m
CONFIG_RTW88_8812AU=m
CONFIG_RTW88_8814AU=m
CONFIG_RTW89=m
CONFIG_RTW89_8851BU=m
CONFIG_RTW89_8852BU=m
CONFIG_RTW89_8852CU=m
CONFIG_RTL8XXXU=m
CONFIG_RTL8XXXU_UNTESTED=y
CONFIG_MT7601U=m
CONFIG_MT76x0U=m
CONFIG_MT76x2U=m
CONFIG_MT7921U=m
CONFIG_MT7925U=m
CONFIG_ATH9K_HTC=m
CONFIG_CARL9170=m
CONFIG_RT2X00=m
CONFIG_RT2800USB=m
CONFIG_RT2800USB_RT33XX=y
CONFIG_RT2800USB_RT35XX=y
CONFIG_RT2800USB_RT3573=y
CONFIG_RT2800USB_RT53XX=y
CONFIG_RT2800USB_RT55XX=y
CONFIG_BRCMFMAC_USB=y
# Keyboards and mice on the USB-A port: USB HID is in the arm64 defconfig
