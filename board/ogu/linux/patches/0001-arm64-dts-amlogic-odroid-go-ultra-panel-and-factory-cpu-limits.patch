From: OdroidLinux SDK
Subject: [PATCH] arm64: dts: amlogic: odroid-go-ultra: add the panel, battery, factory voltages and CPU limits

The board dts has no display: add the MIPI-DSI host and D-PHYs, the
KD50T048A panel (ST7701) of the ODROID-GO Ultra, its PWM backlight on
PWM_F (GPIOH_5) and keep vcc_lcd on. Taken from ROCKNIX's "arm64: meson:
odroid-go-ultra: add DSI panel" (spycat88). The panel compatible is
ROCKNIX's "odroid,go-ultra-panel" (patch 0002): the mainline
"elida,kd50t048a" entry is the ODROID-GO Super's init sequence and
timing, and leaves the Ultra's panel dark.

Rails as Hardkernel sets them (ROCKNIX "arm64: meson: odroid-go-ultra:
correct voltages", Mauro Ribeiro): vcc_lcd and vddao_3v3 at 3.0 V, vdd_ee
up to 0.9 V, no voltage on the vcc_sd switch. Its vddcpu_b limit raise
(for over-clocking) is left out.

Sound: the rk817 codec gets its MCLK from the SoC's mclk0_a pin, which
the dts left unused (no sound at all); as in Hardkernel's "Improve sound
output quality" (ROCKNIX 0026), without its other changes.

Sticks: the Y axes were declared inverted (abs-range <3150 950>), but
the left stick then read upside down: the ADC reads less for up, so up is
the minimum without inverting. Same for the right stick.

Battery: the 4000 mAh Li-Po and the RK818 charger with its 10 mOhm sense
resistor, for the rk818_battery driver (patches 0007-0013), as in ROCKNIX's
"arm64: meson: odroid-go-ultra: add battery and charger" (John Williams).

The A53 cluster table goes up to 1992 MHz, the factory firmware stops at
1800 MHz: turn off 1896 and 1992 MHz.

--- a/arch/arm64/boot/dts/amlogic/meson-g12b-odroid-go-ultra.dts
+++ b/arch/arm64/boot/dts/amlogic/meson-g12b-odroid-go-ultra.dts
@@ -31,7 +31,8 @@
 		axis@0 {
 			reg = <0>;
 			linux,code = <ABS_Y>;
-			abs-range = <3150 950>;
+			/* the ADC reads less for up: up is the minimum */
+			abs-range = <950 3150>;
 			abs-fuzz = <32>;
 			abs-flat = <64>;
 		};
@@ -54,7 +55,8 @@
 		axis@0 {
 			reg = <0>;
 			linux,code = <ABS_RY>;
-			abs-range = <3150 950>;
+			/* the ADC reads less for up: up is the minimum */
+			abs-range = <950 3150>;
 			abs-fuzz = <32>;
 			abs-flat = <64>;
 		};
@@ -71,6 +73,29 @@
 		stdout-path = "serial0:115200n8";
 	};
 
+	/* 3.7 V 4000 mAh Li-Po, charged by the RK818 */
+	bat: battery {
+		compatible = "simple-battery";
+		voltage-min-design-microvolt = <3500000>;
+		voltage-max-design-microvolt = <4200000>;
+		energy-full-design-microwatt-hours = <14800000>;
+		charge-full-design-microamp-hours = <4000000>;
+		precharge-current-microamp = <120000>;
+		charge-term-current-microamp = <200000>;
+		constant-charge-current-max-microamp = <2000000>;
+		constant-charge-voltage-max-microvolt = <4200000>;
+		factory-internal-resistance-micro-ohms = <180000>;
+		resistance-temp-table = <20 180>;
+		ocv-capacity-celsius = <20>;
+		ocv-capacity-table-0 =
+			<4146950 100>, <4001920 95>, <3967900 90>, <3919950 85>,
+			<3888450 80>, <3861850 75>, <3831540 70>, <3799130 65>,
+			<3768190 60>, <3745650 55>, <3726610 50>, <3711630 45>,
+			<3696720 40>, <3685660 35>, <3674950 30>, <3663050 25>,
+			<3649470 20>, <3635260 15>, <3616920 10>, <3592440 5>,
+			<3574170 0>;
+	};
+
 	codec_clk: codec-clk {
 		compatible = "fixed-clock";
 		clock-frequency = <12288000>;
@@ -196,6 +221,14 @@
 		reset-gpios = <&gpio BOOT_12 GPIO_ACTIVE_LOW>;
 	};
 
+	panel_backlight: backlight {
+		compatible = "pwm-backlight";
+		pwms = <&pwm_ef 1 40000 0>;
+		brightness-levels = <0 255>;
+		num-interpolated-steps = <255>;
+		default-brightness-level = <255>;
+	};
+
 	leds {
 		compatible = "gpio-leds";
 
@@ -320,11 +353,14 @@
 	opp-1704000000 {
 		opp-microvolt = <862500>;
 	};
+	/* Above the factory limit for the A53 cluster (1800 MHz) */
 	opp-1896000000 {
 		opp-microvolt = <987500>;
+		status = "disabled";
 	};
 	opp-1992000000 {
 		opp-microvolt = <1012500>;
+		status = "disabled";
 	};
 };
 
@@ -378,6 +414,13 @@
 		vcc9-supply = <&vddao_3v3>;
 		boost-supply = <&vdd_sys>;
 
+		charger {
+			compatible = "rockchip,rk818-charger";
+			monitored-battery = <&bat>;
+
+			rockchip,sense-resistor-micro-ohms = <10000>;
+		};
+
 		regulators {
 			vddcpu_a: DCDC_REG1 {
 				regulator-name = "vddcpu_a";
@@ -397,7 +440,7 @@
 				regulator-always-on;
 				regulator-boot-on;
 				regulator-min-microvolt = <875000>;
-				regulator-max-microvolt = <1250000>;
+				regulator-max-microvolt = <900000>;
 				regulator-ramp-delay = <6001>;
 				regulator-state-mem {
 					regulator-on-in-suspend;
@@ -417,12 +460,12 @@
 			vddao_3v3: DCDC_REG4 {
 				regulator-always-on;
 				regulator-boot-on;
-				regulator-min-microvolt = <3300000>;
-				regulator-max-microvolt = <3300000>;
+				regulator-min-microvolt = <3000000>;
+				regulator-max-microvolt = <3000000>;
 				regulator-name = "vddao_3v3";
 				regulator-state-mem {
 					regulator-on-in-suspend;
-					regulator-suspend-microvolt = <3300000>;
+					regulator-suspend-microvolt = <3000000>;
 				};
 			};
 
@@ -477,8 +520,6 @@
 				regulator-name = "vcc_sd";
 				regulator-always-on;
 				regulator-boot-on;
-				regulator-min-microvolt = <3300000>;
-				regulator-max-microvolt = <3300000>;
 				regulator-state-mem {
 					regulator-on-in-suspend;
 				};
@@ -561,8 +602,10 @@
 			};
 
 			vcc_lcd: LDO_REG8 {
-				regulator-min-microvolt = <3300000>;
-				regulator-max-microvolt = <3300000>;
+				regulator-always-on;
+				regulator-boot-on;
+				regulator-min-microvolt = <3000000>;
+				regulator-max-microvolt = <3000000>;
 				regulator-name = "vcc_lcd";
 				regulator-state-mem {
 					regulator-off-in-suspend;
@@ -604,6 +647,60 @@
 	status = "okay";
 };
 
+&mipi_analog_dphy {
+	status = "okay";
+};
+
+&mipi_dphy {
+	status = "okay";
+};
+
+/*
+ * GP0 PLL at the lane bit rate: 29.17 MHz pixel clock x 24 bpp / 2 lanes
+ * = 350.04 MHz, the pixel clock is GP0 / 12.
+ */
+&mipi_dsi {
+	status = "okay";
+
+	assigned-clocks = <&clkc CLKID_GP0_PLL>,
+			  <&clkc CLKID_MIPI_DSI_PXCLK_SEL>,
+			  <&clkc CLKID_MIPI_DSI_PXCLK>,
+			  <&clkc CLKID_CTS_ENCL_SEL>,
+			  <&clkc CLKID_VCLK2_SEL>;
+	assigned-clock-parents = <0>,
+				 <&clkc CLKID_GP0_PLL>,
+				 <0>,
+				 <&clkc CLKID_VCLK2_DIV1>,
+				 <&clkc CLKID_GP0_PLL>;
+	assigned-clock-rates = <350040000>,
+			       <0>,
+			       <350040000>,
+			       <0>,
+			       <0>;
+
+	panel@0 {
+		compatible = "odroid,go-ultra-panel", "sitronix,st7701";
+		reg = <0>;
+		reset-gpios = <&gpio GPIOH_4 GPIO_ACTIVE_HIGH>;
+		IOVCC-supply = <&vcc_lcd>;
+		VCC-supply = <&vcc_lcd>;
+		backlight = <&panel_backlight>;
+		rotation = <270>;
+
+		port {
+			mipi_in_panel: endpoint {
+				remote-endpoint = <&mipi_out_panel>;
+			};
+		};
+	};
+};
+
+&mipi_dsi_panel_port {
+	mipi_out_panel: endpoint {
+		remote-endpoint = <&mipi_in_panel>;
+	};
+};
+
 &periphs_pinctrl {
 	keypad_gpio_pins: keypad-gpio-state {
 		mux {
@@ -619,6 +716,12 @@
 	};
 };
 
+&pwm_ef {
+	status = "okay";
+	pinctrl-0 = <&pwm_f_h_pins>;
+	pinctrl-names = "default";
+};
+
 &saradc {
 	status = "okay";
 	vref-supply = <&vddio_ao1v8>;
@@ -662,16 +765,20 @@
 };
 
 
+/* The rk817 codec runs on MCLK from the SoC: mclk0_a out, from TDM B */
 &tdmif_b {
-	pinctrl-0 = <&tdm_b_dout0_pins>, <&tdm_b_fs_pins>, <&tdm_b_sclk_pins>, <&tdm_b_din1_pins>;
+	pinctrl-0 = <&mclk0_a_pins>, <&tdm_b_dout0_pins>, <&tdm_b_fs_pins>,
+		    <&tdm_b_sclk_pins>, <&tdm_b_din1_pins>;
 	pinctrl-names = "default";
 	status = "okay";
 
-	assigned-clocks = <&clkc_audio AUD_CLKID_TDM_SCLK_PAD1>,
+	assigned-clocks = <&clkc_audio AUD_CLKID_TDM_MCLK_PAD0>,
+			  <&clkc_audio AUD_CLKID_TDM_SCLK_PAD1>,
 			  <&clkc_audio AUD_CLKID_TDM_LRCLK_PAD1>;
-	assigned-clock-parents = <&clkc_audio AUD_CLKID_MST_B_SCLK>,
+	assigned-clock-parents = <&clkc_audio AUD_CLKID_MST_B_MCLK>,
+				 <&clkc_audio AUD_CLKID_MST_B_SCLK>,
 				 <&clkc_audio AUD_CLKID_MST_B_LRCLK>;
-	assigned-clock-rates = <0>, <0>;
+	assigned-clock-rates = <0>, <0>, <0>;
 };
 
 &tdmin_b {
