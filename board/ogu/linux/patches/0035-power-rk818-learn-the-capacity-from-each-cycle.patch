From: OdroidLinux SDK
Subject: [PATCH] power: supply: rk818: learn the capacity from each cycle

On the second GO Ultra the level counted down to 0% with the battery
still running a game for minutes, then the counter's underflow path took
an estimate from the voltage (the generic OCV table, 40% low mid-range)
and the level climbed 0, 7, 24... 61% on the battery. A logged discharge
from full (scripts/battery-fit.py) ran 4.8 Ah to the brown-out where the
driver had the design 4000 mAh, and the FCC it could store was capped at
that. Under a game's 2.3 A the loaded voltage is the same 3.3 V at 13%
and at the end, the OCV is flat from 15% to 3%, and the board browns out
at once in a dip: no voltage tells empty. The charge drawn does.

- The charge drawn since the last full charge is counted (differences of
  the coulomb counter, so the driver's own writes to it never count;
  charging in between takes back what it puts in) and kept with the
  saved state in spare data registers (CALC_REST, SAVE_DATA19), with
  whether the cycle began full at no charge limit and how the boot ended
  (a clean shutdown, at 0% or not).
- The FCC is the charge from full to the brown-out; 0% is 3% of it still
  in the battery, where bare_app powers the device off.
- At the next power-on: a cycle that ended at a brown-out (no clean
  shutdown, the OCV the PMIC took at most 5%) measured the FCC, which is
  set to it. One that ended at 0% and rested 30 min: the OCV tells what
  was left, and half the difference to drawn + left goes in.
  A simulation of the driver over the logged discharge: from 4000 mAh
  4376, 4580, 4685, 4739, 4766 in five cycles (true about 4790 to the
  reserve), from 5900 one brown-out and then 4832, 4809 (scripts/rk818-sim).
- The counter running out keeps the level at 0 and counts on below it
  (set to 0 when charging starts): the voltage estimate is gone.
- Discharging, the level never goes up (also on resume).
- The FCC may be up to 150% of the design capacity, and is writable
  (charge_full) to seed it from a measurement.
- The device tree: the OCV table and 160 mOhm from the fit.
---
--- a/drivers/power/supply/rk818_battery.c
+++ b/drivers/power/supply/rk818_battery.c
@@ -157,8 +157,37 @@
 
 /* SoC / capacity */
 #define MIN_FCC				500	/* mAh */
-/* Monitor cycles the OCV estimate must stay below vmin to report empty */
-#define VMIN_EMPTY_CYCLES		3
+/* a learnt FCC: up to this share of the design capacity (%) */
+#define FCC_MAX_PCT			150
+/*
+ * 0% is this share of the FCC still in the battery (%): bare_app powers
+ * the device off at 0%, before the battery browns it out. The FCC is the
+ * charge from full to that brown-out, not a voltage: under a game's 2.3 A
+ * the loaded voltage is the same 3.3 V at 13% and at the end (the OCV is
+ * flat from 15% down to 3%), and the board browns out at once in a dip.
+ */
+#define RESERVE_PCT			3
+/* learning from the OCV at a power-on: the battery off at least (min) */
+#define LEARN_REST_MIN			30
+/* no clean shutdown and the OCV at most this (%): a brown-out */
+#define BROWNOUT_PCT			5
+
+/*
+ * Capacity learning state, in data registers the vendor driver used for
+ * other things and this one did not: the charge drawn since the last full
+ * charge (mAh), whether that cycle began full at no charge limit and how
+ * the last boot ended (rk818_learn_at_boot()). Like
+ * the other saved state it survives PMIC resets (reboots, hibernation) and
+ * an emptied battery, not a disconnected one.
+ */
+#define LEARN_DRAWN_REGH		RK818_CALC_REST_REGH
+#define LEARN_DRAWN_REGL		RK818_CALC_REST_REGL
+#define LEARN_FLAGS_REG			RK818_SAVE_DATA19
+#define LEARN_MAGIC			0xa0
+#define LEARN_MAGIC_MSK			0xf0
+#define LEARN_VALID			BIT(0)
+#define LEARN_RUNNING			BIT(1)	/* no clean shutdown since */
+#define LEARN_ZERO			BIT(2)	/* it shut down at 0% */
 
 /*
  * Coulomb counter LSB denominator.
@@ -271,8 +300,18 @@
 	int	fcc_mah;
 	int	rsoc;
 	int	dsoc;
-	/* Monitor cycles with the OCV estimate below the design minimum */
-	int	vmin_cycles;
+
+	/*
+	 * Capacity learning (rk818_account(), rk818_update_soc()): the charge
+	 * drawn since the last full charge, net of what charges in between
+	 * put back. A cycle that began full and ended at a brown-out or at 0%
+	 * measured the FCC (rk818_learn_at_boot()).
+	 */
+	int	cc_last_mah;	/* the counter when drawn_mah was last updated */
+	bool	cc_tracking;	/* cc_last_mah is valid */
+	int	drawn_mah;
+	bool	learn_valid;	/* the cycle began full, at no charge limit */
+	bool	cc_underflow;	/* the counter ran out: logged */
 
 	int	chrg_status;
 	bool	is_charging;
@@ -427,16 +466,35 @@
 	return (raw / CC_LSB_DENOM) * di->res_div;
 }
 
+/*
+ * Adds what the battery gave since the last call to drawn_mah (charging
+ * takes it back): the difference of two counter readings, so that the
+ * counter's own changes (rk818_set_coulomb_cap()) never count.
+ */
+static void rk818_account(struct rk818_battery *di)
+{
+	int now = rk818_get_coulomb_cap(di);
+
+	if (di->cc_tracking)
+		di->drawn_mah = clamp(di->drawn_mah + di->cc_last_mah - now,
+				      0, 0xffff);
+	di->cc_last_mah = now;
+}
+
 static void rk818_set_coulomb_cap(struct rk818_battery *di, int cap_mah)
 {
 	u32 raw = (u32)cap_mah * CC_LSB_DENOM / DIV(di->res_div);
 
+	rk818_account(di);	/* what was drawn up to the new value */
+
 	rk818_write(di, RK818_GASCNT_CAL_REG3, (raw >> 24) & 0xff);
 	rk818_write(di, RK818_GASCNT_CAL_REG2, (raw >> 16) & 0xff);
 	rk818_write(di, RK818_GASCNT_CAL_REG1, (raw >>  8) & 0xff);
 	rk818_write(di, RK818_GASCNT_CAL_REG0,  raw        & 0xff);
 
 	di->remain_cap_mah = cap_mah;
+	/* as rk818_get_coulomb_cap() will read it back */
+	di->cc_last_mah = cap_mah / DIV(di->res_div) * di->res_div;
 	dev_dbg(di->dev, "coulomb cap set to %d mAh\n", cap_mah);
 }
 
@@ -658,6 +716,12 @@
  * FCC (fully-charged capacity) persistence
  * ------------------------------------------------------------------------- */
 
+/* a cell often holds more than its label says: the learnt FCC may */
+static int rk818_fcc_max(struct rk818_battery *di)
+{
+	return di->info->charge_full_design_uah / 1000 * FCC_MAX_PCT / 100;
+}
+
 static int rk818_read_fcc(struct rk818_battery *di)
 {
 	u32 fcc = 0;
@@ -669,14 +733,14 @@
 
 	u32 design_mah = di->info->charge_full_design_uah / 1000;
 
-	if (fcc < MIN_FCC || fcc > design_mah) {
+	if (fcc < MIN_FCC || fcc > rk818_fcc_max(di)) {
 		dev_info(di->dev,
 			 "stored FCC %u mAh out of range, using design capacity\n",
 			 fcc);
 		fcc = design_mah;
 	}
 
-	return (int)clamp(fcc, (u32)MIN_FCC, design_mah);
+	return (int)clamp(fcc, (u32)MIN_FCC, (u32)rk818_fcc_max(di));
 }
 
 static void rk818_save_fcc(struct rk818_battery *di, u32 fcc)
@@ -699,8 +763,7 @@
 
 static void rk818_save_remain_cap(struct rk818_battery *di)
 {
-	int cap = clamp(di->remain_cap_mah, 0,
-			(int)(di->info->charge_full_design_uah / 1000));
+	int cap = clamp(di->remain_cap_mah, 0, rk818_fcc_max(di));
 
 	rk818_write(di, RK818_REMAIN_CAP_REG3, (cap >> 24) & 0xff);
 	rk818_write(di, RK818_REMAIN_CAP_REG2, (cap >> 16) & 0xff);
@@ -720,6 +783,41 @@
 	return cap;
 }
 
+/* running: false at a clean shutdown (rk818_battery_shutdown()) */
+static void rk818_save_learn(struct rk818_battery *di, bool running)
+{
+	rk818_write(di, LEARN_DRAWN_REGH, (di->drawn_mah >> 8) & 0xff);
+	rk818_write(di, LEARN_DRAWN_REGL,  di->drawn_mah       & 0xff);
+	rk818_write(di, LEARN_FLAGS_REG,
+		    LEARN_MAGIC | (di->learn_valid ? LEARN_VALID : 0) |
+		    (running ? LEARN_RUNNING : 0) |
+		    (!running && di->dsoc == 0 ? LEARN_ZERO : 0));
+}
+
+/* the flags the last boot left, 0 none */
+static u8 rk818_read_learn(struct rk818_battery *di)
+{
+	u8 flags = rk818_read(di, LEARN_FLAGS_REG);
+
+	if ((flags & LEARN_MAGIC_MSK) != LEARN_MAGIC) {
+		di->drawn_mah = 0;
+		di->learn_valid = false;
+		return 0;
+	}
+	di->drawn_mah = rk818_read(di, LEARN_DRAWN_REGH) << 8 |
+			rk818_read(di, LEARN_DRAWN_REGL);
+	di->learn_valid = flags & LEARN_VALID;
+	return flags;
+}
+
+/* The level of a charge in the counter: 0 at the reserve (RESERVE_PCT) */
+static int rk818_cap_to_soc(struct rk818_battery *di, int cap_mah)
+{
+	int res = di->fcc_mah * RESERVE_PCT / 100;
+
+	return clamp((cap_mah - res) * 100 / DIV(di->fcc_mah - res), 0, 100);
+}
+
 /* -------------------------------------------------------------------------
  * Hardware configuration
  * ------------------------------------------------------------------------- */
@@ -944,6 +1042,63 @@
 }
 
 /*
+ * The FCC from how the last cycle ended, at the power-on after it: a cycle
+ * that began full (at no charge limit) and
+ *  - ended at a brown-out (no clean shutdown, and the OCV the PMIC took at
+ *    this power-on is at most BROWNOUT_PCT: not a crash with charge left;
+ *    the one after the brown-out of 2026-11-21 read 3610 mV, 0%) drew the
+ *    FCC: the board ran until the battery could not hold it up;
+ *  - ended at 0% (bare_app powers the device off there) and the battery
+ *    rested since (LEARN_REST_MIN): the OCV says what was left, and the
+ *    FCC is what was drawn and that. At a FCC right that is the reserve.
+ * A brown-out sets the FCC at once: the next one would come at the same
+ * level again. From 0% half the difference goes in, as the OCV is flat
+ * there (15% to 3% in 45 mV) and one odd reading moves it only halfway;
+ * it comes up to a larger capacity in a few cycles.
+ */
+static void rk818_learn_at_boot(struct rk818_battery *di, u8 flags, int ocv_mv)
+{
+	int ocv_pct = vol_to_soc(di, ocv_mv);
+	int meas, fcc;
+	const char *how;
+
+	if (!(flags & LEARN_VALID))
+		return;
+	if (flags & LEARN_RUNNING) {
+		if (ocv_pct > BROWNOUT_PCT) {
+			dev_info(di->dev,
+				 "no clean shutdown, OCV %d mV (%d%%): not a brown-out, FCC stays %d mAh\n",
+				 ocv_mv, ocv_pct, di->fcc_mah);
+			return;
+		}
+		how = "a brown-out";
+		meas = di->drawn_mah;
+	} else if (flags & LEARN_ZERO) {
+		if (di->pwroff_min < LEARN_REST_MIN || ocv_pct >= 50)
+			return;
+		how = "0%";
+		meas = di->drawn_mah * 100 / (100 - ocv_pct);
+	} else {
+		return;
+	}
+	di->learn_valid = false;	/* the cycle is used */
+	if (meas < MIN_FCC || meas > rk818_fcc_max(di)) {
+		dev_warn(di->dev,
+			 "%d mAh drawn from full to %s, OCV %d mV (%d%%) after %u min: FCC %d mAh out of range, stays %d mAh\n",
+			 di->drawn_mah, how, ocv_mv, ocv_pct, di->pwroff_min,
+			 meas, di->fcc_mah);
+		return;
+	}
+	fcc = (flags & LEARN_RUNNING) ? meas : (di->fcc_mah + meas) / 2;
+	dev_info(di->dev,
+		 "%d mAh drawn from full to %s, OCV %d mV (%d%%) after %u min: FCC %d mAh, %d -> %d mAh\n",
+		 di->drawn_mah, how, ocv_mv, ocv_pct, di->pwroff_min, meas,
+		 di->fcc_mah, fcc);
+	di->fcc_mah = fcc;
+	rk818_save_fcc(di, fcc);
+}
+
+/*
  * rk818_init_soc - choose the correct starting dsoc / remain_cap on boot.
  *
  * Decision priority:
