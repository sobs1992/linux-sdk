 	dev_info(di->dev,
-		 "init done: dsoc=%d rsoc=%d cap=%d mAh fcc=%d mAh\n",
-		 di->dsoc, di->rsoc, di->remain_cap_mah, di->fcc_mah);
+		 "init done: dsoc=%d rsoc=%d cap=%d mAh fcc=%d mAh, %d mAh drawn since %s\n",
+		 di->dsoc, di->rsoc, di->remain_cap_mah, di->fcc_mah,
+		 di->drawn_mah, di->learn_valid ? "full" : "a partial charge");
 }
 
