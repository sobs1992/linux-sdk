--- a/drivers/gpu/drm/panfrost/panfrost_evict.c
+++ b/drivers/gpu/drm/panfrost/panfrost_evict.c
@@ -0,0 +1,219 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Hibernation with the GPU's memory in swap.
+ *
+ * Every BO's pages are pinned while it is mapped on the GPU, and pinned
+ * pages cannot be reclaimed: a game holding a lot of textures (DOOM 3 BFG,
+ * ~750 MB) leaves too little memory for the hibernation image, which is a
+ * copy of everything that is left. So when the system hibernates, at
+ * device prepare time (user space frozen, the image memory not taken
+ * yet), the BOs are unmapped from the GPU and their pages given back to
+ * their shmem files, marked dirty: reclaim writes them to swap like any
+ * other memory. After the hibernation (resumed from the image, or failed)
+ * they come back: at the PM notifier's post call, or before that if a job
+ * is submitted first; CPU mmaps fault their pages back by themselves.
+ *
+ * Left resident: imported, exported, pinned and vmapped BOs, heaps (the
+ * pages are mapped on GPU faults), purgeable ones (the shrinker frees
+ * them anyway) and BOs a job still holds.
+ */
+
+#include <linux/delay.h>
+#include <linux/dma-resv.h>
+#include <linux/suspend.h>
+
+#include <drm/drm_print.h>
+
+#include "panfrost_device.h"
+#include "panfrost_evict.h"
+#include "panfrost_gem.h"
+#include "panfrost_mmu.h"
+
+#define EVICT_IDLE_WAIT_MS	2000
+
+void panfrost_evict_add(struct panfrost_device *pfdev, struct panfrost_gem_object *bo)
+{
+	mutex_lock(&pfdev->evict.lock);
+	list_add_tail(&bo->evict_node, &pfdev->evict.bos);
+	mutex_unlock(&pfdev->evict.lock);
+}
+
+void panfrost_evict_del(struct panfrost_gem_object *bo)
+{
+	struct panfrost_device *pfdev = to_panfrost_device(bo->base.base.dev);
+
+	mutex_lock(&pfdev->evict.lock);
+	list_del_init(&bo->evict_node);
+	mutex_unlock(&pfdev->evict.lock);
+}
+
+static bool panfrost_evict_bo(struct panfrost_gem_object *bo)
+{
+	struct drm_gem_shmem_object *shmem = &bo->base;
+	struct panfrost_gem_mapping *mapping;
+	bool done = false;
+	int i;
+
+	if (bo->is_heap || drm_gem_is_imported(&shmem->base) || !shmem->pages ||
+	    shmem->madv != PANFROST_MADV_WILLNEED)
+		return false;
+
+	/* the last jobs' cleanup may still be on its way */
+	dma_resv_wait_timeout(shmem->base.resv, DMA_RESV_USAGE_BOOKKEEP, false,
+			      msecs_to_jiffies(EVICT_IDLE_WAIT_MS));
+	for (i = 0; atomic_read(&bo->gpu_usecount) && i < 100; i++)
+		usleep_range(1000, 2000);
+	if (atomic_read(&bo->gpu_usecount))
+		return false;
+
+	mutex_lock(&bo->mappings.lock);
+	dma_resv_lock(shmem->base.resv, NULL);
+
+	if (shmem->base.dma_buf || refcount_read(&shmem->pages_pin_count) ||
+	    refcount_read(&shmem->vmap_use_count))
+		goto out;
+
+	list_for_each_entry(mapping, &bo->mappings.list, node) {
+		if (mapping->active) {
+			panfrost_mmu_unmap(mapping);
+			mapping->evicted = true;
+		}
+	}
+
+	done = drm_gem_shmem_evict_locked(shmem);
+	if (!done) {
+		/* cannot happen after the checks above: map them again */
+		dma_resv_unlock(shmem->base.resv);
+		list_for_each_entry(mapping, &bo->mappings.list, node) {
+			if (mapping->evicted && !panfrost_mmu_map(mapping))
+				mapping->evicted = false;
+		}
+		mutex_unlock(&bo->mappings.lock);
+		return false;
+	}
+	bo->evicted = true;
+
+out:
+	dma_resv_unlock(shmem->base.resv);
+	mutex_unlock(&bo->mappings.lock);
+	return done;
+}
+
+static void panfrost_evict_all(struct panfrost_device *pfdev)
+{
+	struct panfrost_gem_object *bo;
+	size_t bytes = 0, kept = 0;
+	unsigned int n = 0;
+
+	mutex_lock(&pfdev->evict.lock);
+	list_for_each_entry(bo, &pfdev->evict.bos, evict_node) {
+		if (bo->evicted)
+			continue;
+		if (panfrost_evict_bo(bo)) {
+			bytes += bo->base.base.size;
+			n++;
+			pfdev->evict.evicted = true;
+		} else if (bo->base.pages) {
+			kept += bo->base.base.size;
+		}
+	}
+	mutex_unlock(&pfdev->evict.lock);
+
+	if (n)
+		drm_info(&pfdev->base, "hibernation: %zu MiB of %u BOs to swap, %zu MiB kept\n",
+			 bytes >> 20, n, kept >> 20);
+}
+
+/* Map one evicted BO again; its pages come back from shmem/swap */
+static int panfrost_restore_bo(struct panfrost_gem_object *bo)
+{
+	struct panfrost_gem_mapping *mapping;
+	int ret = 0, err;
+
+	mutex_lock(&bo->mappings.lock);
+	list_for_each_entry(mapping, &bo->mappings.list, node) {
+		if (!mapping->evicted)
+			continue;
+		err = panfrost_mmu_map(mapping);
+		if (err) {
+			ret = err;
+			continue;
+		}
+		mapping->evicted = false;
+	}
+	if (!ret)
+		bo->evicted = false;
+	mutex_unlock(&bo->mappings.lock);
+	return ret;
+}
+
+int panfrost_evict_restore(struct panfrost_device *pfdev)
+{
+	struct panfrost_gem_object *bo;
+	unsigned int n = 0, failed = 0;
+	ktime_t start;
+	int ret = 0;
+
+	if (!READ_ONCE(pfdev->evict.evicted))
+		return 0;
+
+	start = ktime_get();
+	mutex_lock(&pfdev->evict.lock);
+	list_for_each_entry(bo, &pfdev->evict.bos, evict_node) {
+		if (!bo->evicted)
+			continue;
+		if (panfrost_restore_bo(bo)) {
+			failed++;
+			ret = -ENOMEM;
+		} else {
+			n++;
+		}
+	}
+	if (!failed)
+		WRITE_ONCE(pfdev->evict.evicted, false);
+	mutex_unlock(&pfdev->evict.lock);
+
+	if (n || failed)
+		drm_info(&pfdev->base, "hibernation: %u BOs back in %lld ms%s\n", n,
+			 ktime_ms_delta(ktime_get(), start), failed ? ", some failed" : "");
+	return ret;
+}
+
+/* dev_pm_ops.prepare: user space frozen, nothing allocated for the image yet */
+int panfrost_evict_prepare(struct panfrost_device *pfdev)
+{
+	if (READ_ONCE(pfdev->evict.hibernating))
+		panfrost_evict_all(pfdev);
+	return 0;
+}
+
+static int panfrost_evict_pm_notifier(struct notifier_block *nb, unsigned long action,
+				      void *data)
+{
+	struct panfrost_device *pfdev = container_of(nb, struct panfrost_device, evict.pm_nb);
+
+	switch (action) {
+	case PM_HIBERNATION_PREPARE:
+		WRITE_ONCE(pfdev->evict.hibernating, true);
+		break;
+	case PM_POST_HIBERNATION:
+		WRITE_ONCE(pfdev->evict.hibernating, false);
+		panfrost_evict_restore(pfdev);
+		break;
+	}
+	return NOTIFY_DONE;
+}
+
+void panfrost_evict_init(struct panfrost_device *pfdev)
+{
+	mutex_init(&pfdev->evict.lock);
+	INIT_LIST_HEAD(&pfdev->evict.bos);
+	pfdev->evict.pm_nb.notifier_call = panfrost_evict_pm_notifier;
+	register_pm_notifier(&pfdev->evict.pm_nb);
+}
+
+void panfrost_evict_fini(struct panfrost_device *pfdev)
+{
+	unregister_pm_notifier(&pfdev->evict.pm_nb);
+	panfrost_evict_restore(pfdev);
+}
