From: OdroidLinux SDK
Subject: [PATCH] drm/panfrost: GPU memory to swap for hibernation

A BO's pages stay pinned while it is mapped on the GPU, and pinned pages
cannot be reclaimed. The hibernation image is a copy of all memory in
use, made in the memory that is free: with DOOM 3 BFG (~750 MB of
textures in BOs plus ~500 MB of its own) it does not fit ("Image
allocation is N pages short").

At the device prepare step of a hibernation (user space frozen, nothing
taken for the image yet) panfrost waits for the GPU to finish with each
BO, unmaps it from the GPU and gives its pages back to its shmem file,
marked dirty (new drm_gem_shmem_evict_locked()): reclaim then writes them
to swap like other memory and the image is small. After the hibernation
(resumed, or failed) the PM notifier maps them again, or the next job
submit if it comes first; CPU mmaps were zapped and fault the pages back
(the shmem helper now keeps "use count but no pages" as evicted and reads
them back in drm_gem_shmem_get_pages_locked() and in its fault handler).

Kept resident: imported, exported, pinned and vmapped BOs, heaps, BOs
marked purgeable (the shrinker frees those) and BOs a job still holds.

--- a/drivers/gpu/drm/drm_gem_shmem_helper.c
+++ b/drivers/gpu/drm/drm_gem_shmem_helper.c
@@ -229,15 +229,41 @@
 }
 EXPORT_SYMBOL_GPL(drm_gem_shmem_free);
 
+/*
+ * An evicted object (drm_gem_shmem_evict_locked()) still has users of its
+ * pages (mmaps) but no pages: they are read back from its shmem file, from
+ * swap if they went there, when they are needed again.
+ */
+static int drm_gem_shmem_populate_locked(struct drm_gem_shmem_object *shmem)
+{
+	struct page **pages;
+
+	if (shmem->pages)
+		return 0;
+
+	pages = drm_gem_get_pages(&shmem->base);
+	if (IS_ERR(pages))
+		return PTR_ERR(pages);
+
+	shmem->pages = pages;
+
+	return 0;
+}
+
 static int drm_gem_shmem_get_pages_locked(struct drm_gem_shmem_object *shmem)
 {
 	struct drm_gem_object *obj = &shmem->base;
 	struct page **pages;
+	int ret;
 
 	dma_resv_assert_held(shmem->base.resv);
 
-	if (refcount_inc_not_zero(&shmem->pages_use_count))
-		return 0;
+	if (refcount_inc_not_zero(&shmem->pages_use_count)) {
+		ret = drm_gem_shmem_populate_locked(shmem);
+		if (ret)
+			refcount_dec(&shmem->pages_use_count);
+		return ret;
+	}
 
 	pages = drm_gem_get_pages(obj);
 	if (IS_ERR(pages)) {
@@ -276,6 +302,8 @@
 	dma_resv_assert_held(shmem->base.resv);
 
 	if (refcount_dec_and_test(&shmem->pages_use_count)) {
+		if (!shmem->pages)	/* evicted */
+			return;
 #ifdef CONFIG_X86
 		if (shmem->map_wc)
 			set_pages_array_wb(shmem->pages, obj->size >> PAGE_SHIFT);
@@ -512,6 +540,60 @@
 }
 EXPORT_SYMBOL_GPL(drm_gem_shmem_madvise_locked);
 
+/**
+ * drm_gem_shmem_evict_locked - Give the backing pages of a shmem GEM object
+ *                              back to the shmem file
+ * @shmem: shmem GEM object
+ *
+ * Unlike purging, the contents are kept: the pages are unpinned and marked
+ * dirty, so that memory reclaim can write them to swap, and come back when
+ * they are used again (a CPU fault on an mmap, drm_gem_shmem_get_pages_sgt(),
+ * a vmap). The caller must have stopped every device use of the object and
+ * torn down its device mappings first. Objects that are pinned, vmapped,
+ * imported, exported or purged are left alone.
+ *
+ * Returns:
+ * True if the pages were given back.
+ */
+bool drm_gem_shmem_evict_locked(struct drm_gem_shmem_object *shmem)
+{
+	struct drm_gem_object *obj = &shmem->base;
+	struct drm_device *dev = obj->dev;
+
+	dma_resv_assert_held(shmem->base.resv);
+
+	if (!shmem->pages || shmem->madv < 0 || drm_gem_is_imported(obj) ||
+	    obj->dma_buf || refcount_read(&shmem->pages_pin_count) ||
+	    refcount_read(&shmem->vmap_use_count))
+		return false;
+
+	/* CPU mappings fault the pages back in */
+	drm_vma_node_unmap(&obj->vma_node, dev->anon_inode->i_mapping);
+
+	/* written by the device: must go to swap, not be dropped as clean */
+	shmem->pages_mark_dirty_on_put = true;
+
+	if (shmem->sgt) {
+		dma_unmap_sgtable(dev->dev, shmem->sgt, DMA_BIDIRECTIONAL, 0);
+		sg_free_table(shmem->sgt);
+		kfree(shmem->sgt);
+		shmem->sgt = NULL;
+		drm_gem_shmem_put_pages_locked(shmem);
+	}
+
+	/* what is left are the mmaps' uses: keep the count, drop the pages */
+	if (shmem->pages) {
+		drm_gem_put_pages(obj, shmem->pages, true,
+				  shmem->pages_mark_accessed_on_put);
+		shmem->pages = NULL;
+		shmem->pages_mark_accessed_on_put = false;
+	}
+	shmem->pages_mark_dirty_on_put = false;
+
+	return true;
+}
+EXPORT_SYMBOL_GPL(drm_gem_shmem_evict_locked);
+
 void drm_gem_shmem_purge_locked(struct drm_gem_shmem_object *shmem)
 {
 	struct drm_gem_object *obj = &shmem->base;
@@ -647,8 +729,17 @@
 
 	dma_resv_lock(obj->resv, NULL);
 
-	if (page_offset >= num_pages || drm_WARN_ON_ONCE(dev, !shmem->pages) ||
-	    shmem->madv < 0)
+	if (page_offset >= num_pages || shmem->madv < 0)
+		goto out;
+
+	/* evicted: the mmap still uses the pages, bring them back */
+	if (!shmem->pages && refcount_read(&shmem->pages_use_count) &&
+	    drm_gem_shmem_populate_locked(shmem)) {
+		ret = VM_FAULT_OOM;
+		goto out;
+	}
+	pages = shmem->pages;
+	if (drm_WARN_ON_ONCE(dev, !pages))
 		goto out;
 
 	page = pages[page_offset];
