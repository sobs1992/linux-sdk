+++ b/sound/soc/meson/axg-frddr.c
@@ -391,6 +391,7 @@
 	.driver = {
 		.name = "axg-frddr",
 		.of_match_table = axg_frddr_of_match,
+		.pm = pm_sleep_ptr(&axg_fifo_pm_ops),
