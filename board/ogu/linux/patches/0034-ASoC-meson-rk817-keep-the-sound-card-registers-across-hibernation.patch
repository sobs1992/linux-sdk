 module_platform_driver(axg_tdmout_pdrv);
--- a/sound/soc/meson/axg-tdmin.c
+++ b/sound/soc/meson/axg-tdmin.c
@@ -251,6 +251,7 @@
 	.driver = {
 		.name = "axg-tdmin",
 		.of_match_table = axg_tdmin_of_match,
+		.pm = pm_sleep_ptr(&axg_tdm_formatter_pm_ops),
 	},
 };
 module_platform_driver(axg_tdmin_pdrv);
--- a/sound/soc/codecs/rk817_codec.c
+++ b/sound/soc/codecs/rk817_codec.c
@@ -23,6 +23,7 @@
 	struct clk *mclk;
 	unsigned int stereo_sysclk;
 	bool mic_in_differential;
+	u8 kept[RK817_CODEC_DI2S_TXCR3_TXCMD - RK817_CODEC_DTOP_VUCTL + 1];
 };
 
 /*
@@ -524,9 +525,73 @@
 	clk_disable_unprepare(rk817->mclk);
 }
 
+/*
+ * The codec registers, kept across a system sleep. Powering off for
+ * hibernation powers the RK817 off, which resets the codec: the setup of
+ * the probe (the APLL among it), the volumes and the routing are gone
+ * while ALSA and DAPM count them as written (the sound card has no sleep
+ * callbacks: DAPM keeps the paths as they were). They are saved before
+ * the image is made and written back, where the codec holds another
+ * value, when the system comes back: the APLL dividers first, then the
+ * registers in their order. After a suspend to RAM the RK817 kept its
+ * power and nothing is written.
+ */
+#define RK817_CODEC_KEPT(i)	(RK817_CODEC_DTOP_VUCTL + (i))
+
+static int rk817_codec_save(struct device *dev)
+{
+	struct rk817_codec_priv *rk817 = dev_get_drvdata(dev);
+	unsigned int i;
+	int v;
+
+	if (!rk817 || !rk817->component)
+		return 0;
+	for (i = 0; i < ARRAY_SIZE(rk817->kept); i++) {
+		v = snd_soc_component_read(rk817->component, RK817_CODEC_KEPT(i));
+		if (v >= 0)
+			rk817->kept[i] = v;
+	}
+	return 0;
+}
+
+static bool rk817_codec_restore_reg(struct rk817_codec_priv *rk817,
+				    unsigned int reg)
+{
+	unsigned int i = reg - RK817_CODEC_DTOP_VUCTL;
+	int v;
+
+	v = snd_soc_component_read(rk817->component, reg);
+	if (v < 0 || v == rk817->kept[i])
+		return false;
+	snd_soc_component_write(rk817->component, reg, rk817->kept[i]);
+	return true;
+}
+
+static int rk817_codec_restore(struct device *dev)
+{
+	struct rk817_codec_priv *rk817 = dev_get_drvdata(dev);
+	unsigned int reg, n = 0;
+
+	if (!rk817 || !rk817->component)
+		return 0;
+	for (reg = RK817_CODEC_APLL_CFG1; reg <= RK817_CODEC_APLL_CFG5; reg++)
+		n += rk817_codec_restore_reg(rk817, reg);
+	for (reg = RK817_CODEC_DTOP_VUCTL; reg <= RK817_CODEC_DI2S_TXCR3_TXCMD; reg++)
+		if (reg < RK817_CODEC_APLL_CFG1 || reg > RK817_CODEC_APLL_CFG5)
+			n += rk817_codec_restore_reg(rk817, reg);
+	if (n)
+		dev_info(dev, "%u codec registers restored\n", n);
+	return 0;
+}
+
+static const struct dev_pm_ops rk817_codec_pm_ops = {
+	SYSTEM_SLEEP_PM_OPS(rk817_codec_save, rk817_codec_restore)
+};
+
 static struct platform_driver rk817_codec_driver = {
 	.driver = {
 		   .name = "rk817-codec",
+		   .pm = pm_sleep_ptr(&rk817_codec_pm_ops),
 		   },
 	.probe = rk817_platform_probe,
 	.remove = rk817_platform_remove,
