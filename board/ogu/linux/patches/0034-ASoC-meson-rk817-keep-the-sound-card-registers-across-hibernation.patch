 module_platform_driver(axg_frddr_pdrv);
--- a/sound/soc/meson/axg-toddr.c
+++ b/sound/soc/meson/axg-toddr.c
@@ -344,6 +344,7 @@
 	.driver = {
 		.name = "axg-toddr",
 		.of_match_table = axg_toddr_of_match,
