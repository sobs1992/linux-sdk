 module_platform_driver(axg_toddr_pdrv);
--- a/sound/soc/meson/axg-tdm-formatter.c
+++ b/sound/soc/meson/axg-tdm-formatter.c
@@ -24,6 +24,8 @@
 	struct reset_control *reset;
 	bool enabled;
 	struct regmap *map;
+	unsigned int num_kept;
+	u32 *kept;
 };
 
 int axg_tdm_formatter_set_channel_masks(struct regmap *map,
@@ -257,6 +259,65 @@
 }
 EXPORT_SYMBOL_GPL(axg_tdm_formatter_event);
 
+/*
+ * The registers of the formatter, kept across a system sleep. After
+ * resuming from hibernation the SoC has been off and the boot kernel did
+ * not have this module: the registers are as reset left them. Starting
+ * the stream again writes the format, but not the input the formatter
+ * takes its samples from (a DAPM mux, written only when it changes), the
+ * gains and the mutes. The registers are saved in the noirq phase before
+ * the image is made and written back, the formatter not enabled (the
+ * stream starts it), where the hardware holds another value. After a
+ * suspend to RAM nothing is written. Both TDMOUT and TDMIN have their
+ * enable bit at bit 31 of the first register.
+ */
+#define AXG_TDM_FORMATTER_ENABLE	BIT(31)
+
+static int axg_tdm_formatter_save(struct device *dev)
+{
+	struct axg_tdm_formatter *formatter = dev_get_drvdata(dev);
+	unsigned int i, v;
+	int ret;
+
+	ret = clk_prepare_enable(formatter->pclk);
+	if (ret)
+		return ret;
+	for (i = 0; i < formatter->num_kept; i++)
+		if (!regmap_read(formatter->map, i * 4, &v))
+			formatter->kept[i] = v;
+	formatter->kept[0] &= ~AXG_TDM_FORMATTER_ENABLE;
+	clk_disable_unprepare(formatter->pclk);
+	return 0;
+}
+
+static int axg_tdm_formatter_restore(struct device *dev)
+{
+	struct axg_tdm_formatter *formatter = dev_get_drvdata(dev);
+	unsigned int i, v, n = 0;
+	int ret;
+
+	ret = clk_prepare_enable(formatter->pclk);
+	if (ret)
+		return ret;
+	for (i = 0; i < formatter->num_kept; i++) {
+		if (regmap_read(formatter->map, i * 4, &v) ||
+		    v == formatter->kept[i])
+			continue;
+		regmap_write(formatter->map, i * 4, formatter->kept[i]);
+		n++;
+	}
+	clk_disable_unprepare(formatter->pclk);
+	if (n)
+		dev_info(dev, "%u registers restored\n", n);
+	return 0;
+}
+
+const struct dev_pm_ops axg_tdm_formatter_pm_ops = {
+	NOIRQ_SYSTEM_SLEEP_PM_OPS(axg_tdm_formatter_save,
+				  axg_tdm_formatter_restore)
+};
+EXPORT_SYMBOL_GPL(axg_tdm_formatter_pm_ops);
+
 int axg_tdm_formatter_probe(struct platform_device *pdev)
 {
 	struct device *dev = &pdev->dev;
@@ -287,6 +348,12 @@
 		return PTR_ERR(formatter->map);
 	}
 
+	formatter->num_kept = regmap_get_max_register(formatter->map) / 4 + 1;
+	formatter->kept = devm_kcalloc(dev, formatter->num_kept,
+				       sizeof(*formatter->kept), GFP_KERNEL);
+	if (!formatter->kept)
+		return -ENOMEM;
+
 	/* Peripharal clock */
 	formatter->pclk = devm_clk_get(dev, "pclk");
 	if (IS_ERR(formatter->pclk))
--- a/sound/soc/meson/axg-tdm-formatter.h
+++ b/sound/soc/meson/axg-tdm-formatter.h
@@ -41,5 +41,6 @@
 			    struct snd_kcontrol *control,
 			    int event);
 int axg_tdm_formatter_probe(struct platform_device *pdev);
+extern const struct dev_pm_ops axg_tdm_formatter_pm_ops;
 
 #endif /* _MESON_AXG_TDM_FORMATTER_H */
--- a/sound/soc/meson/axg-tdmout.c
+++ b/sound/soc/meson/axg-tdmout.c
@@ -330,6 +330,7 @@
 	.driver = {
 		.name = "axg-tdmout",
 		.of_match_table = axg_tdmout_of_match,
