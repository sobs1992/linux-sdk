#!/bin/sh
#
# Network over the USB-C port: a configfs gadget with one NCM function
# (CDC network, built into Linux, macOS and Windows 11). The board is
# <net>.2 on usb0, the PC gets <net>.1 from udhcpd; then
# "ssh root@<net>.2" (dropbear, keys from authorized_keys). <net> is this
# unit's (/usr/sbin/unit net, /etc/units): 192.168.7 unless listed, so two
# units can be plugged into one PC together.
# MAC addresses fixed per unit, so the PC names its interface the same
# every time: enx024f47550001 on 192.168.7, enx024f47550101 on 192.168.8.

G=/sys/kernel/config/usb_gadget/ogu
NET=$(unit net)
ADDR=$NET.2
MAC=02:4f:47:55:$(printf %02x $(( (${NET##*.} - 7) & 255 )))
DHCPD_CONF=/run/udhcpd.usb0.conf

# The PC gets <net>.1; no router and no DNS: its own default route stays
dhcpd_conf() {
	cat > $DHCPD_CONF <<-EOF
	start		$NET.1
	end		$NET.1
	max_leases	1
	interface	usb0
	lease_file	/var/run/udhcpd.usb0.leases
	option	subnet	255.255.255.0
	option	lease	86400
	EOF
}

start() {
	modprobe libcomposite 2>/dev/null
	modprobe usb_f_ncm 2>/dev/null
	mountpoint -q /sys/kernel/config || mount -t configfs none /sys/kernel/config
	udc=$(ls /sys/class/udc 2>/dev/null | head -n 1)
	[ -n "$udc" ] || { echo "no USB device controller"; return 1; }
	if [ ! -d $G ]; then
		mkdir -p $G/strings/0x409 $G/configs/c.1/strings/0x409 $G/functions/ncm.usb0 || return 1
		echo 0x1d6b > $G/idVendor	# Linux Foundation
		echo 0x0104 > $G/idProduct	# multifunction composite gadget
		echo 0x0100 > $G/bcdDevice
		echo 0x0200 > $G/bcdUSB
		echo Hardkernel > $G/strings/0x409/manufacturer
		echo "ODROID-GO Ultra" > $G/strings/0x409/product
		echo OdroidLinux > $G/strings/0x409/serialnumber
		echo NCM > $G/configs/c.1/strings/0x409/configuration
		echo 250 > $G/configs/c.1/MaxPower
		echo $MAC:02 > $G/functions/ncm.usb0/dev_addr
		echo $MAC:01 > $G/functions/ncm.usb0/host_addr
		ln -s $G/functions/ncm.usb0 $G/configs/c.1/
	fi
	echo "$udc" > $G/UDC || return 1
	ifconfig usb0 $ADDR netmask 255.255.255.0 up || return 1
	dhcpd_conf
	udhcpd $DHCPD_CONF
}

stop() {
	killall udhcpd 2>/dev/null
	ifconfig usb0 down 2>/dev/null
	[ -e $G/UDC ] && echo "" > $G/UDC
	return 0
}

case "$1" in
start)
	# in the background: bare_app (S90) does not wait for it
	(
		start && msg="OK ($ADDR)" || msg=FAIL
		echo "Network over USB: $msg" > /dev/console
	) </dev/null >/dev/null 2>&1 &
	echo "Starting the network over USB: in the background"
	;;
stop)
	printf "Stopping the network over USB: "
	stop && echo "OK" || echo "FAIL"
	;;
restart|reload)
	stop
	start
	;;
*)
	echo "Usage: $0 {start|stop|restart}"
	exit 1
esac
