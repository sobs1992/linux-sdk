#!/bin/sh
#
# Wi-Fi on the ODROID-GO Ultra: it has no chip of its own, a USB adapter on
# the USB-A port brings wlan0 (mdev loads its driver by modalias). Started
# at boot if the adapter is already in, and by mdev ("hotplug", see
# /etc/mdev.conf) when it is plugged in or pulled out later:
# wpa_supplicant + DHCP on wlan0. wpa_cli runs /etc/wpa_cli.action on every
# connection, so DHCP follows network changes (bare_app's Wi-Fi screen).

IFACE=wlan0
CONF=/etc/wpa_supplicant.conf
WPA_PID=/var/run/wpa_supplicant.$IFACE.pid
DHCP_PID=/var/run/udhcpc.$IFACE.pid
CLI_PID=/var/run/wpa_cli.$IFACE.pid

running() {
	[ -f $WPA_PID ] && kill -0 "$(cat $WPA_PID)" 2>/dev/null
}

up() {
	running && return
	(
		# the driver may still be loading its firmware
		n=0
		while [ ! -e /sys/class/net/$IFACE ]; do
			n=$((n + 1))
			[ $n -le 10 ] || exit 0
			sleep 1
		done
		wpa_supplicant -B -i $IFACE -c $CONF -P $WPA_PID
		# wpa_cli runs the action script on every connection, which starts
		# or renews the DHCP client. Joining a network takes a scan
		# (seconds), so wpa_cli is there in time; a DHCP client started
		# before it would ask in vain and wait 20 s to ask again.
		wpa_cli -B -i $IFACE -a /etc/wpa_cli.action -P $CLI_PID
		# a network joined before wpa_cli was there to see it
		if wpa_cli -i $IFACE status 2>/dev/null | grep -qx wpa_state=COMPLETED; then
			WPA_ID=$(wpa_cli -i $IFACE status | sed -n 's/^id=//p') \
				/etc/wpa_cli.action $IFACE CONNECTED
		fi
	) </dev/null >/dev/null 2>&1 &
}

down() {
	for pid in $CLI_PID $DHCP_PID $WPA_PID; do
		[ -f $pid ] && kill "$(cat $pid)" 2>/dev/null
		rm -f $pid
	done
	rm -f /var/run/wifi.$IFACE.network
}

case "$1" in
start)
	printf "Starting wifi: "
	[ -e /sys/class/net/$IFACE ] && up
	echo "OK";;
stop)
	printf "Stopping wifi: "
	down
	echo "OK";;
restart|reload)
	down
	sleep 1
	[ -e /sys/class/net/$IFACE ] && up;;
hotplug)
	# from mdev: $ACTION and $INTERFACE of the net uevent
	[ "$INTERFACE" = "$IFACE" ] || exit 0
	case "$ACTION" in
	add) up;;
	remove) down;;
	esac;;
*)
	echo "Usage: $0 {start|stop|restart|hotplug}"
	exit 1
esac
