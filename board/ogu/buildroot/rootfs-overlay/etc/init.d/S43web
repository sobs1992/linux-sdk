#!/bin/sh
#
# The device in a browser (/usr/sbin/bare-web): the computer on the USB
# cable (S42usbnet, <net>.1) opens http://<net>.2/ to install games, read
# their logs, take reports and update the system. Started in the
# background: bare_app (S90) does not wait for Python. Its log is
# /var/log/bare-web.log (256 KB at most, one older beside it).
#
# Settings, System, "The device's site" (bare_app's setting "web", mirrored
# into /data/bare-web.mode): "always" starts it with the system; "auto" (also
# when the file is not there) and "off" not: bare_app starts it ("up") while a
# computer is on the cable or Wi-Fi has an address, and stops it ("stop").
#
#   S43web start     at the start of the system: by /data/bare-web.mode
#   S43web up        started whatever the mode (bare_app; by hand)
#   S43web stop      stopped (SIGTERM; SIGKILL if it is still there 5 s later)
#   S43web restart   stopped, then up

DAEMON=/usr/sbin/bare-web
PIDFILE=/var/run/bare-web.pid
MODE=/data/bare-web.mode

# a pid file whose process is not bare-web (it ended, its pid is another
# python3's now: game-install, bare-backup) is no server: removed, so that
# start-stop-daemon neither says "already running" nor stops that one
stale() {
	pid=$(cat $PIDFILE 2>/dev/null)
	[ -n "$pid" ] || return 0
	tr '\0' ' ' < /proc/$pid/cmdline 2>/dev/null | grep -q bare-web && return 0
	rm -f $PIDFILE
}

up() {
	stale
	start-stop-daemon -S -q -b -m -p $PIDFILE -x /usr/bin/python3 -- $DAEMON
}

stop() {
	stale
	pid=$(cat $PIDFILE 2>/dev/null)
	start-stop-daemon -K -q -p $PIDFILE
	rc=$?
	# gone before another starts: it holds port 80 until then
	i=0
	while [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null && [ $i -lt 50 ]; do
		sleep 0.1
		i=$((i + 1))
	done
	[ -n "$pid" ] && kill -0 "$pid" 2>/dev/null && kill -9 "$pid"
	rm -f $PIDFILE
	return $rc
}

case "$1" in
start)
	mode=$(cat $MODE 2>/dev/null)
	if [ "$mode" != always ]; then
		echo "The web pages: by bare_app (${mode:-auto})"
		exit 0
	fi
	printf "Starting the web pages: "
	up && echo "OK" || echo "FAIL"
	;;
up)
	printf "Starting the web pages: "
	up && echo "OK" || echo "FAIL"
	;;
stop)
	printf "Stopping the web pages: "
	stop && echo "OK" || echo "FAIL"
	;;
restart|reload)
	stop
	up
	;;
*)
	echo "Usage: $0 {start|up|stop|restart}"
	exit 1
esac
