#!/bin/sh
#
# Which ODROID-GO Ultra this is: the line of /etc/units with its eMMC's
# serial number, so units with the same system image differ in host name
# and USB network and can be plugged into one PC together.
#
#   unit serial   the eMMC's serial number (0x...), as /etc/units has it
#   unit name     the host name: its /etc/units name, else /etc/hostname
#   unit net      the USB network's first three numbers, 192.168.7 if not
#                 listed: the board is .2, the PC .1 (S42usbnet)

UNITS=/etc/units

serial() {
	for d in /sys/bus/mmc/devices/*; do
		[ "$(cat "$d/type" 2>/dev/null)" = MMC ] || continue
		cat "$d/serial"
		return 0
	done
	return 1
}

# field N of this unit's line in UNITS, nothing if it has none
field() {
	s=$(serial) || return 0
	awk -v s="$s" -v n="$1" '!/^#/ && $1 == s { print $n; exit }' $UNITS 2>/dev/null
}

case "$1" in
serial)
	serial
	;;
name)
	n=$(field 2)
	[ -n "$n" ] || n=$(cat /etc/hostname 2>/dev/null)
	echo "${n:-odroid-go-ultra}"
	;;
net)
	n=$(field 3)
	echo "${n:-192.168.7}"
	;;
*)
	echo "Usage: $0 serial | name | net" >&2
	exit 1
	;;
esac
