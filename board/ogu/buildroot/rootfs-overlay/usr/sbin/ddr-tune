#!/bin/sh
# ddr-tune: the DDR PHY's read delays of this GO Ultra, moved from what BL2
# trained (docs/boards/ogu.md, "Память: подстройка задержек чтения").
# U-Boot applies them at every start, before the kernel (U-Boot patch
# 0020), from one sector of the eMMC that belongs to the unit, SECTOR (between
# the FIP and p1, next to the A/B sector; a system image never writes it):
#
#   ddr_tune=11668+10 1118c-2
#
# CSR (hex: block << 16 | instance << 12 | r << 8 | register), + or -,
# steps (hex). Taken: the DBYTEs' RxPBDly (register 68, lanes r 0-8, one
# bit's delay) and RxClkDly (8c, nibbles u 0-1, the read strobe), each CSR
# once (40 at most); a value stays within 0..3f. The CPU's bit b of byte n (of a 64-bit word) is DBYTE
# n%4, lane DqbLnSel (register a0+b of that DBYTE): bit 42 = 11668.
#
#   ddr-tune               the line kept, what U-Boot did at this start
#                          (/chosen/ddr-tune: CSR:trained>now) and the CSRs now
#   ddr-tune set 'LINE'    keep LINE (the part after "ddr_tune="), from the
#                          next start on
#   ddr-tune clear         nothing kept: BL2's training as it is
#   ddr-tune apply         the kept line now, if U-Boot did not apply it at
#                          this start (an older U-Boot): from the values now
SECTOR=32510	# 0x7efe in U-Boot's odroid-go-ultra.c
PHY=0xfe000000

die() { echo "ddr-tune: $*" >&2; exit 1; }

# the eMMC (the disk with boot partitions), not the SD card
emmc() {
	for b in /sys/block/mmcblk[0-9]; do
		[ -e "$b/$(basename "$b")boot0" ] && { echo "/dev/$(basename "$b")"; return; }
	done
	return 1
}
disk() { DISK=$(emmc) || die "no eMMC"; }

kept() {
	dd if="$DISK" bs=512 skip=$SECTOR count=1 2>/dev/null | tr -d '\0' | sed -n 's/^ddr_tune=//p'
}

# CSR+STEPS / CSR-STEPS -> "csr sign steps", refused ones fail
parse() {
	echo "$1" | sed -n 's/^\([0-9a-fA-F]\{5\}\)\([+-]\)\([0-9a-fA-F]\{1,2\}\)$/\1 \2 \3/p'
}
csr_ok() {
	c=$((0x$1))
	[ $((c >> 16)) -eq 1 ] && [ $((c >> 12 & 15)) -le 3 ] || return 1
	r=$((c >> 8 & 15)) reg=$((c & 255))
	{ [ $reg -eq $((0x68)) ] && [ $r -le 8 ]; } || { [ $reg -eq $((0x8c)) ] && [ $r -le 1 ]; }
}
# U-Boot moves a CSR as often as the line names it: once only
check() {
	seen=" "
	for t in $1; do
		set -- $(parse "$t")
		[ $# -eq 3 ] || die "not CSR+STEPS or CSR-STEPS: $t"
		csr_ok "$1" || die "not a DBYTE RxPBDly (..68) or RxClkDly (..8c) register: $1"
		[ $((0x$3)) -le 63 ] || die "more than 3f steps: $t"
		c=$(printf '%05x' $((0x$1)))
		case $seen in *" $c "*) die "$c twice" ;; esac
		seen="$seen$c "
	done
}
addr() { printf '0x%x' $((PHY + (0x$1 << 1))); }

case $1 in
"")
	disk
	line=$(kept)
	echo "kept: ${line:-none}"
	done=
	[ -e /proc/device-tree/chosen/ddr-tune ] && done=$(tr -d '\0' < /proc/device-tree/chosen/ddr-tune)
	echo "applied by U-Boot at this start: ${done:-nothing}"
	for t in $line; do
		set -- $(parse "$t")
		[ $# -eq 3 ] && printf '%s now %04x\n' "$1" "$(devmem "$(addr "$1")" 16)"
	done
	;;
set)
	[ -n "$2" ] || die "set 'CSR+STEPS ...'"
	check "$2"
	disk
	old=$(dd if="$DISK" bs=512 skip=$SECTOR count=1 2>/dev/null | tr -d '\0')
	case $old in ""|ddr_tune=*) ;; *) die "sector $SECTOR of $DISK holds something else: not written" ;; esac
	printf 'ddr_tune=%s\n' "$2" | dd of="$DISK" bs=512 seek=$SECTOR count=1 conv=sync,notrunc,fsync 2>/dev/null ||
		die "cannot write $DISK"
	echo "kept: $2 (from the next start on; now: ddr-tune apply)"
	;;
clear)
	disk
	dd if=/dev/zero of="$DISK" bs=512 seek=$SECTOR count=1 conv=notrunc,fsync 2>/dev/null || die "cannot write $DISK"
	echo "kept: none (from the next start on)"
	;;
apply)
	[ -e /proc/device-tree/chosen/ddr-tune ] && die "U-Boot applied it at this start already"
	[ -e /run/ddr-tune.applied ] && die "applied at this start already"
	disk
	line=$(kept)
	[ -n "$line" ] || die "nothing kept"
	check "$line"
	for t in $line; do
		set -- $(parse "$t")
		was=$(($(devmem "$(addr "$1")" 16)))
		if [ "$2" = - ]; then now=$((was - 0x$3)); else now=$((was + 0x$3)); fi
		[ $now -lt 0 ] && now=0
		[ $now -gt 63 ] && now=63
		devmem "$(addr "$1")" 16 $now
		printf '%s %04x -> %04x\n' "$1" $was $now
	done
	touch /run/ddr-tune.applied
	;;
*)
	die "ddr-tune [set 'LINE' | clear | apply]"
	;;
esac
