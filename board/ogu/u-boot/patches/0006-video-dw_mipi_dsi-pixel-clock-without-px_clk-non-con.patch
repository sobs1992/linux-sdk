From: OdroidLinux SDK
Subject: [PATCH] video: dw_mipi_dsi: pixel clock without px_clk,
 non-continuous clock

The Amlogic glue driver sets its clocks itself (the U-Boot clock driver
of the G12A has no video clocks) and has no "px_clk": take the pixel
clock from the timings then.

Honour MIPI_DSI_CLOCK_NON_CONTINUOUS in video mode as Linux does
(AUTO_CLKLANE_CTRL).
---
 drivers/video/dw_mipi_dsi.c | 21 ++++++++++++++++-----
 1 file changed, 16 insertions(+), 5 deletions(-)

diff --git a/drivers/video/dw_mipi_dsi.c b/drivers/video/dw_mipi_dsi.c
index c74fe678d12..851b3f93880 100644
--- a/drivers/video/dw_mipi_dsi.c
+++ b/drivers/video/dw_mipi_dsi.c
@@ -467,9 +467,15 @@ static void dw_mipi_dsi_set_mode(struct dw_mipi_dsi *dsi,
 	dsi_write(dsi, DSI_PWR_UP, RESET);
 
 	if (mode_flags & MIPI_DSI_MODE_VIDEO) {
+		u32 lpclk = PHY_TXREQUESTCLKHS;
+
+		/* As Linux: let the clock lane go to LP between bursts */
+		if (dsi->device->mode_flags & MIPI_DSI_CLOCK_NON_CONTINUOUS)
+			lpclk |= AUTO_CLKLANE_CTRL;
+
 		dsi_write(dsi, DSI_MODE_CFG, ENABLE_VIDEO_MODE);
 		dw_mipi_dsi_video_mode_config(dsi);
-		dsi_write(dsi, DSI_LPCLK_CTRL, PHY_TXREQUESTCLKHS);
+		dsi_write(dsi, DSI_LPCLK_CTRL, lpclk);
 	} else {
 		dsi_write(dsi, DSI_MODE_CFG, ENABLE_CMD_MODE);
 	}
@@ -814,14 +820,19 @@ static int dw_mipi_dsi_init(struct udevice *dev,
 	}
 
 	ret = clk_get_by_name(device->dev, "px_clk", &clk);
-	if (ret) {
+	if (ret == -ENODATA && timings->pixelclock.typ) {
+		/*
+		 * No "px_clk": the platform driver has set the pixel clock
+		 * itself, as given in the timings (Amlogic).
+		 */
+	} else if (ret) {
 		dev_err(device->dev, "peripheral clock get error %d\n", ret);
 		return ret;
+	} else {
+		/*  get the pixel clock set by the clock framework */
+		timings->pixelclock.typ = clk_get_rate(&clk);
 	}
 
-	/*  get the pixel clock set by the clock framework */
-	timings->pixelclock.typ = clk_get_rate(&clk);
-
 	dw_mipi_dsi_bridge_set(dsi, timings);
 
 	return 0;
