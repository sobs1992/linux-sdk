From: OdroidLinux SDK
Subject: [PATCH] board: odroid-go-ultra: DDR PHY read delays tuned per device

GO Ultras read bit 42 of a 64-bit word wrong now and then under GPU
load (the cache line wrong, DRAM right: Oopses, panics, games crashing).
A scan of the PHY's read eye at run time (move one delay, check memory,
put it back at the first wrong word) found the cause: BL2's training
leaves that bit, DBYTE1 lane 6, at the late edge of its eye - one step of
the read strobe and it fails, its neighbours stand five or six. The
training differs from start to start: with a bad one both units tried
failed (the second one less often, and on even beats too, bit 10).
Its own read delay (RxPBDly) 16 steps later puts it among its
neighbours: DOOM 3 soaks with a memory check, GPU at 800 MHz, ran
without an error for 6.7 hours over 5 starts on the first unit and 4
hours over 3 starts on the second; without it the first unit's first
wrong word came after 28 s and a panic after 90, the second one's 7
wrong words in an 82-minute run.

BL2 is Amlogic's binary and trains at every start, so U-Boot moves the
trained delays before the kernel: steps per CSR from a sector of the
eMMC that belongs to the unit (0x7efe, next to the A/B sector between the
FIP and p1; Linux's ddr-tune writes it). Only the DBYTEs' RxPBDly and
RxClkDly registers are taken, within 0..0x3f. /chosen/ddr-tune of the
kernel's device tree records the trained and the new values.
---
--- a/board/amlogic/odroid-go-ultra/odroid-go-ultra.c
+++ b/board/amlogic/odroid-go-ultra/odroid-go-ultra.c
@@ -9,9 +9,13 @@
 #include <console.h>
 #include <dm.h>
 #include <env.h>
+#include <fdt_support.h>
 #include <image.h>
 #include <log.h>
+#include <memalign.h>
+#include <mmc.h>
 #include <asm/arch/boot.h>
+#include <asm/io.h>
 #include <linux/bitops.h>
 #include <linux/delay.h>
 #include <power/pmic.h>
@@ -308,6 +312,111 @@
 }
 
 /*
+ * The DDR PHY's read delays, tuned per device (docs/boards/ogu.md,
+ * "Память: подстройка задержек чтения"). BL2 trains them at every start;
+ * on the GO Ultra the training leaves one data bit (bit 42 of the 64-bit
+ * word: DBYTE1 lane 6) at the edge of its eye, and under GPU load its
+ * odd beats are read wrong now and then (the cache line wrong, DRAM
+ * right). A line of the eMMC's sector OGU_TUNE_SECTOR, between the FIP
+ * and p1 next to the A/B sector, moves such delays from what BL2 trained:
+ *
+ *   ddr_tune=11668+10 1118c-2
+ *
+ * CSR (hex, the PHY's address: block << 16 | instance << 12 | r << 8 |
+ * register), + or -, steps (hex). Only the DBYTEs' RxPBDly (register 0x68,
+ * lanes r 0-8: a bit's own delay) and RxClkDly (0x8c, nibbles u 0-1: the
+ * read strobe) are taken, each kept within 0..0x3f. The sector is the
+ * unit's own (/usr/sbin/ddr-tune writes it; an image of the system never
+ * does): the eMMC's, also when Linux starts from the SD card. U-Boot moves
+ * them before the kernel, also before one that resumes from hibernation
+ * (its Linux runs no init scripts). /chosen/ddr-tune of the device tree
+ * says what was done: "CSR:trained>now ...".
+ */
+#define OGU_TUNE_SECTOR		0x7efe
+#define OGU_PHY_CSR(csr)	((void __iomem *)(0xfe000000UL + ((csr) << 1)))
+
+static char ogu_tune_done[512];	/* "CSR:was>now " for up to 32 lanes */
+
+static bool ogu_tune_csr_ok(ulong csr)
+{
+	ulong db = csr >> 12 & 0xf, r = csr >> 8 & 0xf, reg = csr & 0xff;
+
+	if (csr >> 16 != 1 || db > 3)
+		return false;
+	return (reg == 0x68 && r <= 8) || (reg == 0x8c && r <= 1);
+}
+
+static void ogu_ddr_tune(void)
+{
+	ALLOC_CACHE_ALIGN_BUFFER(char, buf, 512);
+	struct blk_desc *bd;
+	struct mmc *mmc;
+	char *p, *q;
+	int dev, len = 0;
+
+	dev = ogu_emmc_devnum();
+	mmc = dev < 0 ? NULL : find_mmc_device(dev);
+	if (!mmc || mmc_init(mmc))
+		return;
+	bd = mmc_get_blk_desc(mmc);
+	if (!bd || blk_dread(bd, OGU_TUNE_SECTOR, 1, buf) != 1)
+		return;
+	buf[511] = '\0';
+	p = strstr(buf, "ddr_tune=");
+	if (!p)
+		return;
+	p += strlen("ddr_tune=");
+	q = strchr(p, '\n');
+	if (q)
+		*q = '\0';
+
+	while (*p) {
+		ulong csr, steps;
+		long now;
+		int sign;
+		u16 was;
+
+		while (*p == ' ')
+			p++;
+		if (!*p)
+			break;
+		csr = hextoul(p, &q);
+		if (q == p || (*q != '+' && *q != '-'))
+			break;
+		sign = *q == '-' ? -1 : 1;
+		p = q + 1;
+		steps = hextoul(p, &q);
+		if (q == p)
+			break;
+		p = q;
+		if (!ogu_tune_csr_ok(csr) || steps > 0x3f) {
+			printf("DDR tune: %lx refused\n", csr);
+			continue;
+		}
+		was = readw(OGU_PHY_CSR(csr));
+		now = clamp((long)was + sign * (long)steps, 0L, 0x3fL);
+		writew(now, OGU_PHY_CSR(csr));
+		printf("DDR tune: %05lx %04x -> %04lx\n", csr, was, now);
+		if (len < sizeof(ogu_tune_done) - 24)
+			len += snprintf(ogu_tune_done + len, sizeof(ogu_tune_done) - len,
+					"%s%05lx:%04x>%04lx", len ? " " : "", csr, was, now);
+	}
+	dsb();
+}
+
+int meson_ft_board_setup(void *blob, struct bd_info *bd)
+{
+	int node;
+
+	if (!ogu_tune_done[0])
+		return 0;
+	node = fdt_find_or_add_subnode(blob, 0, "chosen");
+	if (node >= 0)
+		fdt_setprop_string(blob, node, "ddr-tune", ogu_tune_done);
+	return 0;
+}
+
+/*
  * VOLUME-UP held at power-on: the eMMC as a USB disk for the computer
  * (USB mass storage on the USB-C port), to write a new image to it. It
  * ends when the computer ejects the disk, when the USB cable goes or with
@@ -339,6 +448,7 @@
 
 int meson_board_late_init(void)
 {
+	ogu_ddr_tune();
 	ogu_charge_wait();
 	ogu_ums_key();
 	/*
