From: OdroidLinux SDK
Subject: [PATCH] phy: meson: add the G12A MIPI D-PHY analog part

Port of the Linux driver: the analog side of the MIPI D-PHY of the G12A,
G12B and SM1, three registers of the HHI system controller. The AXG
MIPI D-PHY driver, which drives the digital side, takes it as its
"analog" PHY; let that one build for G12A too.
---
 drivers/phy/Kconfig                       |  13 +-
 drivers/phy/Makefile                      |   1 +
 drivers/phy/meson-g12a-mipi-dphy-analog.c | 144 ++++++++++++++++++++++
 3 files changed, 157 insertions(+), 1 deletion(-)
 create mode 100644 drivers/phy/meson-g12a-mipi-dphy-analog.c

diff --git a/drivers/phy/Kconfig b/drivers/phy/Kconfig
index 5c8ec2b146f..21e0a6369e4 100644
--- a/drivers/phy/Kconfig
+++ b/drivers/phy/Kconfig
@@ -209,7 +209,7 @@ config MESON_G12A_USB_PHY
 
 config MESON_AXG_MIPI_DPHY
 	bool "Amlogic Meson AXG MIPI D-PHY"
-	depends on PHY && ARCH_MESON && MESON_AXG
+	depends on PHY && ARCH_MESON && (MESON_AXG || MESON_G12A)
 	select MIPI_DPHY_HELPERS
 	imply REGMAP
 	help
@@ -225,6 +225,17 @@ config MESON_AXG_MIPI_PCIE_ANALOG_PHY
 	  This is the generic phy driver for the Amlogic Meson AXG
 	  MIPI PCIe Analog PHY.
 
+config MESON_G12A_MIPI_DPHY_ANALOG
+	bool "Amlogic Meson G12A MIPI D-PHY analog part"
+	depends on PHY && ARCH_MESON && MESON_G12A
+	select MIPI_DPHY_HELPERS
+	select REGMAP
+	select SYSCON
+	help
+	  The analog part of the MIPI D-PHY of the Amlogic G12A, G12B and
+	  SM1, in the HHI system controller. Used with the AXG MIPI D-PHY
+	  driver for MIPI DSI.
+
 config OMAP_USB2_PHY
 	bool "Support OMAP's USB2 PHY"
 	depends on PHY
diff --git a/drivers/phy/Makefile b/drivers/phy/Makefile
index e46c362878d..233b487f8dd 100644
--- a/drivers/phy/Makefile
+++ b/drivers/phy/Makefile
@@ -30,6 +30,7 @@ obj-$(CONFIG_MESON_GXL_USB_PHY) += meson-gxl-usb2.o
 obj-$(CONFIG_MESON_G12A_USB_PHY) += meson-g12a-usb2.o meson-g12a-usb3-pcie.o
 obj-$(CONFIG_MESON_AXG_MIPI_DPHY) += meson-axg-mipi-dphy.o
 obj-$(CONFIG_MESON_AXG_MIPI_PCIE_ANALOG_PHY) += meson-axg-mipi-pcie-analog.o
+obj-$(CONFIG_MESON_G12A_MIPI_DPHY_ANALOG) += meson-g12a-mipi-dphy-analog.o
 obj-$(CONFIG_OMAP_USB2_PHY) += omap-usb2-phy.o
 obj-$(CONFIG_KEYSTONE_USB_PHY) += keystone-usb-phy.o
 obj-$(CONFIG_MT7620_USB_PHY) += mt7620-usb-phy.o
diff --git a/drivers/phy/meson-g12a-mipi-dphy-analog.c b/drivers/phy/meson-g12a-mipi-dphy-analog.c
new file mode 100644
index 00000000000..2ae16f7ac42
--- /dev/null
+++ b/drivers/phy/meson-g12a-mipi-dphy-analog.c
@@ -0,0 +1,144 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Meson G12A MIPI D-PHY analog part
+ *
+ * Ported from Linux drivers/phy/amlogic/phy-meson-g12a-mipi-dphy-analog.c
+ * Copyright (C) 2018 Amlogic, Inc. All rights reserved
+ * Copyright (C) 2022 BayLibre, SAS
+ * Author: Neil Armstrong <narmstrong@baylibre.com>
+ */
+
+#include <dm.h>
+#include <errno.h>
+#include <generic-phy.h>
+#include <phy-mipi-dphy.h>
+#include <regmap.h>
+#include <syscon.h>
+#include <dm/device.h>
+#include <linux/bitfield.h>
+#include <linux/bitops.h>
+#include <linux/err.h>
+
+#define HHI_MIPI_CNTL0 0x00
+#define		HHI_MIPI_CNTL0_DIF_REF_CTL1	GENMASK(31, 16)
+#define		HHI_MIPI_CNTL0_DIF_REF_CTL0	GENMASK(15, 0)
+
+#define HHI_MIPI_CNTL1 0x04
+#define		HHI_MIPI_CNTL1_BANDGAP		BIT(16)
+#define		HHI_MIPI_CNTL2_DIF_REF_CTL2	GENMASK(15, 0)
+
+#define HHI_MIPI_CNTL2 0x08
+#define		HHI_MIPI_CNTL2_DIF_TX_CTL1	GENMASK(31, 16)
+#define		HHI_MIPI_CNTL2_CH_EN		GENMASK(15, 11)
+#define		HHI_MIPI_CNTL2_DIF_TX_CTL0	GENMASK(10, 0)
+
+#define DSI_LANE_0				BIT(4)
+#define DSI_LANE_1				BIT(3)
+#define DSI_LANE_CLK				BIT(2)
+#define DSI_LANE_2				BIT(1)
+#define DSI_LANE_3				BIT(0)
+
+struct phy_g12a_mipi_dphy_analog_priv {
+	struct regmap *regmap;
+	struct phy_configure_opts_mipi_dphy config;
+};
+
+static int phy_g12a_mipi_dphy_analog_configure(struct phy *phy, void *params)
+{
+	struct phy_g12a_mipi_dphy_analog_priv *priv = dev_get_priv(phy->dev);
+	struct phy_configure_opts_mipi_dphy *config = params;
+	int ret;
+
+	ret = phy_mipi_dphy_config_validate(config);
+	if (ret)
+		return ret;
+
+	memcpy(&priv->config, config, sizeof(priv->config));
+
+	return 0;
+}
+
+static int phy_g12a_mipi_dphy_analog_power_on(struct phy *phy)
+{
+	struct phy_g12a_mipi_dphy_analog_priv *priv = dev_get_priv(phy->dev);
+	unsigned int reg;
+
+	regmap_write(priv->regmap, HHI_MIPI_CNTL0,
+		     FIELD_PREP(HHI_MIPI_CNTL0_DIF_REF_CTL0, 0x8) |
+		     FIELD_PREP(HHI_MIPI_CNTL0_DIF_REF_CTL1, 0xa487));
+
+	regmap_write(priv->regmap, HHI_MIPI_CNTL1,
+		     FIELD_PREP(HHI_MIPI_CNTL2_DIF_REF_CTL2, 0x2e) |
+		     HHI_MIPI_CNTL1_BANDGAP);
+
+	regmap_write(priv->regmap, HHI_MIPI_CNTL2,
+		     FIELD_PREP(HHI_MIPI_CNTL2_DIF_TX_CTL0, 0x45a) |
+		     FIELD_PREP(HHI_MIPI_CNTL2_DIF_TX_CTL1, 0x2680));
+
+	reg = DSI_LANE_CLK;
+	switch (priv->config.lanes) {
+	case 4:
+		reg |= DSI_LANE_3;
+		fallthrough;
+	case 3:
+		reg |= DSI_LANE_2;
+		fallthrough;
+	case 2:
+		reg |= DSI_LANE_1;
+		fallthrough;
+	case 1:
+		reg |= DSI_LANE_0;
+		break;
+	default:
+		reg = 0;
+	}
+
+	regmap_update_bits(priv->regmap, HHI_MIPI_CNTL2,
+			   HHI_MIPI_CNTL2_CH_EN,
+			   FIELD_PREP(HHI_MIPI_CNTL2_CH_EN, reg));
+
+	return 0;
+}
+
+static int phy_g12a_mipi_dphy_analog_power_off(struct phy *phy)
+{
+	struct phy_g12a_mipi_dphy_analog_priv *priv = dev_get_priv(phy->dev);
+
+	regmap_write(priv->regmap, HHI_MIPI_CNTL0, 0);
+	regmap_write(priv->regmap, HHI_MIPI_CNTL1, 0);
+	regmap_write(priv->regmap, HHI_MIPI_CNTL2, 0);
+
+	return 0;
+}
+
+static const struct phy_ops phy_g12a_mipi_dphy_analog_ops = {
+	.configure = phy_g12a_mipi_dphy_analog_configure,
+	.power_on = phy_g12a_mipi_dphy_analog_power_on,
+	.power_off = phy_g12a_mipi_dphy_analog_power_off,
+};
+
+static int phy_g12a_mipi_dphy_analog_probe(struct udevice *dev)
+{
+	struct phy_g12a_mipi_dphy_analog_priv *priv = dev_get_priv(dev);
+
+	/* The HHI system controller is the parent node */
+	priv->regmap = syscon_node_to_regmap(dev_ofnode(dev_get_parent(dev)));
+	if (IS_ERR(priv->regmap))
+		return PTR_ERR(priv->regmap);
+
+	return 0;
+}
+
+static const struct udevice_id phy_g12a_mipi_dphy_analog_ids[] = {
+	{ .compatible = "amlogic,g12a-mipi-dphy-analog" },
+	{ }
+};
+
+U_BOOT_DRIVER(meson_g12a_mipi_dphy_analog) = {
+	.name = "meson_g12a_mipi_dphy_analog",
+	.id = UCLASS_PHY,
+	.of_match = phy_g12a_mipi_dphy_analog_ids,
+	.probe = phy_g12a_mipi_dphy_analog_probe,
+	.ops = &phy_g12a_mipi_dphy_analog_ops,
+	.priv_auto = sizeof(struct phy_g12a_mipi_dphy_analog_priv),
+};
