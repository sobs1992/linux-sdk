From: OdroidLinux SDK
Subject: [PATCH] pwm: meson: support the -v2 binding

The upstream G12 device tree describes the EE PWMs with the newer binding:
compatible "amlogic,meson-g12-pwm-v2", "amlogic,meson8-pwm-v2", the
four mux inputs as unnamed clocks. The driver knew none of it, and with
the fallback for missing "clkinN" names the channel clock was left
uninitialised (crash in clk_get_rate() on the first pwm_set_config()).

For the -v2 binding run both channels from the first input, the XTAL:
24 MHz covers backlight and similar periods.
---
 drivers/pwm/pwm-meson.c | 22 ++++++++++++++++++++++
 1 file changed, 22 insertions(+)

diff --git a/drivers/pwm/pwm-meson.c b/drivers/pwm/pwm-meson.c
index caa7af085fa..124b1434fcb 100644
--- a/drivers/pwm/pwm-meson.c
+++ b/drivers/pwm/pwm-meson.c
@@ -84,6 +84,8 @@ struct meson_pwm_channel {
 struct meson_pwm_data {
 	const long *parent_ids;
 	unsigned int num_parents;
+	/* "-v2" binding: the clocks are the mux inputs, in order, unnamed */
+	bool clocks_by_index;
 };
 
 struct meson_pwm {
@@ -273,6 +275,18 @@ static int meson_pwm_probe(struct udevice *dev)
 		struct meson_pwm_channel *channel = &priv->channels[i];
 		struct meson_pwm_channel_data *channel_data = &meson_pwm_per_channel_data[i];
 
+		if (data->clocks_by_index) {
+			/* Run both channels from the first input, the XTAL */
+			err = clk_get_by_index(dev, 0, &channel->clk);
+			if (err)
+				return err;
+
+			reg = readl(priv->base + REG_MISC_AB);
+			reg &= ~(MISC_CLK_SEL_MASK << channel_data->clk_sel_shift);
+			writel(reg, priv->base + REG_MISC_AB);
+			continue;
+		}
+
 		snprintf(name, sizeof(name), "clkin%u", i);
 
 		err = clk_get_by_name(dev, name, &channel->clk);
@@ -488,6 +502,10 @@ static const struct meson_pwm_data pwm_g12a_ee_data = {
 	.num_parents = ARRAY_SIZE(pwm_g12a_ee_parent_ids),
 };
 
+static const struct meson_pwm_data pwm_g12_v2_data = {
+	.clocks_by_index = true,
+};
+
 static const struct udevice_id meson_pwm_ids[] = {
 	{
 		.compatible = "amlogic,meson-gxbb-pwm",
@@ -517,6 +535,10 @@ static const struct udevice_id meson_pwm_ids[] = {
 		.compatible = "amlogic,meson-g12a-ao-pwm-cd",
 		.data = (ulong)&pwm_g12a_ao_cd_data
 	},
+	{
+		.compatible = "amlogic,meson8-pwm-v2",
+		.data = (ulong)&pwm_g12_v2_data
+	},
 };
 
 U_BOOT_DRIVER(meson_pwm) = {
