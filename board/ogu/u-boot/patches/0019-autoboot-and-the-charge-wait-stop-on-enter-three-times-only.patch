From: OdroidLinux SDK
Subject: [PATCH] autoboot and the charge wait: stop on Enter three times only

With the UART lines connected to the ODROID-GO Ultra but the adapter not
plugged into a computer (RX left open), the line picks up noise: U-Boot
read it as keys. Its wait for the power key on USB power stopped at the
prompt ("Key on the console: stopping here", then a screen of garbage
commands; first GO Ultra, 2026-11-21), and with CONFIG_BOOTDELAY=0 any
byte waiting at the autoboot check stops the boot as well.

Both stop on Enter pressed three times in a row now (CR CR CR; a
terminal's LF after its CR is skipped): held down, Enter repeats, as
before; noise hardly sends three CRs in a row. The autoboot is keyed
(CONFIG_AUTOBOOT_KEYED, CONFIG_AUTOBOOT_STOP_STR in
board/ogu/u-boot/ogu.config); its check read one byte per 10 ms pass,
and a boot delay of 0 gives it one pass: it reads all that is waiting in
the UART's FIFO now.
---
--- a/board/amlogic/odroid-go-ultra/odroid-go-ultra.c
+++ b/board/amlogic/odroid-go-ultra/odroid-go-ultra.c
@@ -189,7 +189,7 @@
 static void ogu_charge_wait(void)
 {
 	struct udevice *rk817, *rk818, *backlight;
-	int on818, irq818, sts;
+	int on818, irq818, sts, stop_seen = 0;
 	ulong start;
 
 	if (uclass_get_device_by_name(UCLASS_PMIC, "pmic@20", &rk817) ||
@@ -231,9 +231,20 @@
 			backlight_set_brightness(backlight, BACKLIGHT_OFF);
 			backlight = NULL;
 		}
-		if (tstc()) {
-			getchar();
-			printf("Key on the console: stopping here\n");
+		/* Enter three times in a row on the console (a terminal's
+		 * LF after its CR skipped): noise on a loose UART line (RX
+		 * left open) sends bytes too, hardly three CRs in a row */
+		while (tstc()) {
+			int c = getchar();
+
+			if (c == '\n')
+				continue;
+			stop_seen = c == '\r' ? stop_seen + 1 : 0;
+			if (stop_seen == 3)
+				break;
+		}
+		if (stop_seen == 3) {
+			printf("Enter on the console: stopping here\n");
 			env_set("bootdelay", "-1");
 			break;
 		}
--- a/common/autoboot.c
+++ b/common/autoboot.c
@@ -282,31 +282,39 @@
 	 * when catch up.
 	 */
 	do {
-		if (tstc()) {
+		/* all that came, not one key a pass: with a boot delay of 0
+		 * there is one pass, and the stop string typed in it waits in
+		 * the UART's FIFO (ODROID-GO Ultra) */
+		while (!abort && tstc()) {
+			int c = getchar();
+
+			/* a terminal's LF after its CR: Enter is CR alone */
+			if (c == '\n')
+				continue;
 			if (presskey_len < presskey_max) {
-				presskey[presskey_len++] = getchar();
+				presskey[presskey_len++] = c;
 			} else {
 				for (i = 0; i < presskey_max - 1; i++)
 					presskey[i] = presskey[i + 1];
 
-				presskey[i] = getchar();
+				presskey[i] = c;
 			}
-		}
 
-		for (i = 0; i < sizeof(delaykey) / sizeof(delaykey[0]); i++) {
-			if (delaykey[i].len > 0 &&
-			    presskey_len >= delaykey[i].len &&
-				memcmp(presskey + presskey_len -
-					delaykey[i].len, delaykey[i].str,
-					delaykey[i].len) == 0) {
-					debug_bootkeys("got %skey\n",
-						delaykey[i].retry ? "delay" :
-						"stop");
+			for (i = 0; i < sizeof(delaykey) / sizeof(delaykey[0]); i++) {
+				if (delaykey[i].len > 0 &&
+				    presskey_len >= delaykey[i].len &&
+					memcmp(presskey + presskey_len -
+						delaykey[i].len, delaykey[i].str,
+						delaykey[i].len) == 0) {
+						debug_bootkeys("got %skey\n",
+							delaykey[i].retry ? "delay" :
+							"stop");
 
-				/* don't retry auto boot */
-				if (!delaykey[i].retry)
-					bootretry_dont_retry();
-				abort = 1;
+					/* don't retry auto boot */
+					if (!delaykey[i].retry)
+						bootretry_dont_retry();
+					abort = 1;
+				}
 			}
 		}
 		udelay(10000);
