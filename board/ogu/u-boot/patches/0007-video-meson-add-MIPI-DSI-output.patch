--- /dev/null
+++ b/drivers/video/meson/meson_dw_mipi_dsi.c
@@ -0,0 +1,528 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Amlogic G12A/G12B/SM1 MIPI DSI: the Synopsys DesignWare DSI host with
+ * Amlogic's top-level glue and clocks.
+ *
+ * Based on the Linux driver drivers/gpu/drm/meson/meson_dw_mipi_dsi.c
+ * Copyright (C) 2021 BayLibre, SAS
+ * Author: Neil Armstrong <narmstrong@baylibre.com>
+ * Copyright (C) 2015 Amlogic, Inc. All rights reserved.
+ *
+ * The U-Boot clock driver of the G12A has no GP0 PLL and no video clocks,
+ * so this driver sets them itself, as the Linux clock tree does with the
+ * dsi node's assigned-clocks:
+ *
+ *   GP0 PLL (lane bit rate) --+-- MIPI_DSI_PXCLK (/1) -> D-PHY bit clock
+ *                             +-- VCLK2 (/bpp*lanes) -> VCLK2_DIV1 -> CTS_ENCL
+ *
+ * The pixel clock is the bit rate divided by bpp / lanes, so the ENCL
+ * encoder and the DSI host run exactly in step.
+ *
+ * Order, as in Linux: DSI host and D-PHY up in command mode, panel init
+ * commands (attach), then the VPU starts the encoder, then video mode and
+ * the backlight (set_backlight). The host must not get pixels while it is
+ * still in command mode: its DPI FIFO overflows and the data lanes never
+ * go to HS (black screen).
+ */
+
+#define LOG_CATEGORY UCLASS_VIDEO_BRIDGE
+
+#include <clk.h>
+#include <dm.h>
+#include <dsi_host.h>
+#include <generic-phy.h>
+#include <log.h>
+#include <mipi_dsi.h>
+#include <panel.h>
+#include <phy-mipi-dphy.h>
+#include <regmap.h>
+#include <reset.h>
+#include <syscon.h>
+#include <video_bridge.h>
+#include <asm/io.h>
+#include <dm/device-internal.h>
+#include <dm/device_compat.h>
+#include <dm/lists.h>
+#include <linux/bitfield.h>
+#include <linux/bitops.h>
+#include <linux/delay.h>
+#include <linux/err.h>
+#include <linux/math64.h>
+#include <linux/time.h>
+
+/* Amlogic glue registers, after the DW MIPI DSI ones */
+#define MIPI_DSI_TOP_SW_RESET		0x3c0
+#define MIPI_DSI_TOP_SW_RESET_DWC	BIT(0)
+#define MIPI_DSI_TOP_SW_RESET_INTR	BIT(1)
+#define MIPI_DSI_TOP_SW_RESET_DPI	BIT(2)
+#define MIPI_DSI_TOP_SW_RESET_TIMING	BIT(3)
+#define MIPI_DSI_TOP_SW_RESET_ALL	(MIPI_DSI_TOP_SW_RESET_DWC | \
+					 MIPI_DSI_TOP_SW_RESET_INTR | \
+					 MIPI_DSI_TOP_SW_RESET_DPI | \
+					 MIPI_DSI_TOP_SW_RESET_TIMING)
+#define MIPI_DSI_TOP_CLK_CNTL		0x3c4
+#define MIPI_DSI_TOP_CLK_SYSCLK_EN	BIT(0)
+#define MIPI_DSI_TOP_CLK_PIXCLK_EN	BIT(1)
+#define MIPI_DSI_TOP_CNTL		0x3c8
+#define MIPI_DSI_TOP_DPI_COLOR_MODE	GENMASK(23, 20)
+#define MIPI_DSI_TOP_IN_COLOR_MODE	GENMASK(18, 16)
+#define MIPI_DSI_TOP_COMP2_SEL		GENMASK(13, 12)
+#define MIPI_DSI_TOP_COMP1_SEL		GENMASK(11, 10)
+#define MIPI_DSI_TOP_COMP0_SEL		GENMASK(9, 8)
+#define MIPI_DSI_TOP_MEM_PD		0x3f4
+
+#define VENC_IN_COLOR_24B		0x1
+#define VENC_IN_COLOR_18B		0x2
+#define DPI_COLOR_18BIT_CFG_2		4
+#define DPI_COLOR_24BIT			5
+
+/* HHI clock registers */
+#define HHI_GP0_PLL_CNTL0		0x040
+#define		GP0_PLL_LOCK		BIT(31)
+#define		GP0_PLL_RST		BIT(29)
+#define		GP0_PLL_EN		BIT(28)
+#define		GP0_PLL_OD		GENMASK(18, 16)
+#define		GP0_PLL_N		GENMASK(14, 10)
+#define		GP0_PLL_M		GENMASK(7, 0)
+#define HHI_GP0_PLL_CNTL1		0x044	/* fraction, 17 bits */
+#define HHI_GP0_PLL_CNTL2		0x048
+#define HHI_GP0_PLL_CNTL3		0x04c
+#define HHI_GP0_PLL_CNTL4		0x050
+#define HHI_GP0_PLL_CNTL5		0x054
+#define HHI_GP0_PLL_CNTL6		0x058
+#define HHI_VIID_CLK_DIV		0x128
+#define		VCLK2_DIV		GENMASK(7, 0)
+#define		CTS_ENCL_SEL		GENMASK(15, 12)
+#define		VCLK2_DIV_EN		BIT(16)
+#define		VCLK2_DIV_RESET		BIT(17)
+#define HHI_VIID_CLK_CNTL		0x12c
+#define		VCLK2_DIV1_EN		BIT(0)
+#define		VCLK2_SOFT_RESET	BIT(15)
+#define		VCLK2_SEL		GENMASK(18, 16)
+#define		VCLK2_EN		BIT(19)
+#define HHI_VID_CLK_CNTL2		0x194
+#define		CTS_ENCL_EN		BIT(3)
+#define HHI_MIPIDSI_PHY_CLK_CNTL	0x254
+#define		MIPI_DSI_PXCLK_DIV	GENMASK(6, 0)
+#define		MIPI_DSI_PXCLK_EN	BIT(8)
+#define		MIPI_DSI_PXCLK_SEL	GENMASK(14, 12)
+
+#define VCLK_SEL_GP0			1	/* vclk2 and pxclk muxes */
+#define CTS_SEL_VCLK2_DIV1		8	/* cts_encl mux */
+
+#define XTAL_RATE			24000000ULL
+
+struct meson_dw_mipi_dsi_priv {
+	void __iomem *base;
+	struct regmap *hhi;
+	struct phy phy;
+	struct phy_configure_opts_mipi_dphy phy_opts;
+	struct reset_ctl top_rst;
+	struct mipi_dsi_device device;
+	struct udevice *panel;
+	struct udevice *dsi_host;
+	struct display_timing timings;
+	bool phy_on;
+};
+
+/* GP0 PLL: DCO = 24 MHz * (M + FRAC / 2^17), 3-6 GHz; out = DCO >> OD */
+static int meson_dsi_gp0_set_rate(struct regmap *hhi, u64 rate)
+{
+	unsigned int od, m, frac, try;
+	u64 dco;
+	u32 val;
+	int ret;
+
+	for (od = 0; od <= 4; od++) {
+		dco = rate << od;
+		if (dco >= 3000000000ULL)
+			break;
+	}
+	if (od > 4 || dco > 6120000000ULL)
+		return -EINVAL;
+
+	m = div64_u64(dco, XTAL_RATE);
+	frac = div64_u64((dco - m * XTAL_RATE) << 17, XTAL_RATE);
+	if (m < 125 || m > 255)
+		return -EINVAL;
+
+	/* Linux: GP0 sometimes fails to lock in early boot */
+	for (try = 0; try < 3; try++) {
+		regmap_write(hhi, HHI_GP0_PLL_CNTL0, GP0_PLL_RST);
+		regmap_write(hhi, HHI_GP0_PLL_CNTL0, GP0_PLL_RST |
+			     FIELD_PREP(GP0_PLL_OD, od) |
+			     FIELD_PREP(GP0_PLL_N, 1) |
+			     FIELD_PREP(GP0_PLL_M, m));
+		regmap_write(hhi, HHI_GP0_PLL_CNTL1, frac);
+		regmap_write(hhi, HHI_GP0_PLL_CNTL2, 0x00000000);
+		regmap_write(hhi, HHI_GP0_PLL_CNTL3, 0x48681c00);
+		regmap_write(hhi, HHI_GP0_PLL_CNTL4, 0x33771290);
+		regmap_write(hhi, HHI_GP0_PLL_CNTL5, 0x39272000);
+		regmap_write(hhi, HHI_GP0_PLL_CNTL6, 0x56540000);
+		regmap_update_bits(hhi, HHI_GP0_PLL_CNTL0, GP0_PLL_EN,
+				   GP0_PLL_EN);
+		udelay(10);
+		regmap_update_bits(hhi, HHI_GP0_PLL_CNTL0, GP0_PLL_RST, 0);
+
+		ret = regmap_read_poll_timeout(hhi, HHI_GP0_PLL_CNTL0, val,
+					       val & GP0_PLL_LOCK, 20, 100000);
+		if (!ret)
+			return 0;
+	}
+
+	return ret;
+}
+
+static int meson_dsi_set_clocks(struct udevice *dev, u64 bit_rate,
+				unsigned int px_div)
+{
+	struct meson_dw_mipi_dsi_priv *priv = dev_get_priv(dev);
+	struct regmap *hhi = priv->hhi;
+	int ret;
+
+	if (!px_div || px_div > 256)
+		return -EINVAL;
+
+	/* Stop what runs from GP0 */
+	regmap_update_bits(hhi, HHI_VID_CLK_CNTL2, CTS_ENCL_EN, 0);
+	regmap_update_bits(hhi, HHI_VIID_CLK_CNTL, VCLK2_EN | VCLK2_DIV1_EN, 0);
+	regmap_update_bits(hhi, HHI_MIPIDSI_PHY_CLK_CNTL, MIPI_DSI_PXCLK_EN, 0);
+
+	ret = meson_dsi_gp0_set_rate(hhi, bit_rate);
+	if (ret) {
+		dev_err(dev, "GP0 PLL: no lock at %llu Hz (%d)\n", bit_rate, ret);
+		return ret;
+	}
+
+	/* D-PHY bit clock: GP0 / 1 */
+	regmap_update_bits(hhi, HHI_MIPIDSI_PHY_CLK_CNTL,
+			   MIPI_DSI_PXCLK_SEL | MIPI_DSI_PXCLK_DIV,
+			   FIELD_PREP(MIPI_DSI_PXCLK_SEL, VCLK_SEL_GP0));
+	regmap_update_bits(hhi, HHI_MIPIDSI_PHY_CLK_CNTL, MIPI_DSI_PXCLK_EN,
+			   MIPI_DSI_PXCLK_EN);
+
+	/* Pixel clock: GP0 -> VCLK2 / px_div -> VCLK2_DIV1 -> CTS_ENCL */
+	regmap_update_bits(hhi, HHI_VIID_CLK_CNTL, VCLK2_SEL,
+			   FIELD_PREP(VCLK2_SEL, VCLK_SEL_GP0));
+	regmap_update_bits(hhi, HHI_VIID_CLK_DIV, VCLK2_DIV | VCLK2_DIV_RESET,
+			   FIELD_PREP(VCLK2_DIV, px_div - 1));
+	regmap_update_bits(hhi, HHI_VIID_CLK_DIV, VCLK2_DIV_EN, VCLK2_DIV_EN);
+	regmap_update_bits(hhi, HHI_VIID_CLK_CNTL, VCLK2_EN, VCLK2_EN);
+	regmap_update_bits(hhi, HHI_VIID_CLK_CNTL, VCLK2_SOFT_RESET,
+			   VCLK2_SOFT_RESET);
+	regmap_update_bits(hhi, HHI_VIID_CLK_CNTL, VCLK2_SOFT_RESET, 0);
+	regmap_update_bits(hhi, HHI_VIID_CLK_CNTL, VCLK2_DIV1_EN,
+			   VCLK2_DIV1_EN);
+	regmap_update_bits(hhi, HHI_VIID_CLK_DIV, CTS_ENCL_SEL,
+			   FIELD_PREP(CTS_ENCL_SEL, CTS_SEL_VCLK2_DIV1));
+	regmap_update_bits(hhi, HHI_VID_CLK_CNTL2, CTS_ENCL_EN, CTS_ENCL_EN);
+
+	return 0;
+}
+
+static void meson_dw_mipi_dsi_hw_init(struct meson_dw_mipi_dsi_priv *priv)
+{
+	/* Software reset */
+	setbits_le32(priv->base + MIPI_DSI_TOP_SW_RESET,
+		     MIPI_DSI_TOP_SW_RESET_ALL);
+	clrbits_le32(priv->base + MIPI_DSI_TOP_SW_RESET,
+		     MIPI_DSI_TOP_SW_RESET_ALL);
+
+	/* Enable clocks */
+	setbits_le32(priv->base + MIPI_DSI_TOP_CLK_CNTL,
+		     MIPI_DSI_TOP_CLK_SYSCLK_EN | MIPI_DSI_TOP_CLK_PIXCLK_EN);
+
+	/* Take memory out of power down */
+	writel(0, priv->base + MIPI_DSI_TOP_MEM_PD);
+}
+
+static int meson_dsi_phy_init(void *priv_data)
+{
+	struct mipi_dsi_device *device = priv_data;
+	struct udevice *dev = device->dev;
+	struct meson_dw_mipi_dsi_priv *priv = dev_get_priv(dev);
+	unsigned int dpi_data_format, venc_data_width, bpp;
+	int ret;
+
+	bpp = mipi_dsi_pixel_format_to_bpp(device->format);
+	ret = meson_dsi_set_clocks(dev, priv->phy_opts.hs_clk_rate,
+				   bpp / device->lanes);
+	if (ret)
+		return ret;
+
+	switch (device->format) {
+	case MIPI_DSI_FMT_RGB888:
+		dpi_data_format = DPI_COLOR_24BIT;
+		venc_data_width = VENC_IN_COLOR_24B;
+		break;
+	case MIPI_DSI_FMT_RGB666:
+		dpi_data_format = DPI_COLOR_18BIT_CFG_2;
+		venc_data_width = VENC_IN_COLOR_18B;
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	/* Configure color format for DPI register */
+	writel(FIELD_PREP(MIPI_DSI_TOP_DPI_COLOR_MODE, dpi_data_format) |
+	       FIELD_PREP(MIPI_DSI_TOP_IN_COLOR_MODE, venc_data_width) |
+	       FIELD_PREP(MIPI_DSI_TOP_COMP2_SEL, 2) |
+	       FIELD_PREP(MIPI_DSI_TOP_COMP1_SEL, 1) |
+	       FIELD_PREP(MIPI_DSI_TOP_COMP0_SEL, 0),
+	       priv->base + MIPI_DSI_TOP_CNTL);
+
+	return generic_phy_configure(&priv->phy, &priv->phy_opts);
+}
+
+static int meson_dsi_get_lane_mbps(void *priv_data,
+				   struct display_timing *timings,
+				   u32 lanes, u32 format,
+				   unsigned int *lane_mbps)
+{
+	struct mipi_dsi_device *device = priv_data;
+	struct meson_dw_mipi_dsi_priv *priv = dev_get_priv(device->dev);
+	int bpp;
+
+	bpp = mipi_dsi_pixel_format_to_bpp(format);
+	if (bpp < 0)
+		return bpp;
+
+	phy_mipi_dphy_get_default_config(timings->pixelclock.typ, bpp, lanes,
+					 &priv->phy_opts);
+	*lane_mbps = DIV_ROUND_UP(priv->phy_opts.hs_clk_rate, USEC_PER_SEC);
+
+	return 0;
+}
+
+static int meson_dsi_get_timing(void *priv_data, unsigned int lane_mbps,
+				struct mipi_dsi_phy_timing *timing)
+{
+	struct mipi_dsi_device *device = priv_data;
+	struct meson_dw_mipi_dsi_priv *priv = dev_get_priv(device->dev);
+
+	/* As Linux, which took them from the vendor driver */
+	switch (priv->timings.hactive.typ) {
+	case 240:
+	case 768:
+	case 1920:
+	case 2560:
+		timing->clk_lp2hs = 23;
+		timing->clk_hs2lp = 38;
+		timing->data_lp2hs = 15;
+		timing->data_hs2lp = 9;
+		break;
+	default:
+		timing->clk_lp2hs = 37;
+		timing->clk_hs2lp = 135;
+		timing->data_lp2hs = 50;
+		timing->data_hs2lp = 3;
+	}
+
+	return 0;
+}
+
+static void meson_dsi_get_esc_clk_rate(void *priv_data,
+				       unsigned int *esc_clk_rate)
+{
+	*esc_clk_rate = 4; /* MHz */
+}
+
+static const struct mipi_dsi_phy_ops meson_dsi_phy_ops = {
+	.init = meson_dsi_phy_init,
+	.get_lane_mbps = meson_dsi_get_lane_mbps,
+	.get_timing = meson_dsi_get_timing,
+	.get_esc_clk_rate = meson_dsi_get_esc_clk_rate,
+};
+
+static int meson_dw_mipi_dsi_attach(struct udevice *dev)
+{
+	struct meson_dw_mipi_dsi_priv *priv = dev_get_priv(dev);
+	struct mipi_dsi_device *device = &priv->device;
+	struct mipi_dsi_panel_plat *mplat;
+	int ret;
+
+	ret = device_find_first_child_by_uclass(dev, UCLASS_PANEL,
+						&priv->panel);
+	if (ret) {
+		dev_err(dev, "no panel (%d)\n", ret);
+		return ret;
+	}
+
+	/* Powers the panel up and takes it out of reset */
+	ret = device_probe(priv->panel);
+	if (ret) {
+		dev_err(dev, "panel %s: probe failed (%d)\n",
+			priv->panel->name, ret);
+		return ret;
+	}
+
+	mplat = dev_get_plat(priv->panel);
+	mplat->device = device;
+	device->dev = dev;
+	device->lanes = mplat->lanes;
+	device->format = mplat->format;
+	device->mode_flags = mplat->mode_flags;
+
+	ret = panel_get_display_timing(priv->panel, &priv->timings);
+	if (ret) {
+		ret = ofnode_decode_display_timing(dev_ofnode(priv->panel), 0,
+						   &priv->timings);
+		if (ret) {
+			dev_err(dev, "no display timing (%d)\n", ret);
+			return ret;
+		}
+	}
+
+	ret = device_find_first_child_by_uclass(dev, UCLASS_DSI_HOST,
+						&priv->dsi_host);
+	if (!ret)
+		ret = device_probe(priv->dsi_host);
+	if (ret) {
+		dev_err(dev, "no DSI host (%d)\n", ret);
+		return ret;
+	}
+
+	ret = generic_phy_init(&priv->phy);
+	if (ret)
+		return ret;
+
+	meson_dw_mipi_dsi_hw_init(priv);
+
+	/* Clocks, D-PHY and host setup; leaves the host in command mode */
+	ret = dsi_host_init(priv->dsi_host, device, &priv->timings, 4,
+			    &meson_dsi_phy_ops);
+	if (ret) {
+		dev_err(dev, "DSI host init failed (%d)\n", ret);
+		return ret;
+	}
+
+	ret = generic_phy_power_on(&priv->phy);
+	if (ret) {
+		dev_err(dev, "D-PHY power on failed (%d)\n", ret);
+		return ret;
+	}
+	priv->phy_on = true;
+
+	/* Panel init commands, before the encoder runs */
+	ret = panel_enable_backlight(priv->panel);
+	if (ret) {
+		dev_err(dev, "panel %s: init failed (%d)\n",
+			priv->panel->name, ret);
+		return ret;
+	}
+
+	return 0;
+}
+
+/* Called once the VPU feeds the encoder: video mode, then the backlight */
+static int meson_dw_mipi_dsi_set_backlight(struct udevice *dev, int percent)
+{
+	struct meson_dw_mipi_dsi_priv *priv = dev_get_priv(dev);
+	int ret;
+
+	if (!priv->phy_on)
+		return -ENODEV;
+
+	ret = dsi_host_enable(priv->dsi_host);
+	if (ret) {
+		dev_err(dev, "DSI video mode failed (%d)\n", ret);
+		return ret;
+	}
+
+	ret = panel_set_backlight(priv->panel, percent);
+	if (ret && ret != -ENOSYS)
+		dev_warn(dev, "backlight: %d\n", ret);
+
+	return 0;
+}
+
+static int meson_dw_mipi_dsi_get_display_timing(struct udevice *dev,
+						struct display_timing *timing)
+{
+	struct meson_dw_mipi_dsi_priv *priv = dev_get_priv(dev);
+
+	if (!priv->panel)
+		return -ENODEV;
+
+	*timing = priv->timings;
+
+	return 0;
+}
+
+static int meson_dw_mipi_dsi_bind(struct udevice *dev)
+{
+	int ret;
+
+	ret = device_bind_driver_to_node(dev, "dw_mipi_dsi", "dsihost",
+					 dev_ofnode(dev), NULL);
+	if (ret)
+		return ret;
+
+	/* The panel */
+	return dm_scan_fdt_dev(dev);
+}
+
+static int meson_dw_mipi_dsi_probe(struct udevice *dev)
+{
+	struct meson_dw_mipi_dsi_priv *priv = dev_get_priv(dev);
+	struct clk pclk;
+	ofnode hhi;
+	int ret;
+
+	priv->base = dev_read_addr_ptr(dev);
+	if (!priv->base)
+		return -EINVAL;
+
+	hhi = ofnode_by_compatible(ofnode_null(),
+				   "amlogic,meson-gx-hhi-sysctrl");
+	priv->hhi = syscon_node_to_regmap(hhi);
+	if (IS_ERR(priv->hhi))
+		return PTR_ERR(priv->hhi);
+
+	ret = generic_phy_get_by_name(dev, "dphy", &priv->phy);
+	if (ret) {
+		dev_err(dev, "no D-PHY (%d)\n", ret);
+		return ret;
+	}
+
+	ret = clk_get_by_name(dev, "pclk", &pclk);
+	if (!ret)
+		ret = clk_enable(&pclk);
+	if (ret) {
+		dev_err(dev, "pclk: %d\n", ret);
+		return ret;
+	}
+
+	/* The TOP reset also resets the APB side */
+	ret = reset_get_by_name(dev, "top", &priv->top_rst);
+	if (ret) {
+		dev_err(dev, "no top reset (%d)\n", ret);
+		return ret;
+	}
+	reset_assert(&priv->top_rst);
+	udelay(20);
+	reset_deassert(&priv->top_rst);
+
+	return 0;
+}
+
+static const struct video_bridge_ops meson_dw_mipi_dsi_ops = {
+	.attach = meson_dw_mipi_dsi_attach,
+	.set_backlight = meson_dw_mipi_dsi_set_backlight,
+	.get_display_timing = meson_dw_mipi_dsi_get_display_timing,
+};
+
+static const struct udevice_id meson_dw_mipi_dsi_ids[] = {
+	{ .compatible = "amlogic,meson-g12a-dw-mipi-dsi" },
+	{ }
+};
+
+U_BOOT_DRIVER(meson_dw_mipi_dsi) = {
+	.name		= "meson_dw_mipi_dsi",
+	.id		= UCLASS_VIDEO_BRIDGE,
+	.of_match	= meson_dw_mipi_dsi_ids,
+	.bind		= meson_dw_mipi_dsi_bind,
+	.probe		= meson_dw_mipi_dsi_probe,
+	.ops		= &meson_dw_mipi_dsi_ops,
+	.priv_auto	= sizeof(struct meson_dw_mipi_dsi_priv),
+};
