index 1bc6aaf7305..48122faf34e 100644
--- a/drivers/video/meson/meson_venc.c
+++ b/drivers/video/meson/meson_venc.c
@@ -11,6 +11,9 @@
 #include <fdtdec.h>
 #include <log.h>
 #include <asm/io.h>
+#include <linux/bitfield.h>
+#include <linux/bitops.h>
+#include <linux/iopoll.h>
 #include "meson_vpu.h"
 
 enum {
@@ -1567,3 +1570,215 @@ void meson_vpu_setup_venc(struct udevice *dev,
 
 	meson_venc_hdmi_mode_set(priv, mode);
 }
+
+/*
+ * ENCL, the LCD encoder, for MIPI DSI. Ported from Linux
+ * drivers/gpu/drm/meson/meson_venc.c (meson_venc_mipi_dsi_mode_set(),
+ * meson_encl_load_gamma()) and meson_encoder_dsi.c, with the SDK's
+ * Linux patches 0004 (gamma) and 0005 (no POST2 matrix).
+ */
+#define ENCL_PX_LN_CNT_SHADOW_EN		BIT(15)
+#define ENCL_VIDEO_MODE_ADV_VFIFO_EN		BIT(3)
+#define ENCL_VIDEO_MODE_ADV_GAIN_HDTV		BIT(4)
+#define ENCL_SEL_GAMMA_RGB_IN			BIT(10)
+#define ENCL_VIDEO_FILT_CTRL_BYPASS_FILTER	BIT(12)
+#define ENCL_VIDEO_RGBIN_RGB			BIT(0)
+#define ENCL_VIDEO_RGBIN_ZBLK			BIT(1)
+#define L_GAMMA_CNTL_PORT_ADR_RDY		BIT(5)
+#define L_GAMMA_CNTL_PORT_WR_RDY		BIT(4)
+#define L_GAMMA_CNTL_PORT_EN			BIT(0)
+#define L_GAMMA_ADDR_PORT_AUTO_INC		BIT(11)
+#define L_GAMMA_ADDR_PORT_SEL_R			BIT(10)
+#define L_GAMMA_ADDR_PORT_SEL_G			BIT(9)
+#define L_GAMMA_ADDR_PORT_SEL_B			BIT(8)
+#define L_GAMMA_ADDR_PORT_ADDR			GENMASK(7, 0)
+#define L_DITH_CNTL_DITH10_EN			BIT(10)
+#define L_TCON_MISC_SEL_STV1			BIT(4)
+#define L_TCON_MISC_SEL_STV2			BIT(5)
+
+static void meson_encl_set_gamma_table(struct meson_vpu_priv *priv,
+				       u32 rgb_mask)
+{
+	void __iomem *cntl = priv->io_base + _REG(L_GAMMA_CNTL_PORT);
+	u32 reg;
+	int i;
+
+	writel_bits(L_GAMMA_CNTL_PORT_EN, 0, cntl);
+
+	if (readl_poll_timeout(cntl, reg, reg & L_GAMMA_CNTL_PORT_ADR_RDY,
+			       10000))
+		debug("%s: GAMMA ADR_RDY timeout\n", __func__);
+
+	writel(L_GAMMA_ADDR_PORT_AUTO_INC | rgb_mask |
+	       FIELD_PREP(L_GAMMA_ADDR_PORT_ADDR, 0),
+	       priv->io_base + _REG(L_GAMMA_ADDR_PORT));
+
+	/* Linear: 256 steps over 10 bits */
+	for (i = 0; i < 256; i++) {
+		if (readl_poll_timeout(cntl, reg,
+				       reg & L_GAMMA_CNTL_PORT_WR_RDY, 10000))
+			debug("%s: GAMMA WR_RDY timeout\n", __func__);
+
+		writel(i * 4, priv->io_base + _REG(L_GAMMA_DATA_PORT));
+	}
+
+	if (readl_poll_timeout(cntl, reg, reg & L_GAMMA_CNTL_PORT_ADR_RDY,
+			       10000))
+		debug("%s: GAMMA ADR_RDY timeout\n", __func__);
+
+	writel(L_GAMMA_ADDR_PORT_AUTO_INC | rgb_mask |
+	       FIELD_PREP(L_GAMMA_ADDR_PORT_ADDR, 0x23),
+	       priv->io_base + _REG(L_GAMMA_ADDR_PORT));
+}
+
+static void meson_encl_load_gamma(struct meson_vpu_priv *priv)
+{
+	meson_encl_set_gamma_table(priv, L_GAMMA_ADDR_PORT_SEL_R);
+	meson_encl_set_gamma_table(priv, L_GAMMA_ADDR_PORT_SEL_G);
+	meson_encl_set_gamma_table(priv, L_GAMMA_ADDR_PORT_SEL_B);
+
+	writel_bits(L_GAMMA_CNTL_PORT_EN, L_GAMMA_CNTL_PORT_EN,
+		    priv->io_base + _REG(L_GAMMA_CNTL_PORT));
+}
+
+#define encl_write(reg, val)	writel((val), priv->io_base + _REG(reg))
+
+void meson_vpu_setup_venc_dsi(struct udevice *dev,
+			      const struct display_timing *mode)
+{
+	struct meson_vpu_priv *priv = dev_get_priv(dev);
+	unsigned int hactive = mode->hactive.typ;
+	unsigned int vactive = mode->vactive.typ;
+	unsigned int hsync_start = hactive + mode->hfront_porch.typ;
+	unsigned int hsync_end = hsync_start + mode->hsync_len.typ;
+	unsigned int htotal = hsync_end + mode->hback_porch.typ;
+	unsigned int vsync_start = vactive + mode->vfront_porch.typ;
+	unsigned int vsync_end = vsync_start + mode->vsync_len.typ;
+	unsigned int vtotal = vsync_end + mode->vback_porch.typ;
+	unsigned int max_pxcnt = htotal - 1;
+	unsigned int max_lncnt = vtotal - 1;
+	unsigned int havon_begin = htotal - hsync_start;
+	unsigned int havon_end = havon_begin + hactive - 1;
+	unsigned int vavon_bline = vtotal - vsync_start;
+	unsigned int vavon_eline = vavon_bline + vactive - 1;
+	unsigned int hso_begin = 0;
+	unsigned int hso_end = hsync_end - hsync_start;
+	unsigned int vso_begin = 0;
+	unsigned int vso_end = 0;
+	unsigned int vso_bline = 0;
+	unsigned int vso_eline = vsync_end - vsync_start;
+
+	meson_vpp_setup_mux(priv, MESON_VIU_VPP_MUX_ENCL);
+
+	encl_write(ENCL_VIDEO_EN, 0);
+
+	encl_write(ENCL_VIDEO_MODE, ENCL_PX_LN_CNT_SHADOW_EN);
+	encl_write(ENCL_VIDEO_MODE_ADV, ENCL_VIDEO_MODE_ADV_VFIFO_EN |
+		   ENCL_VIDEO_MODE_ADV_GAIN_HDTV | ENCL_SEL_GAMMA_RGB_IN);
+
+	encl_write(ENCL_VIDEO_FILT_CTRL, ENCL_VIDEO_FILT_CTRL_BYPASS_FILTER);
+	encl_write(ENCL_VIDEO_MAX_PXCNT, max_pxcnt);
+	encl_write(ENCL_VIDEO_MAX_LNCNT, max_lncnt);
+	encl_write(ENCL_VIDEO_HAVON_BEGIN, havon_begin);
+	encl_write(ENCL_VIDEO_HAVON_END, havon_end);
+	encl_write(ENCL_VIDEO_VAVON_BLINE, vavon_bline);
+	encl_write(ENCL_VIDEO_VAVON_ELINE, vavon_eline);
+
+	encl_write(ENCL_VIDEO_HSO_BEGIN, hso_begin);
+	encl_write(ENCL_VIDEO_HSO_END, hso_end);
+	encl_write(ENCL_VIDEO_VSO_BEGIN, vso_begin);
+	encl_write(ENCL_VIDEO_VSO_END, vso_end);
+	encl_write(ENCL_VIDEO_VSO_BLINE, vso_bline);
+	encl_write(ENCL_VIDEO_VSO_ELINE, vso_eline);
+	encl_write(ENCL_VIDEO_RGBIN_CTRL,
+		   ENCL_VIDEO_RGBIN_RGB | ENCL_VIDEO_RGBIN_ZBLK);
+
+	/* default black pattern */
+	encl_write(ENCL_TST_MDSEL, 0);
+	encl_write(ENCL_TST_Y, 0);
+	encl_write(ENCL_TST_CB, 0);
+	encl_write(ENCL_TST_CR, 0);
+	encl_write(ENCL_TST_EN, 1);
+	writel_bits(ENCL_VIDEO_MODE_ADV_VFIFO_EN, 0,
+		    priv->io_base + _REG(ENCL_VIDEO_MODE_ADV));
+
+	encl_write(ENCL_VIDEO_EN, 1);
+
+	encl_write(L_RGB_BASE_ADDR, 0);
+	encl_write(L_RGB_COEFF_ADDR, 0x400); /* Magic value */
+
+	encl_write(L_DITH_CNTL_ADDR, L_DITH_CNTL_DITH10_EN);
+
+	/* DE signal for TTL */
+	encl_write(L_OEH_HS_ADDR, havon_begin);
+	encl_write(L_OEH_HE_ADDR, havon_end + 1);
+	encl_write(L_OEH_VS_ADDR, vavon_bline);
+	encl_write(L_OEH_VE_ADDR, vavon_eline);
+
+	/* DE signal for TTL */
+	encl_write(L_OEV1_HS_ADDR, havon_begin);
+	encl_write(L_OEV1_HE_ADDR, havon_end + 1);
+	encl_write(L_OEV1_VS_ADDR, vavon_bline);
+	encl_write(L_OEV1_VE_ADDR, vavon_eline);
+
+	/* Hsync signal for TTL */
+	if (mode->flags & DISPLAY_FLAGS_HSYNC_HIGH) {
+		encl_write(L_STH1_HS_ADDR, hso_begin);
+		encl_write(L_STH1_HE_ADDR, hso_end);
+	} else {
+		encl_write(L_STH1_HS_ADDR, hso_end);
+		encl_write(L_STH1_HE_ADDR, hso_begin);
+	}
+	encl_write(L_STH1_VS_ADDR, 0);
+	encl_write(L_STH1_VE_ADDR, max_lncnt);
+
+	/* Vsync signal for TTL */
+	encl_write(L_STV1_HS_ADDR, vso_begin);
+	encl_write(L_STV1_HE_ADDR, vso_end);
+	if (mode->flags & DISPLAY_FLAGS_VSYNC_HIGH) {
+		encl_write(L_STV1_VS_ADDR, vso_bline);
+		encl_write(L_STV1_VE_ADDR, vso_eline);
+	} else {
+		encl_write(L_STV1_VS_ADDR, vso_eline);
+		encl_write(L_STV1_VE_ADDR, vso_bline);
+	}
+
+	/* DE signal */
+	encl_write(L_DE_HS_ADDR, havon_begin);
+	encl_write(L_DE_HE_ADDR, havon_end + 1);
+	encl_write(L_DE_VS_ADDR, vavon_bline);
+	encl_write(L_DE_VE_ADDR, vavon_eline);
+
+	/* Hsync signal */
+	encl_write(L_HSYNC_HS_ADDR, hso_begin);
+	encl_write(L_HSYNC_HE_ADDR, hso_end);
+	encl_write(L_HSYNC_VS_ADDR, 0);
+	encl_write(L_HSYNC_VE_ADDR, max_lncnt);
+
+	/* Vsync signal */
+	encl_write(L_VSYNC_HS_ADDR, vso_begin);
+	encl_write(L_VSYNC_HE_ADDR, vso_end);
+	encl_write(L_VSYNC_VS_ADDR, vso_bline);
+	encl_write(L_VSYNC_VE_ADDR, vso_eline);
+
+	encl_write(L_INV_CNT_ADDR, 0);
+	encl_write(L_TCON_MISC_SEL_ADDR,
+		   L_TCON_MISC_SEL_STV1 | L_TCON_MISC_SEL_STV2);
+
+	/* meson_encoder_dsi_atomic_enable() */
+	encl_write(ENCL_VIDEO_EN, 0);
+	meson_encl_load_gamma(priv);
+
+	writel_bits(ENCL_VIDEO_MODE_ADV_VFIFO_EN, ENCL_VIDEO_MODE_ADV_VFIFO_EN,
+		    priv->io_base + _REG(ENCL_VIDEO_MODE_ADV));
+	encl_write(ENCL_TST_EN, 0);
+
+	/*
+	 * The panel takes RGB: no RGB->YUV matrix on OSD1 (meson_vpu_init()
+	 * sets one for HDMI), no YUV->RGB matrix after the blender.
+	 */
+	writel_bits(BIT(0), 0, priv->io_base + _REG(VPP_WRAP_OSD1_MATRIX_EN_CTRL));
+	writel_bits(BIT(0), 0, priv->io_base + _REG(VPP_POST2_MATRIX_EN_CTRL));
+
+	encl_write(ENCL_VIDEO_EN, 1);
+}
