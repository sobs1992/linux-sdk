# ODROID-GO Ultra: options on top of odroid-go-ultra_defconfig.
# Mainline U-Boot runs as BL33 of our FIP (configs/ogu_defconfig); with the
# factory bootloader still on the eMMC it is chainloaded from it instead
# (board/ogu/boot/boot.ini).

CONFIG_BAUDRATE=115200
CONFIG_BOOTDELAY=2

# After a read error ("Error reading cluster") the card reads nothing,
# not even the partition table, until a rescan: try again after one.
# Such errors after a reboot from Linux are fixed by Linux patch 0017
# (RK818 reset) and U-Boot patch 0002 (SD at 50 MHz), see README
# (ODROID-GO Ultra); the retry stays as a safety net.
# distro_bootcmd's loop, with each step named on the screen first: a step
# that hangs (mmc0 is the first access to the SD card) is then visible.
CONFIG_BOOTCOMMAND="for try in 1 2 3; do for target in ${boot_targets}; do echo Boot ${try}: ${target}; run bootcmd_${target}; done; echo Boot ${try}: SD rescan; mmc dev 0; mmc rescan; done"

# Watchdog: a hang in U-Boot resets the board after 60 s (the meson
# watchdog counts up to 65.5 s). U-Boot feeds it while it waits (boot
# delay, power-key loop, prompt) and stops it before the kernel (patch
# 0011, board_prep_linux()).
CONFIG_WDT=y
CONFIG_WATCHDOG=y
CONFIG_WDT_MESON_GXBB=y
CONFIG_WATCHDOG_AUTOSTART=y
CONFIG_WATCHDOG_TIMEOUT_MSECS=60000

# The environment lives in RAM only: the factory U-Boot keeps its own at
# 0xF0000 on the eMMC, mainline must not write over it.
CONFIG_ENV_IS_NOWHERE=y
# CONFIG_ENV_IS_IN_MMC is not set

# The panel, lit by U-Boot right after relocation (patches 0003-0010).
# The console goes to both the panel and the UART.
CONFIG_BOARD_EARLY_INIT_R=y
CONFIG_VIDEO=y
CONFIG_VIDEO_MESON=y
CONFIG_VIDEO_MESON_DSI=y
CONFIG_VIDEO_LCD_SITRONIX_ST7701=y
CONFIG_DM_PWM=y
CONFIG_PWM_MESON=y
CONFIG_BACKLIGHT_PWM=y
CONFIG_CONSOLE_ROTATION=y
# White text on black, as the Linux console
CONFIG_SYS_WHITE_ON_BLACK=y
CONFIG_CONSOLE_MUX=y
CONFIG_SYS_CONSOLE_IS_IN_ENV=y
