# ODROID-GO Ultra: options on top of odroid-go-ultra_defconfig.
# Mainline U-Boot is chainloaded from the factory U-Boot (board/ogu/boot/boot.ini).

CONFIG_BAUDRATE=115200
CONFIG_BOOTDELAY=2

# The environment lives in RAM only: the factory U-Boot keeps its own at
# 0xF0000 on the eMMC, mainline must not write over it.
CONFIG_ENV_IS_NOWHERE=y
# CONFIG_ENV_IS_IN_MMC is not set
