#!/bin/sh
#
# Data partitions of the boot disk, after the rootfs, kept by "make flash":
#   p3  ext4 "data" from a fixed start sector, mounted on /data: saved
#       games, settings and anything else written on the board
#   p4  FAT32 "GAMES" right after p3 to the end of the disk (optional),
#       mounted read-only on /games: game files, copied there from a PC
#
# An SD card the board did not boot from gives its FAT or exFAT "GAMES"
# partition to /games: a card of game files (the board boots from the
# eMMC when the card has no boot files). The GO Ultra keeps its games
# there: its eMMC has no p4, and p3 goes to the end of it. With a p4 too
# /usr/sbin/games-mount joins them: the boot disk's files first, the
# card's next to them, in the same directories.
#
# The image has only BOOT and rootfs; scripts/mkimage.sh writes "start
# size" of p3 in sectors to /etc/data-partition when the firmware config
# sets IMAGE_DATA_START_MB (and IMAGE_DATA_SIZE_MB: without a size p3 goes
# to the end of the disk and there is no p4). The first boot adds the
# partitions and formats them. Flashing the image again rewrites the
# partition table without them: the next boot adds them at the same place,
# finds the "data" and "GAMES" file systems there and keeps them. A
# partition with another file system is never touched.
#
# Without a size p3 takes the rest of the disk. Flashing leaves no p3 in
# the table: a "data" file system at its start gets a p3 of its own size,
# so that a "GAMES" file system right after it (a p4 of an older layout
# with a size) is found and gets its p4 again; it stays on /games and p3
# as it is. A p3 that ends before the end of the disk with nothing after
# it (that p4 deleted) is grown to the end, its file system with it.
#
# A/B system slots (a third value in /etc/data-partition, the slot's size
# in sectors; scripts/mkimage.sh IMAGE_AB_SLOT_MB, /usr/sbin/ab-state):
# slot a is p2, slot b p4 at the end of the disk, p3 between them (its size
# "-": up to slot b). p2 is grown to the data start when it ends before it
# (the image's rootfs is smaller than its slot), online with its file
# system if it is the root; p4 is added once, never formatted (an update
# writes it: /usr/sbin/system-update). A p3 of an older layout that takes
# the end of the disk is kept: no p4 then (scripts/ab-migrate.sh makes
# room for it). No "GAMES" p4 with slots.
#
# /games is read-only, so switching the board off never leaves the FAT
# dirty; "games-mount rw" to write there from the board ("games-mount ro"
# after).
# Needs sfdisk, partx and blkid (util-linux), mke2fs and resize2fs
# (e2fsprogs), mkdosfs.

CONF=${S05DATA_CONF:-/etc/data-partition}
# tests (scripts/test-s05data.sh): another disk than the root's, another
# mount point, no /games
DATA=${S05DATA_MNT:-/data}
MIN_SECTORS=131072	# 64 MiB
GAMES_FS="vfat exfat"	# the file systems of a "GAMES" partition

log() { echo "data: $*"; logger -t data "$*" 2>/dev/null; }

# disk holding / and the name of its partition N (mmcblk0p3, sda3)
root_disk() {
	p=$(readlink -f "/sys/dev/block/$(mountpoint -d /)") || return 1
	basename "$(dirname "$p")"
}
part_name() {
	case $1 in *[0-9]) echo "$1p$2" ;; *) echo "$1$2" ;; esac
}
part_end() {
	echo $(( $(cat "/sys/class/block/$1/start") + $(cat "/sys/class/block/$1/size") ))
}

wait_node() {
	i=0
	while [ ! -b "/dev/$1" ] && [ $i -lt 30 ]; do
		sleep 0.1
		i=$((i + 1))
	done
	[ -b "/dev/$1" ] || mknod "/dev/$1" b $(tr ':' ' ' < "/sys/class/block/$1/dev")
}

# add partition N (the next one) at START, SIZE sectors long (empty: to
# the end of the disk), of MBR type TYPE
add_part() {
	log "adding $(part_name "$disk" "$1") at sector $2"
	echo "start=$2,${3:+ size=$3,} type=$4" |
		sfdisk -q --append --no-reread --no-tell-kernel "/dev/$disk" &&
		partx -a -n "$1" "/dev/$disk" || { log "cannot add partition $1"; return 1; }
	wait_node "$(part_name "$disk" "$1")"
}

# the file system on partition $1 is of a type of the list $2 and
# labelled $3 (one probe for both: each costs tens of ms on a card)
is_fs() {
	fs=$(blkid -p -o export "/dev/$1" 2>/dev/null) || return 1
	echo "$fs" | grep -qxF "LABEL=$3" || return 1
	for t in $2; do
		echo "$fs" | grep -qxF "TYPE=$t" && return 0
	done
	return 1
}

# the file system at sector $1 of the disk, of a type of the list $2 and
# labelled $3: "type size", its size in sectors
fs_at() {
	fs=$(blkid -p -O $(($1 * 512)) -o export "/dev/$disk" 2>/dev/null) || return 1
	echo "$fs" | grep -qxF "LABEL=$3" || return 1
	size=$(echo "$fs" | sed -n 's/^FSSIZE=//p')
	[ -n "$size" ] || return 1
	for t in $2; do
		if echo "$fs" | grep -qxF "TYPE=$t"; then
			echo "$t $((size / 512))"
			return 0
		fi
	done
	return 1
}

# the first MiB boundary at or after the end of p3: where p4 starts
after_p3() {
	echo $(( ($(part_end "$p3") + 2047) / 2048 * 2048 ))
}

# no size: the old p4 of a layout with a size, found after the p3 that
# fs_at gave the size of "data", gets its partition again
old_games() {
	[ -z "$data_size" ] && [ -z "$slot_size" ] && [ ! -e "/sys/class/block/$p4" ] || return 0
	start=$(after_p3)
	found=$(fs_at "$start" "$GAMES_FS" GAMES) || return 0
	log "a \"GAMES\" file system after $p3: its partition back"
	case $found in exfat*) type=7 ;; *) type=c ;; esac
	add_part 4 "$start" "" $type
}

# p3 to the end of the disk when it may take the rest (no size, no p4,
# no file system after it: a deleted p4 must be wiped first)
grow_part() {
	[ -z "$data_size" ] && [ -z "$slot_size" ] && [ ! -e "/sys/class/block/$p4" ] || return 0
	[ $((disk_size - $(part_end "$p3"))) -ge 2048 ] || return 0	# 1 MiB
	if blkid -p -O $(($(after_p3) * 512)) "/dev/$disk" > /dev/null 2>&1; then
		log "a file system after $p3: not growing it"
		return 0
	fi
	log "growing $p3 to the end of $disk"
	echo ",+" | sfdisk -q -N 3 --no-reread --no-tell-kernel "/dev/$disk" &&
		partx -u -n 3 "/dev/$disk" || log "cannot grow $p3"
}

# the mounted /data to the size of p3 when it is 1 MiB or more smaller (p3
# grown, now or on a boot that did not get as far): online, in the
# background
grow_fs() {
	fs=$(blkid -p -o value -s FSSIZE "/dev/$p3" 2>/dev/null)
	[ -n "$fs" ] || return 0
	[ $((fs / 512 + 2048)) -le "$(cat "/sys/class/block/$p3/size")" ] || return 0
	log "growing /data to the size of $p3"
	( nice resize2fs "/dev/$p3" > /dev/null 2>&1 &&
		log "/data grown to $(df -P -h "$DATA" | awk 'NR == 2 { print $2 }')" ||
		log "cannot grow /data" ) &
}

data() {
	new=
	if [ ! -e "/sys/class/block/$p3" ]; then
		if [ "$(part_end "$p2")" -gt "$data_start" ]; then
			log "rootfs ends at sector $(part_end "$p2"), past the data start $data_start"
			return 1
		fi
		if [ $(( ${games_start:-${data_end:-$disk_size}} - data_start )) -lt $MIN_SECTORS ] ||
		   [ "${games_start:-0}" -gt "$disk_size" ]; then
			log "no room for a data partition on $disk"
			return 1
		fi
		size=$data_size
		if [ -z "$size" ] && found=$(fs_at "$data_start" ext4 data) &&
		   [ $((data_start + ${found#* })) -le "$disk_size" ]; then
			# a "data" there: its own size (what is after it is kept;
			# with slots one of an older layout to the end of the disk
			# stays so, and slot b waits for scripts/ab-migrate.sh)
			size=${found#* }
		elif [ -z "$size" ] && [ -n "$data_end" ]; then
			size=$((data_end - data_start))
		fi
		new=1
		add_part 3 "$data_start" "$size" 83 || return 1
		old_games
	elif ! is_fs "$p3" ext4 data; then
		log "$p3 is not an ext4 \"data\" file system, leaving it alone"
		return 1
	fi
	grow_part
	# only a new partition can still be empty (the check above passed)
	if [ -n "$new" ] && ! is_fs "$p3" ext4 data; then
		log "formatting $p3"
		mke2fs -q -t ext4 -L data "/dev/$p3" || return 1
	fi
	mkdir -p "$DATA"
	# fails, keeping it, if "data" is larger than p3 (from an older layout)
	mount -t ext4 -o noatime "/dev/$p3" "$DATA" || { log "cannot mount $p3"; return 1; }
	log "$p3 on /data"
	grow_fs
}

games() {
	new=
	if [ ! -e "/sys/class/block/$p4" ]; then
		if [ "$(part_end "$p3")" -gt "$games_start" ]; then
			log "$p3 ends at sector $(part_end "$p3"), past the games start $games_start"
			return 1
		fi
		if [ $((disk_size - games_start)) -lt $MIN_SECTORS ]; then
			log "no room for a games partition on $disk"
			return 1
		fi
		new=1
		add_part 4 "$games_start" "" c || return 1
	elif ! is_fs "$p4" "$GAMES_FS" GAMES; then
		log "$p4 is not a FAT or exFAT \"GAMES\" file system, leaving it alone"
		return 1
	fi
	# only a new partition can still be empty (the check above passed)
	if [ -n "$new" ] && ! is_fs "$p4" "$GAMES_FS" GAMES; then
		log "formatting $p4"
		mkdosfs -n GAMES "/dev/$p4" > /dev/null || return 1
	fi
}

# A/B slots: p2 (slot a) up to the data start, p4 (slot b) at the end
slots() {
	end_p2=$(part_end "$p2")
	if [ "$end_p2" -lt "$data_start" ] &&
	   ! blkid -p -O $((end_p2 * 512)) "/dev/$disk" > /dev/null 2>&1; then
		log "growing $p2 (slot a) up to the data start"
		echo "start=$(cat "/sys/class/block/$p2/start"), size=$((data_start - $(cat "/sys/class/block/$p2/start")))" |
			sfdisk -q -N 2 --no-reread --no-tell-kernel "/dev/$disk" &&
			partx -u -n 2 "/dev/$disk" || log "cannot grow $p2"
	fi
	# the root file system to its partition, online, in the background
	if [ "$(mountpoint -d /)" = "$(cat "/sys/class/block/$p2/dev")" ]; then
		fs=$(blkid -p -o value -s FSSIZE "/dev/$p2" 2>/dev/null)
		if [ -n "$fs" ] && [ $((fs / 512 + 2048)) -le "$(cat "/sys/class/block/$p2/size")" ]; then
			log "growing the root file system to the size of $p2"
			( nice resize2fs "/dev/$p2" > /dev/null 2>&1 || log "cannot grow the root file system" ) &
		fi
	fi
	[ -e "/sys/class/block/$p4" ] && return 0
	if [ ! -e "/sys/class/block/$p3" ] || [ "$(part_end "$p3")" -gt "$data_end" ]; then
		log "no room for slot b after $p3: system updates need it (scripts/ab-migrate.sh)"
		return 0
	fi
	add_part 4 "$data_end" "$slot_size" 83
}

# the FAT or exFAT "GAMES" partition of an SD card that is not the boot disk
card_games() {
	for b in /sys/block/mmcblk*; do
		c=${b##*/}
		[ "$c" != "$disk" ] && [ "$(cat "$b/device/type" 2>/dev/null)" = SD ] || continue
		for p in "$b/${c}"p*; do
			[ -e "$p" ] || continue
			wait_node "${p##*/}"
			if is_fs "${p##*/}" "$GAMES_FS" GAMES; then
				echo "/dev/${p##*/}"
				return 0
			fi
		done
	done
	return 1
}

start() {
	disk=$(root_disk) || { log "cannot find the root disk"; return 1; }
	if [ -n "${S05DATA_DISK+set}" ]; then
		# a test's disk: never the root disk, never "" (that would be it)
		if [ -z "$S05DATA_DISK" ] || [ "$S05DATA_DISK" = "$disk" ] ||
		   [ ! -e "/sys/class/block/$S05DATA_DISK" ] || [ -z "${S05DATA_MNT:-}" ]; then
			log "S05DATA_DISK \"$S05DATA_DISK\": not a test disk, nothing done"
			return 1
		fi
		disk=$S05DATA_DISK
	fi
	main=
	if [ -f "$CONF" ]; then
		read -r data_start data_size slot_size < "$CONF"
		[ "$data_size" != - ] || data_size=
		games_start=${data_size:+$((data_start + data_size))}
		disk_size=$(cat "/sys/block/$disk/size")
		# A/B: slot b at the end, on a MiB boundary
		data_end=
		[ -z "$slot_size" ] || data_end=$(( (disk_size - slot_size) / 2048 * 2048 ))
		[ -z "$slot_size" ] || games_start=
		p2=$(part_name "$disk" 2)
		p3=$(part_name "$disk" 3)
		p4=$(part_name "$disk" 4)

		data_ok=
		data && data_ok=1
		if [ -n "$data_ok" ] && [ -n "$slot_size" ]; then
			slots
		elif [ -n "$data_ok" ] && [ -n "$games_start" ] && games; then
			main=/dev/$p4
		elif [ -z "$data_size" ] && [ -z "$slot_size" ] && [ -e "/sys/class/block/$p4" ] &&
		     is_fs "$p4" "$GAMES_FS" GAMES; then
			# older layout: kept until p4 is deleted (p3 grows then)
			log "$p4: games of an older layout, kept"
			main=/dev/$p4
		fi
	fi
	[ -z "$S05DATA_NO_GAMES" ] || return 0
	card=$(card_games) && log "$card: games of the SD card"
	games-mount start $main $card
}

case "$1" in
start)
	start
	;;
stop)
	games-mount stop
	! mountpoint -q /data || umount /data
	;;
*)
	echo "Usage: $0 {start|stop}"
	exit 1
	;;
esac
exit 0
