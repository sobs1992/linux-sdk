config BR2_PACKAGE_BARE_APP
	bool "bare_app"
	help
	  LVGL GUI application for the SDK (display, gamepad, battery,
	  backlight, Doom with GAME_DOOM). Source: apps/bare_app (git
	  submodule). Doom is a separate program, /usr/bin/bare_app_doom,
	  under GPLv2 (apps/bare_app/ports/doom); bare_app itself has no
	  GPL code.

if BR2_PACKAGE_BARE_APP

config BR2_PACKAGE_BARE_APP_DEFCONFIG
	string "bare_app configuration"
	default "oga_defconfig"
	help
	  What goes into the binary (bare_app's own Kconfig): a name in
	  apps/bare_app/configs/ or a path to a defconfig file. In the SDK
	  set it from the firmware config:
	  APPS_CONFIG := bare-app.DEFCONFIG=oga_defconfig

config BR2_PACKAGE_BARE_APP_AUTOSTART
	bool "start at boot"
	help
	  Start bare_app from /etc/init.d/S90bare-app. It takes over the
	  screen (the text console on tty1 comes back when it quits;
	  Quit in its menu turns the device off where the platform has a
	  poweroff command).
	  Log: /var/log/bare_app.log. In the SDK: APPS_AUTOSTART.

config BR2_PACKAGE_BARE_APP_DOOM_WAD
	bool "install the shareware Doom WAD"
	select BR2_PACKAGE_DOOM1_WAD
	help
	  doom1.wad (Doom 1.9 shareware, episode 1) in
	  /usr/share/games/doom/, where GAME_DOOM looks by default. Other
	  IWADs (doom.wad, doom2.wad) can be copied there by hand and
	  chosen with GAME_DOOM_WAD. In the SDK:
	  APPS_CONFIG += bare-app.DOOM_WAD=y

config BR2_PACKAGE_BARE_APP_HOMM3
	bool "Heroes of Might and Magic III (VCMI)"
	depends on BR2_INSTALL_LIBSTDCPP
	depends on BR2_TOOLCHAIN_GCC_AT_LEAST_11
	depends on BR2_TOOLCHAIN_HAS_THREADS
	depends on BR2_USE_WCHAR
	depends on !BR2_STATIC_LIBS
	depends on !BR2_TOOLCHAIN_USES_UCLIBC
	depends on BR2_TOOLCHAIN_SUPPORTS_ALWAYS_LOCKFREE_ATOMIC_INTS
	select BR2_PACKAGE_VCMI
	help
	  The VCMI engine (package vcmi, GPLv2) for Heroes III. The game
	  data is not included: copy Data, Maps and Mp3 of an original
	  installation to heroes3/ of the games partition (GAMES, /games),
	  from a PC or with scripts/homm3-install.sh. Also switches
	  bare_app's GAME_HOMM3 on. In the SDK:
	  APPS_CONFIG += bare-app.HOMM3=y

config BR2_PACKAGE_BARE_APP_HALFLIFE
	bool "Half-Life (Xash3D FWGS)"
	depends on BR2_INSTALL_LIBSTDCPP
	depends on BR2_TOOLCHAIN_HAS_THREADS
	depends on BR2_USE_MMU
	depends on !BR2_STATIC_LIBS
	select BR2_PACKAGE_XASH3D_FWGS
	select BR2_PACKAGE_HLSDK_PORTABLE
	# the GPU renderer
	select BR2_PACKAGE_MESA_PANFROST if BR2_TOOLCHAIN_HAS_SYNC_4
	help
	  The Xash3D FWGS engine (package xash3d-fwgs, GPLv3) and the
	  game code of hlsdk-portable (Valve's SDK licence) for
	  Half-Life, drawn by the GPU (mesa-panfrost). The game files
	  are not included: copy the valve directory of a bought copy,
	  and valve_russian for Russian menus, to halflife/ of the games
	  partition (GAMES, /games), from a PC or with
	  scripts/halflife-install.sh.
	  Also switches bare_app's GAME_HALFLIFE on. In the SDK:
	  APPS_CONFIG += bare-app.HALFLIFE=y

config BR2_PACKAGE_BARE_APP_WINE
	bool "Windows games (Wine)"
	depends on BR2_aarch64
	depends on BR2_HOSTARCH = "x86_64" # prebuilt llvm-mingw
	depends on !BR2_STATIC_LIBS
	depends on BR2_TOOLCHAIN_HAS_THREADS_NPTL
	select BR2_PACKAGE_WINE_WOW64
	# OpenGL for Direct3D (WineD3D)
	select BR2_PACKAGE_MESA_PANFROST if BR2_TOOLCHAIN_HAS_SYNC_4
	help
	  Wine for 32-bit x86 Windows games (package wine-wow64, LGPL,
	  with Box64's wowbox64.dll, MIT) and its winebare.drv driver,
	  played by bare_app_wine. Each game is a directory of the games
	  partition (GAMES, /games) with a wine.ini, which names the
	  program and the controls (apps/bare_app/ports/wine/wine.ini).
	  Also switches bare_app's GAME_WINE on. In the SDK:
	  APPS_CONFIG += bare-app.WINE=y

config BR2_PACKAGE_BARE_APP_SDL
	bool "SDL2 games (SDL's bareapp drivers)"
	depends on !BR2_STATIC_LIBS # sdl2
	select BR2_PACKAGE_SDL2
	help
	  SDL2 with the video and joystick drivers "bareapp" (patch in
	  sdl2/): an SDL2 game started by bare_app draws into its video
	  layer and gets its gamepad as a game controller, unchanged.
	  The window is fitted to the layer; OpenGL ES is drawn by the
	  GPU (mesa-panfrost) off screen. Such a game is an entry of the
	  main menu by a game.ini (bare_app's GAME_NATIVE,
	  apps/bare_app/docs/game.ini): a package installs one in
	  /usr/share/bare_app/games/. In the SDK:
	  APPS_CONFIG += bare-app.SDL=y

	  SDL2 is not rebuilt by itself when this changes: run
	  "make rootfs-make BR=sdl2-dirclean" first.

config BR2_PACKAGE_BARE_APP_CHOCOLATE_DOOM
	bool "Chocolate Doom (an SDL2 game by its game.ini)"
	depends on BR2_PACKAGE_BARE_APP_SDL
	depends on BR2_USE_MMU # chocolate-doom
	select BR2_PACKAGE_CHOCOLATE_DOOM
	select BR2_PACKAGE_SDL2_MIXER # sound and OPL music
	select BR2_PACKAGE_DOOM1_WAD
	help
	  Buildroot's chocolate-doom as it is, with the shareware
	  doom1.wad: games/chocolate-doom.ini (installed in
	  /usr/share/bare_app/games/) is all it takes to make it an
	  entry of bare_app's menu, the example of an SDL2 game. In the
	  SDK: APPS_CONFIG += bare-app.CHOCOLATE_DOOM=y

endif
