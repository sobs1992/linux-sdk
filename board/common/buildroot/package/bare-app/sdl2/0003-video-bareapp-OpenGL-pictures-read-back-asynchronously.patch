+/*
+ * SDL_BAREAPP_GL_ASYNC=1: at each swap the GPU copies the picture into one
+ * of two renderbuffers, with a fence, and the copy made at the swap before
+ * (finished by then) is read back and shown. The game's work on the next
+ * frame overlaps the GPU's on this one instead of waiting for it in
+ * glReadPixels; the picture is a frame late. Mesa's panfrost reads pixel
+ * buffer objects back on the CPU too, so they would not help. Needs
+ * framebuffer blits and fences (OpenGL 3, OpenGL ES 3).
+ */
+static SDL_bool AsyncOn(_THIS)
+{
+    if (vd.async < 0) {
+        const char *env = SDL_getenv("SDL_BAREAPP_GL_ASYNC");
+
+        vd.async = 0;
+        if (env && SDL_atoi(env) > 0) {
+#define BA_PROC(name, gl) (vd.name = SDL_EGL_GetProcAddress(_this, gl)) != NULL
+            vd.async = BA_PROC(GenFramebuffers, "glGenFramebuffers") &&
+                       BA_PROC(DeleteFramebuffers, "glDeleteFramebuffers") &&
+                       BA_PROC(GenRenderbuffers, "glGenRenderbuffers") &&
+                       BA_PROC(DeleteRenderbuffers, "glDeleteRenderbuffers") &&
+                       BA_PROC(BindRenderbuffer, "glBindRenderbuffer") &&
+                       BA_PROC(RenderbufferStorage, "glRenderbufferStorage") &&
+                       BA_PROC(FramebufferRenderbuffer, "glFramebufferRenderbuffer") &&
+                       BA_PROC(BlitFramebuffer, "glBlitFramebuffer") &&
+                       BA_PROC(IsEnabled, "glIsEnabled") &&
+                       BA_PROC(Enable, "glEnable") &&
+                       BA_PROC(Disable, "glDisable") &&
+                       BA_PROC(FenceSync, "glFenceSync") &&
+                       BA_PROC(ClientWaitSync, "glClientWaitSync") &&
+                       BA_PROC(DeleteSync, "glDeleteSync") &&
+                       BA_PROC(Flush, "glFlush");
+#undef BA_PROC
+            /* GL_BGRA is bare_app's own layout; OpenGL ES may not read it */
+            vd.bgra = !(_this->gl_config.profile_mask & SDL_GL_CONTEXT_PROFILE_ES);
+        }
+    }
+    return vd.async > 0;
+}
+
+static void ForgetCopies(void)
+{
+    int k;
+
+    for (k = 0; k < 2; k++) {
+        if (vd.fence[k]) {
+            vd.DeleteSync(vd.fence[k]);
+            vd.fence[k] = NULL;
+        }
+        vd.pending[k] = SDL_FALSE;
+    }
+    if (vd.fbo[0]) {
+        vd.DeleteFramebuffers(2, vd.fbo);
+        vd.DeleteRenderbuffers(2, vd.rb);
+        vd.fbo[0] = vd.fbo[1] = vd.rb[0] = vd.rb[1] = 0;
+    }
+    vd.copy_w = vd.copy_h = 0;
+}
+
+/* The window's framebuffer is bound for drawing and reading. The copies
+ * have the size the picture gets in bare_app's frame: the GPU scales it. */
+static void SwapAsync(int w, int h)
+{
+    int k, rb = 0, cw, ch;
+    SDL_bool scissor = vd.IsEnabled(BA_GL_SCISSOR_TEST), nearest;
+    size_t size;
+
+    BAREAPP_FitSize(w, h, &cw, &ch, &nearest);
+    size = (size_t)cw * ch * 4;
+    if (vd.pixels_size < size) {
+        Uint8 *pixels = SDL_realloc(vd.pixels, size);
+
+        if (!pixels) {
+            return;
+        }
+        vd.pixels = pixels;
+        vd.pixels_size = size;
+    }
+    if (vd.copy_w != cw || vd.copy_h != ch) {
+        ForgetCopies();
+        vd.GetIntegerv(BA_GL_RENDERBUFFER_BINDING, &rb);
+        vd.GenFramebuffers(2, vd.fbo);
+        vd.GenRenderbuffers(2, vd.rb);
+        for (k = 0; k < 2; k++) {
+            vd.BindRenderbuffer(BA_GL_RENDERBUFFER, vd.rb[k]);
+            vd.RenderbufferStorage(BA_GL_RENDERBUFFER, BA_GL_RGBA8, cw, ch);
+            vd.BindFramebuffer(BA_GL_DRAW_FRAMEBUFFER, vd.fbo[k]);
+            vd.FramebufferRenderbuffer(BA_GL_DRAW_FRAMEBUFFER, BA_GL_COLOR_ATTACHMENT0, BA_GL_RENDERBUFFER, vd.rb[k]);
+        }
+        vd.BindRenderbuffer(BA_GL_RENDERBUFFER, (unsigned)rb);
+        vd.copy_w = cw;
+        vd.copy_h = ch;
+        vd.next = 0;
+    }
+    if (scissor) {
+        vd.Disable(BA_GL_SCISSOR_TEST); /* blits are cut by it */
+    }
+
+    /* this frame: copied by the GPU after it has drawn it */
+    k = vd.next;
+    if (vd.fence[k]) {
+        vd.DeleteSync(vd.fence[k]);
+    }
+    vd.BindFramebuffer(BA_GL_DRAW_FRAMEBUFFER, vd.fbo[k]);
+    vd.BlitFramebuffer(0, 0, w, h, 0, 0, cw, ch, BA_GL_COLOR_BUFFER_BIT, nearest ? BA_GL_NEAREST : BA_GL_LINEAR);
+    vd.fence[k] = vd.FenceSync(BA_GL_SYNC_GPU_COMMANDS_COMPLETE, 0);
+    vd.pending[k] = SDL_TRUE;
+    vd.Flush();
+
+    /* the one before: done by now, read without waiting */
+    vd.next = 1 - k;
+    if (vd.pending[vd.next]) {
+        vd.ClientWaitSync(vd.fence[vd.next], BA_GL_SYNC_FLUSH_COMMANDS_BIT, 2000000000ull);
+        vd.DeleteSync(vd.fence[vd.next]);
+        vd.fence[vd.next] = NULL;
+        vd.pending[vd.next] = SDL_FALSE;
+        vd.BindFramebuffer(BA_GL_READ_FRAMEBUFFER, vd.fbo[vd.next]);
+        vd.ReadPixels(0, 0, cw, ch, vd.bgra ? BA_GL_BGRA : BA_GL_RGBA, BA_GL_UNSIGNED_BYTE, vd.pixels);
+        /* GL's rows go up */
+        BAREAPP_Present(vd.pixels + (size_t)(ch - 1) * cw * 4, cw, ch, -cw * 4,
+                        vd.bgra ? BAREAPP_XRGB : BAREAPP_RGBA);
+    }
+    vd.BindFramebuffer(BA_GL_FRAMEBUFFER, 0);
+    if (scissor) {
+        vd.Enable(BA_GL_SCISSOR_TEST);
+    }
+}
+
 static int BAREAPP_GL_SwapWindow(_THIS, SDL_Window *window)
 {
     BAREAPP_WindowData *data = window->driverdata;
@@ -406,7 +571,11 @@
