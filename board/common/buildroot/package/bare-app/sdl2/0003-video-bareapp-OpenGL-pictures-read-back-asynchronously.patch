+#define BA_GL_RENDERBUFFER_BINDING 0x8CA7
+#define BA_GL_COLOR_ATTACHMENT0 0x8CE0
+#define BA_GL_COLOR_BUFFER_BIT 0x4000
+#define BA_GL_NEAREST 0x2600
+#define BA_GL_LINEAR 0x2601
+#define BA_GL_SCISSOR_TEST 0x0C11
+#define BA_GL_SYNC_GPU_COMMANDS_COMPLETE 0x9117
+#define BA_GL_SYNC_FLUSH_COMMANDS_BIT 0x0001
 
