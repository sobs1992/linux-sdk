+/*
+ * SDL_BAREAPP_GL_ASYNC=1: at each swap the GPU copies the picture into one
+ * of two renderbuffers, with a fence, and the copy made at the swap before
+ * (finished by then) is read back and shown. The game's work on the next
+ * frame overlaps the GPU's on this one instead of waiting for it in
+ * glReadPixels; the picture is a frame late. Mesa's panfrost reads pixel
+ * buffer objects back on the CPU too, so they would not help. Needs
+ * framebuffer blits and fences (OpenGL 3, OpenGL ES 3) and a window
+ * without multisampling (a blit that scales cannot resolve it). Looked at
+ * for each context that swaps, with the window's framebuffer bound.
+ */
+static SDL_bool AsyncOn(_THIS)
+{
+    const char *env = SDL_getenv("SDL_BAREAPP_GL_ASYNC");
+    int samples = 0;
+    SDL_bool on;
+
+    if (!env || SDL_atoi(env) <= 0) {
+        return SDL_FALSE;
+    }
+    vd.GetIntegerv(BA_GL_SAMPLE_BUFFERS, &samples);
+#define BA_PROC(name, gl) (vd.name = SDL_EGL_GetProcAddress(_this, gl)) != NULL
+    /* eglGetProcAddress gives something for any name: the version tells */
+    on = vd.gl_major >= 3 && samples == 0 &&
+         BA_PROC(GenFramebuffers, "glGenFramebuffers") &&
+         BA_PROC(DeleteFramebuffers, "glDeleteFramebuffers") &&
+         BA_PROC(GenRenderbuffers, "glGenRenderbuffers") &&
+         BA_PROC(DeleteRenderbuffers, "glDeleteRenderbuffers") &&
+         BA_PROC(BindRenderbuffer, "glBindRenderbuffer") &&
+         BA_PROC(RenderbufferStorage, "glRenderbufferStorage") &&
+         BA_PROC(FramebufferRenderbuffer, "glFramebufferRenderbuffer") &&
+         BA_PROC(BlitFramebuffer, "glBlitFramebuffer") &&
+         BA_PROC(IsEnabled, "glIsEnabled") &&
+         BA_PROC(Enable, "glEnable") &&
+         BA_PROC(Disable, "glDisable") &&
+         BA_PROC(FenceSync, "glFenceSync") &&
+         BA_PROC(ClientWaitSync, "glClientWaitSync") &&
+         BA_PROC(DeleteSync, "glDeleteSync") &&
+         BA_PROC(Flush, "glFlush");
+#undef BA_PROC
+    /* GL_BGRA is bare_app's own layout; OpenGL ES may not read it */
+    vd.bgra = !vd.gl_es;
+    if (!on) {
+        SDL_Log("bareapp: SDL_BAREAPP_GL_ASYNC needs OpenGL (ES) 3 without multisampling; pictures read at each swap");
+    }
+    return on;
+}
+
+/*
+ * Reading the window back whatever the game has bound to draw, to read and
+ * to pack pixels into, and however it packs them: saved, then set for
+ * pixels read tightly into memory, and put back after. Separate read
+ * framebuffers, pixel pack buffers, row lengths and skips are OpenGL ES 3's
+ * (desktop OpenGL has the last ones in any version): asked only where they
+ * are, not to leave an error behind.
+ */
+#define BA_PACK_PARAMS 4
+static const unsigned pack_names[BA_PACK_PARAMS] = {
+    BA_GL_PACK_ALIGNMENT, BA_GL_PACK_ROW_LENGTH, BA_GL_PACK_SKIP_ROWS, BA_GL_PACK_SKIP_PIXELS
+};
+static const int pack_wanted[BA_PACK_PARAMS] = { 4, 0, 0, 0 };
+
+typedef struct
+{
+    int draw, read, pack;
+    int params[BA_PACK_PARAMS];
+} BA_ReadState;
+
+static void SaveReadState(BA_ReadState *s)
+{
+    const int params = (vd.gl_major >= 3 || !vd.gl_es) ? BA_PACK_PARAMS : 1;
+    int k;
+
+    s->draw = 0;
+    s->read = -1;
+    s->pack = 0;
+    vd.GetIntegerv(BA_GL_FRAMEBUFFER_BINDING, &s->draw);
+    if (vd.gl_major >= 3) {
+        vd.GetIntegerv(BA_GL_READ_FRAMEBUFFER_BINDING, &s->read);
+        vd.GetIntegerv(BA_GL_PIXEL_PACK_BUFFER_BINDING, &s->pack);
+    }
+    if (s->read < 0) {
+        s->read = s->draw;
+    }
+    if (s->pack && vd.BindBuffer) {
+        vd.BindBuffer(BA_GL_PIXEL_PACK_BUFFER, 0);
+    }
+    for (k = 0; k < BA_PACK_PARAMS; k++) {
+        s->params[k] = pack_wanted[k];
+        if (k < params) {
+            vd.GetIntegerv(pack_names[k], &s->params[k]);
+            if (s->params[k] != pack_wanted[k]) {
+                vd.PixelStorei(pack_names[k], pack_wanted[k]);
+            }
+        }
+    }
+}
+
+static void RestoreReadState(const BA_ReadState *s)
+{
+    int k;
+
+    for (k = 0; k < BA_PACK_PARAMS; k++) {
+        if (s->params[k] != pack_wanted[k]) {
+            vd.PixelStorei(pack_names[k], s->params[k]);
+        }
+    }
+    if (s->pack && vd.BindBuffer) {
+        vd.BindBuffer(BA_GL_PIXEL_PACK_BUFFER, (unsigned)s->pack);
+    }
+    if (s->read != s->draw) {
+        vd.BindFramebuffer(BA_GL_READ_FRAMEBUFFER, (unsigned)s->read);
+        vd.BindFramebuffer(BA_GL_DRAW_FRAMEBUFFER, (unsigned)s->draw);
+    } else {
+        vd.BindFramebuffer(BA_GL_FRAMEBUFFER, (unsigned)s->draw);
+    }
+}
+
+/* current: the copies' context is current, their objects are deleted; else
+ * they go with that context */
+static void ForgetCopies(SDL_bool current)
+{
+    int k;
+
+    for (k = 0; k < 2; k++) {
+        if (vd.fence[k] && current) {
+            vd.DeleteSync(vd.fence[k]);
+        }
+        vd.fence[k] = NULL;
+    }
+    if (vd.fbo[0] && current) {
+        vd.DeleteFramebuffers(2, vd.fbo);
+        vd.DeleteRenderbuffers(2, vd.rb);
+    }
+    vd.fbo[0] = vd.fbo[1] = vd.rb[0] = vd.rb[1] = 0;
+    vd.copy_w = vd.copy_h = 0;
+    vd.copy_context = NULL;
+}
+
+/* Copy k, finished by the GPU (or waited for), read and shown */
+static void ShowCopy(int k)
+{
+    int cw = vd.copy_w, ch = vd.copy_h;
+
+    vd.ClientWaitSync(vd.fence[k], BA_GL_SYNC_FLUSH_COMMANDS_BIT, 2000000000ull);
+    vd.DeleteSync(vd.fence[k]);
+    vd.fence[k] = NULL;
+    vd.BindFramebuffer(BA_GL_READ_FRAMEBUFFER, vd.fbo[k]);
+    vd.ReadPixels(0, 0, cw, ch, vd.bgra ? BA_GL_BGRA : BA_GL_RGBA, BA_GL_UNSIGNED_BYTE, vd.pixels);
+    /* GL's rows go up */
+    BAREAPP_Present(vd.pixels + (size_t)(ch - 1) * cw * 4, cw, ch, -cw * 4,
+                    vd.bgra ? BAREAPP_XRGB : BAREAPP_RGBA);
+}
+
+/* The window's framebuffer is bound for drawing and reading. The copies
+ * have the size the picture gets in bare_app's frame: the GPU scales it. */
+static void SwapAsync(int w, int h)
+{
+    int k, rb = 0, cw, ch;
+    SDL_bool scissor, nearest, slow;
+    SDL_GLContext context = SDL_GL_GetCurrentContext();
+    Uint64 now = SDL_GetTicks64();
+    size_t size;
+
+    /* frames far apart (a game loading): this one is shown now, as the
+     * next swap that would show it may be long in coming */
+    slow = vd.last_swap != 0 && now - vd.last_swap > 100;
+    vd.last_swap = now;
+
+    BAREAPP_FitSize(w, h, &cw, &ch, &nearest);
+    size = (size_t)cw * ch * 4;
+    if (vd.pixels_size < size) {
+        Uint8 *pixels = SDL_realloc(vd.pixels, size);
+
+        if (!pixels) {
+            return;
+        }
+        vd.pixels = pixels;
+        vd.pixels_size = size;
+    }
+    if (vd.copy_context != context) {
+        ForgetCopies(SDL_FALSE); /* another context's (or none) */
+    }
+    if (vd.copy_w != cw || vd.copy_h != ch) {
+        ForgetCopies(SDL_TRUE);
+        vd.GetIntegerv(BA_GL_RENDERBUFFER_BINDING, &rb);
+        vd.GenFramebuffers(2, vd.fbo);
+        vd.GenRenderbuffers(2, vd.rb);
+        for (k = 0; k < 2; k++) {
+            vd.BindRenderbuffer(BA_GL_RENDERBUFFER, vd.rb[k]);
+            vd.RenderbufferStorage(BA_GL_RENDERBUFFER, BA_GL_RGBA8, cw, ch);
+            vd.BindFramebuffer(BA_GL_DRAW_FRAMEBUFFER, vd.fbo[k]);
+            vd.FramebufferRenderbuffer(BA_GL_DRAW_FRAMEBUFFER, BA_GL_COLOR_ATTACHMENT0, BA_GL_RENDERBUFFER, vd.rb[k]);
+        }
+        vd.BindRenderbuffer(BA_GL_RENDERBUFFER, (unsigned)rb);
+        vd.copy_w = cw;
+        vd.copy_h = ch;
+        vd.copy_context = context;
+        vd.next = 0;
+    }
+    scissor = vd.IsEnabled(BA_GL_SCISSOR_TEST);
+    if (scissor) {
+        vd.Disable(BA_GL_SCISSOR_TEST); /* blits are cut by it */
+    }
+
+    /* this frame: copied by the GPU after it has drawn it */
+    k = vd.next;
+    if (vd.fence[k]) {
+        vd.DeleteSync(vd.fence[k]);
+    }
+    vd.BindFramebuffer(BA_GL_DRAW_FRAMEBUFFER, vd.fbo[k]);
+    vd.BlitFramebuffer(0, 0, w, h, 0, 0, cw, ch, BA_GL_COLOR_BUFFER_BIT, nearest ? BA_GL_NEAREST : BA_GL_LINEAR);
+    vd.fence[k] = vd.FenceSync(BA_GL_SYNC_GPU_COMMANDS_COMPLETE, 0);
+    vd.Flush();
+
+    vd.next = 1 - k;
+    if (slow) {
+        /* this one now; the one before is older, never shown */
+        if (vd.fence[vd.next]) {
+            vd.DeleteSync(vd.fence[vd.next]);
+            vd.fence[vd.next] = NULL;
+        }
+        ShowCopy(k);
+    } else if (vd.fence[vd.next]) {
+        ShowCopy(vd.next); /* the one before: done by now, no waiting */
+    }
+    vd.BindFramebuffer(BA_GL_FRAMEBUFFER, 0);
+    if (scissor) {
+        vd.Enable(BA_GL_SCISSOR_TEST);
+    }
+}
+
+/*
+ * A picture is shown at the swap after its own. When that one is late in
+ * coming (a game loading between two pictures, or one drawn once that
+ * waits for a key), the picture is shown from the game's event loop
+ * instead, as soon as the GPU has made its copy: with the copies' context
+ * current on this thread, and with no waiting.
+ */
+#define BA_LATE_MS 50
+
+static void ShowLateCopy(_THIS)
+{
+    const int k = 1 - vd.next;
+    unsigned status;
+    BA_ReadState state;
+
+    if (!vd.async || !vd.fence[k] || !vd.copy_context || vd.copy_context != vd.gl_context ||
+        SDL_GL_GetCurrentContext() != vd.copy_context ||
+        SDL_GetTicks64() - vd.last_swap < BA_LATE_MS) {
+        return;
+    }
+    status = vd.ClientWaitSync(vd.fence[k], BA_GL_SYNC_FLUSH_COMMANDS_BIT, 0);
+    if (status != BA_GL_ALREADY_SIGNALED && status != BA_GL_CONDITION_SATISFIED) {
+        return; /* not done yet (or the wait failed): later */
+    }
+    SaveReadState(&state);
+    ShowCopy(k);
+    RestoreReadState(&state);
+}
+
+/* "OpenGL ES 3.1 Mesa ..." (es) or "3.1 Mesa ...": 3 */
+static int GLVersion(_THIS, SDL_bool *es)
+{
+    const char *(*GetString)(unsigned name) = SDL_EGL_GetProcAddress(_this, "glGetString");
+    const char *version = GetString ? GetString(0x1F02 /* GL_VERSION */) : NULL;
+
+    *es = SDL_FALSE;
+    if (!version) {
+        return 0;
+    }
+    *es = SDL_strncmp(version, "OpenGL ES", 9) == 0;
+    while (*version && (*version < '0' || *version > '9')) {
+        version++;
+    }
+    return SDL_atoi(version);
+}
