@@ -55,6 +55,21 @@
 #define BA_GL_PACK_ALIGNMENT 0x0D05
 #define BA_GL_RGBA 0x1908
 #define BA_GL_UNSIGNED_BYTE 0x1401
+/* and for SDL_BAREAPP_GL_ASYNC */
+#define BA_GL_BGRA 0x80E1
+#define BA_GL_RGBA8 0x8058
+#define BA_GL_READ_FRAMEBUFFER 0x8CA8
+#define BA_GL_DRAW_FRAMEBUFFER 0x8CA9
+#define BA_GL_READ_FRAMEBUFFER_BINDING 0x8CAA
