     if (window->w != data->egl_w || window->h != data->egl_h) {
@@ -426,6 +597,9 @@
 
 static void BAREAPP_GL_DeleteContext(_THIS, SDL_GLContext context)
 {
+    if (vd.async > 0) {
+        ForgetCopies(); /* the copies go with the context */
+    }
     SDL_EGL_DeleteContext(_this, context);
 }
