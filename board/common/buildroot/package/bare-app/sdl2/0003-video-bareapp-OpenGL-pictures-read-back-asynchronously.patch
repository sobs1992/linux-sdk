+void BAREAPP_FitSize(int w, int h, int *fit_w, int *fit_h, SDL_bool *nearest)
+{
+    SDL_Rect r;
+
+    if (!ba.open || ba.gone || w <= 0 || h <= 0) {
+        *fit_w = w;
+        *fit_h = h;
+        *nearest = SDL_TRUE;
+        return;
+    }
+    Place(w, h, (int)ba.app.shm->width, (int)ba.app.shm->height, &r);
+    *fit_w = r.w;
+    *fit_h = r.h;
+    *nearest = ba.nearest || (r.w % w == 0 && r.h % h == 0);
+}
