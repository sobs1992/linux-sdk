-    BAREAPP_Present(vd.pixels + (size_t)(h - 1) * w * 4, w, h, -w * 4, BAREAPP_RGBA);
+    if (vd.async <= 0) {
+        /* GL's rows go up */
+        BAREAPP_Present(vd.pixels + (size_t)(h - 1) * w * 4, w, h, -w * 4, BAREAPP_RGBA);
+    }
 
     /* the window got another size (full screen): a pbuffer of it */
     if (window->w != data->egl_w || window->h != data->egl_h) {
@@ -426,6 +674,10 @@
 
 static void BAREAPP_GL_DeleteContext(_THIS, SDL_GLContext context)
 {
+    /* SDL has made it no longer current: its copies go with it */
+    if (context == vd.copy_context) {
+        ForgetCopies(SDL_FALSE);
+    }
     SDL_EGL_DeleteContext(_this, context);
 }
