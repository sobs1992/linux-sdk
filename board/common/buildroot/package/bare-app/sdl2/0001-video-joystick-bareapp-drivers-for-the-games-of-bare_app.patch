+/*
+ * The link to bare_app, the launcher of the OdroidLinux SDK, when it
+ * started this program as one of its games: a socket and shared memory
+ * inherited as descriptors 3 and 4 (game_ipc.h and its game side
+ * game_ipc_client.h, copied from bare_app at build time, with its gamepad
+ * names in input.h). Frames go
+ * to bare_app's video layer, its gamepad comes back as messages. Shared by
+ * the video driver (frames, keyboard) and the joystick driver.
+ */
+#ifndef SDL_bareapp_h_
+#define SDL_bareapp_h_
+
+#include "../../SDL_internal.h"
+
+#include "SDL_error.h"
+#include "SDL_rect.h"
+
+#include "game_ipc_client.h"
+#include "input.h"
+
+/* Whether bare_app started us and we may take its link: the descriptors are
+ * there and SDL_VIDEODRIVER does not name another driver (a game that talks
+ * to bare_app itself, like VCMI with "dummy", keeps the socket). */
+extern SDL_bool BAREAPP_Available(void);
+
+/* Maps the frames and reads the socket from now on; 0 or -1 */
+extern int BAREAPP_Open(void);
+
+/* Frame size: bare_app's video layer */
+extern int BAREAPP_FrameWidth(void);
+extern int BAREAPP_FrameHeight(void);
+
+/* Reads what bare_app sent; SDL_FALSE once bare_app is gone */
+extern SDL_bool BAREAPP_Poll(void);
+
+/* Messages received after *tail, one per call; NULL when there are no
+ * more. Each reader keeps its own tail (starting at 0). */
+extern const struct game_msg *BAREAPP_Next(Uint32 *tail);
+
+/* Source pixel layouts for BAREAPP_Present */
+typedef enum
+{
+    BAREAPP_XRGB,   /* 32-bit 0x00RRGGBB, as bare_app's frames */
+    BAREAPP_RGBA    /* bytes R, G, B, A (glReadPixels) */
+} BAREAPP_Format;
+
+/*
+ * Puts a picture into the next frame, fitted to the frame as
+ * SDL_BAREAPP_SCALE says (fit: whole, aspect kept, black borders; stretch:
+ * whole frame; integer: whole multiples), filtered as SDL_BAREAPP_FILTER
+ * says (linear, nearest; whole multiples always nearest), and publishes
+ * it. pitch may be negative (rows going up). Waits as needed for at most
+ * SDL_BAREAPP_FPS frames a second (default 60, 0: no limit).
+ */
+extern void BAREAPP_Present(const void *pixels, int w, int h, int pitch, BAREAPP_Format format);
+
+/* bare_app's gamepad names (up, a, l2, f1...): enum gp_button, -1 if none */
+extern int BAREAPP_ButtonFromString(const char *name);
+
+/* Calls cb(button, value) for every "button=value" of a comma separated
+ * list such as "a=space, b=escape"; warns about unknown buttons */
+extern void BAREAPP_ParseMap(const char *list, void (*cb)(int button, const char *value, void *ud), void *ud);
+
+#endif /* SDL_bareapp_h_ */
diff --git a/src/video/bareapp/SDL_bareapplink.c b/src/video/bareapp/SDL_bareapplink.c
new file mode 100644
index 0000000..3922c03
--- /dev/null
+++ b/src/video/bareapp/SDL_bareapplink.c
@@ -0,0 +1,436 @@
+/*
+  Simple DirectMedia Layer
+  Copyright (C) 1997-2025 Sam Lantinga <slouken@libsdl.org>
+
+  This software is provided 'as-is', without any express or implied
+  warranty.  In no event will the authors be held liable for any damages
+  arising from the use of this software.
+
+  Permission is granted to anyone to use this software for any purpose,
+  including commercial applications, and to alter it and redistribute it
+  freely, subject to the following restrictions:
+
+  1. The origin of this software must not be misrepresented; you must not
+     claim that you wrote the original software. If you use this software
+     in a product, an acknowledgment in the product documentation would be
+     appreciated but is not required.
+  2. Altered source versions must be plainly marked as such, and must not be
+     misrepresented as being the original software.
+  3. This notice may not be removed or altered from any source distribution.
+*/
+#include "../../SDL_internal.h"
+
+#ifdef SDL_VIDEO_DRIVER_BAREAPP
+
+#include <errno.h>
+#include <string.h>
+#include <time.h>
+
+#include "SDL_hints.h"
+#include "SDL_log.h"
+#include "SDL_bareapp.h"
+
+/* Messages kept for the readers (video: keys, joystick): a reader that
+ * falls further behind loses the oldest */
+#define RING 256
+
+typedef enum
+{
+    SCALE_FIT,
+    SCALE_STRETCH,
+    SCALE_INTEGER
+} ScaleMode;
+
+static struct
+{
+    int checked;            /* the descriptors were looked at */
+    SDL_bool there;         /* ...and are bare_app's */
+    struct game_link app;   /* opened by BAREAPP_Open() */
+    SDL_bool open;
+    SDL_bool gone;
+    struct game_msg ring[RING];
+    Uint32 head;
+    ScaleMode scale;
+    SDL_bool nearest;
+    Uint64 period_ns, last_ns;
+    int *xmap;              /* per column of the frame: source column, weight */
+    int xmap_size;
+} ba;
+
+static const char *const button_names[GP_COUNT] = {
+    "up", "down", "left", "right",
+    "a", "b", "x", "y",
+    "l1", "r1", "l2", "r2",
+    "select", "start", "menu",
+    "f1", "f2", "f3", "f4", "f5", "f6",
+    "volup", "voldown",
+    "power",
+};
+
+SDL_bool BAREAPP_Available(void)
+{
+    const char *driver = SDL_GetHint(SDL_HINT_VIDEODRIVER);
+
+    if (driver && *driver && !SDL_strstr(driver, "bareapp")) {
+        return SDL_FALSE;
+    }
+    if (!ba.checked) {
+        ba.there = game_link_there() ? SDL_TRUE : SDL_FALSE;
+        ba.checked = 1;
+    }
+    return ba.there;
+}
+
+static int EnvInt(const char *name, int def)
+{
+    const char *value = SDL_getenv(name);
+
+    return value && *value ? SDL_atoi(value) : def;
+}
+
+int BAREAPP_Open(void)
+{
+    const char *scale = SDL_getenv("SDL_BAREAPP_SCALE");
+    const char *filter = SDL_getenv("SDL_BAREAPP_FILTER");
+    int fps;
+
+    if (ba.open) {
+        return 0;
+    }
+    if (!BAREAPP_Available()) {
+        return SDL_SetError("bareapp: not started by bare_app");
+    }
+    /* programs this game starts do not keep bare_app's link open */
+    if (game_link_open(&ba.app, false) < 0) {
+        return SDL_SetError("bareapp: shared memory: %s", strerror(errno));
+    }
+    ba.open = SDL_TRUE;
+
+    ba.scale = SCALE_FIT;
+    if (scale && SDL_strcasecmp(scale, "stretch") == 0) {
+        ba.scale = SCALE_STRETCH;
+    } else if (scale && SDL_strcasecmp(scale, "integer") == 0) {
+        ba.scale = SCALE_INTEGER;
+    }
+    ba.nearest = filter && SDL_strcasecmp(filter, "nearest") == 0;
+    fps = EnvInt("SDL_BAREAPP_FPS", 60);
+    ba.period_ns = fps > 0 ? 1000000000ull / (Uint64)fps : 0;
+    SDL_LogInfo(SDL_LOG_CATEGORY_VIDEO, "bareapp: frames %ux%u, %s, %s, %d fps at most",
+                ba.app.shm->width, ba.app.shm->height,
+                ba.scale == SCALE_STRETCH ? "stretched" : ba.scale == SCALE_INTEGER ? "whole multiples" : "fitted",
+                ba.nearest ? "nearest" : "linear", fps);
+    return 0;
+}
+
+int BAREAPP_FrameWidth(void)
+{
+    return ba.open ? (int)ba.app.shm->width : 0;
+}
+
+int BAREAPP_FrameHeight(void)
+{
+    return ba.open ? (int)ba.app.shm->height : 0;
+}
+
+SDL_bool BAREAPP_Poll(void)
+{
+    struct game_msg msg;
+    int n;
+
+    if (!ba.open || ba.gone) {
+        return SDL_FALSE;
+    }
+    while ((n = game_link_recv(&msg)) > 0) {
+        ba.ring[ba.head++ % RING] = msg;
+    }
+    if (n < 0) {
+        ba.gone = SDL_TRUE;
+        SDL_LogInfo(SDL_LOG_CATEGORY_VIDEO, "bareapp: bare_app is gone");
+    }
+    return !ba.gone;
+}
+
+const struct game_msg *BAREAPP_Next(Uint32 *tail)
+{
+    if (ba.head - *tail > RING) {
+        *tail = ba.head - RING;
+    }
+    if (*tail == ba.head) {
+        return NULL;
+    }
+    return &ba.ring[(*tail)++ % RING];
+}
+
+/* ---- frames ------------------------------------------------------------- */
+
+static SDL_INLINE Uint32 Pixel(const Uint32 *row, int x, BAREAPP_Format format)
+{
+    Uint32 p = row[x];
+
+    if (format == BAREAPP_RGBA) {
+#if SDL_BYTEORDER == SDL_LIL_ENDIAN
+        return ((p & 0xff) << 16) | (p & 0xff00) | ((p >> 16) & 0xff);
+#else
+        return p >> 8;
+#endif
+    }
+    return p;
+}
+
+/* a + (b - a) * f / 256 for each channel; f 0..256 */
+static SDL_INLINE Uint32 Lerp(Uint32 a, Uint32 b, Uint32 f)
+{
+    Uint32 rb = (((a & 0xff00ff) * (256 - f) + (b & 0xff00ff) * f) >> 8) & 0xff00ff;
+    Uint32 g = (((a & 0x00ff00) * (256 - f) + (b & 0x00ff00) * f) >> 8) & 0x00ff00;
+
+    return rb | g;
+}
+
+static void Fill(Uint8 *frame, int stride, int x, int y, int w, int h)
+{
+    int i;
+
+    for (i = 0; i < h; i++) {
+        SDL_memset(frame + (size_t)(y + i) * stride + (size_t)x * 4, 0, (size_t)w * 4);
+    }
+}
+
+/* Where the picture goes in the frame */
+static void Place(int w, int h, int fw, int fh, SDL_Rect *r)
+{
+    if (ba.scale == SCALE_STRETCH) {
+        r->w = fw;
+        r->h = fh;
+    } else if (ba.scale == SCALE_INTEGER && w <= fw && h <= fh) {
+        int k = SDL_min(fw / w, fh / h);
+
+        r->w = w * k;
+        r->h = h * k;
+    } else if ((Sint64)fw * h <= (Sint64)fh * w) { /* as wide as the frame */
+        r->w = fw;
+        r->h = (int)SDL_max(1, ((Sint64)fw * h + w / 2) / w);
+    } else {
+        r->h = fh;
+        r->w = (int)SDL_max(1, ((Sint64)fh * w + h / 2) / h);
+    }
+    r->x = (fw - r->w) / 2;
+    r->y = (fh - r->h) / 2;
+}
+
+static int *ColumnMap(int n)
+{
+    if (ba.xmap_size < n) {
+        int *map = SDL_realloc(ba.xmap, (size_t)n * 2 * sizeof(int));
+
+        if (!map) {
+            return NULL;
+        }
+        ba.xmap = map;
+        ba.xmap_size = n;
+    }
+    return ba.xmap;
+}
+
+static void Draw(const Uint8 *pixels, int w, int h, int pitch, BAREAPP_Format format,
+                 Uint8 *frame, int stride, const SDL_Rect *r)
+{
+    int x, y;
+    int *map;
+
+    if (r->w == w && r->h == h) { /* 1:1 */
+        for (y = 0; y < h; y++) {
+            const Uint32 *in = (const Uint32 *)(pixels + (Sint64)y * pitch);
+            Uint32 *out = (Uint32 *)(frame + (size_t)(r->y + y) * stride) + r->x;
+
+            if (format == BAREAPP_XRGB) {
+                SDL_memcpy(out, in, (size_t)w * 4);
+            } else {
+                for (x = 0; x < w; x++) {
+                    out[x] = Pixel(in, x, format);
+                }
+            }
+        }
+        return;
+    }
+
+    map = ColumnMap(r->w);
+    if (!map) {
+        return;
+    }
+    if (ba.nearest || (r->w % w == 0 && r->h % h == 0)) {
+        for (x = 0; x < r->w; x++) {
+            map[x] = (int)((Sint64)x * w / r->w);
+        }
+        for (y = 0; y < r->h; y++) {
+            const Uint32 *in = (const Uint32 *)(pixels + (Sint64)((Sint64)y * h / r->h) * pitch);
+            Uint32 *out = (Uint32 *)(frame + (size_t)(r->y + y) * stride) + r->x;
+
+            for (x = 0; x < r->w; x++) {
+                out[x] = Pixel(in, map[x], format);
+            }
+        }
+        return;
+    }
+
+    /* linear: the centre of each frame pixel in the picture, 8 bits of fraction */
+    for (x = 0; x < r->w; x++) {
+        Sint64 sx = ((2 * (Sint64)x + 1) * w * 256) / (2 * (Sint64)r->w) - 128;
+        int x0;
+
+        if (sx < 0) {
+            sx = 0;
+        }
+        x0 = (int)(sx >> 8);
+        if (x0 >= w - 1) {
+            map[2 * x] = w - 1;
+            map[2 * x + 1] = 0;
+        } else {
+            map[2 * x] = x0;
+            map[2 * x + 1] = (int)(sx & 255);
+        }
+    }
+    for (y = 0; y < r->h; y++) {
+        Sint64 sy = ((2 * (Sint64)y + 1) * h * 256) / (2 * (Sint64)r->h) - 128;
+        int y0, y1, fy;
+        const Uint32 *in0, *in1;
+        Uint32 *out = (Uint32 *)(frame + (size_t)(r->y + y) * stride) + r->x;
+
+        if (sy < 0) {
+            sy = 0;
+        }
+        y0 = (int)(sy >> 8);
+        fy = (int)(sy & 255);
+        if (y0 >= h - 1) {
+            y0 = h - 1;
+            fy = 0;
+        }
+        y1 = fy ? y0 + 1 : y0;
+        in0 = (const Uint32 *)(pixels + (Sint64)y0 * pitch);
+        in1 = (const Uint32 *)(pixels + (Sint64)y1 * pitch);
+        for (x = 0; x < r->w; x++) {
+            int sx0 = map[2 * x], fx = map[2 * x + 1], sx1 = fx ? sx0 + 1 : sx0;
+            Uint32 top = Lerp(Pixel(in0, sx0, format), Pixel(in0, sx1, format), (Uint32)fx);
+            Uint32 bottom = Lerp(Pixel(in1, sx0, format), Pixel(in1, sx1, format), (Uint32)fx);
+
+            out[x] = Lerp(top, bottom, (Uint32)fy);
+        }
+    }
+}
+
+static Uint64 NowNs(void)
+{
+    struct timespec ts;
+
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return (Uint64)ts.tv_sec * 1000000000ull + (Uint64)ts.tv_nsec;
+}
+
+/* At most SDL_BAREAPP_FPS frames a second: the vsync a game may wait for */
+static void Pace(void)
+{
+    Uint64 now = NowNs(), due = ba.last_ns + ba.period_ns;
+
+    if (!ba.period_ns) {
+        return;
+    }
+    if (ba.last_ns && now < due) {
+        struct timespec ts = { (time_t)((due - now) / 1000000000ull), (long)((due - now) % 1000000000ull) };
+
+        while (nanosleep(&ts, &ts) < 0 && errno == EINTR) {
+        }
+        ba.last_ns = due;
+    } else {
+        ba.last_ns = now;
+    }
+}
+
+void BAREAPP_Present(const void *pixels, int w, int h, int pitch, BAREAPP_Format format)
+{
+    struct game_shm *shm = ba.app.shm;
+    int fw, fh, stride;
+    Uint8 *frame;
+    SDL_Rect r;
+
+    if (!ba.open || ba.gone || w <= 0 || h <= 0) {
+        return;
+    }
+    fw = (int)shm->width;
+    fh = (int)shm->height;
+    stride = (int)shm->stride;
+    frame = game_link_frame(&ba.app);
+    Place(w, h, fw, fh, &r);
+    Fill(frame, stride, 0, 0, fw, r.y);
+    Fill(frame, stride, 0, r.y + r.h, fw, fh - r.y - r.h);
+    Fill(frame, stride, 0, r.y, r.x, r.h);
+    Fill(frame, stride, r.x + r.w, r.y, fw - r.x - r.w, r.h);
+    Draw(pixels, w, h, pitch, format, frame, stride, &r);
+
+    Pace();
+    if (game_link_publish(&ba.app) < 0) {
+        ba.gone = SDL_TRUE;
+    }
+}
+
+/* ---- settings ----------------------------------------------------------- */
+
+int BAREAPP_ButtonFromString(const char *name)
+{
+    int i;
+
+    for (i = 0; i < GP_COUNT; i++) {
+        if (SDL_strcasecmp(name, button_names[i]) == 0) {
+            return i;
+        }
+    }
+    return -1;
+}
+
+static char *Trim(char *s)
+{
+    char *end;
+
+    while (*s == ' ' || *s == '\t') {
+        s++;
+    }
+    end = s + SDL_strlen(s);
+    while (end > s && (end[-1] == ' ' || end[-1] == '\t')) {
+        *--end = '\0';
+    }
+    return s;
+}
+
+void BAREAPP_ParseMap(const char *list, void (*cb)(int button, const char *value, void *ud), void *ud)
+{
+    char *copy, *item, *next, *eq;
+    int button;
+
+    if (!list || !*list) {
+        return;
+    }
+    copy = SDL_strdup(list);
+    if (!copy) {
+        return;
+    }
+    for (item = copy; item; item = next) {
+        next = SDL_strchr(item, ',');
+        if (next) {
+            *next++ = '\0';
+        }
+        eq = SDL_strchr(item, '=');
+        if (!eq) {
+            continue;
+        }
+        *eq = '\0';
+        button = BAREAPP_ButtonFromString(Trim(item));
+        if (button < 0) {
+            SDL_LogWarn(SDL_LOG_CATEGORY_INPUT, "bareapp: no button \"%s\"", Trim(item));
+            continue;
+        }
+        cb(button, Trim(eq + 1), ud);
+    }
+    SDL_free(copy);
+}
+
+#endif /* SDL_VIDEO_DRIVER_BAREAPP */
+
+/* vi: set ts=4 sw=4 expandtab: */
