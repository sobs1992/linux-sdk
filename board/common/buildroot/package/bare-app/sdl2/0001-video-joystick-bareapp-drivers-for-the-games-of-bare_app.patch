+#include "../../SDL_internal.h"
+
+#ifdef SDL_VIDEO_DRIVER_BAREAPP
+
+/*
+ * The "bareapp" video driver: a game of bare_app (the OdroidLinux SDK's
+ * launcher) shows its window in bare_app's video layer. It is picked by
+ * itself when bare_app started the program (SDL_bareapp.h). The window
+ * has the size the game asks for and is fitted to the frame when shown;
+ * the desktop mode is the frame's size. Software windows (window surfaces,
+ * the software renderer) are copied, OpenGL (ES) is drawn off screen by
+ * the GPU into a pbuffer of the window's size (EGL, Mesa's surfaceless
+ * platform) and read back at each swap. bare_app's buttons are a game
+ * controller (joystick driver "bareapp") and, as SDL_BAREAPP_KEYS says,
+ * keys: "a=space, b=escape, up=up, start=return".
+ */
+
+#include "../SDL_sysvideo.h"
+#include "../SDL_egl_c.h"
+#include "../../events/SDL_events_c.h"
+#include "../../events/SDL_keyboard_c.h"
+
+#include "SDL_bareapp.h"
+
+#define BAREAPP_SURFACE "_SDL_BareAppSurface"
+
+#ifndef EGL_PLATFORM_SURFACELESS_MESA
+#define EGL_PLATFORM_SURFACELESS_MESA 0x31DD
+#endif
+
+/* glReadPixels and what is saved around it */
+#define BA_GL_FRAMEBUFFER 0x8D40
+#define BA_GL_FRAMEBUFFER_BINDING 0x8CA6
+#define BA_GL_PACK_ALIGNMENT 0x0D05
+#define BA_GL_RGBA 0x1908
+#define BA_GL_UNSIGNED_BYTE 0x1401
+
+typedef struct
+{
+#ifdef SDL_VIDEO_OPENGL_EGL
+    EGLSurface egl_surface;
+    int egl_w, egl_h; /* its size: the window's when it was made */
+#endif
+} BAREAPP_WindowData;
+
+static struct
+{
+    SDL_Scancode keys[GP_COUNT];       /* SDL_BAREAPP_KEYS; 0: none */
+    Uint8 down[GP_COUNT];              /* bit 0: D-pad or button, bit 1: stick */
+    Uint8 key_count[SDL_NUM_SCANCODES]; /* buttons holding the key */
+    Uint32 tail;
+    SDL_bool quit_sent;
+#ifdef SDL_VIDEO_OPENGL_EGL
+    Uint8 *pixels;
+    size_t pixels_size;
+    void (*ReadPixels)(int x, int y, int w, int h, unsigned format, unsigned type, void *pixels);
+    void (*GetIntegerv)(unsigned name, int *value);
+    void (*BindFramebuffer)(unsigned target, unsigned framebuffer);
+    void (*PixelStorei)(unsigned name, int value);
+#endif
+} vd;
+
+/* ---- keys --------------------------------------------------------------- */
+
+static void KeyMapped(int button, const char *value, void *ud)
+{
+    SDL_Scancode code = SDL_GetScancodeFromName(value);
+
+    (void)ud;
+    if (code == SDL_SCANCODE_UNKNOWN && SDL_strcasecmp(value, "none") != 0) {
+        SDL_LogWarn(SDL_LOG_CATEGORY_INPUT, "bareapp: no key \"%s\"", value);
+    }
+    vd.keys[button] = code;
+}
+
+static void Button(const struct game_msg *m)
+{
+    Uint8 bit = (m->flags & GAME_BTN_STICK) ? 2 : 1;
+    SDL_bool was, is;
+    SDL_Scancode key;
+
+    if (m->code >= GP_COUNT) {
+        return;
+    }
+    was = vd.down[m->code] != 0;
+    vd.down[m->code] = m->pressed ? (vd.down[m->code] | bit) : (vd.down[m->code] & ~bit);
+    is = vd.down[m->code] != 0;
+    key = vd.keys[m->code];
+    if (was == is || !key) {
+        return;
+    }
+    /* several buttons may make the same key */
+    if (is && vd.key_count[key]++ == 0) {
+        SDL_SendKeyboardKey(SDL_PRESSED, key);
+    } else if (!is && vd.key_count[key] && --vd.key_count[key] == 0) {
+        SDL_SendKeyboardKey(SDL_RELEASED, key);
+    }
+}
+
+static void BAREAPP_PumpEvents(_THIS)
+{
+    const struct game_msg *m;
+
+    if (!BAREAPP_Poll() && !vd.quit_sent) {
+        vd.quit_sent = SDL_TRUE;
+        SDL_SendQuit();
+    }
+    while ((m = BAREAPP_Next(&vd.tail)) != NULL) {
+        if (m->type == GAME_MSG_BUTTON) {
+            Button(m);
+        }
+    }
+}
+
+/* ---- displays ----------------------------------------------------------- */
+
+static int BAREAPP_VideoInit(_THIS)
+{
+    SDL_DisplayMode mode;
+
+    if (BAREAPP_Open() < 0) {
+        return -1;
+    }
+    SDL_zero(mode);
+    mode.format = SDL_PIXELFORMAT_RGB888;
+    mode.w = BAREAPP_FrameWidth();
+    mode.h = BAREAPP_FrameHeight();
+    mode.refresh_rate = 60;
+    if (SDL_AddBasicVideoDisplay(&mode) < 0) {
+        return -1;
+    }
+    SDL_zero(vd.keys);
+    BAREAPP_ParseMap(SDL_getenv("SDL_BAREAPP_KEYS"), KeyMapped, NULL);
+    return 0;
+}
+
+/* The frame's size and what old games ask for full screen: any of them is
+ * fitted to the frame */
+static void BAREAPP_GetDisplayModes(_THIS, SDL_VideoDisplay *display)
+{
+    static const int sizes[][2] = { { 320, 200 }, { 320, 240 }, { 640, 400 }, { 640, 480 }, { 800, 600 } };
+    SDL_DisplayMode mode = display->desktop_mode;
+    size_t i;
+
+    SDL_AddDisplayMode(display, &mode);
+    for (i = 0; i < SDL_arraysize(sizes); i++) {
+        mode.w = sizes[i][0];
+        mode.h = sizes[i][1];
+        mode.driverdata = NULL;
+        SDL_AddDisplayMode(display, &mode);
+    }
+}
+
+static int BAREAPP_SetDisplayMode(_THIS, SDL_VideoDisplay *display, SDL_DisplayMode *mode)
+{
+    return 0;
+}
+
+static void BAREAPP_VideoQuit(_THIS)
+{
+}
+
+/* ---- windows ------------------------------------------------------------ */
+
+#ifdef SDL_VIDEO_OPENGL_EGL
+/* The pbuffer of the window's size; the old one goes once the new one is
+ * made current in its place */
+static int MakeSurface(_THIS, SDL_Window *window)
+{
+    BAREAPP_WindowData *data = window->driverdata;
+    EGLSurface old = data->egl_surface;
+    EGLSurface surface = SDL_EGL_CreateOffscreenSurface(_this, window->w, window->h);
+
+    if (surface == EGL_NO_SURFACE) {
+        return SDL_SetError("bareapp: no %dx%d pbuffer", window->w, window->h);
+    }
+    data->egl_surface = surface;
+    data->egl_w = window->w;
+    data->egl_h = window->h;
+    SDL_LogDebug(SDL_LOG_CATEGORY_VIDEO, "bareapp: pbuffer %dx%d", window->w, window->h);
+    if (old != EGL_NO_SURFACE) {
+        if (SDL_GL_GetCurrentWindow() == window) {
+            SDL_EGL_MakeCurrent(_this, surface, SDL_GL_GetCurrentContext());
+        }
+        SDL_EGL_DestroySurface(_this, old);
+    }
+    return 0;
+}
+#endif
+
+static int BAREAPP_CreateWindow(_THIS, SDL_Window *window)
+{
+    BAREAPP_WindowData *data = SDL_calloc(1, sizeof(*data));
+
+    if (!data) {
+        return SDL_OutOfMemory();
+    }
+    window->driverdata = data;
+    if (window->x == SDL_WINDOWPOS_UNDEFINED) {
+        window->x = 0;
+    }
+    if (window->y == SDL_WINDOWPOS_UNDEFINED) {
+        window->y = 0;
+    }
+#ifdef SDL_VIDEO_OPENGL_EGL
+    data->egl_surface = EGL_NO_SURFACE;
+    if (window->flags & SDL_WINDOW_OPENGL) {
+        if (!_this->egl_data) {
+            return SDL_SetError("bareapp: OpenGL is not loaded");
+        }
+        if (MakeSurface(_this, window) < 0) {
+            return -1;
+        }
+    }
+#endif
+    /* the only window there is: it has the gamepad's keys */
+    SDL_SetKeyboardFocus(window);
+    return 0;
+}
+
+static void BAREAPP_DestroyWindow(_THIS, SDL_Window *window)
+{
+    BAREAPP_WindowData *data = window->driverdata;
+
+    if (data) {
+#ifdef SDL_VIDEO_OPENGL_EGL
+        if (data->egl_surface != EGL_NO_SURFACE) {
+            SDL_EGL_DestroySurface(_this, data->egl_surface);
+        }
+#endif
+        SDL_free(data);
+    }
+    window->driverdata = NULL;
+}
+
+static void BAREAPP_SetWindowFullscreen(_THIS, SDL_Window *window, SDL_VideoDisplay *display, SDL_bool fullscreen)
+{
+}
+
+static int BAREAPP_CreateWindowFramebuffer(_THIS, SDL_Window *window, Uint32 *format, void **pixels, int *pitch)
+{
+    SDL_Surface *surface;
+    int w, h;
+
+    SDL_FreeSurface((SDL_Surface *)SDL_SetWindowData(window, BAREAPP_SURFACE, NULL));
+    SDL_GetWindowSizeInPixels(window, &w, &h);
+    surface = SDL_CreateRGBSurfaceWithFormat(0, w, h, 0, SDL_PIXELFORMAT_RGB888);
+    if (!surface) {
+        return -1;
+    }
+    SDL_SetWindowData(window, BAREAPP_SURFACE, surface);
+    *format = SDL_PIXELFORMAT_RGB888;
+    *pixels = surface->pixels;
+    *pitch = surface->pitch;
+    return 0;
+}
+
+static int BAREAPP_UpdateWindowFramebuffer(_THIS, SDL_Window *window, const SDL_Rect *rects, int numrects)
+{
+    SDL_Surface *surface = SDL_GetWindowData(window, BAREAPP_SURFACE);
+
+    if (!surface) {
+        return SDL_SetError("bareapp: the window has no surface");
+    }
+    BAREAPP_Present(surface->pixels, surface->w, surface->h, surface->pitch, BAREAPP_XRGB);
+    return 0;
+}
+
+static void BAREAPP_DestroyWindowFramebuffer(_THIS, SDL_Window *window)
+{
+    SDL_FreeSurface((SDL_Surface *)SDL_SetWindowData(window, BAREAPP_SURFACE, NULL));
+}
+
+/* ---- OpenGL ------------------------------------------------------------- */
+
+#ifdef SDL_VIDEO_OPENGL_EGL
+static int BAREAPP_GL_LoadLibrary(_THIS, const char *path)
+{
+    /* on the GPU's render node without a display; other drivers (a PC's)
+     * get their default display, which makes pbuffers too */
+    int ret = SDL_EGL_LoadLibrary(_this, path, (NativeDisplayType)EGL_DEFAULT_DISPLAY, EGL_PLATFORM_SURFACELESS_MESA);
+
+    if (ret != 0) {
+        return ret;
+    }
+    _this->egl_data->is_offscreen = SDL_TRUE; /* pbuffer configs */
+    return SDL_EGL_ChooseConfig(_this);
+}
+
+static SDL_GLContext BAREAPP_GL_CreateContext(_THIS, SDL_Window *window)
+{
+    BAREAPP_WindowData *data = window->driverdata;
+
+    return SDL_EGL_CreateContext(_this, data->egl_surface);
+}
+
+static int BAREAPP_GL_MakeCurrent(_THIS, SDL_Window *window, SDL_GLContext context)
+{
+    if (window && context) {
+        BAREAPP_WindowData *data = window->driverdata;
+
+        return SDL_EGL_MakeCurrent(_this, data->egl_surface, context);
+    }
+    return SDL_EGL_MakeCurrent(_this, NULL, NULL);
+}
+
+static int BAREAPP_GL_SwapWindow(_THIS, SDL_Window *window)
+{
+    BAREAPP_WindowData *data = window->driverdata;
+    int w = data->egl_w, h = data->egl_h, fb = 0, align = 4;
+    size_t size = (size_t)w * h * 4;
+
+    if (!vd.ReadPixels) {
+        vd.ReadPixels = SDL_EGL_GetProcAddress(_this, "glReadPixels");
+        vd.GetIntegerv = SDL_EGL_GetProcAddress(_this, "glGetIntegerv");
+        vd.BindFramebuffer = SDL_EGL_GetProcAddress(_this, "glBindFramebuffer");
+        vd.PixelStorei = SDL_EGL_GetProcAddress(_this, "glPixelStorei");
+        if (!vd.ReadPixels || !vd.GetIntegerv || !vd.BindFramebuffer || !vd.PixelStorei) {
+            vd.ReadPixels = NULL;
+            return SDL_SetError("bareapp: no glReadPixels");
+        }
+    }
+    if (vd.pixels_size < size) {
+        Uint8 *pixels = SDL_realloc(vd.pixels, size);
+
+        if (!pixels) {
+            return SDL_OutOfMemory();
+        }
+        vd.pixels = pixels;
+        vd.pixels_size = size;
+    }
+
+    /* the window's pixels whatever the game has bound */
+    vd.GetIntegerv(BA_GL_FRAMEBUFFER_BINDING, &fb);
+    vd.GetIntegerv(BA_GL_PACK_ALIGNMENT, &align);
+    if (fb) {
+        vd.BindFramebuffer(BA_GL_FRAMEBUFFER, 0);
+    }
+    if (align != 4) {
+        vd.PixelStorei(BA_GL_PACK_ALIGNMENT, 4);
+    }
+    vd.ReadPixels(0, 0, w, h, BA_GL_RGBA, BA_GL_UNSIGNED_BYTE, vd.pixels);
+    if (align != 4) {
+        vd.PixelStorei(BA_GL_PACK_ALIGNMENT, align);
+    }
+    if (fb) {
+        vd.BindFramebuffer(BA_GL_FRAMEBUFFER, (unsigned)fb);
+    }
+
+    /* GL's rows go up */
+    BAREAPP_Present(vd.pixels + (size_t)(h - 1) * w * 4, w, h, -w * 4, BAREAPP_RGBA);
+
+    /* the window got another size (full screen): a pbuffer of it */
+    if (window->w != data->egl_w || window->h != data->egl_h) {
+        MakeSurface(_this, window);
+    }
+    return 0;
+}
+
+static void BAREAPP_GL_DeleteContext(_THIS, SDL_GLContext context)
+{
+    SDL_EGL_DeleteContext(_this, context);
+}
+#endif /* SDL_VIDEO_OPENGL_EGL */
+
+/* ---- device ------------------------------------------------------------- */
+
+static void BAREAPP_DeleteDevice(SDL_VideoDevice *device)
+{
+    SDL_free(device);
+}
+
+static SDL_VideoDevice *BAREAPP_CreateDevice(void)
+{
+    SDL_VideoDevice *device;
+
+    if (!BAREAPP_Available()) {
+        return NULL;
+    }
+    device = (SDL_VideoDevice *)SDL_calloc(1, sizeof(SDL_VideoDevice));
+    if (!device) {
+        SDL_OutOfMemory();
+        return NULL;
+    }
+    device->VideoInit = BAREAPP_VideoInit;
+    device->VideoQuit = BAREAPP_VideoQuit;
+    device->GetDisplayModes = BAREAPP_GetDisplayModes;
+    device->SetDisplayMode = BAREAPP_SetDisplayMode;
+    device->PumpEvents = BAREAPP_PumpEvents;
+    device->CreateSDLWindow = BAREAPP_CreateWindow;
+    device->DestroyWindow = BAREAPP_DestroyWindow;
+    device->SetWindowFullscreen = BAREAPP_SetWindowFullscreen;
+    device->CreateWindowFramebuffer = BAREAPP_CreateWindowFramebuffer;
+    device->UpdateWindowFramebuffer = BAREAPP_UpdateWindowFramebuffer;
+    device->DestroyWindowFramebuffer = BAREAPP_DestroyWindowFramebuffer;
+#ifdef SDL_VIDEO_OPENGL_EGL
+    device->GL_LoadLibrary = BAREAPP_GL_LoadLibrary;
+    device->GL_GetProcAddress = SDL_EGL_GetProcAddress;
+    device->GL_UnloadLibrary = SDL_EGL_UnloadLibrary;
+    device->GL_CreateContext = BAREAPP_GL_CreateContext;
+    device->GL_MakeCurrent = BAREAPP_GL_MakeCurrent;
+    device->GL_SetSwapInterval = SDL_EGL_SetSwapInterval;
+    device->GL_GetSwapInterval = SDL_EGL_GetSwapInterval;
+    device->GL_SwapWindow = BAREAPP_GL_SwapWindow;
+    device->GL_DeleteContext = BAREAPP_GL_DeleteContext;
+#endif
+    device->free = BAREAPP_DeleteDevice;
+    return device;
+}
+
+VideoBootStrap BAREAPP_bootstrap = {
+    "bareapp", "bare_app's video layer (OdroidLinux SDK)",
+    BAREAPP_CreateDevice,
+    NULL /* no ShowMessageBox implementation */
+};
