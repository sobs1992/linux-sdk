+dnl The OdroidLinux SDK's bare_app: its games draw into its video layer and
+dnl get its gamepad (src/video/bareapp, src/joystick/bareapp)
+CheckBareApp()
+{
+    AC_ARG_ENABLE(bareapp,
+[AS_HELP_STRING([--enable-bareapp], [use the video and joystick drivers of bare_app's games [default=no]])],
+                  , enable_bareapp=no)
+    if test x$enable_bareapp = xyes; then
+        AC_DEFINE(SDL_VIDEO_DRIVER_BAREAPP, 1, [ ])
+        SOURCES="$SOURCES $srcdir/src/video/bareapp/*.c"
+        have_video=yes
+        SUMMARY_video="${SUMMARY_video} bareapp"
+        if test x$enable_joystick = xyes; then
+            AC_DEFINE(SDL_JOYSTICK_BAREAPP, 1, [ ])
+            SOURCES="$SOURCES $srcdir/src/joystick/bareapp/*.c"
+        fi
+    fi
+}
