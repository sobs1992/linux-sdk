+#include "../../SDL_internal.h"
+
+#ifdef SDL_JOYSTICK_BAREAPP
+
+/*
+ * bare_app's gamepad as one game controller (video/bareapp/SDL_bareapp.h).
+ * Its buttons and axes are numbered as SDL_GameControllerButton and
+ * SDL_GameControllerAxis, and the driver gives that mapping itself. Which
+ * button of the device is which button of the controller: by their labels
+ * (A is A), Select back, Start start, F1 start, F2 back, F3 misc1, F4
+ * paddle1 (F5 and F6 are bare_app's); SDL_BAREAPP_GAMEPAD changes it
+ * ("f1=guide, f3=leftstick, l2=none"). The left stick is the
+ * left stick, the triggers L2 and R2 are fully pressed or not. While
+ * bare_app's link is there the evdev devices are not opened (the Linux
+ * driver honours SDL_JOYSTICK_LINUX=0): they are the same buttons.
+ */
+
+#include "SDL_events.h"
+#include "SDL_hints.h"
+#include "SDL_log.h"
+#include "../SDL_sysjoystick.h"
+#include "../SDL_joystick_c.h"
+#include "../../video/bareapp/SDL_bareapp.h"
+
+#define NBUTTONS SDL_CONTROLLER_BUTTON_MAX
+#define NAXES SDL_CONTROLLER_AXIS_MAX
+/* a target that is an axis: TRIGGER + SDL_GameControllerAxis */
+#define TRIGGER 0x100
+#define NONE (-1)
+
+static struct
+{
+    SDL_bool there;
+    SDL_JoystickID instance;
+    SDL_Joystick *joystick;
+    int target[GP_COUNT]; /* SDL_GameControllerButton, TRIGGER + axis or NONE */
+    Uint8 held[NBUTTONS + NAXES];
+    SDL_bool rest_sent; /* the axes' resting values, which SDL takes first */
+    Uint32 tail;
+} jd;
+
+static void DefaultMap(void)
+{
+    int i;
+
+    for (i = 0; i < GP_COUNT; i++) {
+        jd.target[i] = NONE;
+    }
+    jd.target[GP_UP] = SDL_CONTROLLER_BUTTON_DPAD_UP;
+    jd.target[GP_DOWN] = SDL_CONTROLLER_BUTTON_DPAD_DOWN;
+    jd.target[GP_LEFT] = SDL_CONTROLLER_BUTTON_DPAD_LEFT;
+    jd.target[GP_RIGHT] = SDL_CONTROLLER_BUTTON_DPAD_RIGHT;
+    jd.target[GP_A] = SDL_CONTROLLER_BUTTON_A;
+    jd.target[GP_B] = SDL_CONTROLLER_BUTTON_B;
+    jd.target[GP_X] = SDL_CONTROLLER_BUTTON_X;
+    jd.target[GP_Y] = SDL_CONTROLLER_BUTTON_Y;
+    jd.target[GP_L1] = SDL_CONTROLLER_BUTTON_LEFTSHOULDER;
+    jd.target[GP_R1] = SDL_CONTROLLER_BUTTON_RIGHTSHOULDER;
+    jd.target[GP_L2] = TRIGGER + SDL_CONTROLLER_AXIS_TRIGGERLEFT;
+    jd.target[GP_R2] = TRIGGER + SDL_CONTROLLER_AXIS_TRIGGERRIGHT;
+    jd.target[GP_SELECT] = SDL_CONTROLLER_BUTTON_BACK;
+    jd.target[GP_START] = SDL_CONTROLLER_BUTTON_START;
+    jd.target[GP_MENU] = SDL_CONTROLLER_BUTTON_GUIDE;
+    /* boards with a row of F keys and no Select or Start (GO Ultra) */
+    jd.target[GP_F1] = SDL_CONTROLLER_BUTTON_START;
+    jd.target[GP_F2] = SDL_CONTROLLER_BUTTON_BACK;
+    jd.target[GP_F3] = SDL_CONTROLLER_BUTTON_MISC1;
+    jd.target[GP_F4] = SDL_CONTROLLER_BUTTON_PADDLE1;
+}
+
+static void Mapped(int button, const char *value, void *ud)
+{
+    SDL_GameControllerButton b = SDL_GameControllerGetButtonFromString(value);
+    SDL_GameControllerAxis a = SDL_GameControllerGetAxisFromString(value);
+
+    (void)ud;
+    if (b != SDL_CONTROLLER_BUTTON_INVALID) {
+        jd.target[button] = b;
+    } else if (a == SDL_CONTROLLER_AXIS_TRIGGERLEFT || a == SDL_CONTROLLER_AXIS_TRIGGERRIGHT) {
+        jd.target[button] = TRIGGER + a;
+    } else {
+        if (SDL_strcasecmp(value, "none") != 0) {
+            SDL_LogWarn(SDL_LOG_CATEGORY_INPUT, "bareapp: no controller button \"%s\"", value);
+        }
+        jd.target[button] = NONE;
+    }
+}
+
+static int BAREAPP_JoystickInit(void)
+{
+    if (!BAREAPP_Available() || BAREAPP_Open() < 0) {
+        return 0;
+    }
+    jd.there = SDL_TRUE;
+    DefaultMap();
+    BAREAPP_ParseMap(SDL_getenv("SDL_BAREAPP_GAMEPAD"), Mapped, NULL);
+    /* the same buttons are evdev devices too */
+    SDL_SetHintWithPriority("SDL_JOYSTICK_LINUX", "0", SDL_HINT_DEFAULT);
+    jd.instance = SDL_GetNextJoystickInstanceID();
+    SDL_PrivateJoystickAdded(jd.instance);
+    return 0;
+}
+
+static int BAREAPP_JoystickGetCount(void)
+{
+    return jd.there ? 1 : 0;
+}
+
+static void BAREAPP_JoystickDetect(void)
+{
+}
+
+static const char *BAREAPP_JoystickGetDeviceName(int device_index)
+{
+    return "bare_app gamepad";
+}
+
+static const char *BAREAPP_JoystickGetDevicePath(int device_index)
+{
+    return NULL;
+}
+
+static int BAREAPP_JoystickGetDeviceSteamVirtualGamepadSlot(int device_index)
+{
+    return -1;
+}
+
+static int BAREAPP_JoystickGetDevicePlayerIndex(int device_index)
+{
+    return 0;
+}
+
+static void BAREAPP_JoystickSetDevicePlayerIndex(int device_index, int player_index)
+{
+}
+
+static SDL_JoystickGUID BAREAPP_JoystickGetDeviceGUID(int device_index)
+{
+    return SDL_CreateJoystickGUID(SDL_HARDWARE_BUS_UNKNOWN, 0, 0, 0, NULL, "bare_app gamepad", 'b', 0);
+}
+
+static SDL_JoystickID BAREAPP_JoystickGetDeviceInstanceID(int device_index)
+{
+    return jd.instance;
+}
+
+static int BAREAPP_JoystickOpen(SDL_Joystick *joystick, int device_index)
+{
+    if (!jd.there) {
+        return SDL_SetError("No such device");
+    }
+    joystick->instance_id = jd.instance;
+    joystick->nbuttons = NBUTTONS;
+    joystick->naxes = NAXES;
+    joystick->nhats = 0;
+    jd.joystick = joystick;
+    SDL_zero(jd.held);
+    jd.rest_sent = SDL_FALSE;
+    return 0;
+}
+
+static int BAREAPP_JoystickRumble(SDL_Joystick *joystick, Uint16 low_frequency_rumble, Uint16 high_frequency_rumble)
+{
+    return SDL_Unsupported();
+}
+
+static int BAREAPP_JoystickRumbleTriggers(SDL_Joystick *joystick, Uint16 left_rumble, Uint16 right_rumble)
+{
+    return SDL_Unsupported();
+}
+
+static Uint32 BAREAPP_JoystickGetCapabilities(SDL_Joystick *joystick)
+{
+    return 0;
+}
+
+static int BAREAPP_JoystickSetLED(SDL_Joystick *joystick, Uint8 red, Uint8 green, Uint8 blue)
+{
+    return SDL_Unsupported();
+}
+
+static int BAREAPP_JoystickSendEffect(SDL_Joystick *joystick, const void *data, int size)
+{
+    return SDL_Unsupported();
+}
+
+static int BAREAPP_JoystickSetSensorsEnabled(SDL_Joystick *joystick, SDL_bool enabled)
+{
+    return SDL_Unsupported();
+}
+
+/* Several buttons of the device may be one of the controller's */
+static void Target(SDL_Joystick *joystick, int target, SDL_bool pressed)
+{
+    int slot = target >= TRIGGER ? NBUTTONS + (target - TRIGGER) : target;
+    SDL_bool was = jd.held[slot] != 0;
+
+    if (pressed) {
+        jd.held[slot]++;
+    } else if (jd.held[slot]) {
+        jd.held[slot]--;
+    }
+    if (was == (jd.held[slot] != 0)) {
+        return;
+    }
+    if (target >= TRIGGER) {
+        SDL_PrivateJoystickAxis(joystick, (Uint8)(target - TRIGGER), pressed ? SDL_JOYSTICK_AXIS_MAX : 0);
+    } else {
+        SDL_PrivateJoystickButton(joystick, (Uint8)target, pressed ? SDL_PRESSED : SDL_RELEASED);
+    }
+}
+
+static void BAREAPP_JoystickUpdate(SDL_Joystick *joystick)
+{
+    static const Uint8 axes[GP_AXIS_COUNT] = {
+        SDL_CONTROLLER_AXIS_LEFTX, SDL_CONTROLLER_AXIS_LEFTY,
+        SDL_CONTROLLER_AXIS_RIGHTX, SDL_CONTROLLER_AXIS_RIGHTY,
+    };
+    const struct game_msg *m;
+    int i;
+
+    if (!jd.rest_sent) {
+        for (i = 0; i < NAXES; i++) {
+            SDL_PrivateJoystickAxis(joystick, (Uint8)i, 0);
+        }
+        jd.rest_sent = SDL_TRUE;
+    }
+    BAREAPP_Poll();
+    while ((m = BAREAPP_Next(&jd.tail)) != NULL) {
+        if (m->type == GAME_MSG_BUTTON && m->code < GP_COUNT) {
+            /* the left stick moves the stick, not the D-pad */
+            if ((m->flags & GAME_BTN_STICK) || jd.target[m->code] == NONE) {
+                continue;
+            }
+            Target(joystick, jd.target[m->code], m->pressed ? SDL_TRUE : SDL_FALSE);
+        } else if (m->type == GAME_MSG_AXIS && m->code < GP_AXIS_COUNT) {
+            SDL_PrivateJoystickAxis(joystick, axes[m->code], m->value);
+        }
+    }
+}
+
+static void BAREAPP_JoystickClose(SDL_Joystick *joystick)
+{
+    jd.joystick = NULL;
+}
+
+static void BAREAPP_JoystickQuit(void)
+{
+    jd.there = SDL_FALSE;
+}
+
+static SDL_bool BAREAPP_JoystickGetGamepadMapping(int device_index, SDL_GamepadMapping *out)
+{
+#define BUTTON(field, b)                  \
+    out->field.kind = EMappingKind_Button; \
+    out->field.target = b
+#define AXIS(field, a)                   \
+    out->field.kind = EMappingKind_Axis; \
+    out->field.target = a
+
+    BUTTON(a, SDL_CONTROLLER_BUTTON_A);
+    BUTTON(b, SDL_CONTROLLER_BUTTON_B);
+    BUTTON(x, SDL_CONTROLLER_BUTTON_X);
+    BUTTON(y, SDL_CONTROLLER_BUTTON_Y);
+    BUTTON(back, SDL_CONTROLLER_BUTTON_BACK);
+    BUTTON(guide, SDL_CONTROLLER_BUTTON_GUIDE);
+    BUTTON(start, SDL_CONTROLLER_BUTTON_START);
+    BUTTON(leftstick, SDL_CONTROLLER_BUTTON_LEFTSTICK);
+    BUTTON(rightstick, SDL_CONTROLLER_BUTTON_RIGHTSTICK);
+    BUTTON(leftshoulder, SDL_CONTROLLER_BUTTON_LEFTSHOULDER);
+    BUTTON(rightshoulder, SDL_CONTROLLER_BUTTON_RIGHTSHOULDER);
+    BUTTON(dpup, SDL_CONTROLLER_BUTTON_DPAD_UP);
+    BUTTON(dpdown, SDL_CONTROLLER_BUTTON_DPAD_DOWN);
+    BUTTON(dpleft, SDL_CONTROLLER_BUTTON_DPAD_LEFT);
+    BUTTON(dpright, SDL_CONTROLLER_BUTTON_DPAD_RIGHT);
+    BUTTON(misc1, SDL_CONTROLLER_BUTTON_MISC1);
+    BUTTON(paddle1, SDL_CONTROLLER_BUTTON_PADDLE1);
+    BUTTON(paddle2, SDL_CONTROLLER_BUTTON_PADDLE2);
+    BUTTON(paddle3, SDL_CONTROLLER_BUTTON_PADDLE3);
+    BUTTON(paddle4, SDL_CONTROLLER_BUTTON_PADDLE4);
+    BUTTON(touchpad, SDL_CONTROLLER_BUTTON_TOUCHPAD);
+    AXIS(leftx, SDL_CONTROLLER_AXIS_LEFTX);
+    AXIS(lefty, SDL_CONTROLLER_AXIS_LEFTY);
+    AXIS(rightx, SDL_CONTROLLER_AXIS_RIGHTX);
+    AXIS(righty, SDL_CONTROLLER_AXIS_RIGHTY);
+    /* 0 released, SDL_JOYSTICK_AXIS_MAX pressed */
+    AXIS(lefttrigger, SDL_CONTROLLER_AXIS_TRIGGERLEFT);
+    out->lefttrigger.half_axis_positive = SDL_TRUE;
+    AXIS(righttrigger, SDL_CONTROLLER_AXIS_TRIGGERRIGHT);
+    out->righttrigger.half_axis_positive = SDL_TRUE;
+#undef BUTTON
+#undef AXIS
+    return SDL_TRUE;
+}
+
+SDL_JoystickDriver SDL_BAREAPP_JoystickDriver = {
+    BAREAPP_JoystickInit,
+    BAREAPP_JoystickGetCount,
+    BAREAPP_JoystickDetect,
+    BAREAPP_JoystickGetDeviceName,
+    BAREAPP_JoystickGetDevicePath,
+    BAREAPP_JoystickGetDeviceSteamVirtualGamepadSlot,
+    BAREAPP_JoystickGetDevicePlayerIndex,
+    BAREAPP_JoystickSetDevicePlayerIndex,
+    BAREAPP_JoystickGetDeviceGUID,
+    BAREAPP_JoystickGetDeviceInstanceID,
+    BAREAPP_JoystickOpen,
+    BAREAPP_JoystickRumble,
+    BAREAPP_JoystickRumbleTriggers,
+    BAREAPP_JoystickGetCapabilities,
+    BAREAPP_JoystickSetLED,
+    BAREAPP_JoystickSendEffect,
+    BAREAPP_JoystickSetSensorsEnabled,
+    BAREAPP_JoystickUpdate,
+    BAREAPP_JoystickClose,
+    BAREAPP_JoystickQuit,
+    BAREAPP_JoystickGetGamepadMapping
+};
+
+#endif /* SDL_JOYSTICK_BAREAPP */
+
