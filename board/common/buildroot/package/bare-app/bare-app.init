#!/bin/sh
# Starts the bare_app GUI in the background (bare-app package).

DAEMON=/usr/bin/bare_app
PIDFILE=/var/run/bare_app.pid
LOG=/var/log/bare_app.log
# its screenshot on SIGUSR1 (view.c): the web service's check of a game reads
# it there (bare-web /api/shot.png)
export BARE_APP_SHOT=/run/bare_app/shot.ppm

case "$1" in
start)
	printf "Starting bare_app: "
	mkdir -p /run/bare_app
	start-stop-daemon -S -q -b -m -p $PIDFILE -x /bin/sh -- \
		-c "exec $DAEMON >> $LOG 2>&1" && echo "OK" || echo "FAIL"
	;;
stop)
	printf "Stopping bare_app: "
	# SIGTERM: the app gives the screen back to the text console
	pid=$(cat $PIDFILE 2>/dev/null)
	start-stop-daemon -K -q -p $PIDFILE && echo "OK" || echo "FAIL"
	# gone before "restart" starts another: it holds the DRM master until then
	i=0
	while [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null && [ $i -lt 50 ]; do
		sleep 0.1
		i=$((i + 1))
	done
	rm -f $PIDFILE
	;;
restart|reload)
	"$0" stop
	sleep 1
	"$0" start
	;;
*)
	echo "Usage: $0 {start|stop|restart}"
	exit 1
	;;
esac
