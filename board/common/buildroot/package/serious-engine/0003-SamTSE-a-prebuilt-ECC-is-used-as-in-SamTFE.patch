From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Sobs <antohasobne@gmail.com>
Date: Fri, 20 Nov 2026 00:10:00 +0100
Subject: [PATCH] SamTSE: a prebuilt ECC is used, as in SamTFE

When ECC (a native Entity Class Compiler, for a cross build) was given,
the entities were generated by an empty command.
---
 SamTSE/Sources/CMakeLists.txt | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/SamTSE/Sources/CMakeLists.txt b/SamTSE/Sources/CMakeLists.txt
index 326707c..f2876e6 100755
--- a/SamTSE/Sources/CMakeLists.txt
+++ b/SamTSE/Sources/CMakeLists.txt
@@ -658,6 +658,8 @@ if(NOT ECC)
     add_parser_and_scanner("Ecc/Parser" "Ecc/Scanner")
     add_executable(ecc-se Ecc/Main.cpp Ecc/Parser.cpp Ecc/Parser.h Ecc/Scanner.cpp)
     set(ECC-SE "ecc-se")
+else()
+    set(ECC-SE "${ECC}")
 endif()
 
 macro(entity _NAME)
