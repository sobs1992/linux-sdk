+++ b/SamTSE/Sources/Engine/Base/Unzip.cpp
@@ -478,7 +478,9 @@ int qsort_ArchiveCTFileName_reverse(const void *elem1, const void *elem2 )
   } else if (iPriority1>iPriority2) {
     return -1;
   } else {
-    return -stricmp(fnm1, fnm2);
