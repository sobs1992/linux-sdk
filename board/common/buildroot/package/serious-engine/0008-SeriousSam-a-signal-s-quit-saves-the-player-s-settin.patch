From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Sobs <antohasobne@gmail.com>
Date: Fri, 20 Nov 2026 00:20:00 +0100
Subject: [PATCH] SeriousSam: a signal's quit saves the player's settings and
 exits at once

bare_app waits a second after SIGTERM; taking a level's world and the
engine down took about two, and the game was killed before it had saved
anything. On SIGTERM or SIGINT the persistent symbols, the players and
controls and the game's settings are saved, then _exit(0).
---
 SamTFE/Sources/SeriousSam/SeriousSam.cpp | 16 ++++++++++++++++
 SamTSE/Sources/SeriousSam/SeriousSam.cpp | 16 ++++++++++++++++
 2 files changed, 32 insertions(+)

diff --git a/SamTFE/Sources/SeriousSam/SeriousSam.cpp b/SamTFE/Sources/SeriousSam/SeriousSam.cpp
index 4995a49..134211a 100644
--- a/SamTFE/Sources/SeriousSam/SeriousSam.cpp
+++ b/SamTFE/Sources/SeriousSam/SeriousSam.cpp
@@ -1658,6 +1658,22 @@ int SubMain( HINSTANCE hInstance, HINSTANCE hPrevInstance, LPSTR lpCmdLine, int
 
   } // end of main application loop
 
+#ifdef PLATFORM_UNIX
+  // a launcher ending the game waits a moment only (bare_app: a second);
+  // taking the world and the engine down takes longer in a level: save what
+  // the player set and leave the rest to the system
+  if (_bQuitSignal) {
+    _pShell->StorePersistentSymbols(CTString("Scripts\\PersistentSymbols.ini"));
+    _pGame->SavePlayersAndControls();
+    try {
+      _pGame->Save_t();
+    } catch (const char *strError) {
+      (void)strError;
+    }
+    _exit(0);
+  }
+#endif
+
   _pInput->DisableInput();
   _pGame->StopGame();
   
diff --git a/SamTSE/Sources/SeriousSam/SeriousSam.cpp b/SamTSE/Sources/SeriousSam/SeriousSam.cpp
index 4995a49..134211a 100644
--- a/SamTSE/Sources/SeriousSam/SeriousSam.cpp
+++ b/SamTSE/Sources/SeriousSam/SeriousSam.cpp
@@ -1658,6 +1658,22 @@ int SubMain( HINSTANCE hInstance, HINSTANCE hPrevInstance, LPSTR lpCmdLine, int
 
   } // end of main application loop
 
+#ifdef PLATFORM_UNIX
+  // a launcher ending the game waits a moment only (bare_app: a second);
+  // taking the world and the engine down takes longer in a level: save what
+  // the player set and leave the rest to the system
+  if (_bQuitSignal) {
+    _pShell->StorePersistentSymbols(CTString("Scripts\\PersistentSymbols.ini"));
+    _pGame->SavePlayersAndControls();
+    try {
+      _pGame->Save_t();
+    } catch (const char *strError) {
+      (void)strError;
+    }
+    _exit(0);
+  }
+#endif
+
   _pInput->DisableInput();
   _pGame->StopGame();
   
