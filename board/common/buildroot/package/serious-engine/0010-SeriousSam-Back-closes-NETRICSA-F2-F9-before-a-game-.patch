         } else if (msg.wParam==SDL_CONTROLLER_AXIS_LEFTX || msg.wParam==SDL_CONTROLLER_AXIS_LEFTY) {
           // a press when the stick leaves the middle, with hysteresis
@@ -1357,6 +1363,24 @@ int SubMain( HINSTANCE hInstance, HINSTANCE hPrevInstance, LPSTR lpCmdLine, int
