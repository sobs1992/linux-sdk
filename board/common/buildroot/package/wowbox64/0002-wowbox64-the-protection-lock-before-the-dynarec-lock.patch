---
--- a/src/include/box64context.h
+++ b/src/include/box64context.h
@@ -281,6 +281,26 @@
 
 extern box64context_t *my_context; // global context
 
+/*
+ * The dynarec's lock. In wowbox64 the protection lock (custommem.c) is
+ * always taken first: a block being built protects its pages (protectDB,
+ * protection lock) while a thread changing the protection of memory
+ * (unprotectDB...) frees or marks blocks (dynarec lock). Taken in both
+ * orders they deadlock. Both are recursive critical sections there.
+ */
+#ifdef _WIN32
+void dyndump_lock(void);
+int dyndump_trylock(void);
+void dyndump_unlock(void);
+#define DYNDUMP_LOCK()    dyndump_lock()
+#define DYNDUMP_TRYLOCK() dyndump_trylock()
+#define DYNDUMP_UNLOCK()  dyndump_unlock()
+#else
+#define DYNDUMP_LOCK()    mutex_lock(&my_context->mutex_dyndump)
+#define DYNDUMP_TRYLOCK() mutex_trylock(&my_context->mutex_dyndump)
+#define DYNDUMP_UNLOCK()  mutex_unlock(&my_context->mutex_dyndump)
+#endif
+
 box64context_t *NewBox64Context(int argc);
 void FreeBox64Context(box64context_t** context);
 
