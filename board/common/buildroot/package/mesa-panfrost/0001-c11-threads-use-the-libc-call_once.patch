From: Sobs <antohasobne@gmail.com>
Subject: [PATCH] c11: threads: use the libc call_once() declared in stdlib.h

glibc 2.43 declares the C23 call_once() and once_flag in <stdlib.h> for C
with _GNU_SOURCE, which conflicts with the ones of the pthread shim.

diff -ru a/src/c11/impl/threads_posix.c b/src/c11/impl/threads_posix.c
--- a/src/c11/impl/threads_posix.c	2026-11-07 17:06:38.009978993 +0100
+++ b/src/c11/impl/threads_posix.c	2026-11-07 17:06:38.029472154 +0100
@@ -46,11 +46,13 @@
 
 /*--------------- 7.25.2 Initialization functions ---------------*/
 // 7.25.2.1
+#ifndef C11_LIBC_CALL_ONCE
 void
 call_once(once_flag *flag, void (*func)(void))
 {
     pthread_once(flag, func);
 }
+#endif
 
 
 /*------------- 7.25.3 Condition variable functions -------------*/
diff -ru a/src/c11/threads.h b/src/c11/threads.h
--- a/src/c11/threads.h	2026-11-07 17:06:38.007602975 +0100
+++ b/src/c11/threads.h	2026-11-07 17:06:38.029410489 +0100
@@ -37,6 +37,14 @@
 #include <limits.h>
 #include <stdlib.h>
 
+/*
+ * glibc 2.43 declares the C23 call_once() and once_flag in <stdlib.h> for C
+ * with _GNU_SOURCE; its call_once() has been in libc since 2.28. Use them.
+ */
+#if !defined(__cplusplus) && defined(ONCE_FLAG_INIT)
+#  define C11_LIBC_CALL_ONCE 1
+#endif
+
 #if defined(_WIN32) && !defined(HAVE_PTHREAD)
 #  include <io.h> /* close */
 #  include <process.h> /* _exit */
@@ -118,8 +126,10 @@
 typedef pthread_t       thrd_t;
 typedef pthread_key_t   tss_t;
 typedef pthread_mutex_t mtx_t;
+#  ifndef C11_LIBC_CALL_ONCE
 typedef pthread_once_t  once_flag;
 #  define ONCE_FLAG_INIT PTHREAD_ONCE_INIT
+#  endif
 #  ifdef PTHREAD_DESTRUCTOR_ITERATIONS
 #    define TSS_DTOR_ITERATIONS PTHREAD_DESTRUCTOR_ITERATIONS
 #  else
@@ -148,7 +158,9 @@
 
 /*-------------------------- functions --------------------------*/
 
+#ifndef C11_LIBC_CALL_ONCE
 void call_once(once_flag *, void (*)(void));
+#endif
 int cnd_broadcast(cnd_t *);
 void cnd_destroy(cnd_t *);
 int cnd_init(cnd_t *);
