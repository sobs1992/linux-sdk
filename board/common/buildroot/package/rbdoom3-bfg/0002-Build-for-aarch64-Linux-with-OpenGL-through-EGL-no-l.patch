From 9365324bdda595cff0d354c4aa259906f176722b Mon Sep 17 00:00:00 2001
From: Sobs <antohasobne@gmail.com>
Date: Wed, 11 Nov 2026 00:40:35 +0100
Subject: [PATCH 02/17] Build for aarch64 Linux with OpenGL through EGL (no
 libGL, no GLX)

---
 neo/CMakeLists.txt          |  4 +++-
 neo/idlib/sys/sys_defines.h |  2 ++
 neo/libs/glew/src/glew.c    | 11 +++++++----
 3 files changed, 12 insertions(+), 5 deletions(-)

diff --git a/neo/CMakeLists.txt b/neo/CMakeLists.txt
index a72a323..6d67640 100644
--- a/neo/CMakeLists.txt
+++ b/neo/CMakeLists.txt
@@ -58,6 +58,9 @@ set(CPU_OPTIMIZATION "-mmmx -msse -msse2" CACHE STRING "Which CPU specific optim
 option(USE_INTRINSICS "Compile using intrinsics (e.g mmx, sse, msse2)" ON)
 
 option(USE_EGL "OpenGL through EGL, no libGL" OFF)
+if(USE_EGL)
+	add_definitions(-DGLEW_NO_GLU -DUSE_EGL)
+endif()
 
 if(FFMPEG AND BINKDEC)
 	message(FATAL_ERROR "Only one of FFMPEG and BINKDEC (or neither) can be enabled at a time")
@@ -1483,7 +1486,6 @@ else()
 		# OpenGL through EGL only (Mesa without GLX, no libGL): GLEW and
 		# the core functions are looked up by eglGetProcAddress
 		find_library(EGL_LIBRARY EGL REQUIRED)
-		add_definitions(-DGLEW_EGL -DUSE_EGL)
 		set(OPENGL_LIBRARIES ${EGL_LIBRARY})
 	else()
 		find_package(OpenGL REQUIRED)
diff --git a/neo/idlib/sys/sys_defines.h b/neo/idlib/sys/sys_defines.h
index 58af3e2..fce3f5b 100644
--- a/neo/idlib/sys/sys_defines.h
+++ b/neo/idlib/sys/sys_defines.h
@@ -111,6 +111,8 @@ If you have questions concerning this license or the applicable additional terms
 #define CPUSTRING						"x86_64"
 #elif defined(__e2k__)
 #define CPUSTRING						"e2k"
+#elif defined(__aarch64__)
+#define CPUSTRING						"aarch64"
 #else
 #error unknown CPU
 #endif
diff --git a/neo/libs/glew/src/glew.c b/neo/libs/glew/src/glew.c
index 6c93c07..5ba9750 100644
--- a/neo/libs/glew/src/glew.c
+++ b/neo/libs/glew/src/glew.c
@@ -37,6 +37,9 @@
 #  include <GL/osmesa.h>
 #elif defined(GLEW_EGL)
 #  include <GL/eglew.h>
+#elif defined(USE_EGL)
+/* RBDOOM on Mesa without GLX: every GL function from eglGetProcAddress */
+#  include <EGL/egl.h>
 #elif defined(_WIN32)
 #  include <GL/wglew.h>
 #elif !defined(__ANDROID__) && !defined(__native_client__) && !defined(__HAIKU__) && (!defined(__APPLE__) || defined(GLEW_APPLE_GLX))
@@ -150,7 +153,7 @@ void* NSGLGetProcAddress (const GLubyte *name)
 #  define glewGetProcAddress(name) regalGetProcAddress((const GLchar *)name)
 #elif defined(GLEW_OSMESA)
 #  define glewGetProcAddress(name) OSMesaGetProcAddress((const char *)name)
-#elif defined(GLEW_EGL)
+#elif defined(GLEW_EGL) || defined(USE_EGL)
 #  define glewGetProcAddress(name) eglGetProcAddress((const char *)name)
 #elif defined(_WIN32)
 #  define glewGetProcAddress(name) wglGetProcAddress((LPCSTR)name)
@@ -16709,7 +16712,7 @@ GLenum GLEWAPIENTRY wglewInit ()
   return GLEW_OK;
 }
 
-#elif !defined(__ANDROID__) && !defined(__native_client__) && !defined(__HAIKU__) && (!defined(__APPLE__) || defined(GLEW_APPLE_GLX))
+#elif !defined(USE_EGL) && !defined(__ANDROID__) && !defined(__native_client__) && !defined(__HAIKU__) && (!defined(__APPLE__) || defined(GLEW_APPLE_GLX))
 
 PFNGLXGETCURRENTDISPLAYPROC __glewXGetCurrentDisplay = NULL;
 
@@ -17823,7 +17826,7 @@ GLenum GLEWAPIENTRY glewInit (void)
 #if defined(GLEW_EGL)
   getCurrentDisplay = (PFNEGLGETCURRENTDISPLAYPROC) glewGetProcAddress("eglGetCurrentDisplay");
   return eglewInit(getCurrentDisplay());
-#elif defined(GLEW_OSMESA) || defined(__ANDROID__) || defined(__native_client__) || defined(__HAIKU__)
+#elif defined(GLEW_OSMESA) || defined(USE_EGL) || defined(__ANDROID__) || defined(__native_client__) || defined(__HAIKU__)
   return r;
 #elif defined(_WIN32)
   return wglewInit();
@@ -22605,7 +22608,7 @@ GLboolean GLEWAPIENTRY wglewIsSupported (const char* name)
   return ret;
 }
 
-#elif !defined(GLEW_OSMESA) && !defined(GLEW_EGL) && !defined(__ANDROID__) && !defined(__native_client__) && !defined(__HAIKU__) && !defined(__APPLE__) || defined(GLEW_APPLE_GLX)
+#elif !defined(GLEW_OSMESA) && !defined(GLEW_EGL) && !defined(USE_EGL) && !defined(__ANDROID__) && !defined(__native_client__) && !defined(__HAIKU__) && !defined(__APPLE__) || defined(GLEW_APPLE_GLX)
 
 GLboolean glxewIsSupported (const char* name)
 {
-- 
2.53.0

