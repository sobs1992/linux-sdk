 	// do the first render
+	// dynamic resolution (rs_enable): the 3D view at a smaller size when the
+	// frames are slow, stretched to the screen; the HUD, texts and menus
+	// drawn after it stay at the full size
+	int sceneWidth = renderSystem->GetWidth();
+	int sceneHeight = renderSystem->GetHeight();
+	renderSystem->PerformResolutionScaling( sceneWidth, sceneHeight );
+	const bool scaledScene = scaledSceneMaterial != NULL && !IsGameStereoRendered() &&
+							 ( sceneWidth < renderSystem->GetWidth() || sceneHeight < renderSystem->GetHeight() ) &&
+							 sceneWidth > 0 && sceneHeight > 0;
+	if( scaledScene )
+	{
+		renderSystem->CropRenderSize( sceneWidth, sceneHeight );
+	}
+	
 	gameRenderWorld->RenderScene( view );
 	
+	if( scaledScene )
+	{
+		renderSystem->CaptureRenderToImage( "_scaledSceneImage" );
+		renderSystem->UnCrop();
+		renderSystem->SetColor4( 1.0f, 1.0f, 1.0f, 1.0f );
+		renderSystem->DrawStretchPic( 0.0f, 0.0f, renderSystem->GetVirtualWidth(), renderSystem->GetVirtualHeight(), 0.0f, 1.0f, 1.0f, 0.0f, scaledSceneMaterial );
+	}
+	
