From a0da41d6fb297e92f3318a4c312ba4e668a2fa1c Mon Sep 17 00:00:00 2001
From: Sobs <antohasobne@gmail.com>
Date: Wed, 11 Nov 2026 12:56:16 +0100
Subject: [PATCH 13/17] BinkDec videos: frames uploaded into two sets of images
 in turn

A frame was uploaded into the images the GPU might still be drawing the
frame before with. With r_syncEveryFrame 0 that happens all the time,
and on Mesa's panfrost the upload (glTexSubImage2D of a busy texture)
read past the end of the mapping: a crash at the loading of hell1 and
mars_city2. Each new frame now goes into the other set.
---
 neo/renderer/Cinematic.cpp | 49 +++++++++++++++++++++++++-------------
 1 file changed, 33 insertions(+), 16 deletions(-)

diff --git a/neo/renderer/Cinematic.cpp b/neo/renderer/Cinematic.cpp
index d92425b..5c4afa9 100644
--- a/neo/renderer/Cinematic.cpp
+++ b/neo/renderer/Cinematic.cpp
@@ -121,6 +121,12 @@ private:
 	idImage*				imgY;
 	idImage*				imgCr;
 	idImage*				imgCb;
+	// BinkDec: frames go into two sets of images in turn, so that a frame is
+	// never uploaded into images the GPU may still be drawing the frame
+	// before with (r_syncEveryFrame 0); on Mesa's panfrost that upload read
+	// past the end of the mapping
+	idImage*				binkImgs[2][3];
+	int						binkSet;
 #endif
 	idImage*				img;
 	bool					isRoQ;
@@ -430,29 +436,30 @@ idCinematicLocal::idCinematicLocal()
 	framePos = -1;
 	numFrames = 0;
 	
-	imgY = globalImages->AllocStandaloneImage( "_cinematicY" );
-	imgCr = globalImages->AllocStandaloneImage( "_cinematicCr" );
-	imgCb = globalImages->AllocStandaloneImage( "_cinematicCb" );
+	binkSet = 0;
+	for( int set = 0; set < 2; set++ )
 	{
+		binkImgs[set][0] = globalImages->AllocStandaloneImage( "_cinematicY" );
+		binkImgs[set][1] = globalImages->AllocStandaloneImage( "_cinematicCr" );
+		binkImgs[set][2] = globalImages->AllocStandaloneImage( "_cinematicCb" );
+		
 		idImageOpts opts;
 		opts.format = FMT_LUM8;
 		opts.colorFormat = CFM_DEFAULT;
 		opts.width = 32;
 		opts.height = 32;
 		opts.numLevels = 1;
-		if( imgY != NULL )
-		{
-			imgY->AllocImage( opts, TF_LINEAR, TR_REPEAT );
-		}
-		if( imgCr != NULL )
+		for( int i = 0; i < 3; i++ )
 		{
-			imgCr->AllocImage( opts, TF_LINEAR, TR_REPEAT );
-		}
-		if( imgCb != NULL )
-		{
-			imgCb->AllocImage( opts, TF_LINEAR, TR_REPEAT );
+			if( binkImgs[set][i] != NULL )
+			{
+				binkImgs[set][i]->AllocImage( opts, TF_LINEAR, TR_REPEAT );
+			}
 		}
 	}
+	imgY = binkImgs[0][0];
+	imgCr = binkImgs[0][1];
+	imgCb = binkImgs[0][2];
 	
 #endif
 	
@@ -519,11 +526,16 @@ idCinematicLocal::~idCinematicLocal()
 		Bink_Close( binkHandle );
 	}
 	
-	delete imgY;
+	for( int set = 0; set < 2; set++ )
+	{
+		for( int i = 0; i < 3; i++ )
+		{
+			delete binkImgs[set][i];
+			binkImgs[set][i] = NULL;
+		}
+	}
 	imgY = NULL;
-	delete imgCr;
 	imgCr = NULL;
-	delete imgCb;
 	imgCb = NULL;
 #endif
 	
@@ -1237,6 +1249,11 @@ cinData_t idCinematicLocal::ImageForTimeBinkDec( int thisTime )
 	
 	double invAspRat = double( CIN_HEIGHT ) / double( CIN_WIDTH );
 	
+	// the other set of images: the GPU may still draw with the one shown last
+	binkSet ^= 1;
+	imgY = binkImgs[binkSet][0];
+	imgCr = binkImgs[binkSet][1];
+	imgCb = binkImgs[binkSet][2];
 	idImage* imgs[3] = {imgY, imgCb, imgCr}; // that's the order of the channels in yuvBuffer[]
 	for( int i = 0; i < 3; ++i )
 	{
-- 
2.53.0

