+/*
+========================
+SWF_TextLines
+
+The lines a text takes in a field at a glyph scale, broken as
+idSWF::RenderEditText breaks them (tooltip icons left out); at most
+lineLimit + 1 are counted. A field that neither wraps nor has several
+lines takes one, or two when the text is cut at its end.
+========================
+*/
+static int SWF_TextLines( idSWFTextInstance* textInstance, const idFont* fontInfo, idStr& text, float glyphScale, float left, float right, int lineLimit )
+{
+	const idSWFEditText* shape = textInstance->editText;
+	const bool wrap = ( shape->flags & ( SWF_ET_MULTILINE | SWF_ET_WORDWRAP ) ) != 0;
+	const float strokeSkip = textInstance->HasStroke() ? swf_textStrokeSizeGlyphSpacer.GetFloat() * textInstance->GetStrokeWeight() * glyphScale : 0.0f;
+	
+	int lines = 1;
+	float x = left;
+	bool haveBreak = false;
+	float lastbreakX = 0.0f;
+	int charIndex = textInstance->IsSubtitle() ? textInstance->GetSubStartIndex() : 0;
+	
+	while( charIndex < text.Length() && lines <= lineLimit )
+	{
+		if( text[ charIndex ] == '\n' )
+		{
+			if( !( shape->flags & SWF_ET_MULTILINE ) )
+			{
+				break;
+			}
+			lines++;
+			x = left;
+			haveBreak = false;
+			charIndex++;
+			continue;
+		}
+		const uint32 tc = text.UTF8Char( charIndex );
+		scaledGlyphInfo_t glyph;
+		fontInfo->GetScaledGlyph( glyphScale, tc, glyph );
+		const float glyphSkip = glyph.xSkip + strokeSkip;
+		if( x + glyphSkip > right )
+		{
+			lines++;	// a new line, or (no wrapping) the text is cut
+			if( !wrap )
+			{
+				break;
+			}
+			// as RenderEditText: the part after the last break moves on
+			x = haveBreak ? x - lastbreakX : left;
+			haveBreak = false;
+		}
+		x += glyphSkip;
+		if( tc == ' ' || tc == '-' )
+		{
+			haveBreak = true;
+			lastbreakX = x;
+		}
+	}
+	return lines;
+}
+
+static float SWF_FitTextBoost( idSWFTextInstance* textInstance, const idFont* fontInfo, idStr& text, float xScale, float yScale, float height, float wanted );
+
+/*
+========================
+SWF_TextBoost
+
+swf_textMinHeight: how much bigger a text smaller than that is drawn, at
+most swf_textMaxScale times, and only as far as it still fits its field:
+the lines it took at its own size, as many as the field has room for
+then. Lines that did not fit at their own size either (scrolled like the
+PDA's) grow all the same. Worked out again only when the text or the
+scale changes.
+========================
+*/
+static float SWF_TextBoost( idSWFTextInstance* textInstance, const idFont* fontInfo, idStr& text, float xScale, float yScale )
+{
+	const idSWFEditText* shape = textInstance->editText;
+	const float height = SWFTWIP( shape->fontHeight ) * yScale;
+	if( height <= 0.0f || height >= swf_textMinHeight.GetFloat() || text.IsEmpty() )
+	{
+		return 1.0f;
+	}
+	const float wanted = idMath::ClampFloat( 1.0f, swf_textMaxScale.GetFloat(), swf_textMinHeight.GetFloat() / height );
+	if( shape->flags & SWF_ET_AUTOSIZE )
+	{
+		return wanted;	// the field grows with its text
+	}
+	
+	const int hash = idStr::Hash( text.c_str() ) ^ ( int )( wanted * 1000.0f );
+	if( hash == textInstance->textBoostHash && xScale == textInstance->textBoostXScale && yScale == textInstance->textBoostYScale )
+	{
+		return textInstance->textBoostFit;
+	}
+	textInstance->textBoostHash = hash;
+	textInstance->textBoostXScale = xScale;
+	textInstance->textBoostYScale = yScale;
+	textInstance->textBoostFit = SWF_FitTextBoost( textInstance, fontInfo, text, xScale, yScale, height, wanted );
+	return textInstance->textBoostFit;
+}
+
+/*
+========================
+SWF_FitTextBoost
+
+SWF_TextBoost without its cache: the biggest boost up to wanted at which
+the text still fits its field
+========================
+*/
+static float SWF_FitTextBoost( idSWFTextInstance* textInstance, const idFont* fontInfo, idStr& text, float xScale, float yScale, float height, float wanted )
+{
+	const idSWFEditText* shape = textInstance->editText;
+	
+	// the field as RenderEditText sees it at a boost
+	const float left = xScale * ( shape->bounds.tl.x + SWFTWIP( shape->leftMargin ) );
+	const float right = xScale * ( shape->bounds.br.x - SWFTWIP( shape->rightMargin ) );
+	const bool severalLines = ( shape->flags & ( SWF_ET_MULTILINE | SWF_ET_WORDWRAP ) ) != 0;
+	auto roomFor = [&]( float boost ) -> int
+	{
+		if( !severalLines )
+		{
+			return 1;
+		}
+		const float glyphScale = height * boost / 48.0f;
+		float linespacing = fontInfo->GetAscender( 1.15f * glyphScale );
+		if( shape->leading != 0 )
+		{
+			linespacing += SWFTWIP( shape->leading );
+		}
+		const float top = yScale * ( shape->bounds.tl.y + ( 1.15f * glyphScale ) );
+		const float bottom = yScale * shape->bounds.br.y;
+		return Max( idMath::Ftoi( ( bottom - top ) / linespacing ), 1 );
+	};
+	
+	const int ownRoom = roomFor( 1.0f );
+	if( SWF_TextLines( textInstance, fontInfo, text, height / 48.0f, left, right, ownRoom ) > ownRoom )
+	{
+		// did not fit at its own size either: lines that scroll (the PDA's)
+		// grow all the same, a single cut line stays as it was
+		return severalLines ? wanted : 1.0f;
+	}
+	for( float boost = wanted; boost > 1.0f; boost -= 0.05f )
+	{
+		const int room = roomFor( boost );
+		if( SWF_TextLines( textInstance, fontInfo, text, height * boost / 48.0f, left, right, room ) <= room )
+		{
+			return boost;
+		}
+	}
+	return 1.0f;
+}
