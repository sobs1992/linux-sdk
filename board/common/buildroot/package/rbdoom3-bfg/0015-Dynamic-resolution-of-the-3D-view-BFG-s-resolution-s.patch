+/*
+========================
+idResolutionScale::SetCurrentFrameTime
+
+For GPUs without usable timer queries: frames are paced to the engine's
+rate (com_engineHz), so a frame that keeps that rate tells nothing about
+the time to spare. The scale drops at once (proportionally to the miss,
+pixels cost about the area) when frames take too long; it rises a step
+after raiseWait frames at the full rate, and a rise that had to be taken
+back soon makes the next wait longer, so the picture does not keep
+changing between two sizes.
+========================
+*/
+void idResolutionScale::SetCurrentFrameTime( int microseconds )
+{
+	const float old = currentResolution;
+	const float target = 1000.0f / idMath::ClampFloat( 10.0f, 240.0f, com_engineHz_latched );
+	float ms = microseconds * 0.001f;
+	
+	if( ms <= 0.0f || ms > 500.0f )
+	{
+		return;	// loading, a pause: nothing to learn
+	}
+	if( frameMsAverage <= 0.0f )
+	{
+		frameMsAverage = ms;
+	}
+	frameMsAverage = frameMsAverage * 0.8f + ms * 0.2f;
+	framesSinceChange++;
+	
+	const float drop = target + rs_frameDropMilliseconds.GetFloat();
+	const float raise = target + rs_frameRaiseMilliseconds.GetFloat();
+	
+	if( frameMsAverage > drop && framesSinceChange >= 6 )
+	{
+		float want = currentResolution * idMath::Sqrt( target / frameMsAverage );
+		want = Max( want, currentResolution - 0.15f );
+		want = Min( want, currentResolution - 0.02f );
+		currentResolution = Max( want, MINIMUM_RESOLUTION_SCALE );
+		if( lastChangeWasRaise && framesSinceChange < raiseWait )
+		{
+			raiseWait = Min( raiseWait * 2, 1200 );	// that rise was too much
+		}
+		lastChangeWasRaise = false;
+		framesSinceChange = 0;
+		framesAboveRaise = 0;
+		frameMsAverage = target;	// judge the new size by its own frames
+	}
+	else if( frameMsAverage < raise && currentResolution < MAXIMUM_RESOLUTION_SCALE )
+	{
+		if( ++framesAboveRaise >= raiseWait )
+		{
+			currentResolution = Min( currentResolution + rs_raiseFraction.GetFloat(), MAXIMUM_RESOLUTION_SCALE );
+			lastChangeWasRaise = true;
+			framesSinceChange = 0;
+			framesAboveRaise = 0;
+		}
+	}
+	else
+	{
+		framesAboveRaise = 0;
+		if( framesSinceChange > 1200 )
+		{
+			raiseWait = Max( raiseWait / 2, 60 );	// calm for a while: try sooner again
+			framesSinceChange = 600;
+		}
+	}
+	
+	if( rs_showResolutionChanges.GetInteger() > 1 ||
+			( rs_showResolutionChanges.GetInteger() == 1 && currentResolution != old ) )
+	{
+		idLib::Printf( "frame msec: %4.1f (average %4.1f) resolutionScale: %4.2f, raise wait %d\n", ms, frameMsAverage, currentResolution, raiseWait );
+	}
+}
