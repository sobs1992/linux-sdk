+/*
+==================
+FullscreenFXManager::RenderScaledScene
+
+Dynamic resolution (rs_enable): a 3D view of the player's drawn at the
+size this frame's scale gives (RenderScene draws into the crop, at the
+bottom left), then captured into image; false when it is drawn at the
+full size (captured then too if captureAlways). The view and its portal
+sky alike, as the view reads the sky back over its own size. Only here:
+other 3D views (demos, screenshots, the end of a level) stay at the full
+size, as nothing would stretch them.
+==================
+*/
+bool FullscreenFXManager::RenderScaledScene( const renderView_t* view, const char* image, bool captureAlways )
+{
+	int width = renderSystem->GetWidth();
+	int height = renderSystem->GetHeight();
+	renderSystem->PerformResolutionScaling( width, height );
+	const bool scaled = scaledSceneMaterial != NULL && !IsGameStereoRendered() &&
+						( width < renderSystem->GetWidth() || height < renderSystem->GetHeight() ) &&
+						width > 0 && height > 0;
+	if( scaled )
+	{
+		renderSystem->CropRenderSize( width, height );
+	}
+	gameRenderWorld->RenderScene( view );
+	if( scaled || captureAlways )
+	{
+		renderSystem->CaptureRenderToImage( image );
+	}
+	if( scaled )
+	{
+		renderSystem->UnCrop();
+	}
+	return scaled;
+}
