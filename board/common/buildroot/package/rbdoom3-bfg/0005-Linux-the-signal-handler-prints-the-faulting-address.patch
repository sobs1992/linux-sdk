From 1c3c2f5beef7547b3904c06a8897f38e07343663 Mon Sep 17 00:00:00 2001
From: Sobs <antohasobne@gmail.com>
Date: Wed, 11 Nov 2026 09:18:04 +0100
Subject: [PATCH 05/17] Linux: the signal handler prints the faulting address
 and a backtrace

Offsets into the files, for addr2line on an unstripped build.
---
 neo/sys/posix/posix_signal.cpp | 32 ++++++++++++++++++++++++++++++++
 1 file changed, 32 insertions(+)

diff --git a/neo/sys/posix/posix_signal.cpp b/neo/sys/posix/posix_signal.cpp
index 5c33b34..d327f0d 100644
--- a/neo/sys/posix/posix_signal.cpp
+++ b/neo/sys/posix/posix_signal.cpp
@@ -30,6 +30,13 @@ If you have questions concerning this license or the applicable additional terms
 
 #include <string.h>
 #include <errno.h>
+#if defined(__linux__) && defined(__GLIBC__)
+#include <execinfo.h>
+#include <dlfcn.h>
+#include <ucontext.h>
+#include <unistd.h>
+#define POSIX_SIG_BACKTRACE
+#endif
 
 const int siglist[] =
 {
@@ -111,6 +118,31 @@ static void sig_handler( int signum, siginfo_t* info, void* context )
 	
 	// NOTE: see sigaction man page, could verbose the whole siginfo_t and print human readable si_code
 	Sys_Printf( "signal caught: %s\nsi_code %d\n", strsignal( signum ), info->si_code );
+#ifdef POSIX_SIG_BACKTRACE
+	// where it happened: addresses as offsets into their files, for addr2line
+	{
+		void* frames[ 48 ];
+		int n = backtrace( frames, 48 );
+		void* pc = NULL;
+#if defined(__aarch64__)
+		pc = ( void* )( ( ucontext_t* )context )->uc_mcontext.pc;
+#elif defined(__x86_64__)
+		pc = ( void* )( ( ucontext_t* )context )->uc_mcontext.gregs[ REG_RIP ];
+#endif
+		fprintf( stderr, "%s (si_code %d): fault address %p, pc %p\n", strsignal( signum ), info->si_code, info->si_addr, pc );
+		for( int i = -1; i < n; i++ )
+		{
+			void* a = i < 0 ? pc : frames[ i ];
+			Dl_info dl;
+			if( a && dladdr( a, &dl ) && dl.dli_fname )
+			{
+				fprintf( stderr, "  #%d %s+0x%lx (%s)\n", i + 1, dl.dli_fname,
+						 ( unsigned long )( ( char* )a - ( char* )dl.dli_fbase ), dl.dli_sname ? dl.dli_sname : "?" );
+			}
+		}
+		fflush( stderr );
+	}
+#endif
 	
 	if( fatalError[ 0 ] )
 	{
-- 
