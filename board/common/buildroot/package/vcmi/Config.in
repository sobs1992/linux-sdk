config BR2_PACKAGE_VCMI
	bool "vcmi"
	depends on BR2_INSTALL_LIBSTDCPP
	depends on BR2_TOOLCHAIN_GCC_AT_LEAST_11 # C++20
	depends on BR2_TOOLCHAIN_HAS_THREADS
	depends on BR2_USE_WCHAR
	depends on !BR2_STATIC_LIBS
	depends on !BR2_TOOLCHAIN_USES_UCLIBC # tbb
	depends on BR2_TOOLCHAIN_SUPPORTS_ALWAYS_LOCKFREE_ATOMIC_INTS # boost-locale
	depends on BR2_PACKAGE_FFMPEG_ARCH_SUPPORTS
	select BR2_PACKAGE_BOOST
	select BR2_PACKAGE_BOOST_DATE_TIME
	select BR2_PACKAGE_BOOST_FILESYSTEM
	select BR2_PACKAGE_BOOST_LOCALE
	select BR2_PACKAGE_BOOST_PROGRAM_OPTIONS
	select BR2_PACKAGE_FFMPEG
	select BR2_PACKAGE_FFMPEG_SWSCALE
	select BR2_PACKAGE_LIBSQUISH
	select BR2_PACKAGE_LIBPNG
	select BR2_PACKAGE_MINIZIP_ZLIB
	select BR2_PACKAGE_SDL2
	select BR2_PACKAGE_SDL2_IMAGE
	select BR2_PACKAGE_SDL2_MIXER
	select BR2_PACKAGE_SDL2_TTF
	select BR2_PACKAGE_TBB
	select BR2_PACKAGE_ZLIB
	help
	  VCMI, an open-source engine for Heroes of Might and Magic III:
	  the client (vcmiclient, with the game server built in), the
	  adventure AI Nullkiller2 and the battle AIs BattleAI and
	  StupidAI. No launcher, map editor or Lua.

	  The game data is not included: VCMI needs the Data, Maps and
	  Mp3 directories of an original installation (Shadow of Death
	  or Complete) in its data directory.

	  SDL2 gets its dummy video driver (VCMI draws in software into
	  a window kept in memory) and SDL2_mixer MP3 support (the
	  game's music). FFmpeg is built with what the game's videos
	  need only: Bink and Smacker.

	  https://vcmi.eu/

comment "vcmi needs a glibc/musl toolchain w/ C++, gcc >= 11, threads, wchar, dynamic library"
	depends on !BR2_INSTALL_LIBSTDCPP || !BR2_TOOLCHAIN_GCC_AT_LEAST_11 || \
		!BR2_TOOLCHAIN_HAS_THREADS || !BR2_USE_WCHAR || BR2_STATIC_LIBS || \
		BR2_TOOLCHAIN_USES_UCLIBC
