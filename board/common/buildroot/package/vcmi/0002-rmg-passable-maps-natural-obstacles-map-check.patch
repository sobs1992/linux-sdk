+void ObstaclePlacer::measureTerrain()
+{
+	// Breadth-first distances over the zone, 4-connected; -1 outside
+	const size_t size = map.width() * map.height() * map.levels();
+	placedTypes.assign(size, ObstacleSet::INVALID);
+	auto measure = [this, size](const rmg::Area & from, const rmg::Area & within, std::vector<int> & result)
+	{
+		result.assign(size, -1);
+		std::deque<int3> queue;
+		for(const auto & t : from.getTilesVector())
+		{
+			result[tileIndex(t)] = 0;
+			queue.push_back(t);
+		}
+		while(!queue.empty())
+		{
+			auto t = queue.front();
+			queue.pop_front();
+			map.foreachDirectNeighbour(t, [&](int3 & n)
+			{
+				if(result[tileIndex(n)] < 0 && within.contains(n))
+				{
+					result[tileIndex(n)] = result[tileIndex(t)] + 1;
+					queue.push_back(n);
+				}
+			});
+		}
+	};
+
+	auto area = zone.area();
+	// The zone's outer tiles, and the map's edge
+	rmg::Area edge(area->getBorder());
+	edge.unite(area->getSubarea([this](const int3 & t)
+	{
+		return t.x <= 1 || t.y <= 1 || t.x >= map.width() - 2 || t.y >= map.height() - 2;
+	}));
+	measure(edge, area.get(), borderDistance);
+
+	// Depth into the ground to be covered with obstacles
+	rmg::Area open = area->getSubarea([this](const int3 & t)
+	{
+		return !blockedArea.contains(t);
+	});
+	measure(open, blockedArea, depth);
+}
+
+size_t ObstaclePlacer::tileIndex(const int3 & t) const
+{
+	return (t.z * map.height() + t.y) * map.width() + t.x;
+}
+
+int ObstaclePlacer::obstaclePreference(const ObjectTemplate & temp, const rmg::Area & objArea) const
+{
+	if(zone.getType() == ETemplateZoneType::WATER)
+		return 0;
+
+	auto value = [this](const std::vector<int> & m, const int3 & t, int fallback)
+	{
+		int v = m.empty() ? -1 : m[tileIndex(t)];
+		return v < 0 ? fallback : v;
+	};
+
+	auto type = getObstacleType(temp);
+	const auto & tiles = objArea.getTilesVector();
+
+	if(type == ObstacleSet::MOUNTAINS)
+	{
+		// Mountains make ridges along the zone's edge, or the heart of a wide
+		// blocked mass; not a random wall in the middle of open land
+		for(const auto & t : tiles)
+		{
+			if(value(borderDistance, t, 0) > 3 && value(depth, t, 0) < 3)
+				return -1;
+		}
+	}
+
+	int preference = 0;
+	if(type == ObstacleSet::MOUNTAINS || type == ObstacleSet::TREES || type == ObstacleSet::LAKES)
+	{
+		// Like next to like: forests grow together, mountains line up
+		int alike = 0;
+		for(const auto & t : objArea.getBorderOutside())
+		{
+			if(map.isOnMap(t) && !placedTypes.empty() && placedTypes[tileIndex(t)] == type)
+				alike++;
+		}
+		preference += std::min(alike, 3);
+	}
+	if(type == ObstacleSet::TREES)
+	{
+		// Forests inside the zone rather than on its edge
+		bool inside = true;
+		for(const auto & t : tiles)
+			if(value(borderDistance, t, 0) <= 2)
+				inside = false;
+		if(inside)
+			preference += 1;
+	}
+	return preference;
+}
+
 void ObstaclePlacer::postProcess(const rmg::Object & object)
 {
+	{
+		auto type = getObstacleType(*object.instances().front()->object().appearance);
+		for(const auto & t : object.getArea().getTilesVector())
+			if(!placedTypes.empty() && map.isOnMap(t))
+				placedTypes[tileIndex(t)] = type;
+	}
+
 	//river processing
 	riverManager = zone.getModificator<RiverPlacer>();
 	if(riverManager)
