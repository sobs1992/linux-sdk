+	};
+
+	RmgValidator(RmgMap & map, vstd::RNG & rand);
+	~RmgValidator();
+
+	/// Analysis only
+	Report check();
+	/// Fix what can be fixed, then check again
+	Report checkAndFix();
+
+private:
+	enum ETile : uint8_t
+	{
+		BLOCKED, // objects, map edge water rocks: never opened
+		OPEN, // passable land
+		WATER, // sailable
+		VISIT, // entrance of a visitable object that stays on the map
+		OBSTACLE, // covered only by decorative obstacles: can be cleared
+		ROCK // impassable terrain (underground rock): can be repainted
+	};
+
+	using TPath = std::vector<int>;
+
+	int idx(const int3 & t) const;
+	int3 pos(int i) const;
+	bool onMap(int x, int y, int z) const;
+
+	void build();
+	std::vector<uint8_t> flood(const std::vector<int> & starts, const std::function<bool(int)> & allowed) const;
+	std::vector<int> startTiles() const;
