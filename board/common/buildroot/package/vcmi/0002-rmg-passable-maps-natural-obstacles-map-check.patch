+	TPath findWay(const std::vector<uint8_t> & sources, const std::vector<uint8_t> & targets, const std::function<bool(int)> & allowed, int maxCost, bool overWater = false) const;
+	/// Clears obstacles and rock along the way, plants the rest again
+	void openWay(const TPath & way, bool widen, Report & report, TerrainId bridgeTerrain = TerrainId(ETerrainId::NONE));
+	TerrainId landTerrain(TRmgTemplateZoneId zoneId) const;
+	/// Plants obstacles on the given tiles of the zone; returns what is left
+	rmg::Area plant(const rmg::Area & tiles, TRmgTemplateZoneId zoneId, Report & report);
+
+	void fixObjectsInWater(Report & report);
+	void fixIsolatedStarts(Report & report);
+	void fixObjectsOnRock(Report & report);
+	void fixCoveredEntrances(Report & report);
+	void fixUnreachableObjects(Report & report);
+	void fixPockets(Report & report);
+	void fixConnections(Report & report);
+	std::vector<int> groundOf(TRmgTemplateZoneId zoneId) const;
+	bool placeBoat(TRmgTemplateZoneId from, TRmgTemplateZoneId to, Report & report);
+	bool placePortals(const rmg::ZoneConnection & connection, Report & report);
+	void fixDeadEnds(Report & report);
+	std::vector<int> findDeadEnds() const;
+
+	Report analyse(bool fix);
+	bool checkConnection(const rmg::ZoneConnection & connection, std::vector<uint8_t> * fromA) const;
+	std::vector<rmg::ZoneConnection> realConnections() const;
+	bool zoneIgnored(TRmgTemplateZoneId zone) const;
+	bool isWaterObject(const CGObjectInstance * obj) const;
+
+	RmgMap & map;
+	CMap & cmap;
+	vstd::RNG & rand;
+	int W, H, L;
+
+	std::vector<uint8_t> tiles;
+	std::vector<uint8_t> transitBlocked;
+	std::vector<uint16_t> entryMask; // VISIT tiles: allowed directions, bit per neighbour
+	std::vector<int> obstacleCost;
+	std::map<int, std::vector<int>> teleports;
+	std::vector<int> waterComponent;
+	std::vector<std::vector<int>> waterTiles;
+	std::map<int, std::vector<int>> boarding; // land tile -> water components
+	std::vector<uint8_t> reached;
+	std::set<TRmgTemplateZoneId> unconnectedZones;
+};
