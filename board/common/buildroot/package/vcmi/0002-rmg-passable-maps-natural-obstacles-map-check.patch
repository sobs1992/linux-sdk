+/// Objects that are gone once visited (or fought, or passed with a key):
+/// they never close a way for good
+bool isRemovableType(MapObjectID id)
+{
+	switch(id.toEnum())
+	{
+		case Obj::MONSTER:
+		case Obj::RANDOM_MONSTER:
+		case Obj::RANDOM_MONSTER_L1:
+		case Obj::RANDOM_MONSTER_L2:
+		case Obj::RANDOM_MONSTER_L3:
+		case Obj::RANDOM_MONSTER_L4:
+		case Obj::RANDOM_MONSTER_L5:
+		case Obj::RANDOM_MONSTER_L6:
+		case Obj::RANDOM_MONSTER_L7:
+		case Obj::RESOURCE:
+		case Obj::RANDOM_RESOURCE:
+		case Obj::ARTIFACT:
+		case Obj::RANDOM_ART:
+		case Obj::RANDOM_TREASURE_ART:
+		case Obj::RANDOM_MINOR_ART:
+		case Obj::RANDOM_MAJOR_ART:
+		case Obj::RANDOM_RELIC_ART:
+		case Obj::TREASURE_CHEST:
+		case Obj::PANDORAS_BOX:
+		case Obj::CAMPFIRE:
+		case Obj::SCHOLAR:
+		case Obj::SPELL_SCROLL:
+		case Obj::PRISON:
+		case Obj::EVENT:
+		case Obj::GARRISON:
+		case Obj::GARRISON2:
+		case Obj::BORDER_GATE:
+		case Obj::BORDERGUARD:
+		case Obj::QUEST_GUARD:
+		case Obj::HERO:
+		case Obj::RANDOM_HERO:
+			return true;
+		default:
+			return false;
+	}
+}
+
+bool isRemovable(const CGObjectInstance * obj)
+{
+	return obj->removable || isRemovableType(obj->ID);
+}
+
+int directionBit(int dx, int dy)
+{
+	return (dy + 1) * 3 + (dx + 1);
+}
+
+/// Plants obstacles of the zone's biome on exactly the given tiles
+class Planter : public ObstacleProxy
+{
+public:
+	Planter(RmgMap & map, vstd::RNG & rand, const rmg::Area & tiles)
+		: map(map)
+		, rand(rand)
+		, allowed(tiles)
+	{
+		setBlockedArea(tiles);
+	}
+
+	bool isInTheMap(const int3 & tile) override
+	{
+		return map.isOnMap(tile);
+	}
+
+	bool isProhibited(const rmg::Area & objArea) const override
+	{
+		return !allowed.contains(objArea);
+	}
+
+	void placeObject(rmg::Object & object, std::set<std::shared_ptr<CGObjectInstance>> &) override
+	{
+		object.finalize(map, rand);
+		placed++;
+	}
+
+	const rmg::Area & leftover() const
+	{
+		return blockedArea;
+	}
+
+	int placed = 0;
+
+private:
+	RmgMap & map;
+	vstd::RNG & rand;
+	rmg::Area allowed;
+};
+
+}
+
+bool RmgValidator::Report::critical() const
+{
+	return isolatedPlayers > 0 || unreachableZones > 0 || brokenConnections > 0 || unreachableObjects > 0 || objectsInWater > 0;
+}
+
+std::string RmgValidator::Report::toString() const
+{
+	return boost::str(boost::format("isolated players %d, unreachable zones %d, broken connections %d, unreachable objects %d, "
+		"objects in water %d, sealed pockets %d (%d tiles), dead ends %d, unpaired gates %d; "
+		"fixes %d: removed obstacles %d, planted obstacles %d, cleared rock %d, land bridges %d")
+		% isolatedPlayers % unreachableZones % brokenConnections % unreachableObjects % objectsInWater % pockets % pocketTiles
+		% deadEnds % unpairedGates % fixes % removedObstacles % plantedObstacles % clearedRock % landBridges);
+}
+
+RmgValidator::RmgValidator(RmgMap & map, vstd::RNG & rand)
+	: map(map)
+	, cmap(*map.mapInstance)
+	, rand(rand)
+	, W(map.width())
+	, H(map.height())
+	, L(map.levels())
+{
+	// A zone the template connects to nothing is out of reach by design
+	// (unless a player starts there)
+	for(const auto & zone : map.getZones())
+	{
+		bool connected = false;
+		for(const auto & c : zone.second->getConnections())
+		{
+			auto type = c.getConnectionType();
+			if(c.getZoneA() != c.getZoneB() && type != rmg::EConnectionType::FICTIVE && type != rmg::EConnectionType::REPULSIVE)
+				connected = true;
+		}
+		if(!connected && map.getZones().size() > 1 && !zone.second->getOwner())
+			unconnectedZones.insert(zone.first);
+	}
+}
+
+RmgValidator::~RmgValidator() = default;
+
+int RmgValidator::idx(const int3 & t) const
+{
+	return (t.z * H + t.y) * W + t.x;
+}
+
+int3 RmgValidator::pos(int i) const
+{
+	return int3(i % W, (i / W) % H, i / (W * H));
+}
+
+bool RmgValidator::onMap(int x, int y, int z) const
+{
+	return x >= 0 && y >= 0 && z >= 0 && x < W && y < H && z < L;
+}
+
+bool RmgValidator::isWaterObject(const CGObjectInstance * obj) const
+{
+	return obj->appearance && obj->appearance->canBePlacedAt(ETerrainId::WATER);
+}
+
+bool RmgValidator::zoneIgnored(TRmgTemplateZoneId zoneId) const
+{
+	auto & zones = map.getZones();
+	auto it = zones.find(zoneId);
+	return it == zones.end() || it->second->getType() == ETemplateZoneType::SEALED || unconnectedZones.count(zoneId);
+}
+
+void RmgValidator::build()
+{
+	const int N = W * H * L;
+	tiles.assign(N, BLOCKED);
+	transitBlocked.assign(N, 0);
+	entryMask.assign(N, 0);
+	obstacleCost.assign(N, 0);
+	teleports.clear();
+	waterComponent.assign(N, -1);
+	waterTiles.clear();
+	boarding.clear();
+
+	for(int i = 0; i < N; i++)
+	{
+		const int3 t = pos(i);
+		const auto & tile = cmap.getTile(t);
+
+		if(tile.isWater())
+		{
+			bool obstacle = false;
+			for(const auto & id : tile.blockingObjects)
+			{
+				const auto * obj = cmap.getObject(id);
+				if(obj && !(obj->isVisitable() && obj->visitablePos() == t))
+					obstacle = true;
+			}
+			tiles[i] = obstacle ? BLOCKED : WATER;
+			continue;
+		}
+		if(!tile.getTerrain()->isPassable())
+		{
+			tiles[i] = tile.blocked() ? BLOCKED : ROCK;
+			continue;
+		}
+
+		ETile kind = OPEN;
+		bool onlyObstacles = true;
+		int obstacleSize = 0;
+		for(const auto & id : tile.blockingObjects)
+		{
+			const auto * obj = cmap.getObject(id);
+			if(!obj)
+				continue;
+			if(obj->isVisitable() && obj->visitablePos() == t)
+			{
+				// A guard or a pick-up: gone after the visit
+				if(!isRemovable(obj))
+					kind = VISIT;
+				continue;
+			}
+			if(obj->isVisitable() || !obj->getObjectHandler()->isStaticObject())
+				onlyObstacles = false;
+			else
+				obstacleSize += obj->getBlockedOffsets().size();
+			if(kind == OPEN)
+				kind = BLOCKED;
+		}
+		if(kind == BLOCKED && onlyObstacles)
+		{
+			kind = OBSTACLE;
+			// Prefer clearing small obstacles over big mountains
+			obstacleCost[i] = 6 + std::min(obstacleSize, 30) / 2;
+		}
+		if(kind == OPEN)
+		{
+			for(const auto & id : tile.visitableObjects)
+			{
+				const auto * obj = cmap.getObject(id);
+				if(obj && obj->visitablePos() == t && !isRemovable(obj))
+					kind = VISIT;
+			}
+		}
+		if(kind == VISIT)
+		{
+			for(const auto & id : tile.visitableObjects)
+			{
+				const auto * obj = cmap.getObject(id);
+				if(!obj || obj->visitablePos() != t)
+					continue;
+				if(obj->blockVisit && !isRemovable(obj))
+					transitBlocked[i] = 1;
+				for(int dy = -1; dy <= 1; dy++)
+					for(int dx = -1; dx <= 1; dx++)
+						if((dx || dy) && (!obj->appearance || obj->appearance->isVisitableFrom(dx, dy)))
+							entryMask[i] |= 1 << directionBit(dx, dy);
+			}
+		}
+		tiles[i] = kind;
+	}
+
+	// Monoliths, one-way monoliths and subterranean gates
+	std::map<std::pair<int, int>, std::vector<int>> twoWay;
+	std::map<int, std::vector<int>> entrances;
+	std::map<int, std::vector<int>> exits;
+	std::vector<int3> gates[2];
+	for(const auto & obj : cmap.objects)
+	{
+		if(!obj)
+			continue;
+		const int3 v = obj->visitablePos();
+		if(!cmap.isInTheMap(v))
+			continue;
+		if(obj->ID == Obj::MONOLITH_TWO_WAY || obj->ID == Obj::WHIRLPOOL)
+			twoWay[{obj->ID.getNum(), obj->subID}].push_back(idx(v));
+		else if(obj->ID == Obj::MONOLITH_ONE_WAY_ENTRANCE)
+			entrances[obj->subID].push_back(idx(v));
+		else if(obj->ID == Obj::MONOLITH_ONE_WAY_EXIT)
+			exits[obj->subID].push_back(idx(v));
+		else if(obj->ID == Obj::SUBTERRANEAN_GATE && v.z < 2)
+			gates[v.z].push_back(v);
+	}
+	for(const auto & group : twoWay)
+		for(int a : group.second)
+			for(int b : group.second)
+				if(a != b)
+					teleports[a].push_back(b);
+	for(const auto & group : entrances)
+		for(int a : group.second)
+			for(int b : exits[group.first])
+				teleports[a].push_back(b);
+	// The game pairs every gate with the nearest one on the other level
+	for(int level = 0; level < 2; level++)
+	{
+		for(const auto & a : gates[level])
+		{
+			int3 best(-1, -1, -1);
+			for(const auto & b : gates[1 - level])
+				if(!best.isValid() || a.dist2dSQ(b) < a.dist2dSQ(best))
+					best = b;
+			if(best.isValid())
+				teleports[idx(a)].push_back(idx(best));
+		}
+	}
+
+	// Seas, and where a hero gets a boat for them: a boat at the shore or a shipyard
+	for(int i = 0; i < N; i++)
+	{
+		if(tiles[i] != WATER || waterComponent[i] >= 0)
+			continue;
+		const int component = waterTiles.size();
+		waterTiles.emplace_back();
+		std::vector<int> queue{i};
+		waterComponent[i] = component;
+		while(!queue.empty())
+		{
+			const int c = queue.back();
+			queue.pop_back();
+			waterTiles[component].push_back(c);
+			const int3 p = pos(c);
+			for(int dy = -1; dy <= 1; dy++)
+				for(int dx = -1; dx <= 1; dx++)
+				{
+					if(!onMap(p.x + dx, p.y + dy, p.z))
+						continue;
+					const int n = idx(int3(p.x + dx, p.y + dy, p.z));
+					if(tiles[n] == WATER && waterComponent[n] < 0)
+					{
+						waterComponent[n] = component;
+						queue.push_back(n);
+					}
+				}
+		}
+	}
+	for(const auto & obj : cmap.objects)
+	{
+		if(!obj || (obj->ID != Obj::BOAT && obj->ID != Obj::SHIPYARD))
+			continue;
+		const int3 v = obj->visitablePos();
+		std::set<int3> around;
+		if(obj->ID == Obj::BOAT)
+		{
+			if(waterComponent[idx(v)] < 0)
+				continue;
+			for(int dy = -1; dy <= 1; dy++)
+				for(int dx = -1; dx <= 1; dx++)
+					if(onMap(v.x + dx, v.y + dy, v.z))
+						boarding[idx(int3(v.x + dx, v.y + dy, v.z))].push_back(waterComponent[idx(v)]);
+		}
+		else
+		{
+			for(const auto & b : obj->getBlockedPos())
+				for(int dy = -1; dy <= 1; dy++)
+					for(int dx = -1; dx <= 1; dx++)
+						if(onMap(b.x + dx, b.y + dy, b.z) && waterComponent[idx(int3(b.x + dx, b.y + dy, b.z))] >= 0)
+							boarding[idx(v)].push_back(waterComponent[idx(int3(b.x + dx, b.y + dy, b.z))]);
+		}
+	}
+}
+
+bool RmgValidator::canEnter(int from, int to) const
+{
+	if(tiles[to] != VISIT)
+		return true;
+	const int3 f = pos(from);
+	const int3 t = pos(to);
+	return entryMask[to] & (1 << directionBit(f.x - t.x, f.y - t.y));
+}
+
+bool RmgValidator::canLeave(int from) const
+{
+	return tiles[from] != VISIT || !transitBlocked[from];
+}
+
+std::vector<uint8_t> RmgValidator::flood(const std::vector<int> & starts, const std::function<bool(int)> & allowed) const
+{
+	std::vector<uint8_t> seen(tiles.size(), 0);
+	std::vector<uint8_t> isStart(tiles.size(), 0);
+	std::set<int> usedSeas;
+	std::deque<int> queue;
+	auto push = [&](int t)
+	{
+		if(!seen[t] && allowed(t))
+		{
+			seen[t] = 1;
+			queue.push_back(t);
+		}
+	};
+	for(int s : starts)
+	{
+		isStart[s] = 1;
+		push(s);
+	}
+	while(!queue.empty())
+	{
+		const int c = queue.front();
+		queue.pop_front();
+
+		auto tp = teleports.find(c);
+		if(tp != teleports.end())
+			for(int d : tp->second)
+				push(d);
+		auto boat = boarding.find(c);
+		if(boat != boarding.end())
+			for(int sea : boat->second)
+				if(usedSeas.insert(sea).second)
+					for(int t : waterTiles[sea])
+						push(t);
+
+		if(!isStart[c] && tp == teleports.end() && !canLeave(c))
+			continue;
+
+		const int3 p = pos(c);
+		for(int dy = -1; dy <= 1; dy++)
+			for(int dx = -1; dx <= 1; dx++)
+			{
+				if((!dx && !dy) || !onMap(p.x + dx, p.y + dy, p.z))
+					continue;
+				const int n = idx(int3(p.x + dx, p.y + dy, p.z));
+				switch(tiles[n])
+				{
+					case OPEN:
+						push(n);
+						break;
+					case WATER:
+						if(tiles[c] == WATER)
+							push(n);
+						break;
+					case VISIT:
+						if(canEnter(c, n))
+							push(n);
+						break;
+					default:
+						break;
+				}
+			}
+	}
+	return seen;
+}
+
+std::vector<uint8_t> RmgValidator::reachAll() const
+{
+	// What any player can reach. Players that cannot reach each other are
+	// checked on their own (Report::isolatedPlayers)
+	return flood(startTiles(), [](int) { return true; });
+}
+
+std::vector<int> RmgValidator::startTiles() const
+{
+	std::vector<int> result;
+	for(const auto & player : cmap.players)
+	{
+		if(!player.hasMainTown)
+			continue;
+		// posOfMainTown is not the gate: take the town object nearest to it
+		const CGObjectInstance * town = nullptr;
+		for(const auto & obj : cmap.objects)
+		{
+			if(!obj || obj->ID != Obj::TOWN || obj->anchorPos().z != player.posOfMainTown.z)
+				continue;
+			if(!town || obj->anchorPos().dist2dSQ(player.posOfMainTown) < town->anchorPos().dist2dSQ(player.posOfMainTown))
+				town = obj.get();
+		}
+		if(town)
+			result.push_back(idx(town->visitablePos()));
+	}
+	if(result.empty())
+	{
+		for(const auto & zone : map.getZones())
+		{
+			if(zone.second->getType() == ETemplateZoneType::WATER || zoneIgnored(zone.first))
+				continue;
+			for(const auto & t : zone.second->freePaths()->getTilesVector())
+			{
+				if(tiles[idx(t)] == OPEN)
+				{
+					result.push_back(idx(t));
+					break;
+				}
+			}
+			if(!result.empty())
+				break;
+		}
+	}
+	return result;
+}
+
+RmgValidator::TPath RmgValidator::findWay(const std::vector<uint8_t> & sources, const std::vector<uint8_t> & targets, const std::function<bool(int)> & allowed, int maxCost, bool overWater) const
+{
+	const int N = tiles.size();
+	std::vector<int> cost(N, std::numeric_limits<int>::max());
+	std::vector<int> from(N, -1);
+	using Node = std::pair<int, int>;
+	std::priority_queue<Node, std::vector<Node>, std::greater<>> queue;
+
+	for(int i = 0; i < N; i++)
+	{
+		if(sources[i] && canLeave(i))
+		{
+			cost[i] = 0;
+			queue.emplace(0, i);
+		}
+	}
+
+	while(!queue.empty())
+	{
+		auto [c, t] = queue.top();
+		queue.pop();
+		if(c != cost[t])
+			continue;
+		if(targets[t] && !sources[t])
+		{
+			TPath way;
+			for(int i = t; i >= 0 && !sources[i]; i = from[i])
+				way.push_back(i);
+			std::reverse(way.begin(), way.end());
+			return way;
+		}
+		if(!sources[t] && !canLeave(t))
+			continue;
+
+		const int3 p = pos(t);
+		for(int dy = -1; dy <= 1; dy++)
+			for(int dx = -1; dx <= 1; dx++)
+			{
+				if((!dx && !dy) || !onMap(p.x + dx, p.y + dy, p.z))
+					continue;
+				const int n = idx(int3(p.x + dx, p.y + dy, p.z));
+				if(!allowed(n))
+					continue;
+				int step;
+				switch(tiles[n])
+				{
+					case OPEN:
+						step = 1;
+						break;
+					case VISIT:
+						if(!canEnter(t, n))
+							continue;
+						step = 1;
+						break;
+					case OBSTACLE:
+						step = obstacleCost[n];
+						break;
+					case ROCK:
+						step = 10;
+						break;
+					case WATER:
+						// A land bridge: only when nothing else helps
+						if(!overWater)
+							continue;
+						step = 25;
+						break;
+					default:
+						continue;
+				}
+				// Do not cut corners of obstacles: diagonal steps cost a little more
+				if(dx && dy)
+					step += 1;
+				const int newCost = c + step;
+				if(newCost < cost[n] && newCost <= maxCost)
+				{
+					cost[n] = newCost;
+					from[n] = t;
+					queue.emplace(newCost, n);
+				}
+			}
+	}
+	return {};
+}
+
+TerrainId RmgValidator::landTerrain(TRmgTemplateZoneId zoneId) const
+{
+	const auto & zone = map.getZones().at(zoneId);
+	TerrainId terrain = zone->getTerrainType();
+	const auto * type = LIBRARY->terrainTypeHandler->getById(terrain);
+	if(zone->getType() == ETemplateZoneType::WATER || type->isWater() || !type->isPassable())
+		return zone->isUnderground() ? TerrainId(ETerrainId::SUBTERRANEAN) : TerrainId(ETerrainId::DIRT);
+	return terrain;
+}
+
+rmg::Area RmgValidator::plant(const rmg::Area & area, TRmgTemplateZoneId zoneId, Report & report)
+{
+	if(area.empty())
+		return area;
+	auto & zone = *map.getZones().at(zoneId);
+	const auto * faction = zone.getTownType().toFaction();
+
+	Planter planter(map, rand, area);
+	ObstacleSetFilter filter(ObstacleSet::EObstacleType::INVALID,
+		zone.getTerrainType(),
+		static_cast<EMapLevel>(zone.isUnderground()),
+		faction->getId(),
+		faction->alignment);
+	if(!planter.prepareBiome(filter, rand))
+		planter.collectPossibleObstacles(zone.getTerrainType());
+	planter.createObstacles(rand, cmap.cb);
+	report.plantedObstacles += planter.placed;
+	return planter.leftover();
+}
+
+void RmgValidator::openWay(const TPath & way, bool widen, Report & report, TerrainId bridgeTerrain)
+{
+	std::set<CGObjectInstance *> toRemove;
+	std::vector<int3> bridge;
+	std::set<int> keep(way.begin(), way.end());
+	std::map<TRmgTemplateZoneId, std::vector<int3>> rock;
+
+	if(widen)
+	{
+		// A passage of 2-3 tiles, not a slit
+		for(int t : way)
+		{
+			const int3 p = pos(t);
+			const int3 sides[] = {int3(1, 0, 0), int3(-1, 0, 0), int3(0, 1, 0), int3(0, -1, 0)};
+			for(const auto & d : sides)
+			{
+				const int3 n = p + d;
+				if(onMap(n.x, n.y, n.z) && map.getZoneID(n) == map.getZoneID(p) && (tiles[idx(n)] == OBSTACLE || tiles[idx(n)] == ROCK))
+					keep.insert(idx(n));
+			}
+		}
+	}
+
+	for(int t : keep)
+	{
+		const int3 p = pos(t);
+		if(tiles[t] == OBSTACLE)
+		{
+			for(const auto & id : cmap.getTile(p).blockingObjects)
+				if(auto * obj = cmap.getObject(id))
+					toRemove.insert(obj);
+		}
+		else if(tiles[t] == ROCK)
+			rock[map.getZoneID(p)].push_back(p);
+		else if(tiles[t] == WATER && bridgeTerrain != ETerrainId::NONE)
+			bridge.push_back(p);
+	}
+	if(!bridge.empty())
+	{
+		map.getMapProxy()->drawTerrain(rand, bridge, bridgeTerrain);
+		report.landBridges += bridge.size();
+	}
+
+	std::map<TRmgTemplateZoneId, rmg::Area> freed;
+	for(auto * obj : toRemove)
+	{
+		for(const auto & t : obj->getBlockedPos())
+			if(map.isOnMap(t) && !keep.count(idx(t)))
+				freed[map.getZoneID(t)].add(t);
+		map.getMapProxy()->removeObject(obj);
+		report.removedObstacles++;
+	}
+
+	for(auto & zoneRock : rock)
+	{
+		map.getMapProxy()->drawTerrain(rand, zoneRock.second, landTerrain(zoneRock.first));
+		report.clearedRock += zoneRock.second.size();
+	}
+
+	// Cleared ground around the passage gets obstacles again: the landscape
+	// keeps its look, only the way through is new
+	for(auto & zoneFreed : freed)
+	{
+		zoneFreed.second.erase_if([this](const int3 & t)
+		{
+			const auto & tile = cmap.getTile(t);
+			return tile.blocked() || tile.visitable() || !tile.getTerrain()->isPassable() || tile.isWater();
+		});
+		plant(zoneFreed.second, zoneFreed.first, report);
+	}
+
+	report.fixes++;
+	build();
+}
+
+void RmgValidator::fixObjectsInWater(Report & report)
+{
+	std::map<TerrainId, std::vector<int3>> toPaint;
+	for(const auto & obj : cmap.objects)
+	{
+		if(!obj || !obj->isVisitable() || isWaterObject(obj.get()))
+			continue;
+		const int3 v = obj->visitablePos();
+		if(!cmap.isInTheMap(v) || !cmap.getTile(v).isWater())
+			continue;
+
+		// Land of the object's own tiles, or the zone's
+		TerrainId terrain = ETerrainId::NONE;
+		for(const auto & t : obj->getBlockedPos())
+			if(cmap.isInTheMap(t) && cmap.getTile(t).isLand() && cmap.getTile(t).getTerrain()->isPassable())
+				terrain = cmap.getTile(t).getTerrainID();
+		if(terrain == ETerrainId::NONE)
+		{
+			auto & zone = map.getZones().at(map.getZoneID(v));
+			terrain = zone->getType() == ETemplateZoneType::WATER ? TerrainId(ETerrainId::DIRT) : zone->getTerrainType();
+		}
+		if(!LIBRARY->terrainTypeHandler->getById(terrain)->isPassable())
+			terrain = ETerrainId::DIRT;
+
+		// The entrance and the tiles in front of it
+		auto & tilesToPaint = toPaint[terrain];
+		tilesToPaint.push_back(v);
+		for(int dy = 0; dy <= 1; dy++)
+			for(int dx = -1; dx <= 1; dx++)
+			{
+				const int3 n(v.x + dx, v.y + dy, v.z);
+				if(cmap.isInTheMap(n) && cmap.getTile(n).isWater() && !cmap.getTile(n).visitable() && !cmap.getTile(n).blocked()
+					&& obj->appearance->isVisitableFrom(dx, dy))
+					tilesToPaint.push_back(n);
+			}
+		logGlobal->warn("RMG validator: %s at %s stands in water, putting land under it", obj->getObjectName(), v.toString());
+	}
+	for(auto & paint : toPaint)
+	{
+		map.getMapProxy()->drawTerrain(rand, paint.second, paint.first);
+		report.fixes++;
+	}
+	if(!toPaint.empty())
+		build();
+}
+
+void RmgValidator::fixIsolatedStarts(Report & report)
+{
+	for(int attempt = 0; attempt < 16; attempt++)
+	{
+		auto starts = startTiles();
+		if(starts.size() < 2)
+			return;
+		std::vector<std::vector<uint8_t>> seen;
+		size_t best = 0;
+		std::vector<int> count;
+		for(int s : starts)
+		{
+			seen.push_back(flood({s}, [](int) { return true; }));
+			count.push_back(std::count(seen.back().begin(), seen.back().end(), 1));
+			if(count.back() > count[best])
+				best = count.size() - 1;
+		}
+
+		// A town whose own surroundings are sealed: join them to the rest of its zone
+		bool changed = false;
+		for(size_t i = 0; i < starts.size() && !changed; i++)
+		{
+			if(seen[i][starts[best]])
+				continue;
+			const auto zoneId = map.getZoneID(pos(starts[i]));
+			std::vector<uint8_t> sources(tiles.size(), 0);
+			std::vector<uint8_t> targets(tiles.size(), 0);
+			bool anyTarget = false;
+			for(size_t t = 0; t < tiles.size(); t++)
+			{
+				if(map.getZoneID(pos(t)) != zoneId || tiles[t] == WATER)
+					continue;
+				if(seen[i][t])
+					sources[t] = 1;
+				else if(seen[best][t])
+				{
+					targets[t] = 1;
+					anyTarget = true;
+				}
+			}
+			if(!anyTarget)
+			{
+				// Nobody reaches the zone: aim at the rest of it, its connections lead on
+				for(size_t t = 0; t < tiles.size(); t++)
+					if(map.getZoneID(pos(t)) == zoneId && tiles[t] == OPEN && !seen[i][t])
+						targets[t] = 1;
+			}
+			auto way = findWay(sources, targets, [this, zoneId](int t)
+			{
+				return map.getZoneID(pos(t)) == zoneId || tiles[t] == WATER;
+			}, 400, true);
+			if(way.empty())
+			{
+				logGlobal->warn("RMG validator: the town at %s is sealed off, no way out", pos(starts[i]).toString());
+				continue;
+			}
+			logGlobal->info("RMG validator: the town at %s is sealed off, opening a way out", pos(starts[i]).toString());
+			openWay(way, true, report, landTerrain(zoneId));
+			changed = true;
+		}
+		if(!changed)
+			return;
+	}
+}
+
+void RmgValidator::fixObjectsOnRock(Report & report)
+{
+	// Underground rock painted under an object: the object gets ground again
+	std::map<TRmgTemplateZoneId, std::vector<int3>> toPaint;
+	for(const auto & obj : cmap.objects)
+	{
+		if(!obj || !obj->isVisitable() || !cmap.isInTheMap(obj->visitablePos()))
+			continue;
+		auto objectTiles = obj->getBlockedPos();
+		objectTiles.insert(obj->visitablePos());
+		bool onRock = false;
+		for(const auto & t : objectTiles)
+			if(cmap.isInTheMap(t) && !cmap.getTile(t).isWater() && !cmap.getTile(t).getTerrain()->isPassable())
+				onRock = true;
+		if(!onRock)
+			continue;
+		logGlobal->warn("RMG validator: %s at %s stands on rock", obj->getObjectName(), obj->visitablePos().toString());
+		for(const auto & t : objectTiles)
+			if(cmap.isInTheMap(t) && !cmap.getTile(t).isWater() && !cmap.getTile(t).getTerrain()->isPassable())
+				toPaint[map.getZoneID(t)].push_back(t);
+	}
+	for(auto & paint : toPaint)
+	{
+		map.getMapProxy()->drawTerrain(rand, paint.second, landTerrain(paint.first));
+		report.clearedRock += paint.second.size();
+		report.fixes++;
+	}
+	if(!toPaint.empty())
+		build();
+}
+
+void RmgValidator::fixCoveredEntrances(Report & report)
+{
+	// An obstacle placed over the entrance of an object (a guard standing
+	// in a rock): the obstacle goes
+	TPath covered;
+	for(const auto & obj : cmap.objects)
+	{
+		if(!obj || !obj->isVisitable() || !cmap.isInTheMap(obj->visitablePos()))
+			continue;
+		const int3 v = obj->visitablePos();
+		for(const auto & id : cmap.getTile(v).blockingObjects)
+		{
+			const auto * other = cmap.getObject(id);
+			if(other && other != obj.get() && !other->isVisitable() && other->getObjectHandler()->isStaticObject())
+			{
+				logGlobal->warn("RMG validator: %s at %s is covered by an obstacle", obj->getObjectName(), v.toString());
+				covered.push_back(idx(v));
+				break;
+			}
+		}
+	}
+	for(int t : covered)
+	{
+		// openWay() clears obstacles on OBSTACLE tiles: the entrance is one, but for the object on it
+		tiles[t] = OBSTACLE;
+		openWay({t}, false, report);
+	}
+}
+
+void RmgValidator::fixUnreachableObjects(Report & report)
+{
+	std::set<const CGObjectInstance *> failed;
+	std::set<TRmgTemplateZoneId> lostZones;
+	reached = reachAll();
+	for(int attempt = 0; attempt < 1000; attempt++)
+	{
+		const CGObjectInstance * target = nullptr;
+		for(const auto & obj : cmap.objects)
+		{
+			if(!obj || !obj->isVisitable() || failed.count(obj.get()))
+				continue;
+			const int3 v = obj->visitablePos();
+			if(!cmap.isInTheMap(v) || cmap.getTile(v).isWater() || zoneIgnored(map.getZoneID(v)) || lostZones.count(map.getZoneID(v)))
+				continue;
+			if(!reached[idx(v)])
+			{
+				target = obj.get();
+				break;
+			}
+		}
+		if(!target)
+			return;
+
+		const int3 v = target->visitablePos();
+		const auto zoneId = map.getZoneID(v);
+		// Land in a water zone (islands, coast) has no guards to bypass: any
+		// reached ground may lead there
+		const bool waterZone = map.getZones().at(zoneId)->getType() == ETemplateZoneType::WATER;
+		std::vector<uint8_t> sources(tiles.size(), 0);
+		bool anySource = false;
+		for(size_t i = 0; i < tiles.size(); i++)
+		{
+			if(reached[i] && (waterZone || map.getZoneID(pos(i)) == zoneId) && tiles[i] != WATER)
+			{
+				sources[i] = 1;
+				anySource = true;
+			}
+		}
+		if(!anySource)
+		{
+			// The whole zone is cut off: a matter of its connections
+			lostZones.insert(zoneId);
+			continue;
+		}
+		std::vector<uint8_t> targets(tiles.size(), 0);
+		targets[idx(v)] = 1;
+
+		// Inside the zone only: a new way across a zone border would bypass its guards
+		auto way = findWay(sources, targets, [this, zoneId](int t)
+		{
+			return map.getZoneID(pos(t)) == zoneId || tiles[t] == WATER;
+		}, 400, true);
+		if(way.empty())
+		{
+			logGlobal->warn("RMG validator: no way to %s at %s (zone %d, tile %d)", target->getObjectName(), v.toString(), zoneId, static_cast<int>(tiles[idx(v)]));
+			failed.insert(target);
+			continue;
+		}
+		logGlobal->info("RMG validator: opening a way to %s at %s (%d tiles)", target->getObjectName(), v.toString(), way.size());
+		openWay(way, true, report, landTerrain(zoneId));
+		reached = reachAll();
+		if(!reached[idx(v)])
+		{
+			// Should not happen; do not try forever
+			logGlobal->warn("RMG validator: opened a way to %s at %s, still out of reach", target->getObjectName(), v.toString());
+			failed.insert(target);
+		}
+	}
+}
+
+void RmgValidator::fixPockets(Report & report)
+{
+	std::set<int> failed;
+	for(int attempt = 0; attempt < 500; attempt++)
+	{
+		reached = reachAll();
+
+		// First pocket not handled yet
+		std::vector<int> pocket;
+		std::vector<uint8_t> inPocket(tiles.size(), 0);
+		for(size_t i = 0; i < tiles.size() && pocket.empty(); i++)
+		{
+			if(tiles[i] != OPEN || reached[i] || failed.count(i) || zoneIgnored(map.getZoneID(pos(i))))
+				continue;
+			std::vector<int> queue{static_cast<int>(i)};
+			inPocket[i] = 1;
+			while(!queue.empty())
+			{
+				const int c = queue.back();
+				queue.pop_back();
+				pocket.push_back(c);
+				const int3 p = pos(c);
+				for(int dy = -1; dy <= 1; dy++)
+					for(int dx = -1; dx <= 1; dx++)
+					{
+						if(!onMap(p.x + dx, p.y + dy, p.z))
+							continue;
+						const int n = idx(int3(p.x + dx, p.y + dy, p.z));
+						if(tiles[n] == OPEN && !reached[n] && !inPocket[n])
+						{
+							inPocket[n] = 1;
+							queue.push_back(n);
+						}
+					}
+			}
+		}
+		if(pocket.empty())
+			return;
+		if(pocket.size() > 150)
+		{
+			// Not a pocket but a lost part of the map: a matter of connections
+			for(int t : pocket)
+				failed.insert(t);
+			logGlobal->warn("RMG validator: an area of %d tiles at %s cannot be reached", pocket.size(), pos(pocket.front()).toString());
+			continue;
+		}
+
+		const auto zoneId = map.getZoneID(pos(pocket.front()));
+		auto & zone = *map.getZones().at(zoneId);
+
+		// Big pockets are worth walking into
+		if(pocket.size() >= 9)
+		{
+			std::vector<uint8_t> sources(tiles.size(), 0);
+			for(size_t i = 0; i < tiles.size(); i++)
+				if(reached[i] && tiles[i] != WATER && map.getZoneID(pos(i)) == zoneId)
+					sources[i] = 1;
+			auto way = findWay(sources, inPocket, [this, zoneId](int t)
+			{
+				return map.getZoneID(pos(t)) == zoneId;
+			}, 60);
+			if(!way.empty())
+			{
+				logGlobal->info("RMG validator: opening a sealed area of %d tiles at %s", pocket.size(), pos(pocket.front()).toString());
+				openWay(way, true, report);
+				continue;
+			}
+		}
+
+		rmg::Area area;
+		for(int t : pocket)
+			area.add(pos(t));
+
+		// Obstacles, also underground: painting rock would change the terrain
+		// of the tiles around too, objects included
+		auto left = plant(area, zoneId, report);
+		report.fixes++;
+		build();
+		if(!left.empty())
+		{
+			// Tiles no obstacle fits: join them to the land around, if it is cheap
+			std::vector<uint8_t> sources(tiles.size(), 0);
+			std::vector<uint8_t> targets(tiles.size(), 0);
+			for(size_t i = 0; i < tiles.size(); i++)
+				if(reached[i] && tiles[i] != WATER && map.getZoneID(pos(i)) == zoneId)
+					sources[i] = 1;
+			for(const auto & t : left.getTilesVector())
+				targets[idx(t)] = 1;
+			auto way = findWay(sources, targets, [this, zoneId](int t)
+			{
+				return map.getZoneID(pos(t)) == zoneId;
+			}, 30);
+			if(!way.empty())
+				openWay(way, false, report);
+			else
+				for(const auto & t : left.getTilesVector())
+					failed.insert(idx(t));
+		}
+	}
+}
+
+std::vector<rmg::ZoneConnection> RmgValidator::realConnections() const
+{
+	std::vector<rmg::ZoneConnection> result;
+	std::set<int> seen;
+	for(const auto & zone : map.getZones())
+	{
+		for(const auto & connection : zone.second->getConnections())
+		{
+			auto type = connection.getConnectionType();
+			if(type == rmg::EConnectionType::FICTIVE || type == rmg::EConnectionType::REPULSIVE)
+				continue;
+			if(connection.getZoneA() == connection.getZoneB())
+				continue;
+			if(!map.getZones().count(connection.getZoneA()) || !map.getZones().count(connection.getZoneB()))
+				continue;
+			if(zoneIgnored(connection.getZoneA()) || zoneIgnored(connection.getZoneB()))
+				continue;
+			if(seen.insert(connection.getId()).second)
+				result.push_back(connection);
+		}
+	}
+	return result;
+}
+
+bool RmgValidator::checkConnection(const rmg::ZoneConnection & connection, std::vector<uint8_t> * fromA) const
+{
+	const auto a = connection.getZoneA();
+	const auto b = connection.getZoneB();
+	std::vector<int> starts;
+	for(size_t i = 0; i < tiles.size(); i++)
+		if(reached[i] && tiles[i] != WATER && map.getZoneID(pos(i)) == a)
+			starts.push_back(i);
+	if(starts.empty())
+		return false;
+
+	// Only through the two zones (and the sea, for connections by boat)
+	auto seen = flood(starts, [this, a, b](int t)
+	{
+		auto zone = map.getZoneID(pos(t));
+		return zone == a || zone == b || tiles[t] == WATER;
+	});
+	bool ok = false;
+	for(size_t i = 0; i < tiles.size() && !ok; i++)
+		if(seen[i] && tiles[i] != WATER && map.getZoneID(pos(i)) == b)
+			ok = true;
+	if(fromA)
+		*fromA = std::move(seen);
+	return ok;
+}
+
+std::vector<int> RmgValidator::groundOf(TRmgTemplateZoneId zoneId) const
+{
+	// Where the players walk in the zone; if nobody gets there yet, its own paths
+	std::vector<int> result;
+	for(size_t i = 0; i < tiles.size(); i++)
+		if(reached[i] && tiles[i] == OPEN && map.getZoneID(pos(i)) == zoneId)
+			result.push_back(i);
+	if(result.empty())
+	{
+		for(const auto & t : map.getZones().at(zoneId)->freePaths()->getTilesVector())
+			if(tiles[idx(t)] == OPEN)
+				result.push_back(idx(t));
+	}
+	return result;
+}
+
+bool RmgValidator::placeBoat(TRmgTemplateZoneId from, TRmgTemplateZoneId to, Report & report)
+{
+	// A sea touching the ground of both zones; the boat waits at the shore of the first
+	std::vector<uint8_t> isGround(tiles.size(), 0);
+	for(int t : groundOf(from))
+		isGround[t] = 1;
+	std::set<int> seasOfTo;
+	for(int t : groundOf(to))
+	{
+		const int3 p = pos(t);
+		for(int dy = -1; dy <= 1; dy++)
+			for(int dx = -1; dx <= 1; dx++)
+				if(onMap(p.x + dx, p.y + dy, p.z) && waterComponent[idx(int3(p.x + dx, p.y + dy, p.z))] >= 0)
+					seasOfTo.insert(waterComponent[idx(int3(p.x + dx, p.y + dy, p.z))]);
+	}
+	if(seasOfTo.empty())
+		return false;
+
+	std::vector<MapObjectSubID> sailing;
+	for(auto sub : LIBRARY->objtypeh->knownSubObjects(Obj::BOAT))
+	{
+		auto test = LIBRARY->objtypeh->getHandlerFor(Obj::BOAT, sub)->create(cmap.cb, nullptr);
+		if(auto * boat = dynamic_cast<CGBoat *>(test.get()))
+			if(boat->layer == EPathfindingLayer::SAIL)
+				sailing.push_back(sub);
+	}
+	if(sailing.empty())
+		return false;
+
+	for(size_t w = 0; w < tiles.size(); w++)
+	{
+		if(tiles[w] != WATER || !seasOfTo.count(waterComponent[w]) || cmap.getTile(pos(w)).visitable())
+			continue;
+		const int3 p = pos(w);
+		bool shore = false;
+		for(int dy = -1; dy <= 1 && !shore; dy++)
+			for(int dx = -1; dx <= 1 && !shore; dx++)
+				if(onMap(p.x + dx, p.y + dy, p.z) && isGround[idx(int3(p.x + dx, p.y + dy, p.z))])
+					shore = true;
+		if(!shore)
+			continue;
+
+		auto boat = LIBRARY->objtypeh->getHandlerFor(Obj::BOAT, *RandomGeneratorUtil::nextItem(sailing, rand))->create(cmap.cb, nullptr);
+		rmg::Object object(boat);
+		object.setTemplate(ETerrainId::WATER, rand);
+		object.setPosition(p);
+		object.setPosition(p + (p - object.getVisitablePosition()));
+		bool fits = object.getVisitablePosition() == p;
+		for(const auto & t : object.getArea().getTilesVector())
+			if(!map.isOnMap(t) || tiles[idx(t)] != WATER || cmap.getTile(t).visitable())
+				fits = false;
+		if(!fits)
+		{
+			object.clear();
+			continue;
+		}
+		object.finalize(map, rand);
+		logGlobal->info("RMG validator: a boat at %s for the way from zone %d to zone %d", p.toString(), from, to);
+		report.fixes++;
+		build();
+		return true;
+	}
+	return false;
+}
+
+bool RmgValidator::placePortals(const rmg::ZoneConnection & connection, Report & report)
+{
+	// A pair of monoliths of a kind not used on the map yet
+	std::set<MapObjectSubID> used;
+	for(const auto & obj : cmap.objects)
+		if(obj && obj->ID == Obj::MONOLITH_TWO_WAY)
+			used.insert(obj->subID);
+	std::optional<MapObjectSubID> kind;
+	for(auto sub : LIBRARY->objtypeh->knownSubObjects(Obj::MONOLITH_TWO_WAY))
+	{
+		auto handler = LIBRARY->objtypeh->getHandlerFor(Obj::MONOLITH_TWO_WAY, sub);
+		if(!used.count(sub)
+			&& !handler->getTemplates(landTerrain(connection.getZoneA())).empty()
+			&& !handler->getTemplates(landTerrain(connection.getZoneB())).empty())
+		{
+			kind = sub;
+			break;
+		}
+	}
+	if(!kind)
+		return false;
+
+	struct Spot
+	{
+		std::shared_ptr<rmg::Object> object;
+		int3 approach;
+		bool ownApproach;
+	};
+
+	// In each zone: a monolith in place of obstacles, entered from a tile
+	// of its own (which gets the guard) next to the ground of the zone
+	auto findSpot = [&](TRmgTemplateZoneId zoneId) -> std::optional<Spot>
+	{
+		auto & zone = *map.getZones().at(zoneId);
+		std::vector<uint8_t> isGround(tiles.size(), 0);
+		for(int t : groundOf(zoneId))
+			isGround[t] = 1;
+		// As far as possible from towns and other objects, like the generator's own monoliths
+		std::vector<int> distance(tiles.size(), -1);
+		std::deque<int> queue;
+		for(const auto & obj : cmap.objects)
+		{
+			if(obj && obj->isVisitable() && cmap.isInTheMap(obj->visitablePos()))
+			{
+				distance[idx(obj->visitablePos())] = 0;
+				queue.push_back(idx(obj->visitablePos()));
+			}
+		}
+		while(!queue.empty())
+		{
+			const int c = queue.front();
+			queue.pop_front();
+			const int3 p = pos(c);
+			for(int dy = -1; dy <= 1; dy++)
+				for(int dx = -1; dx <= 1; dx++)
+				{
+					if(!onMap(p.x + dx, p.y + dy, p.z))
+						continue;
+					const int n = idx(int3(p.x + dx, p.y + dy, p.z));
+					if(distance[n] < 0)
+					{
+						distance[n] = distance[c] + 1;
+						queue.push_back(n);
+					}
+				}
+		}
+		auto candidates = zone.area()->getTilesVector();
+		std::stable_sort(candidates.begin(), candidates.end(), [&](const int3 & a, const int3 & b)
+		{
+			return distance[idx(a)] > distance[idx(b)];
+		});
+		auto clearable = [&](const int3 & t)
+		{
+			return map.isOnMap(t) && map.getZoneID(t) == zoneId && (tiles[idx(t)] == OBSTACLE || tiles[idx(t)] == ROCK);
+		};
+		auto touchesGround = [&](const int3 & t, const rmg::Area & except)
+		{
+			for(int dy = -1; dy <= 1; dy++)
+				for(int dx = -1; dx <= 1; dx++)
+				{
+					const int3 n(t.x + dx, t.y + dy, t.z);
+					if(onMap(n.x, n.y, n.z) && isGround[idx(n)] && !except.contains(n))
+						return true;
+				}
+			return false;
+		};
+
+		for(const auto & v : candidates)
+		{
+			if(!clearable(v))
+				continue;
+			auto monolith = LIBRARY->objtypeh->getHandlerFor(Obj::MONOLITH_TWO_WAY, *kind)->create(cmap.cb, nullptr);
+			auto object = std::make_shared<rmg::Object>(monolith);
+			object->setTemplate(landTerrain(zoneId), rand);
+			object->setPosition(v);
+			object->setPosition(v + (v - object->getVisitablePosition()));
+			if(object->getVisitablePosition() != v)
+				continue;
+			const auto area = object->getArea();
+			bool fits = true;
+			for(const auto & t : area.getTilesVector())
+				if(!clearable(t))
+					fits = false;
+			if(!fits)
+				continue;
+			const auto & appearance = *monolith->appearance;
+			std::optional<Spot> fallback;
+			for(int dy = -1; dy <= 1; dy++)
+				for(int dx = -1; dx <= 1; dx++)
+				{
+					const int3 n(v.x + dx, v.y + dy, v.z);
+					if((!dx && !dy) || !onMap(n.x, n.y, n.z) || area.contains(n) || !appearance.isVisitableFrom(dx, dy))
+						continue;
+					if(clearable(n) && touchesGround(n, area))
+						return Spot{object, n, true};
+					if(isGround[idx(n)] && !fallback)
+						fallback = Spot{object, n, false};
+				}
+			if(fallback)
+				return fallback;
+		}
+		return std::nullopt;
+	};
+
+	auto spotA = findSpot(connection.getZoneA());
+	if(!spotA)
+		return false;
+	auto spotB = findSpot(connection.getZoneB());
+	if(!spotB)
+		return false;
+
+	for(const auto & spot : {*spotA, *spotB})
+	{
+		const auto zoneId = map.getZoneID(spot.approach);
+		TPath way;
+		for(const auto & t : spot.object->getArea().getTilesVector())
+			way.push_back(idx(t));
+		if(spot.ownApproach)
+			way.push_back(idx(spot.approach));
+		openWay(way, false, report, landTerrain(zoneId));
+		spot.object->finalize(map, rand);
+
+		if(spot.ownApproach && connection.getGuardStrength() > 0)
+		{
+			auto zone = map.getZones().at(zoneId);
+			if(auto * manager = zone->getModificator<ObjectManager>())
+			{
+				if(auto monster = manager->chooseGuard(connection.getGuardStrength(), true))
+				{
+					rmg::Object guard(monster);
+					guard.setPosition(spot.approach);
+					manager->placeObject(guard, false, false);
+				}
+			}
+		}
+		logGlobal->info("RMG validator: a monolith at %s for the connection of zones %d and %d",
+			spot.object->getVisitablePosition().toString(), connection.getZoneA(), connection.getZoneB());
+	}
+	report.fixes++;
+	build();
+	return true;
+}
+
+void RmgValidator::fixConnections(Report & report)
+{
+	reached = reachAll();
+	for(const auto & connection : realConnections())
+	{
+		std::vector<uint8_t> fromA;
+		if(checkConnection(connection, &fromA))
+			continue;
+
+		const auto a = connection.getZoneA();
+		const auto b = connection.getZoneB();
+		// From the side that can be reached
+		std::vector<uint8_t> sources(tiles.size(), 0);
+		std::vector<uint8_t> targets(tiles.size(), 0);
+		bool anySource = false;
+		auto side = a;
+		auto other = b;
+		for(int pass = 0; pass < 2 && !anySource; pass++)
+		{
+			if(pass == 1)
+				std::swap(side, other);
+			for(size_t i = 0; i < tiles.size(); i++)
+			{
+				const auto zone = map.getZoneID(pos(i));
+				if(reached[i] && tiles[i] != WATER && zone == side)
+				{
+					sources[i] = 1;
+					anySource = true;
+				}
+			}
+		}
+		for(size_t i = 0; i < tiles.size(); i++)
+			if((tiles[i] == OPEN || tiles[i] == VISIT) && map.getZoneID(pos(i)) == other && !sources[i])
+				targets[i] = 1;
+
+		{
+			auto zoneA = map.getZones().at(a);
+			auto zoneB = map.getZones().at(b);
+			bool adjacent = false;
+			for(const auto & t : zoneA->area()->getBorderOutside())
+				if(map.isOnMap(t) && map.getZoneID(t) == b)
+					adjacent = true;
+			logGlobal->warn("RMG validator: zones %d (level %d) and %d (level %d) are connected in the template (type %d, guard %d), but not on the map; adjacent %d",
+				a, zoneA->getPos().z, b, zoneB->getPos().z, static_cast<int>(connection.getConnectionType()), connection.getGuardStrength(), adjacent);
+		}
+		if(!anySource)
+			continue;
+
+		auto way = findWay(sources, targets, [this, a, b](int t)
+		{
+			auto zone = map.getZoneID(pos(t));
+			return zone == a || zone == b;
+		}, 1000);
+		if(way.empty())
+		{
+			// Not neighbours on the map: by boat over a shared sea, or by monoliths
+			bool fixed = placeBoat(side, other, report) && checkConnection(connection, nullptr);
+			if(!fixed)
+				fixed = placePortals(connection, report);
+			if(fixed)
+				reached = reachAll();
+			continue;
+		}
+
+		// The new passage gets the guard the template asks for, at the border
+		int3 guardPos(-1, -1, -1);
+		for(size_t i = 0; i + 1 < way.size(); i++)
+		{
+			if(map.getZoneID(pos(way[i])) != map.getZoneID(pos(way[i + 1])))
+			{
+				guardPos = pos(way[i]);
+				break;
+			}
+		}
+		openWay(way, false, report);
+
+		if(guardPos.isValid() && connection.getConnectionType() != rmg::EConnectionType::WIDE && connection.getGuardStrength() > 0)
+		{
+			auto zone = map.getZones().at(map.getZoneID(guardPos));
+			if(auto * manager = zone->getModificator<ObjectManager>())
+			{
+				if(auto monster = manager->chooseGuard(connection.getGuardStrength(), true))
+				{
+					rmg::Object guard(monster);
+					guard.setPosition(guardPos);
+					manager->placeObject(guard, false, false);
+					build();
+				}
+			}
+		}
+		reached = reachAll();
+	}
+}
+
+std::vector<int> RmgValidator::findDeadEnds() const
+{
+	// Empty one-tile-wide spurs off the paths: tiles with a single passable
+	// neighbour, nothing to visit next to them, peeled off a few times over.
+	// Spurs that lead to something keep it reachable: they end at an object.
+	std::vector<uint8_t> peeled(tiles.size(), 0);
+	std::vector<int> result;
+	auto passable = [this, &peeled](int t)
+	{
+		return !peeled[t] && (tiles[t] == OPEN || tiles[t] == VISIT || tiles[t] == WATER);
+	};
+	for(int round = 0; round < 6; round++)
+	{
+		std::vector<int> found;
+		for(size_t i = 0; i < tiles.size(); i++)
+		{
+			if(tiles[i] != OPEN || peeled[i] || !reached[i] || zoneIgnored(map.getZoneID(pos(i))))
+				continue;
+			const int3 p = pos(i);
+			const auto & tile = cmap.getTile(p);
+			if(tile.visitable() || tile.hasRoad() || teleports.count(i) || boarding.count(i))
+				continue;
+			int open = 0;
+			bool nearObject = false;
+			for(int dy = -1; dy <= 1; dy++)
+				for(int dx = -1; dx <= 1; dx++)
+				{
+					if((!dx && !dy) || !onMap(p.x + dx, p.y + dy, p.z))
+						continue;
+					const int n = idx(int3(p.x + dx, p.y + dy, p.z));
+					if(passable(n))
+						open++;
+					if(cmap.getTile(pos(n)).visitable())
+						nearObject = true;
+				}
+			if(open == 1 && !nearObject)
+				found.push_back(i);
+		}
+		if(found.empty())
+			break;
+		for(int t : found)
+		{
+			peeled[t] = 1;
+			result.push_back(t);
+		}
+	}
+	return result;
+}
+
+void RmgValidator::fixDeadEnds(Report & report)
+{
+	reached = reachAll();
+	std::map<TRmgTemplateZoneId, rmg::Area> spurs;
+	for(int t : findDeadEnds())
+		spurs[map.getZoneID(pos(t))].add(pos(t));
+	if(spurs.empty())
+		return;
+	for(auto & spur : spurs)
+	{
+		auto & zone = *map.getZones().at(spur.first);
+		if(zone.getType() == ETemplateZoneType::WATER)
+			continue;
+		plant(spur.second, spur.first, report);
+	}
+	report.fixes++;
+	build();
+}
+
+RmgValidator::Report RmgValidator::analyse(bool fix)
+{
+	Report report;
+	build();
+	if(fix)
+	{
+		// A fix may disturb what an earlier one did (terrain painting reaches
+		// the neighbouring tiles): again, while anything changes
+		for(int round = 0; round < 3; round++)
+		{
+			const int fixesBefore = report.fixes;
+			fixObjectsInWater(report);
+			fixObjectsOnRock(report);
+			fixCoveredEntrances(report);
+			fixIsolatedStarts(report);
+			fixConnections(report);
+			fixUnreachableObjects(report);
+			fixPockets(report);
+			fixUnreachableObjects(report);
+			if(round == 0)
+				fixDeadEnds(report);
+			if(report.fixes == fixesBefore)
+				break;
+		}
+	}
+
+	Report result;
+	build();
+	{
+		// Every player must be able to walk (or sail) to every other one
+		auto starts = startTiles();
+		for(int a : starts)
+		{
+			auto seen = flood({a}, [](int) { return true; });
+			int missing = 0;
+			for(int b : starts)
+				if(!seen[b])
+					missing++;
+			if(missing)
+			{
+				result.isolatedPlayers++;
+				logGlobal->warn("RMG validator: from the town at %s %d other players cannot be reached", pos(a).toString(), missing);
+			}
+		}
+	}
+	result.removedObstacles = report.removedObstacles;
+	result.plantedObstacles = report.plantedObstacles;
+	result.clearedRock = report.clearedRock;
+	result.landBridges = report.landBridges;
+	result.fixes = report.fixes;
+
+	build();
+	reached = reachAll();
+
+	for(const auto & zone : map.getZones())
+	{
+		if(zone.second->getType() == ETemplateZoneType::WATER || zoneIgnored(zone.first))
+			continue;
+		bool hasLand = false;
+		bool isReached = false;
+		for(const auto & t : zone.second->area()->getTilesVector())
+		{
+			if(tiles[idx(t)] == OPEN)
+			{
+				hasLand = true;
+				if(reached[idx(t)])
+				{
+					isReached = true;
+					break;
+				}
+			}
+		}
+		if(hasLand && !isReached)
+		{
+			result.unreachableZones++;
+			std::string connections;
+			for(const auto & c : zone.second->getConnections())
+				connections += boost::str(boost::format(" %d-%d(type %d)") % c.getZoneA() % c.getZoneB() % static_cast<int>(c.getConnectionType()));
+			logGlobal->warn("RMG validator: zone %d cannot be reached, connections:%s", zone.first, connections);
+		}
+	}
+	for(const auto & connection : realConnections())
+	{
+		if(!checkConnection(connection, nullptr))
+		{
+			result.brokenConnections++;
+			logGlobal->warn("RMG validator: no way between zones %d and %d", connection.getZoneA(), connection.getZoneB());
+		}
+	}
+	int gates[2] = {0, 0};
+	for(const auto & obj : cmap.objects)
+	{
+		if(!obj || !obj->isVisitable())
+			continue;
+		const int3 v = obj->visitablePos();
+		if(!cmap.isInTheMap(v))
+			continue;
+		if(obj->ID == Obj::SUBTERRANEAN_GATE && v.z < 2)
+			gates[v.z]++;
+		if(isWaterObject(obj.get()) || zoneIgnored(map.getZoneID(v)))
+			continue;
+		if(cmap.getTile(v).isWater())
+		{
+			result.objectsInWater++;
+			logGlobal->warn("RMG validator: %s at %s stands in water", obj->getObjectName(), v.toString());
+		}
+		else if(!reached[idx(v)])
+		{
+			result.unreachableObjects++;
+			const auto zoneId = map.getZoneID(v);
+			logGlobal->warn("RMG validator: %s at %s cannot be reached (zone %d type %d, tile %d)", obj->getObjectName(), v.toString(),
+				zoneId, static_cast<int>(map.getZones().at(zoneId)->getType()), static_cast<int>(tiles[idx(v)]));
+		}
+	}
+	result.unpairedGates = std::abs(gates[0] - gates[1]);
+
+	std::vector<uint8_t> counted(tiles.size(), 0);
+	for(size_t i = 0; i < tiles.size(); i++)
+	{
+		if(tiles[i] != OPEN || reached[i] || counted[i] || zoneIgnored(map.getZoneID(pos(i))))
+			continue;
+		result.pockets++;
+		std::vector<int> queue{static_cast<int>(i)};
+		counted[i] = 1;
+		while(!queue.empty())
+		{
+			const int c = queue.back();
+			queue.pop_back();
+			result.pocketTiles++;
+			const int3 p = pos(c);
+			for(int dy = -1; dy <= 1; dy++)
+				for(int dx = -1; dx <= 1; dx++)
+				{
+					if(!onMap(p.x + dx, p.y + dy, p.z))
+						continue;
+					const int n = idx(int3(p.x + dx, p.y + dy, p.z));
+					if(tiles[n] == OPEN && !reached[n] && !counted[n])
+					{
+						counted[n] = 1;
+						queue.push_back(n);
+					}
+				}
+		}
+	}
+	result.deadEnds = findDeadEnds().size();
+	return result;
+}
+
+RmgValidator::Report RmgValidator::check()
+{
+	return analyse(false);
+}
+
+RmgValidator::Report RmgValidator::checkAndFix()
+{
+	return analyse(true);
+}
+
+VCMI_LIB_NAMESPACE_END
