+/// pixels whose centers lie in that frame pixel: the screen pixels the way
+/// down (BareAppLink) takes it from, so it comes back exactly as drawn
+void CTrueTypeFont::renderTextOnFrame(SDL_Surface * surface, const std::string & text, const ColorRGBA & color, const Point & framePos) const
+{
+	SDL_Surface * rendered = TTF_RenderUTF8_Blended(frameFont.get(), text.c_str(), CSDL_Ext::toSDL(color));
+	if(!rendered || rendered->format->format != SDL_PIXELFORMAT_ARGB8888)
+	{
+		if(rendered)
+			SDL_FreeSurface(rendered);
+		logGlobal->error("Failed to render text '%s'. Reason: '%s'", text, TTF_GetError());
+		return;
+	}
+
+	const auto start = &BareAppLink::fitFirst;
+	const auto spread = [&start](int from, int count, double ratio)
+	{
+		std::vector<int> source;	// the rendered pixel of each screen pixel
+		for(int k = 0; k < count; k++)
+			source.resize(start(from + k + 1, ratio) - start(from, ratio), k);
+		return source;
+	};
+	const std::vector<int> columns = spread(framePos.x, rendered->w, frameRatioX);
+	const std::vector<int> rows = spread(framePos.y, rendered->h, frameRatioY);
+
+	SDL_Surface * spreadOut = SDL_CreateRGBSurfaceWithFormat(0, columns.size(), rows.size(), 32, SDL_PIXELFORMAT_ARGB8888);
+	if(spreadOut)
+	{
+		for(size_t y = 0; y < rows.size(); y++)
+		{
+			const auto * in = reinterpret_cast<const uint32_t *>(static_cast<const uint8_t *>(rendered->pixels) + rows[y] * rendered->pitch);
+			auto * out = reinterpret_cast<uint32_t *>(static_cast<uint8_t *>(spreadOut->pixels) + y * spreadOut->pitch);
+			for(size_t x = 0; x < columns.size(); x++)
+				out[x] = in[columns[x]];
+		}
+		SDL_SetSurfaceBlendMode(spreadOut, SDL_BLENDMODE_BLEND);
+		CSDL_Ext::blitSurface(spreadOut, surface, Point(start(framePos.x, frameRatioX), start(framePos.y, frameRatioY)));
+		SDL_FreeSurface(spreadOut);
+	}
+	SDL_FreeSurface(rendered);
+}
