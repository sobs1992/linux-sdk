+/// The client as a game of bare_app, an LVGL launcher for handheld consoles
+/// (ODROID-GO Advance). bare_app starts it with a socket and shared memory
+/// (bare_app's src/games/game_ipc.h) and runs SDL's dummy video driver: the
+/// screen, twice the size of bare_app's video layer, stays in memory. Its
+/// frames go to bare_app scaled down 2:1 (overview) or as a 1:1 part around
+/// the cursor (magnifier), the cursor drawn over them; L1 switches. With
+/// BARE_APP_VCMI_NATIVE=1 the screen is the frame's size instead (at least
+/// 800x600), at 1:1, and the frame is the part of it the cursor's position
+/// points at (native). Gamepad events come back and become
+/// SDL game controller events, so VCMI's own controller support drives the
+/// game. The D-pad moves the magnifier, or in the overview scrolls the
+/// adventure map (elsewhere it swipes, as VCMI's right stick). F1 and F2
+/// stand for the Ctrl and Shift keys while held.
+class BareAppLink
+{
+public:
+	/// D-pad map scrolling, a share of the border scrolling speed
+	static constexpr double dpadScrollShare = 0.375;
+
+	/// nullptr unless started by bare_app
+	static BareAppLink * get();
+
+	/// Settings the link needs (window size, software rendering and cursor,
+	/// quiet logging); before logging is configured. bare_app's language is
+	/// set earlier, by GameLibrary, before the mods load.
+	void configure();
+	/// Take VCMI's screen into bare_app's frame, scaled, in the color
+	/// scheme: under the interface lock, as other threads draw into it too
+	void capture(SDL_Surface * screen, ColorScheme scheme);
+	/// Draw the cursor over the frame taken last and publish it. With
+	/// capture() it takes the place of SDL's renderer, which would copy the
+	/// whole screen twice more on the way.
+	void present();
+	/// The software cursor for the frame being presented: its image, and
+	/// where its hot spot is (CursorSoftware::render)
+	void setCursor(const SDL_Surface * image, const Point & position, const Point & hotSpot);
+	/// Gamepad messages into SDL events (main thread, before SDL_PollEvent)
+	void poll();
+
+	/// -1, 0 or +1 on each axis: where the stick is pushed
+	Point stickDirection() const;
+	/// The D-pad's direction for the adventure map to scroll (overview
+	/// only), called while map scrolling is active: the D-pad stops
+	/// swiping meanwhile. The on-screen keyboard steps with it too.
+	Point mapScrollDirection();
+
+	/// F1 and F2 held: the keyboard's Ctrl and Shift for VCMI
+	bool ctrlDown() const { return ctrl; }
+	bool shiftDown() const { return shift; }
+
+	/// Moves VCMI's cursor, as its own controller cursor moves
+	static void moveCursor(const Point & position);
+
+	/// Saves without typing names: one autosave after each turn, first in
+	/// the lists, and numbered slots for the player's own
+	static constexpr int saveSlots = 10;
+	/// "Saves/Autosave" for slot 0, "Saves/Slot01".. for the others
+	static std::string savePath(int slot);
+	/// The slot of a save (its path from the data directory), or -1
+	static int saveSlot(const std::string & path);
+	/// What the lists call a slot
+	static std::string saveName(int slot, bool empty = false);
+
+private:
+	BareAppLink(game_shm * shm);
+
+	void onButton(int button, bool pressed, bool fromStick);
+	void onAxis(int axis, int value);
+	void pushButton(int sdlButton, bool pressed);
+	void pushAxis(int sdlAxis, int value);
+	Point dpadDirection() const;
+	void updateDpad();
+	void moveMagnifier();
+	void cursorIntoView();
+	void compose(const uint32_t * src, int srcW, int srcH, int srcPitch, uint32_t * dst);
+	void drawCursor(uint32_t * dst, const Point & screenSize);
+	void applyColorScheme(ColorScheme scheme, uint32_t * frame);
+
+	game_shm * shm;
+	unsigned back = 0;	///< buffer being drawn
+	bool magnifier = false;
+	bool native = false;	///< BARE_APP_VCMI_NATIVE: 1:1, the view follows the cursor
+	Point viewport;		///< top left of the magnified part, in window pixels
+	bool detached = false;	///< the D-pad has moved the magnifier off the cursor
+	bool rejoin = false;	///< the magnifier has opened: around the cursor
+	uint32_t movedAt = 0;	///< SDL_GetTicks() of the last magnifier move check
+	uint32_t dpad = 0;	///< D-pad directions held, gp_button bits
+	bool swiping = false;	///< the D-pad holds VCMI's right stick
+	uint32_t mapScrollAt = 0;	///< SDL_GetTicks() when the map last asked for the D-pad
+	Point stick;		///< last left stick values
+	bool ctrl = false;	///< F1 held
+	bool shift = false;	///< F2 held
+	Point captured;		///< the screen's size when taken, (0, 0): nothing new to present
+	const SDL_Surface * cursorImage = nullptr;	///< set for each frame, none: hidden
+	Point cursorPosition;	///< in screen pixels
+	Point cursorHotSpot;	///< in the image
+	std::vector<uint32_t> last;	///< the frame published last
+	uint32_t framesDrawn = 0;
+	uint32_t framesSent = 0;
+	uint32_t statsSince = 0;	///< SDL_GetTicks()
+	uint64_t composeTime = 0;	///< SDL_GetPerformanceCounter() ticks
+};
