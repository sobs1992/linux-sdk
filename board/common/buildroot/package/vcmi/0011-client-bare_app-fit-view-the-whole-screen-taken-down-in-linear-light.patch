+/// The fit view's scaling down: an output pixel is the average of the source
+/// pixels whose centers lie in it (2 or 3 at ~2.5:1), so no thin stroke is
+/// skipped and nothing drawn over exactly those pixels (text) leaks into the
+/// next one; and the average is taken in linear light, so the light text on
+/// the dark interface keeps its brightness (an sRGB average darkens it and
+/// thins it out)
+struct BareAppLink::Downscaler
+{
+	/// The weights along each axis sum to this
+	static constexpr uint32_t weightOne = 256;
+	/// Linear light, 0..linearMax: times both axes' weights (1 << 16) it stays
+	/// within 32 bits
+	static constexpr uint32_t linearMax = (1 << 15) - 1;
+	/// The linear sums' bits that pick the sRGB value
+	static constexpr int indexBits = 14;
+	static constexpr int indexShift = 15 + 16 - indexBits;
+
+	/// The source pixels of each output pixel along one axis, with their weights
+	struct Axis
+	{
+		int taps = 0;	///< most source pixels an output one covers
+		std::vector<int> first;
+		std::vector<int> count;
+		std::vector<uint32_t> weights;	///< `taps` for each output pixel
+
+		void build(int from, int to)
+		{
+			const double ratio = static_cast<double>(from) / to;
+			taps = (from + to - 1) / to + 1;
+			first.assign(to, 0);
+			count.assign(to, 0);
+			weights.assign(static_cast<size_t>(to) * taps, 0);
+			for(int i = 0; i < to; i++)
+			{
+				first[i] = std::clamp(BareAppLink::fitFirst(i, ratio), 0, from - 1);
+				count[i] = std::clamp(std::min(BareAppLink::fitFirst(i + 1, ratio), from) - first[i], 1, taps);
+				uint32_t * w = &weights[static_cast<size_t>(i) * taps];
+				for(int k = 0; k < count[i]; k++)
+					w[k] = weightOne / count[i];
+				w[0] += weightOne % count[i];	// what division left
+			}
+		}
+	};
+
+	std::array<uint16_t, 256> toLinear;
+	std::vector<uint8_t> toSrgb;	///< (1 << indexBits) + 1: a full sum rounds up to it
+	Point from;
+	Point to;
+	Axis x;
+	Axis y;
+
+	Downscaler()
+		: toSrgb((1 << indexBits) + 1)
+	{
+		for(int i = 0; i < 256; i++)
+		{
+			const double c = i / 255.0;
+			const double linear = c <= 0.04045 ? c / 12.92 : std::pow((c + 0.055) / 1.055, 2.4);
+			toLinear[i] = static_cast<uint16_t>(std::lround(linear * linearMax));
+		}
+		for(size_t i = 0; i < toSrgb.size(); i++)
+		{
+			const double linear = std::min(1.0, (i + 0.5) / (1 << indexBits));
+			const double c = linear <= 0.0031308 ? linear * 12.92 : 1.055 * std::pow(linear, 1 / 2.4) - 0.055;
+			toSrgb[i] = static_cast<uint8_t>(std::lround(std::clamp(c, 0.0, 1.0) * 255));
+		}
+	}
+
+	void run(const uint32_t * src, const Point & srcSize, int srcPitch, uint32_t * dst, const Point & dstSize, int dstPitch)
+	{
+		if(srcSize != from || dstSize != to)
+		{
+			from = srcSize;
+			to = dstSize;
+			x.build(from.x, to.x);
+			y.build(from.y, to.y);
+		}
+
+		// rows in parallel: the screen is twice the window, ~2.5 times the frame
+		tbb::parallel_for(tbb::blocked_range<int>(0, to.y, 8), [&](const tbb::blocked_range<int> & rows)
+		{
+			std::vector<uint32_t> line(static_cast<size_t>(from.x) * 3);	// one row's linear sums, RGB
+			for(int oy = rows.begin(); oy < rows.end(); oy++)
+			{
+				std::fill(line.begin(), line.end(), 0);
+				for(int k = 0; k < y.count[oy]; k++)
+				{
+					const uint32_t weight = y.weights[static_cast<size_t>(oy) * y.taps + k];
+					const uint32_t * in = src + static_cast<size_t>(y.first[oy] + k) * srcPitch;
+					uint32_t * sum = line.data();
+					for(int sx = 0; sx < from.x; sx++, sum += 3)
+					{
+						const uint32_t p = in[sx];
+						sum[0] += weight * toLinear[p & 0xff];
+						sum[1] += weight * toLinear[(p >> 8) & 0xff];
+						sum[2] += weight * toLinear[(p >> 16) & 0xff];
+					}
+				}
+
+				uint32_t * out = dst + static_cast<size_t>(oy) * dstPitch;
+				for(int ox = 0; ox < to.x; ox++)
+				{
+					const uint32_t * w = &x.weights[static_cast<size_t>(ox) * x.taps];
+					const uint32_t * in = &line[static_cast<size_t>(x.first[ox]) * 3];
+					uint32_t b = 1 << (indexShift - 1);
+					uint32_t g = b;
+					uint32_t r = b;
+					for(int k = 0; k < x.count[ox]; k++, in += 3)
+					{
+						b += w[k] * in[0];
+						g += w[k] * in[1];
+						r += w[k] * in[2];
+					}
+					out[ox] = toSrgb[b >> indexShift] | toSrgb[g >> indexShift] << 8 | toSrgb[r >> indexShift] << 16;
+				}
+			}
+		});
+	}
+};
