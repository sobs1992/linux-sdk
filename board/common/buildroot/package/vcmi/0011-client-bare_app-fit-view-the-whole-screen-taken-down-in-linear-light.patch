+void CTrueTypeFont::openFrameFont(int size)
+{
+	// taken down more on one axis than the other: the glyphs too, by their
+	// resolution, so they are hinted to the frame's pixels as they are
+	const auto & source = frameData.first ? frameData : data;
+	const unsigned dpi = 72;
+	frameFont.reset(TTF_OpenFontDPIRW(SDL_RWFromConstMem(source.first.get(), source.second), 1, size,
+		dpi, static_cast<unsigned>(std::lround(dpi * frameRatioX / frameRatioY))));
+	if(!frameFont)
+	{
+		logGlobal->error("Failed to open a font at %d for the frame: %s", size, TTF_GetError());
+		return;
+	}
+	TTF_SetFontStyle(frameFont.get(), frameStyle);
+	TTF_SetFontHinting(frameFont.get(), TTF_HINTING_MONO);
+}
+
+void CTrueTypeFont::fitTo(const IFont & bitmap)
+{
+	if(!frameFont)
+		return;
+
+	// Russian, English and numbers, as far as the bitmap font has them
+	static const std::string sample = "Однажды, много столетий тому назад, все жили в мире. Long ago, 1234567890";
+	std::string text;
+	for(size_t i = 0; i < sample.size(); i += TextOperations::getUnicodeCharacterSize(sample[i]))
+		if(bitmap.canRepresentCharacter(sample.data() + i))
+			text += sample.substr(i, TextOperations::getUnicodeCharacterSize(sample[i]));
+
+	const double room = bitmap.getStringWidthScaled(text) / frameRatioX;	// frame pixels
+	int size = TTF_FontHeight(frameFont.get());
+	int fits = 0;
+	for(size = 4; size <= 40; size++)
+	{
+		openFrameFont(size);
+		int width = 0;
+		if(!frameFont || TTF_SizeUTF8(frameFont.get(), text.c_str(), &width, nullptr) < 0 || width > room)
+			break;
+		fits = size;
+	}
+	openFrameFont(std::max(fits, 4));
+	fittedLineHeight = bitmap.getLineHeightScaled();
+	fittedAscent = bitmap.getFontAscentScaled();
+	logGlobal->info("A bitmap font of %d px drawn on the frame at %d px", fittedLineHeight / getScalingFactor(), fits);
+}
+
+void CTrueTypeFont::renderInPlaceOf(SDL_Surface * surface, const std::string & text, const ColorRGBA & color, const Point & pos, int width, int ascent) const
+{
+	if(text.empty() || !frameFont)
+		return;
+
+	int drawn = 0;
+	TTF_SizeUTF8(frameFont.get(), text.c_str(), &drawn, nullptr);
+	drawn += (outline ? 1 : 0) + (dropShadow || outline ? 1 : 0);
+	const int room = std::max<int>(0, std::lround(width / frameRatioX) - drawn);	// frame pixels to spare
+	const int left = std::lround(pos.x / frameRatioX) + (anchor == Anchor::CENTER ? room / 2 : anchor == Anchor::RIGHT ? room : 0);
+	const int baseline = std::lround((pos.y + ascent) / frameRatioY);
+	const Point at(left, baseline - TTF_FontAscent(frameFont.get()));
+
+	if (outline)
+		renderTextOnFrame(surface, text, Colors::BLACK, at - Point(1,1));
+	if (dropShadow || outline)
+		renderTextOnFrame(surface, text, Colors::BLACK, at + Point(1,1));
+	renderTextOnFrame(surface, text, color, at);
+}
