+/// 2:1, each pixel the average of four (`dst` w x h)
+void halve(const uint32_t * src, int srcPitch, uint32_t * dst, int dstPitch, int w, int h)
+{
+	for(int y = 0; y < h; y++)
+	{
+		const uint32_t * a = src + 2 * y * srcPitch;
+		const uint32_t * b = a + srcPitch;
+		uint32_t * out = dst + y * dstPitch;
+		int x = 0;
+#ifdef __ARM_NEON
+		// four at a time, the same rounding down per channel
+		for(; x + 4 <= w; x += 4)
+		{
+			const uint32x4x2_t top = vld2q_u32(a + 2 * x);
+			const uint32x4x2_t bottom = vld2q_u32(b + 2 * x);
+			const uint8x16_t upper = vhaddq_u8(vreinterpretq_u8_u32(top.val[0]), vreinterpretq_u8_u32(top.val[1]));
+			const uint8x16_t lower = vhaddq_u8(vreinterpretq_u8_u32(bottom.val[0]), vreinterpretq_u8_u32(bottom.val[1]));
+			vst1q_u32(out + x, vreinterpretq_u32_u8(vhaddq_u8(upper, lower)));
+		}
+#endif
+		for(; x < w; x++)
+			out[x] = average(average(a[2 * x], a[2 * x + 1]), average(b[2 * x], b[2 * x + 1]));
+	}
+}
