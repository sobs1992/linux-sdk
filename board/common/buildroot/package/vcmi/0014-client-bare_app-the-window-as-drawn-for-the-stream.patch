 	const int step = fit ? ENGINE->screenHandler().getScalingFactor() : 1;
 	const Point origin = magnifier || native
 		? cursorPosition / step - cursorHotSpot - viewport
 		: Point(cursorPosition.x * w / screenSize.x, cursorPosition.y * h / screenSize.y) - cursorHotSpot;
 
+	// the window as drawn as well: its pixels are VCMI's own, so is the cursor
+	if(fullCaptured != Point(0, 0))
+		drawCursorAt(image, static_cast<uint32_t *>(game_shm_full(shm, fullBack)), fullCaptured, shm->full_width,
+			cursorPosition / step - cursorHotSpot, step);
+	drawCursorAt(image, dst, Point(w, h), shm->stride / 4, origin, step);
+}
+
+/// The cursor image, every step-th pixel of it, with its top left at origin
+void BareAppLink::drawCursorAt(const SDL_Surface * image, uint32_t * dst, const Point & size, int dstPitch, const Point & origin, int step)
+{
+	const int w = size.x;
+	const int h = size.y;
+
 	for(int y = std::max(0, -origin.y); y < image->h / step && origin.y + y < h; y++)
 	{
 		const auto * in = reinterpret_cast<const uint32_t *>(static_cast<const uint8_t *>(image->pixels) + y * step * image->pitch);
@@ -585,14 +638,14 @@
 }
 
