+/// The size of the window as VCMI drew it, for the stream: the fit view
+/// draws at twice it, the others at 1:1 (the default view's screen is
+/// twice the frame, the native view's at least 800x600); (0, 0) when it
+/// is no bigger than the frame: nothing to gain
+Point BareAppLink::fullSize(const Point & screenSize) const
+{
+	const Point size = fit ? screenSize / ENGINE->screenHandler().getScalingFactor() : screenSize;
+	if(size.x <= static_cast<int>(shm->width) && size.y <= static_cast<int>(shm->height))
+		return Point(0, 0);
+	return size;
+}
+
+/// While bare_app streams the screen it wants the window as drawn: the
+/// fit view's screen taken down in linear light like the frame (only the
+/// rows that changed), the others' copied
+void BareAppLink::composeFull(const uint32_t * src, const Point & screenSize, int srcPitch)
+{
+	fullCaptured = Point(0, 0);
+	const Point size = fullSize(screenSize);
+	if(!shm->full_width || !shm->full_want.load() || size.x <= 0 || size.y <= 0 ||
+		size.x > static_cast<int>(shm->full_width) || size.y > static_cast<int>(shm->full_height))
+	{
+		fullScaler.reset();	// its copy of the screen is memory
+		return;
+	}
+	auto * dst = static_cast<uint32_t *>(game_shm_full(shm, fullBack));
+	const int dstPitch = static_cast<int>(shm->full_width);
+	if(size == screenSize)
+	{
+		for(int y = 0; y < size.y; y++)
+			std::memcpy(dst + static_cast<size_t>(y) * dstPitch, src + static_cast<size_t>(y) * srcPitch, static_cast<size_t>(size.x) * 4);
+	}
+	else
+	{
+		if(!fullScaler)
+			fullScaler = std::make_unique<Downscaler>();
+		fullScaler->run(src, screenSize, srcPitch, dst, size, dstPitch);
+	}
+	fullCaptured = size;
+}
+
 /// The magnifier's view (in VCMI's pixels) over an area of `area`: around
 /// the cursor when it opens, pushed by the cursor at its edges unless the
 /// D-pad has taken it away
@@ -563,12 +604,24 @@
 
