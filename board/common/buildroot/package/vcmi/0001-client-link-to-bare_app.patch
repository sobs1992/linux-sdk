+ * License: GNU General Public License v2.0 or later
+ * Full text of license available in license.txt file, in main folder
+ *
+ */
+#include "StdInc.h"
+#include "BareAppLink.h"
+
+#include "../GameEngine.h"
+#include "../eventsSDL/InputHandler.h"
+#include "../gui/CursorHandler.h"
+#include "../render/IScreenHandler.h"
+#include "../../lib/CConfigHandler.h"
+
+#include <SDL.h>
+#include <sys/mman.h>
+#include <sys/socket.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+// bare_app's headers: the exchange and its gamepad button names
+#include "games/game_ipc.h"
+#include "core/input.h"
+
+namespace
+{
+/// Cursor images are smaller than this, hot spot included
+constexpr int cursorReach = 64;
+/// D-pad: the magnifier's speed, window pixels per second
+constexpr int magnifierSpeed = 480;
+/// D-pad: VCMI's right stick held this far (it squares that: ~0.3 of full speed)
+constexpr int dpadSwipe = SDL_JOYSTICK_AXIS_MAX * 55 / 100;
+/// The adventure map asked for the D-pad this recently: it is on screen
+constexpr uint32_t mapScrollHoldMs = 200;
+/// The stick is pushed (for border scrolling) past this
+constexpr int stickPush = SDL_JOYSTICK_AXIS_MAX / 4;
+constexpr uint32_t statsPeriodMs = 10000;
+
+constexpr uint32_t dpadBits = GP_BIT(GP_UP) | GP_BIT(GP_DOWN) | GP_BIT(GP_LEFT) | GP_BIT(GP_RIGHT);
+
+/// Average of two XRGB pixels, per channel
+inline uint32_t average(uint32_t a, uint32_t b)
+{
+	return (a & b) + (((a ^ b) & 0xfefefefe) >> 1);
+}
+
+[[noreturn]] void leave()
+{
+	// bare_app is gone: nobody sees or controls the game any more
+	logGlobal->info("bare_app has closed the link, leaving");
+	_exit(0);
+}
+}
+
+BareAppLink * BareAppLink::get()
+{
+	static BareAppLink * link = []() -> BareAppLink *
+	{
+		struct stat st;
+
+		if(fstat(GAME_IPC_SOCK, &st) < 0 || !S_ISSOCK(st.st_mode))
+			return nullptr;
+		if(fstat(GAME_IPC_SHM, &st) < 0 || st.st_size < GAME_SHM_HEADER)
+			return nullptr;
+		void * mem = mmap(nullptr, st.st_size, PROT_READ | PROT_WRITE, MAP_SHARED, GAME_IPC_SHM, 0);
+		if(mem == MAP_FAILED)
+			return nullptr;
+		auto * shm = static_cast<game_shm *>(mem);
+		if(shm->magic != GAME_SHM_MAGIC || game_shm_size(shm) > static_cast<size_t>(st.st_size))
+		{
+			munmap(mem, st.st_size);
+			return nullptr;
+		}
+		logGlobal->info("Started by bare_app, frames of %dx%d", shm->width, shm->height);
+		return new BareAppLink(shm);
+	}();
+	return link;
+}
+
+BareAppLink::BareAppLink(game_shm * shm)
+	: shm(shm)
+	, last(static_cast<size_t>(shm->width) * shm->height)
+{
+}
+
+void BareAppLink::configure()
+{
+	// The default traces everything into a file: on a handheld's SD card
+	// that costs more than the game itself. Other loggers stay as they are.
+	{
+		Settings loggers = settings.write["logging"]["loggers"];
+		for(auto & logger : loggers->Vector())
+		{
+			const std::string & level = logger["level"].String();
+			if(logger["domain"].String() == "global" && (level == "trace" || level == "debug"))
+				logger["level"].String() = "info";
+		}
+	}
+
+	Settings resolution = settings.write["video"]["resolution"];
+	resolution["width"].Float() = 2 * shm->width;
+	resolution["height"].Float() = 2 * shm->height;
+	resolution["scaling"].Float() = 100;
+
+	// bare_app already cuts the stick's dead zone and rescales the rest:
+	// a second one would swallow small deflections
+	Settings input = settings.write["input"];
+	input["controllerAxisDeadZone"].Float() = 0;
+
+	Settings video = settings.write["video"];
+	video["fullscreen"].Bool() = false;
+	video["driver"].String() = "software";	// the only one with the dummy driver
+	video["cursor"].String() = "software";	// drawn into the frame
+}
+
+void BareAppLink::compose(const uint32_t * src, int srcW, int srcH, int srcPitch, uint32_t * dst)
+{
+	const int w = shm->width;
+	const int h = shm->height;
+	const int dstPitch = shm->stride / 4;
+
+	if(magnifier)
+	{
+		moveMagnifier();
+		const Point & cursor = ENGINE->getCursorPosition();
+		if(rejoin)
+		{
+			// Back to the cursor: around it, unless it is in view already
+			rejoin = false;
+			if(cursor.x < viewport.x || cursor.x >= viewport.x + w || cursor.y < viewport.y || cursor.y >= viewport.y + h)
+				viewport = cursor - Point(w / 2, h / 2);
+		}
+		if(!detached)
+		{
+			// The cursor pushes the view at its edges
+			viewport.x = std::clamp(viewport.x, cursor.x - w + 1, cursor.x);
+			viewport.y = std::clamp(viewport.y, cursor.y - h + 1, cursor.y);
+		}
+		viewport.x = std::clamp(viewport.x, 0, std::max(srcW - w, 0));
+		viewport.y = std::clamp(viewport.y, 0, std::max(srcH - h, 0));
+
+		const int cw = std::min(w, srcW);
+		for(int y = 0; y < std::min(h, srcH); y++)
+			std::memcpy(dst + y * dstPitch, src + (viewport.y + y) * srcPitch + viewport.x, cw * 4);
+		return;
+	}
+
+	if(srcW == 2 * w && srcH == 2 * h)
+	{
+		// 2:1, each pixel the average of four
+		for(int y = 0; y < h; y++)
+		{
+			const uint32_t * a = src + 2 * y * srcPitch;
+			const uint32_t * b = a + srcPitch;
+			uint32_t * out = dst + y * dstPitch;
+			for(int x = 0; x < w; x++)
+				out[x] = average(average(a[2 * x], a[2 * x + 1]), average(b[2 * x], b[2 * x + 1]));
+		}
+		return;
+	}
+
+	// Any other size (the window did not get the size asked for): nearest
+	for(int y = 0; y < h; y++)
+	{
+		const uint32_t * in = src + (y * srcH / h) * srcPitch;
+		uint32_t * out = dst + y * dstPitch;
+		for(int x = 0; x < w; x++)
+			out[x] = in[x * srcW / w];
+	}
+}
+
+/// The overview halves the cursor too, and on a 3.5" screen it gets lost.
+/// The window holds the screen with the cursor drawn over it: the pixels
+/// that differ around the cursor are the cursor, put back at full size.
+void BareAppLink::drawCursor(const SDL_Surface * window, const SDL_Surface * screen, uint32_t * dst)
+{
+	if(!screen || screen->w != window->w || screen->h != window->h || screen->format->BytesPerPixel != 4)
+		return;
+
+	const Point & cursor = ENGINE->getCursorPosition();
+	const int dstPitch = shm->stride / 4;
+	const int x0 = std::max(cursor.x - cursorReach, 0);
+	const int y0 = std::max(cursor.y - cursorReach, 0);
+	const int x1 = std::min(cursor.x + cursorReach, window->w);
+	const int y1 = std::min(cursor.y + cursorReach, window->h);
+
+	for(int y = y0; y < y1; y++)
+	{
+		const int outY = cursor.y / 2 + y - cursor.y;
+		if(outY < 0 || outY >= static_cast<int>(shm->height))
+			continue;
+		const auto * win = static_cast<const uint32_t *>(window->pixels) + y * window->pitch / 4;
+		const auto * scr = static_cast<const uint32_t *>(screen->pixels) + y * screen->pitch / 4;
+		for(int x = x0; x < x1; x++)
+		{
+			const int outX = cursor.x / 2 + x - cursor.x;
+			if(outX >= 0 && outX < static_cast<int>(shm->width) && ((win[x] ^ scr[x]) & 0xffffff))
+				dst[outY * dstPitch + outX] = win[x];
+		}
+	}
+}
+
+void BareAppLink::present(SDL_Window * window, SDL_Surface * screen)
+{
+	SDL_Surface * surface = SDL_GetWindowSurface(window);
+	if(!surface || surface->format->BytesPerPixel != 4)
+	{
+		static bool reported = false;
+		if(!reported)
+			logGlobal->error("bare_app link: no 32-bit window surface: %s", SDL_GetError());
+		reported = true;
+		return;
+	}
+
+	const uint64_t start = SDL_GetPerformanceCounter();
+	auto * frame = static_cast<uint32_t *>(game_shm_frame(shm, back));
+	SDL_LockSurface(surface);
+	compose(static_cast<const uint32_t *>(surface->pixels), surface->w, surface->h, surface->pitch / 4, frame);
+	if(!magnifier && surface->w == static_cast<int>(2 * shm->width))
+		drawCursor(surface, screen, frame);
+	SDL_UnlockSurface(surface);
+
+	framesDrawn++;
+	composeTime += SDL_GetPerformanceCounter() - start;
+	const uint32_t now = SDL_GetTicks();
+	if(now - statsSince >= statsPeriodMs)
+	{
+		// Only while something moves: an idle menu says nothing
+		if(statsSince && framesSent)
+			logGlobal->info("bare_app link: %.1f frames/s drawn, %.1f sent, %.1f ms each to compose",
+				framesDrawn * 1000.0 / (now - statsSince), framesSent * 1000.0 / (now - statsSince),
+				composeTime * 1000.0 / SDL_GetPerformanceFrequency() / framesDrawn);
+		statsSince = now;
+		framesDrawn = framesSent = 0;
+		composeTime = 0;
+	}
+
+	// VCMI redraws at its frame rate whether anything changed or not
+	const size_t rowBytes = static_cast<size_t>(shm->width) * 4;
+	bool same = true;
+	for(uint32_t y = 0; y < shm->height && same; y++)
+		same = !std::memcmp(&last[y * shm->width], reinterpret_cast<uint8_t *>(frame) + y * shm->stride, rowBytes);
+	if(same)
+		return;
+	for(uint32_t y = 0; y < shm->height; y++)
+		std::memcpy(&last[y * shm->width], reinterpret_cast<uint8_t *>(frame) + y * shm->stride, rowBytes);
+
+	framesSent++;
+	back = shm->middle.exchange(back | GAME_SHM_FRESH) & ~GAME_SHM_FRESH;
+	game_msg msg = {};
+	msg.type = GAME_MSG_FRAME;
+	// a full socket already holds a "frame" message: nothing to add
+	if(send(GAME_IPC_SOCK, &msg, sizeof(msg), MSG_DONTWAIT | MSG_NOSIGNAL) < 0 && errno == EPIPE)
+		leave();
+}
+
+void BareAppLink::pushButton(int sdlButton, bool pressed)
+{
+	SDL_Event event = {};
+	event.type = pressed ? SDL_CONTROLLERBUTTONDOWN : SDL_CONTROLLERBUTTONUP;
+	event.cbutton.timestamp = SDL_GetTicks();
+	event.cbutton.button = sdlButton;
+	event.cbutton.state = pressed ? SDL_PRESSED : SDL_RELEASED;
+	SDL_PushEvent(&event);
+}
+
+void BareAppLink::pushAxis(int sdlAxis, int value)
+{
+	SDL_Event event = {};
+	event.type = SDL_CONTROLLERAXISMOTION;
+	event.caxis.timestamp = SDL_GetTicks();
+	event.caxis.axis = sdlAxis;
+	event.caxis.value = std::clamp(value, -SDL_JOYSTICK_AXIS_MAX, SDL_JOYSTICK_AXIS_MAX);
+	SDL_PushEvent(&event);
+}
+
+Point BareAppLink::dpadDirection() const
+{
+	return Point(!!(dpad & GP_BIT(GP_RIGHT)) - !!(dpad & GP_BIT(GP_LEFT)),
+		!!(dpad & GP_BIT(GP_DOWN)) - !!(dpad & GP_BIT(GP_UP)));
+}
+
+/// Outside the adventure map the D-pad swipes (lists, sliders): VCMI does
+/// that with the right stick, which the OGA does not have. The magnifier
+/// and the adventure map move with the D-pad by themselves.
+void BareAppLink::updateDpad()
+{
+	const bool swipe = dpad && !magnifier && SDL_GetTicks() - mapScrollAt > mapScrollHoldMs;
+	if(!swipe && !swiping)
+		return;
+	const Point direction = swipe ? dpadDirection() : Point(0, 0);
+	pushAxis(SDL_CONTROLLER_AXIS_RIGHTX, direction.x * dpadSwipe);
+	pushAxis(SDL_CONTROLLER_AXIS_RIGHTY, direction.y * dpadSwipe);
+	swiping = swipe;
+}
+
+/// The magnifier follows the D-pad and leaves the cursor until the stick moves
+void BareAppLink::moveMagnifier()
+{
+	const uint32_t now = SDL_GetTicks();
+	// after a pause (the overview) no more than a frame's step
+	const uint32_t passed = std::min<uint32_t>(now - movedAt, 50);
+	movedAt = now;
+
+	const Point direction = dpadDirection();
+	if(direction == Point(0, 0))
+		return;
+	detached = true;
+	viewport += direction * std::max<int>(magnifierSpeed * passed / 1000, 1);
+}
+
+/// The D-pad has moved the magnifier off the cursor: the cursor comes in at
+/// the edge it was beyond, the view stays where it is
+void BareAppLink::cursorIntoView()
+{
+	const Point & cursor = ENGINE->getCursorPosition();
+	const int w = shm->width;
+	const int h = shm->height;
+	if(cursor.x >= viewport.x && cursor.x < viewport.x + w && cursor.y >= viewport.y && cursor.y < viewport.y + h)
+		return;
+
+	const Point target(std::clamp(cursor.x, viewport.x, viewport.x + w - 1),
+		std::clamp(cursor.y, viewport.y, viewport.y + h - 1));
+	// as VCMI's own controller cursor moves (InputSourceGameController::doCursorMove)
+	const int scale = ENGINE->screenHandler().getScalingFactor();
+	ENGINE->input().setCursorPosition(target);
+	ENGINE->cursor().cursorMove(target.x * scale, target.y * scale);
+}
+
+Point BareAppLink::mapScrollDirection()
+{
+	mapScrollAt = SDL_GetTicks();
+	if(swiping)
+		updateDpad();	// the map has come back while the D-pad swiped: it scrolls by itself now
+	return magnifier ? Point(0, 0) : dpadDirection();
+}
+
+Point BareAppLink::stickDirection() const
+{
+	const auto sign = [](int value) { return value > stickPush ? 1 : value < -stickPush ? -1 : 0; };
+	return Point(sign(stick.x), sign(stick.y));
+}
+
+void BareAppLink::onButton(int button, bool pressed, bool fromStick)
+{
+	if(GP_BIT(button) & dpadBits)
+	{
+		if(fromStick)
+			return;	// the stick moves the cursor through its axes
+		if(pressed)
+			dpad |= GP_BIT(button);
+		else
+			dpad &= ~GP_BIT(button);
+		updateDpad();
+		return;
+	}
+
+	// As in VCMI's controller bindings (config/keyBindingsConfig.json):
+	// x, y: mouse left and right; a: accept, open the selected hero;
+	// b: cancel; back: end turn; start: options; left shoulder: next hero.
+	// The OGA has F1..F6 instead of Start and Select (F5, F6 are bare_app's);
+	// bare_app keeps L2 and R2 for the volume.
+	switch(button)
+	{
+		case GP_A:      pushButton(SDL_CONTROLLER_BUTTON_X, pressed); break;
+		case GP_Y:      pushButton(SDL_CONTROLLER_BUTTON_Y, pressed); break;
+		case GP_B:      pushButton(SDL_CONTROLLER_BUTTON_A, pressed); break;
+		case GP_SELECT:
+		case GP_F2:     pushButton(SDL_CONTROLLER_BUTTON_B, pressed); break;
+		case GP_X:      pushButton(SDL_CONTROLLER_BUTTON_BACK, pressed); break;
+		case GP_START:
+		case GP_F1:     pushButton(SDL_CONTROLLER_BUTTON_START, pressed); break;
+		case GP_R1:     pushButton(SDL_CONTROLLER_BUTTON_LEFTSHOULDER, pressed); break;
+		case GP_L1:
+			if(pressed)
+			{
+				magnifier = !magnifier;
+				// a magnifier opens around the cursor
+				detached = false;
+				rejoin = magnifier;
+				updateDpad();
+				// the cursor is redrawn every frame, so the new view comes with the next one
+				logGlobal->debug("bare_app link: %s", magnifier ? "magnifier" : "overview");
+			}
+			break;
+		default:
+			break;
+	}
+}
+
+void BareAppLink::onAxis(int axis, int value)
+{
+	// The left stick moves the cursor, from inside the magnifier
+	if(axis != GP_AXIS_LX && axis != GP_AXIS_LY)
+		return;
+	if(value && detached)
+	{
+		detached = false;
+		cursorIntoView();
+	}
+	if(axis == GP_AXIS_LX)
+	{
+		stick.x = value;
+		pushAxis(SDL_CONTROLLER_AXIS_LEFTX, value);
+	}
+	else
+	{
+		stick.y = value;
+		pushAxis(SDL_CONTROLLER_AXIS_LEFTY, value);
+	}
+}
+
+void BareAppLink::poll()
+{
+	for(;;)
+	{
+		game_msg msg;
+		ssize_t n = recv(GAME_IPC_SOCK, &msg, sizeof(msg), MSG_DONTWAIT);
+
+		if(n == 0)
+			leave();
+		if(n < 0)
+		{
+			if(errno == EINTR)
+				continue;
+			if(errno == EAGAIN || errno == EWOULDBLOCK)
+				return;
+			leave();
+		}
+		if(n != sizeof(msg))
+			continue;
+		if(msg.type == GAME_MSG_BUTTON)
+			onButton(msg.code, msg.pressed, msg.flags & GAME_BTN_STICK);
+		else if(msg.type == GAME_MSG_AXIS)
+			onAxis(msg.code, msg.value);
+	}
+}
