+#pragma once
+
+#include "../../lib/Point.h"
+
+struct SDL_Surface;
+struct SDL_Window;
+struct game_shm;
+
+/// The client as a game of bare_app, an LVGL launcher for handheld consoles
+/// (ODROID-GO Advance). bare_app starts it with a socket and shared memory
+/// (bare_app's src/games/game_ipc.h) and runs SDL's dummy video driver: the
+/// window, twice the size of bare_app's video layer, stays in memory. Its
+/// frames go to bare_app scaled down 2:1 (overview) or as a 1:1 part around
+/// the cursor (magnifier); L1 switches. Gamepad events come back and become
+/// SDL game controller events, so VCMI's own controller support drives the
+/// game.
+class BareAppLink
+{
+public:
+	/// nullptr unless started by bare_app
+	static BareAppLink * get();
+
+	/// Settings the link needs (window size, software rendering and cursor,
+	/// quiet logging, bare_app's language); before logging is configured
+	void configure();
+	/// Publish the window's content (after SDL_RenderPresent); screen is
+	/// the same picture before the cursor was drawn over it
+	void present(SDL_Window * window, SDL_Surface * screen);
+	/// Gamepad messages into SDL events (main thread, before SDL_PollEvent)
+	void poll();
+
+private:
+	BareAppLink(game_shm * shm);
+
+	void onButton(int button, bool pressed, bool fromStick);
+	void onAxis(int axis, int value);
+	void pushButton(int sdlButton, bool pressed);
+	void pushAxis(int sdlAxis, int value);
+	void updateDpad();
+	void compose(const uint32_t * src, int srcW, int srcH, int srcPitch, uint32_t * dst);
+	void drawCursor(const SDL_Surface * window, const SDL_Surface * screen, uint32_t * dst);
+
+	game_shm * shm;
+	unsigned back = 0;	///< buffer being drawn
+	bool magnifier = false;
+	Point viewport;		///< top left of the magnified part, in window pixels
+	uint32_t dpad = 0;	///< D-pad directions held, gp_button bits
+	std::vector<uint32_t> last;	///< the frame published last
+	uint32_t framesDrawn = 0;
+	uint32_t framesSent = 0;
+	uint32_t statsSince = 0;	///< SDL_GetTicks()
+	uint64_t composeTime = 0;	///< SDL_GetPerformanceCounter() ticks
+};
