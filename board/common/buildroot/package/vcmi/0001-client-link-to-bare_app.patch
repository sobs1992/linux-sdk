--- /dev/null
+++ b/client/renderSDL/BareAppLink.cpp
@@ -0,0 +1,441 @@
+/*
+ * BareAppLink.cpp, part of VCMI engine
+ *
+ * Authors: listed in file AUTHORS in main folder
