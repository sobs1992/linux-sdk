+/// Heroes III maps and campaigns do not say their encoding: VCMI reads those
+/// in Maps/ with the selected language's one. A Russian edition's maps (CP1251)
+/// shown in English (CP1252) would turn into accented Latin garbage. In CP1252
+/// Cyrillic letters are bytes 0xC0..0xFF, accented Latin letters: real Western
+/// text never has them as most of its letters.
+static bool looksLikeCyrillic(const std::string & text)
+{
+	size_t letters = 0;
+	size_t high = 0;
+
+	for(unsigned char c : text)
+	{
+		if(c >= 0xC0)
+			high++;
+		else if((c | 0x20) >= 'a' && (c | 0x20) <= 'z')
+			letters++;
+	}
+	return high >= 2 && high > letters;
+}
