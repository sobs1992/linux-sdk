+#ifdef VCMI_BARE_APP
+/// The save list as bare_app's slots: all of them, empty ones too, and nothing else
+void SelectionTab::showSaveSlots()
+{
+	vstd::erase_if(allItems, [](const std::shared_ptr<ElementInfo> & item) { return item->saveSlot < 1; });
+	for(auto & item : allItems)
+	{
+		// a save of another kind (a campaign's) is hidden from the list, not from its slot
+		if(!item->mapHeader)
+			item->saveInit(ResourcePath(item->fileURI, EResType::SAVEGAME));
+	}
+
+	for(int slot = 1; slot <= BareAppLink::saveSlots; slot++)
+	{
+		if(vstd::contains_if(allItems, [slot](const std::shared_ptr<ElementInfo> & item) { return item->saveSlot == slot; }))
+			continue;
+		// the game being saved stands for it: its map is what the slot would get
+		auto empty = std::make_shared<ElementInfo>();
+		empty->mapHeader = std::make_unique<CMapHeader>(*GAME->interface()->cb->getMapHeader());
+		empty->originalFileURI = BareAppLink::savePath(slot);
+		empty->fileURI = boost::to_upper_copy(empty->originalFileURI);
+		empty->saveSlot = slot;
+		empty->emptySlot = true;
+		empty->name = BareAppLink::saveName(slot, true);
+		allItems.push_back(empty);
+	}
+}
+#endif
