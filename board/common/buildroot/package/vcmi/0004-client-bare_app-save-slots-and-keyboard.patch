--- /dev/null
+++ b/client/windows/BareAppKeyboard.cpp
@@ -0,0 +1,363 @@
+/*
+ * BareAppKeyboard.cpp, part of VCMI engine
+ *
+ * Authors: listed in file AUTHORS in main folder
+ *
+ * License: GNU General Public License v2.0 or later
+ * Full text of license available in license.txt file, in main folder
+ *
+ */
+#include "StdInc.h"
+#include "BareAppKeyboard.h"
+
+#include "../GameEngine.h"
+#include "../gui/Shortcut.h"
+#include "../gui/WindowHandler.h"
+#include "../render/Canvas.h"
+#include "../render/Colors.h"
+#include "../renderSDL/BareAppLink.h"
+#include "../widgets/CTextInput.h"
+#include "../widgets/Images.h"
+
+#include "../../lib/CConfigHandler.h"
+#include "../../lib/GameLibrary.h"
+#include "../../lib/texts/CGeneralTextHandler.h"
+#include "../../lib/texts/TextOperations.h"
+
+namespace
+{
+/// Keys are laid out on a grid this many keys wide
+constexpr int columns = 12;
+constexpr int rows = 5;
+constexpr int rowHeight = 56;
+constexpr int margin = 8;
+/// Between two keys
+constexpr int gap = 4;
+/// D-pad held: the first step, then the next ones (ms)
+constexpr uint32_t dpadDelay = 400;
+constexpr uint32_t dpadRepeat = 120;
+
+struct Layout
+{
+	const char * name;
+	std::array<const char *, 3> lower;
+	std::array<const char *, 3> upper;
+};
+
+const Layout layoutTable[] = {
+	{ "EN", { "qwertyuiop", "asdfghjkl", "zxcvbnm.,!" }, { "QWERTYUIOP", "ASDFGHJKL", "ZXCVBNM.,!" } },
+	{ "RU", { "йцукенгшщзхъ", "фывапролджэё", "ячсмитьбю.,!" }, { "ЙЦУКЕНГШЩЗХЪ", "ФЫВАПРОЛДЖЭЁ", "ЯЧСМИТЬБЮ.,!" } },
+};
+
+std::vector<std::string> characters(const std::string & text)
+{
+	std::vector<std::string> result;
+	for(size_t i = 0; i < text.size(); i += TextOperations::getUnicodeCharacterSize(text[i]))
+		result.push_back(text.substr(i, TextOperations::getUnicodeCharacterSize(text[i])));
+	return result;
+}
+}
+
+void BareAppKeyboard::open(const Rect & inputArea)
+{
+	if(!ENGINE->windows().findWindows<BareAppKeyboard>().empty())
+		return;
+	auto * input = dynamic_cast<CTextInput *>(CFocusable::inputWithFocus);
+	if(input)
+		ENGINE->windows().createAndPushWindow<BareAppKeyboard>(input, inputArea);
+}
+
+BareAppKeyboard::BareAppKeyboard(CTextInput * target, const Rect & inputArea)
+	: CWindowObject(SHADOW_DISABLED)
+	, target(target)
+	, initialText(target->getText())
+{
+	OBJECT_CONSTRUCTION;
+
+	// Across the screen, on the half without the input: it shows what is typed
+	const Point screen = ENGINE->screenDimensions();
+	pos.w = screen.x;
+	pos.h = rows * rowHeight + 2 * margin;
+	pos.x = 0;
+	pos.y = inputArea.center().y < screen.y / 2 ? screen.y - pos.h : 0;
+	backgroundTexture = std::make_shared<CFilledTexture>(ImagePath::builtin("DiBoxBck"), Rect(0, 0, pos.w, pos.h));
+
+	// Latin always, the game's own alphabet first
+	layouts.push_back(0);
+	if(settings["general"]["language"].String() == "russian")
+		layouts.insert(layouts.begin(), 1);
+	createKeys();
+
+	addUsedEvents(LCLICK | KEYBOARD | TIME);
+}
+
+void BareAppKeyboard::createKeys()
+{
+	std::array<std::vector<std::pair<Key, int>>, rows> grid;
+	const auto add = [&grid](int row, Action action, const std::string & lower = "", const std::string & upper = "", int width = 1)
+	{
+		grid[row].push_back({ Key{ Rect(), row, action, lower, upper }, width });
+	};
+
+	for(const auto & digit : characters("1234567890-"))
+		add(0, Action::TYPE, digit, digit);
+	add(0, Action::ERASE);
+
+	const Layout & letters = layoutTable[layouts[layout]];
+	for(int row = 0; row < 3; row++)
+	{
+		const auto lower = characters(letters.lower[row]);
+		const auto upper = characters(letters.upper[row]);
+		for(size_t i = 0; i < lower.size() && i < upper.size(); i++)
+			add(row + 1, Action::TYPE, lower[i], upper[i]);
+	}
+
+	const int switcher = layouts.size() > 1 ? 2 : 0;
+	add(4, Action::CAPS, "", "", 2);
+	if(switcher)
+		add(4, Action::LAYOUT, "", "", switcher);
+	add(4, Action::SPACE, " ", " ", columns - 2 - switcher - 3);
+	add(4, Action::DONE, "", "", 3);
+
+	// Shorter rows in the middle
+	keys.clear();
+	const int unit = (pos.w - 2 * margin) / columns;
+	for(int row = 0; row < rows; row++)
+	{
+		int units = 0;
+		for(const auto & key : grid[row])
+			units += key.second;
+		int x = margin + (columns - units) * unit / 2;
+		const int y = margin + row * rowHeight;
+		for(auto & [key, width] : grid[row])
+		{
+			key.area = Rect(x + gap / 2, y + gap / 2, width * unit - gap, rowHeight - gap);
+			keys.push_back(key);
+			x += width * unit;
+		}
+	}
+}
+
+int BareAppKeyboard::keyAt(const Point & position) const
+{
+	for(size_t i = 0; i < keys.size(); i++)
+		if((keys[i].area + pos.topLeft()).isInside(position))
+			return static_cast<int>(i);
+	return -1;
+}
+
+std::string BareAppKeyboard::label(const Key & key) const
+{
+	switch(key.action)
+	{
+		case Action::TYPE:
+			return caps ? key.upper : key.lower;
+		case Action::ERASE:
+			return LIBRARY->generaltexth->translate("vcmi.bareApp.keyboard.erase");
+		case Action::CAPS:
+			return LIBRARY->generaltexth->translate("vcmi.bareApp.keyboard.caps");
+		case Action::LAYOUT:
+			return layoutTable[layouts[(layout + 1) % layouts.size()]].name;
+		case Action::SPACE:
+			return LIBRARY->generaltexth->translate("vcmi.bareApp.keyboard.space");
+		case Action::DONE:
+			return LIBRARY->generaltexth->translate("vcmi.bareApp.keyboard.done");
+	}
+	return "";
+}
+
+void BareAppKeyboard::showAll(Canvas & to)
+{
+	CWindowObject::showAll(to);
+
+	for(size_t i = 0; i < keys.size(); i++)
+	{
+		const Key & key = keys[i];
+		const Rect area = key.area + pos.topLeft();
+		const bool lit = static_cast<int>(i) == hovered;
+		const bool on = key.action == Action::CAPS && caps;
+
+		to.drawColorBlended(area, lit ? ColorRGBA(255, 255, 255, 48) : ColorRGBA(0, 0, 0, 96));
+		to.drawBorder(area, lit ? Colors::YELLOW : ColorRGBA(128, 100, 75), lit ? 2 : 1);
+		to.drawText(area.center(), key.action == Action::TYPE ? FONT_BIG : FONT_MEDIUM,
+			lit || on ? Colors::YELLOW : Colors::WHITE, ETextAlignment::CENTER, label(key));
+	}
+}
+
+void BareAppKeyboard::press(const Key & key)
+{
+	switch(key.action)
+	{
+		case Action::TYPE:
+		case Action::SPACE:
+			target->textInputted(caps ? key.upper : key.lower);
+			break;
+		case Action::ERASE:
+			target->keyPressed(EShortcut::GLOBAL_BACKSPACE);
+			break;
+		case Action::CAPS:
+			caps = !caps;
+			break;
+		case Action::LAYOUT:
+			layout = (layout + 1) % layouts.size();
+			createKeys();
+			hovered = keyAt(ENGINE->getCursorPosition());
+			break;
+		case Action::DONE:
+			finish(true);
+			return;
+	}
+	// the input is under this window, inactive: it does not redraw itself
+	ENGINE->windows().totalRedraw();
+}
+
+void BareAppKeyboard::step(const Point & direction)
+{
+	if(keys.empty())
+		return;
+
+	int next = hovered;
+	if(next < 0)
+	{
+		// from the first letter
+		next = static_cast<int>(std::find_if(keys.begin(), keys.end(), [](const Key & key) { return key.row == 1; }) - keys.begin());
+	}
+	else
+	{
+		if(direction.x)
+		{
+			// along the row, round
+			std::vector<int> row;
+			for(size_t i = 0; i < keys.size(); i++)
+				if(keys[i].row == keys[next].row)
+					row.push_back(static_cast<int>(i));
+			const int at = static_cast<int>(std::find(row.begin(), row.end(), next) - row.begin());
+			const int count = static_cast<int>(row.size());
+			next = row[(at + direction.x + count) % count];
+		}
+		if(direction.y)
+		{
+			// the nearest key of the next row, round
+			const int row = (keys[next].row + direction.y + rows) % rows;
+			const int x = keys[next].area.center().x;
+			int best = -1;
+			for(size_t i = 0; i < keys.size(); i++)
+			{
+				if(keys[i].row != row)
+					continue;
+				if(best < 0 || std::abs(keys[i].area.center().x - x) < std::abs(keys[best].area.center().x - x))
+					best = static_cast<int>(i);
+			}
+			next = best;
+		}
+	}
+
+	hovered = next;
+	BareAppLink::moveCursor(keys[next].area.center() + pos.topLeft());
+	redraw();
+}
+
+bool BareAppKeyboard::targetAlive() const
+{
+	// an input that is gone has lost its focus too
+	return CFocusable::inputWithFocus == target;
+}
+
+void BareAppKeyboard::finish(bool accept)
+{
+	if(targetAlive())
+	{
+		if(!accept && target->getText() != initialText)
+		{
+			target->setText(initialText);
+			if(target->onTextEdited)
+				target->onTextEdited(initialText);
+		}
+		// an input with its own confirmation (a town's name) confirms or
+		// cancels on these, and drops its focus
+		target->keyPressed(accept ? EShortcut::GLOBAL_ACCEPT : EShortcut::GLOBAL_CANCEL);
+		// the others drop it here: back under focus, they would open the keyboard again
+		target->removeFocus();
+	}
+	close();
+	ENGINE->windows().totalRedraw();
+}
+
+void BareAppKeyboard::clickPressed(const Point & cursorPosition)
+{
+	pressed = keyAt(cursorPosition);
+}
+
+void BareAppKeyboard::clickReleased(const Point & cursorPosition)
+{
+	// on release: the release of a click that closes the keyboard stays here
+	const int key = keyAt(cursorPosition);
+	if(key >= 0 && key == pressed)
+	{
+		const Key copy = keys[key];	// a layout switch replaces the keys
+		press(copy);
+	}
+	pressed = -1;
+}
+
+bool BareAppKeyboard::captureThisKey(EShortcut key)
+{
+	return key == EShortcut::GLOBAL_ACCEPT || key == EShortcut::GLOBAL_CANCEL
+		|| key == EShortcut::GLOBAL_BACKSPACE || key == EShortcut::ADVENTURE_END_TURN;
+}
+
+void BareAppKeyboard::keyPressed(EShortcut key)
+{
+	switch(key)
+	{
+		case EShortcut::GLOBAL_ACCEPT:
+			finish(true);
+			break;
+		case EShortcut::GLOBAL_CANCEL:
+			finish(false);
+			break;
+		case EShortcut::GLOBAL_BACKSPACE:
+		case EShortcut::ADVENTURE_END_TURN:	// X on the console
+			press(Key{ Rect(), 0, Action::ERASE, "", "" });
+			break;
+		default:
+			break;
+	}
+}
+
+void BareAppKeyboard::tick(uint32_t msPassed)
+{
+	if(!targetAlive())
+	{
+		close();
+		return;
+	}
+
+	const int under = keyAt(ENGINE->getCursorPosition());
+	if(under != hovered)
+	{
+		hovered = under;
+		redraw();
+	}
+
+	// The D-pad steps from key to key (while the magnifier is off: it moves that)
+	auto * link = BareAppLink::get();
+	const Point direction = link ? link->mapScrollDirection() : Point(0, 0);
+	if(direction != dpad)
+	{
+		dpad = direction;
+		dpadRepeatIn = dpadDelay;
+		if(direction != Point(0, 0))
+			step(direction);
+	}
+	else if(direction != Point(0, 0))
+	{
+		if(msPassed >= dpadRepeatIn)
+		{
+			step(direction);
+			dpadRepeatIn = dpadRepeat;
+		}
+		else
+			dpadRepeatIn -= msPassed;
+	}
+}
diff --git a/client/windows/BareAppKeyboard.h b/client/windows/BareAppKeyboard.h
new file mode 100644
index 0000000..de599ef
