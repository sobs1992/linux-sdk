+std::string BareAppLink::savePath(int slot)
+{
+	if(slot == 0)
+		return "Saves/Autosave";
+	return (boost::format("Saves/Slot%02d") % slot).str();
+}
+
+int BareAppLink::saveSlot(const std::string & path)
+{
+	// only right in Saves/, not in its folders
+	if(!boost::istarts_with(path, "Saves/"))
+		return -1;
+	const std::string name = path.substr(6);
+	if(boost::iequals(name, "Autosave"))
+		return 0;
+	if(name.size() != 6 || !boost::istarts_with(name, "Slot") || !std::isdigit(name[4]) || !std::isdigit(name[5]))
+		return -1;
+	const int slot = std::stoi(name.substr(4));
+	return slot >= 1 && slot <= saveSlots ? slot : -1;
+}
+
+std::string BareAppLink::saveName(int slot, bool empty)
+{
+	if(slot == 0)
+		return LIBRARY->generaltexth->translate("vcmi.bareApp.autosave");
+	std::string name = LIBRARY->generaltexth->translate(empty ? "vcmi.bareApp.emptySlot" : "vcmi.bareApp.slot");
+	boost::replace_first(name, "%d", std::to_string(slot));
+	return name;
 }
 
