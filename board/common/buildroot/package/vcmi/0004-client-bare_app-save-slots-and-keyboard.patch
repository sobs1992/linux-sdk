+++ b/client/windows/BareAppKeyboard.h
@@ -0,0 +1,69 @@
+/*
+ * BareAppKeyboard.h, part of VCMI engine
+ *
+ * Authors: listed in file AUTHORS in main folder
+ *
+ * License: GNU General Public License v2.0 or later
+ * Full text of license available in license.txt file, in main folder
+ *
+ */
+#pragma once
+
+#include "CWindowObject.h"
+
+class CFilledTexture;
+class CTextInput;
+
+/// On-screen keyboard for bare_app: the console has no keyboard. A text
+/// input opens it when the player clicks it (InputHandler::startTextInput),
+/// and the keys type into that input. The stick's cursor or the D-pad picks
+/// a key, A presses it; B is "done", Select cancels, X erases.
+class BareAppKeyboard : public CWindowObject
+{
+	enum class Action
+	{
+		TYPE, ERASE, CAPS, LAYOUT, SPACE, DONE
+	};
+
+	struct Key
+	{
+		Rect area;	///< in the window
+		int row;
+		Action action;
+		std::string lower;	///< what it types, or its label
+		std::string upper;
+	};
+
+	CTextInput * target;
+	std::string initialText;
+	std::shared_ptr<CFilledTexture> backgroundTexture;
+	std::vector<Key> keys;
+	std::vector<int> layouts;	///< indices into the layout table
+	size_t layout = 0;
+	bool caps = false;
+	int hovered = -1;	///< key under the cursor
+	int pressed = -1;	///< key the click started on
+	Point dpad;
+	uint32_t dpadRepeatIn = 0;	///< ms
+
+	void createKeys();
+	int keyAt(const Point & position) const;
+	std::string label(const Key & key) const;
+	void press(const Key & key);
+	void step(const Point & direction);
+	void finish(bool accept);
+	bool targetAlive() const;
+
+public:
+	BareAppKeyboard(CTextInput * target, const Rect & inputArea);
+
+	/// Opens the keyboard for the text input with focus, unless it is open
+	static void open(const Rect & inputArea);
+
+	void showAll(Canvas & to) override;
+	void clickPressed(const Point & cursorPosition) override;
+	void clickReleased(const Point & cursorPosition) override;
+	bool captureThisKey(EShortcut key) override;
+	void keyPressed(EShortcut key) override;
+	void tick(uint32_t msPassed) override;
+};
