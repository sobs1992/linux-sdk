+/// A USB keyboard's key: SDL's key event, and the character it types while
+/// a text input waits for one (SDL sends both too)
+void BareAppLink::onKey(int code, bool pressed)
+{
+	const UsbKey * key = std::find_if(std::begin(usbKeys), std::end(usbKeys), [code](const UsbKey & k) { return k.code == code; });
+	if(key == std::end(usbKeys))
+		return;
+	keyboardUsed = true;
+
+	const uint16_t mod = usbKeyMod(key->scancode);
+	if(mod)
+		keyMods = pressed ? keyMods | mod : keyMods & ~mod;
+	if(key->scancode == SDL_SCANCODE_CAPSLOCK && pressed)
+		keyMods ^= KMOD_CAPS;
+	if(key->scancode == SDL_SCANCODE_NUMLOCKCLEAR && pressed)
+		keyMods ^= KMOD_NUM;
+	SDL_SetModState(static_cast<SDL_Keymod>(keyMods));
+
+	SDL_Event event = {};
+	event.type = pressed ? SDL_KEYDOWN : SDL_KEYUP;
+	event.key.timestamp = SDL_GetTicks();
+	event.key.state = pressed ? SDL_PRESSED : SDL_RELEASED;
+	event.key.keysym.scancode = key->scancode;
+	event.key.keysym.sym = SDL_GetKeyFromScancode(key->scancode);
+	event.key.keysym.mod = keyMods;
+	SDL_PushEvent(&event);
+
+	if(!pressed || !key->lower || (keyMods & (KMOD_CTRL | KMOD_ALT | KMOD_GUI)) || SDL_IsTextInputActive() != SDL_TRUE)
+		return;
+	bool upper = keyMods & KMOD_SHIFT;
+	if(key->lower >= 'a' && key->lower <= 'z' && (keyMods & KMOD_CAPS))
+		upper = !upper;
+	SDL_Event text = {};
+	text.type = SDL_TEXTINPUT;
+	text.text.timestamp = SDL_GetTicks();
+	text.text.text[0] = upper ? key->upper : key->lower;
+	SDL_PushEvent(&text);
+}
+
+/// Where the USB mouse has the cursor, in screen pixels: VCMI's cursor
+/// unless only the mouse has moved it since (VCMI keeps its own position
+/// while a button drags)
+Point BareAppLink::mousePosition()
+{
+	const Point & engine = ENGINE->getCursorPosition();
+	if(engine != mouseEnginePos)
+	{
+		mousePos = engine;
+		mouseEnginePos = engine;
+	}
+	return mousePos;
+}
+
+void BareAppLink::onMouseMove(int axis, int value)
+{
+	if(axis == GAME_MOUSE_X)
+		mouseMoved.x += value;
+	else if(axis == GAME_MOUSE_Y)
+		mouseMoved.y += value;
+	else if(axis == GAME_MOUSE_WHEEL && value)
+	{
+		const int scale = ENGINE->screenHandler().getScalingFactor();
+		const Point position = mousePosition();
+		SDL_Event event = {};
+		event.type = SDL_MOUSEWHEEL;
+		event.wheel.timestamp = SDL_GetTicks();
+		event.wheel.y = value;
+		event.wheel.preciseY = static_cast<float>(value);
+		event.wheel.direction = SDL_MOUSEWHEEL_NORMAL;
+		event.wheel.mouseX = position.x * scale;
+		event.wheel.mouseY = position.y * scale;
+		SDL_PushEvent(&event);
+	}
+}
+
+/// The moves of a poll() as one SDL mouse motion, counts as screen pixels
+void BareAppLink::flushMouseMove()
+{
+	if(mouseMoved == Point(0, 0))
+		return;
+	if(detached)
+	{
+		// as the stick: the magnifier comes back to the cursor
+		detached = false;
+		cursorIntoView();
+	}
+	const int scale = ENGINE->screenHandler().getScalingFactor();
+	const Point screen = ENGINE->screenDimensions();
+	const Point from = mousePosition();
+	const Point to(std::clamp(from.x + mouseMoved.x, 0, screen.x - 1), std::clamp(from.y + mouseMoved.y, 0, screen.y - 1));
+	mouseMoved = Point(0, 0);
+	if(to == from)
+		return;
+	mousePos = to;
+
+	SDL_Event event = {};
+	event.type = SDL_MOUSEMOTION;
+	event.motion.timestamp = SDL_GetTicks();
+	event.motion.state = mouseButtons;
+	event.motion.x = to.x * scale;
+	event.motion.y = to.y * scale;
+	event.motion.xrel = (to.x - from.x) * scale;
+	event.motion.yrel = (to.y - from.y) * scale;
+	SDL_PushEvent(&event);
+}
+
+void BareAppLink::onMouseButton(int button, bool pressed)
+{
+	const int sdlButton = button == GAME_MOUSE_LEFT ? SDL_BUTTON_LEFT
+		: button == GAME_MOUSE_RIGHT ? SDL_BUTTON_RIGHT
+		: button == GAME_MOUSE_MIDDLE ? SDL_BUTTON_MIDDLE : 0;
+	if(!sdlButton)
+		return;
+	flushMouseMove();	// the press where the cursor is now
+	const int scale = ENGINE->screenHandler().getScalingFactor();
+	const Point position = mousePosition();
+	const uint32_t now = SDL_GetTicks();
+
+	if(pressed)
+	{
+		const Point d = position - clickPos;
+		if(sdlButton == clickButton && now - clickAt <= doubleClickMs
+			&& std::abs(d.x) <= doubleClickDistance && std::abs(d.y) <= doubleClickDistance)
+			clicks = std::min<int>(clicks + 1, 255);
+		else
+			clicks = 1;
+		clickAt = now;
+		clickPos = position;
+		clickButton = sdlButton;
+		mouseButtons |= SDL_BUTTON(sdlButton);
+	}
+	else
+		mouseButtons &= ~SDL_BUTTON(sdlButton);
+
+	SDL_Event event = {};
+	event.type = pressed ? SDL_MOUSEBUTTONDOWN : SDL_MOUSEBUTTONUP;
+	event.button.timestamp = now;
+	event.button.button = sdlButton;
+	event.button.state = pressed ? SDL_PRESSED : SDL_RELEASED;
+	event.button.clicks = sdlButton == clickButton ? clicks : 1;
+	event.button.x = position.x * scale;
+	event.button.y = position.y * scale;
+	SDL_PushEvent(&event);
+}
+
