+/// BARE_APP_VCMI_KEYS=ogu (bare_app on the ODROID-GO Ultra)
+bool BareAppLink::ultraKeysSet()
+{
+	const char * keys = std::getenv("BARE_APP_VCMI_KEYS");
+	return keys && !std::strcmp(keys, "ogu");
+}
+
+/// The ODROID-GO Ultra's row of F1..F6: F1 (minimise) and F6 (quit) are
+/// bare_app's, F2 and F3 are held as Ctrl and Shift, F4 accepts, F5 ends
+/// the turn on the adventure map, elsewhere it is Escape: cancel, also
+/// back in the main menu's pages (the controller's b is not). The options
+/// stay on the map's own button. false: as on the OGA.
+bool BareAppLink::onUltraButton(int button, bool pressed)
+{
+	switch(button)
+	{
+		case GP_F1:
+		case GP_F6:
+			return true;
+		case GP_F2:
+			ctrl = pressed;
+			return true;
+		case GP_F3:
+			shift = pressed;
+			return true;
+		case GP_F4:
+			pushButton(SDL_CONTROLLER_BUTTON_A, pressed);
+			return true;
+		case GP_F5:
+			// the release goes to what the press was, also if the map has gone meanwhile
+			if(pressed)
+				f5EndsTurn = adventureInt && adventureInt->isActive()
+					&& adventureInt->getAdventureShortcuts().optionCanEndTurn();
+			if(f5EndsTurn)
+				pushButton(SDL_CONTROLLER_BUTTON_BACK, pressed);
+			else
+				pushKey(SDL_SCANCODE_ESCAPE, pressed);
+			return true;
+		default:
+			return false;
+	}
+}
+
+/// The right stick (the GO Ultra has one) does what the D-pad does
+void BareAppLink::onRightStick(int axis, int value)
+{
+	const uint32_t negative = GP_BIT(axis == GP_AXIS_RX ? GP_LEFT : GP_UP);
+	const uint32_t positive = GP_BIT(axis == GP_AXIS_RX ? GP_RIGHT : GP_DOWN);
+	const uint32_t held = stickDpad & (negative | positive);
+	uint32_t now = 0;
+
+	if(value >= stickDpadPress || ((held & positive) && value > stickDpadRelease))
+		now = positive;
+	else if(value <= -stickDpadPress || ((held & negative) && value < -stickDpadRelease))
+		now = negative;
+	if(now == held)
+		return;
+	stickDpad = (stickDpad & ~(negative | positive)) | now;
+	updateDpad();
+}
+
 void BareAppLink::onAxis(int axis, int value)
 {
+	if(axis == GP_AXIS_RX || axis == GP_AXIS_RY)
+	{
+		onRightStick(axis, value);
+		return;
+	}
 	// The left stick moves the cursor, from inside the magnifier
 	if(axis != GP_AXIS_LX && axis != GP_AXIS_LY)
 		return;
