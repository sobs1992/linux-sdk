+#ifdef VCMI_BARE_APP
+namespace
+{
+/// Map headers read once a session when bare_app runs the client: the new
+/// game list read all of them whenever it opened, a second on the ODROID-GO
+/// Advance. prefetchMaps() reads them in the background at the main menu.
+/// nullptr: the map cannot be read.
+struct ReadMaps
+{
+	std::map<ResourcePath, std::shared_ptr<ElementInfo>> maps;
+	std::future<void> prefetch;
+	std::mutex mutex;
+};
+
+/// Never destroyed: a map header takes its texts out of LIBRARY when it
+/// goes, and at exit LIBRARY goes first (the game crashed on quitting)
+ReadMaps & readMaps()
+{
+	static auto * state = new ReadMaps;
+	return *state;
+}
+
+std::shared_ptr<ElementInfo> readMap(const ResourcePath & file)
+{
+	{
+		std::scoped_lock lock(readMaps().mutex);
+		auto found = readMaps().maps.find(file);
+		if(found != readMaps().maps.end())
+			return found->second;
+	}
+
+	std::shared_ptr<ElementInfo> mapInfo;
+	try
+	{
+		mapInfo = std::make_shared<ElementInfo>();
+		mapInfo->mapInit(file.getOriginalName());
+		mapInfo->name = mapInfo->getNameForList();
+	}
+	catch(std::exception & e)
+	{
+		logGlobal->error("Map %s is invalid. Message: %s", file.getName(), e.what());
+		mapInfo = nullptr;
+	}
+
+	std::scoped_lock lock(readMaps().mutex);
+	readMaps().maps[file] = mapInfo;
+	return mapInfo;
+}
+
+void waitForMapPrefetch()
+{
+	std::future<void> prefetch;
+	{
+		std::scoped_lock lock(readMaps().mutex);
+		prefetch = std::move(readMaps().prefetch);
+	}
+	if(prefetch.valid())
+		prefetch.wait();
+}
+}
+
+void SelectionTab::prefetchMaps()
+{
+	if(!BareAppLink::get())
+		return;
+	{
+		std::scoped_lock lock(readMaps().mutex);
+		if(readMaps().prefetch.valid() || !readMaps().maps.empty())
+			return;
+	}
+
+	// the file lists are made here, in the main thread: only the headers
+	// are read in the background, as VCMI reads them in its network thread
+	auto files = getNewGameMaps();
+	std::scoped_lock lock(readMaps().mutex);
+	readMaps().prefetch = std::async(std::launch::async, [files = std::move(files)]()
+	{
+		setThreadName("prefetchMaps");
+		for(const auto & file : files)
+			readMap(file);
+	});
+}
