+namespace
+{
+/// A WAV file in the device's format, its rate converted by linear
+/// interpolation: SDL's windowed sinc filter took ~0.1 s for a few seconds
+/// of a 22 kHz sound on the ODROID-GO Advance, and the game loads sounds as
+/// it plays them (at a battle's start, for every new creature). nullptr
+/// for what it does not handle: SDL converts that.
+Mix_Chunk * loadWavQuickly(const ui8 * data, si64 size)
+{
+	int freq;
+	Uint16 format;
+	int channels;
+	if(!Mix_QuerySpec(&freq, &format, &channels) || format != AUDIO_S16SYS || channels != 2)
+		return nullptr;
+
+	SDL_AudioSpec spec;
+	Uint8 * buffer;
+	Uint32 length;
+	if(!SDL_LoadWAV_RW(SDL_RWFromConstMem(data, static_cast<int>(size)), 1, &spec, &buffer, &length))
+		return nullptr;
+	const int sampleBytes = spec.format == AUDIO_S16LSB ? 2 : 1;
+	const size_t frames = length / (sampleBytes * std::max<int>(spec.channels, 1));
+	if((spec.format != AUDIO_S16LSB && spec.format != AUDIO_U8) || (spec.channels != 1 && spec.channels != 2) || spec.freq <= 0 || frames == 0)
+	{
+		SDL_FreeWAV(buffer);
+		return nullptr;
+	}
+
+	const auto sample = [&](size_t frame, int channel) -> int
+	{
+		const size_t i = frame * spec.channels + (spec.channels == 2 ? channel : 0);
+		if(spec.format == AUDIO_U8)
+			return (buffer[i] - 128) * 256;
+		Sint16 value;
+		std::memcpy(&value, buffer + 2 * i, 2);
+		return SDL_SwapLE16(value);
+	};
+	const size_t outFrames = static_cast<uint64_t>(frames) * freq / spec.freq;
+	auto * out = static_cast<Sint16 *>(SDL_malloc(std::max<size_t>(outFrames, 1) * 4));
+	auto * chunk = static_cast<Mix_Chunk *>(SDL_malloc(sizeof(Mix_Chunk)));
+	if(!out || !chunk)
+	{
+		SDL_free(out);
+		SDL_free(chunk);
+		SDL_FreeWAV(buffer);
+		return nullptr;
+	}
+	for(size_t i = 0; i < outFrames; i++)
+	{
+		// the source position, 16.16 fixed point
+		const uint64_t position = static_cast<uint64_t>(i) * spec.freq * 65536 / freq;
+		const size_t frame = position >> 16;
+		const size_t next = std::min(frame + 1, frames - 1);
+		const int weight = static_cast<int>(position & 0xffff);
+		for(int c = 0; c < 2; c++)
+			out[2 * i + c] = static_cast<Sint16>((sample(frame, c) * (65536 - weight) + sample(next, c) * weight) >> 16);
+	}
+	SDL_FreeWAV(buffer);
+
+	// as Mix_LoadWAV_RW makes them: Mix_FreeChunk frees both
+	chunk->allocated = 1;
+	chunk->abuf = reinterpret_cast<Uint8 *>(out);
+	chunk->alen = static_cast<Uint32>(outFrames * 4);
+	chunk->volume = MIX_MAX_VOLUME;
+	return chunk;
+}
+}
+#endif
+
+static Mix_Chunk * loadChunk(const ui8 * data, si64 size)
+{
+#ifdef VCMI_BARE_APP
+	if(BareAppLink::get())
+	{
+		if(auto * chunk = loadWavQuickly(data, size))
+			return chunk;
+	}
+#endif
+	return Mix_LoadWAV_RW(SDL_RWFromConstMem(data, static_cast<int>(size)), 1); // will free ops
+}
