+/// The cache holds images only while something uses them: closing a window
+/// let go of all of its images, and opening it again read and decoded them
+/// again (a third of a second for the kingdom overview on the ODROID-GO
+/// Advance). When bare_app runs the client, the ones used last stay loaded.
+void RenderHandler::keepRecent(const std::shared_ptr<ScalableImageShared> & image)
+{
+#ifdef VCMI_BARE_APP
+	/// Pixels as 32 bits (paletted ones take less): the adventure map, a
+	/// town and the windows around them, on a console with 1 GB
+	static constexpr size_t budget = 64 * 1024 * 1024;
+
+	if(!BareAppLink::get())
+		return;
+
+	auto found = recentIndex.find(image.get());
+	if(found != recentIndex.end())
+	{
+		recentImages.splice(recentImages.begin(), recentImages, found->second);
+		return;
+	}
+
+	const Point size = image->dimensions();
+	const size_t bytes = static_cast<size_t>(std::max(size.x, 0)) * std::max(size.y, 0) * 4;
+	recentImages.emplace_front(image, bytes);
+	recentIndex[image.get()] = recentImages.begin();
