+/*
+==================
+Menu_GamepadKey
+
+A gamepad drives the menus as the keyboard does: the D-pad and the left
+stick (four keys in a menu, sdl_input.c) go from item to item and change
+values as the arrow keys, A chooses as Enter, B goes back as Escape.
+While a binding waits for its key the button itself is bound, but B
+cancels it as Escape does (a binding entered by mistake must not take
+the next button), and neither the sticks, which move and look, nor Start
+are bound (0: the key is dropped; Start's own binding, togglemenu, gives
+the menus an Escape, which cancels).
+==================
+*/
+int Menu_GamepadKey( int key ) {
+	if ( g_waitingForKey ) {
+		switch ( key ) {
+		case K_PAD0_B:
+			return K_ESCAPE;
+		case K_PAD0_START:
+		case K_PAD0_LEFTSTICK_LEFT:
+		case K_PAD0_LEFTSTICK_RIGHT:
+		case K_PAD0_LEFTSTICK_UP:
+		case K_PAD0_LEFTSTICK_DOWN:
+		case K_PAD0_RIGHTSTICK_LEFT:
+		case K_PAD0_RIGHTSTICK_RIGHT:
+		case K_PAD0_RIGHTSTICK_UP:
+		case K_PAD0_RIGHTSTICK_DOWN:
+			return 0;
+		}
+		return key;
+	}
+	switch ( key ) {
+	case K_PAD0_DPAD_UP:
+	case K_PAD0_LEFTSTICK_UP:
+		return K_UPARROW;
+	case K_PAD0_DPAD_DOWN:
+	case K_PAD0_LEFTSTICK_DOWN:
+		return K_DOWNARROW;
+	case K_PAD0_DPAD_LEFT:
+	case K_PAD0_LEFTSTICK_LEFT:
+		return K_LEFTARROW;
+	case K_PAD0_DPAD_RIGHT:
+	case K_PAD0_LEFTSTICK_RIGHT:
+		return K_RIGHTARROW;
+	case K_PAD0_A:
+		return K_ENTER;
+	case K_PAD0_B:
+		return K_ESCAPE;
+	}
+	return key;
+}
+
+/*
+==================
+A gamepad's pointer is its selection
+
+A gamepad has one thing chosen: the item under the pointer. Keys that
+choose another item take the pointer onto it (Menu_PointerToCursorItem);
+the pointer (the right stick) over an item of another menu, the tabs above
+a panel, gives that menu the keys (Menus_FocusUnderPointer). B goes back
+to the menu this one was opened from while that one is up (Menu_FocusOpener),
+otherwise it is Escape, and the menus opened from one that Escape closed
+close with it (Menus_CloseOpenedFrom).
+==================
+*/
+static void Menu_TakeFocus( menuDef_t *menu ) {
+	menuDef_t *left = Menu_GetFocused();
+	int i;
+
+	// a page that a click outside closes (outOfBoundsClick: the pages of
+	// the in-game menu) closes when the keys leave it, unless for a menu
+	// opened from it: otherwise the next page would open over it
+	if ( left && left != menu && ( left->window.flags & WINDOW_OOB_CLICK ) && menu->opener != left ) {
+		Menu_RunCloseScript( left );
+		left->window.flags &= ~( WINDOW_VISIBLE | WINDOW_HASFOCUS );
+	}
+	// the menus left show nothing chosen (they keep their cursorItem)
+	for ( i = 0; i < menuCount; i++ ) {
+		if ( &Menus[i] != menu && ( Menus[i].window.flags & WINDOW_VISIBLE ) ) {
+			Menu_ClearFocus( &Menus[i] );
+		}
+		Menus[i].window.flags &= ~WINDOW_HASFOCUS;
+	}
+	menu->window.flags |= WINDOW_HASFOCUS;
+}
+
+void Menu_PointerToCursorItem( void ) {
+	menuDef_t *menu = Menu_GetFocused();
+	itemDef_t *item;
+	rectDef_t r;
+
+	if ( !menu || menu->cursorItem < 0 || menu->cursorItem >= menu->itemCount ) {
+		return;
+	}
+	item = menu->items[menu->cursorItem];
+	if ( !( item->window.flags & WINDOW_VISIBLE ) || ( item->window.flags & WINDOW_DECORATION ) ) {
+		return;
+	}
+	r = item->window.rect;
+	if ( item->type == ITEM_TYPE_TEXT && item->text ) {
+		r = *Item_CorrectedTextRect( item );    // text takes the focus there only
+	}
+	DC->cursorx = r.x + r.w / 2;
+	DC->cursory = r.y + r.h / 2;
+	Display_MouseMove( NULL, DC->cursorx, DC->cursory );
+}
+
+void Menus_FocusUnderPointer( void ) {
+	menuDef_t *focus = Menu_GetFocused();
+	int i;
+
+	if ( !focus || ( focus->window.flags & WINDOW_POPUP ) || g_waitingForKey || g_editingField || itemCapture ||
+		 Menu_OverActiveItem( focus, DC->cursorx, DC->cursory ) ) {
+		return;
+	}
+	for ( i = 0; i < menuCount; i++ ) {
+		if ( &Menus[i] != focus && Menu_OverActiveItem( &Menus[i], DC->cursorx, DC->cursory ) ) {
+			Menu_TakeFocus( &Menus[i] );
+			return;
+		}
+	}
+}
+
+qboolean Menu_FocusOpener( void ) {
+	menuDef_t *menu = Menu_GetFocused();
+	menuDef_t *opener = menu ? menu->opener : NULL;
+
+	if ( !menu || ( menu->window.flags & WINDOW_POPUP ) || !opener || opener == menu ||
+		 !( opener->window.flags & WINDOW_VISIBLE ) ) {
+		return qfalse;
+	}
+	Menu_TakeFocus( opener );
+	// nothing chosen there yet (opened by a script, never used): its first item
+	if ( opener->cursorItem < 0 || opener->cursorItem >= opener->itemCount ||
+		 !( opener->items[opener->cursorItem]->window.flags & WINDOW_VISIBLE ) ) {
+		opener->cursorItem = -1;
+		Menu_SetNextCursorItem( opener );
+	}
+	Menu_PointerToCursorItem();
+	return qtrue;
+}
+
+void Menus_CloseOpenedFrom( menuDef_t *menu ) {
+	int i;
+
+	if ( !menu || ( menu->window.flags & WINDOW_VISIBLE ) ) {
+		return;
+	}
+	for ( i = 0; i < menuCount; i++ ) {
+		if ( Menus[i].opener == menu && ( Menus[i].window.flags & WINDOW_VISIBLE ) ) {
+			Menu_RunCloseScript( &Menus[i] );
+			Menus[i].window.flags &= ~( WINDOW_VISIBLE | WINDOW_HASFOCUS );
+			Menus_CloseOpenedFrom( &Menus[i] );
+		}
+	}
+}
+
