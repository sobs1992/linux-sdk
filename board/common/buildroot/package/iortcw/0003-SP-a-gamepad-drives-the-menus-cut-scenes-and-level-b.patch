+/*
+===============
+IN_GamepadPointer
+
+While a menu is up the right stick moves the mouse pointer: the menus are
+made for a mouse (a level's briefing has a button shown only under it).
+Full tilt crosses the menus' 640 units in about a second; the speed goes
+with the square of the tilt, for fine moves.
+===============
+*/
+#define GAMEPAD_POINTER_SPEED 640.0f
+
+static void IN_GamepadPointer( void )
+{
+	static int lastTime;
+	static float rest[2];
+	int now = Sys_Milliseconds( );
+	float dt = ( now - lastTime ) * 0.001f;
+	int i, move[2];
+
+	lastTime = now;
+	if( !gamepad || !( Key_GetCatcher( ) & KEYCATCH_UI ) || dt <= 0.0f )
+	{
+		rest[0] = rest[1] = 0.0f;
+		return;
+	}
+	if( dt > 0.05f )
+		dt = 0.05f;
+
+	for( i = 0; i < 2; i++ )
+	{
+		float f = SDL_GameControllerGetAxis( gamepad, SDL_CONTROLLER_AXIS_RIGHTX + i ) / 32767.0f;
+		float a = ( fabs( f ) - in_joystickThreshold->value ) / ( 1.0f - in_joystickThreshold->value );
+
+		if( a > 1.0f )
+			a = 1.0f;
+		if( a > 0.0f )
+			rest[i] += ( f < 0.0f ? -a * a : a * a ) * GAMEPAD_POINTER_SPEED * dt;
+		else
+			rest[i] = 0.0f;
+		move[i] = (int)rest[i];
+		rest[i] -= move[i];
+	}
+
+	if( move[0] || move[1] )
+		Com_QueueEvent( in_eventTime, SE_MOUSE, move[0], move[1], 0, NULL );
+}
