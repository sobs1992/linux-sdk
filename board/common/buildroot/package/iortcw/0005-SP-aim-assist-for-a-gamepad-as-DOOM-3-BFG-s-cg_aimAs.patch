+/*
+==============
+CL_SetAimAssist
+
+From the cgame each frame: the gamepad stick's turning speed (1: as it is)
+and a turn to add (degrees), which waits for the next command
+==============
+*/
+static void CL_SetAimAssist( float friction, float pitch, float yaw ) {
+	if ( friction < 0.0f ) {
+		friction = 0.0f;
+	} else if ( friction > 1.0f ) {
+		friction = 1.0f;
+	}
+	cl.aimAssistSlow = 1.0f - friction;
+	cl.aimAssistTime = cls.realtime;
+	cl.aimAssistTurn[PITCH] += pitch;
+	cl.aimAssistTurn[YAW] += yaw;
+}
+
 /*
 ==============
 CL_AddCgameCommand
@@ -846,6 +866,10 @@ intptr_t CL_CgameSystemCalls( intptr_t *args ) {
 	case CG_ALLOC:
 		return VM_Alloc( args[1] );
 
+	case CG_SETAIMASSIST:
+		CL_SetAimAssist( VMF( 1 ), VMF( 2 ), VMF( 3 ) );
+		return 0;
+
 	default:
 		Com_Error( ERR_DROP, "Bad cgame system trap: %ld", (long int) args[0] );
 	}
diff --git a/SP/code/client/cl_input.c b/SP/code/client/cl_input.c
index 116e0deb..e46a31f6 100644
--- a/SP/code/client/cl_input.c
+++ b/SP/code/client/cl_input.c
@@ -455,6 +455,13 @@ void CL_JoystickMove( usercmd_t *cmd ) {
 		anglespeed = 0.001 * cls.frametime;
 	}
 
+	// aim assist's friction: the stick turns slower near a target (the
+	// cgame tells each frame; an old word, from before a pause, is not used)
+	if ( cls.realtime - cl.aimAssistTime < 200 ) {
+		yaw *= 1.0f - cl.aimAssistSlow;
+		pitch *= 1.0f - cl.aimAssistSlow;
+	}
+
 	if ( !kb[KB_STRAFE].active ) {
 		cl.viewangles[YAW] += anglespeed * yaw;
 		cmd->rightmove = ClampChar( cmd->rightmove + (int)right );
@@ -656,6 +663,11 @@ usercmd_t CL_CreateCmd( void ) {
 	// get basic movement from joystick
 	CL_JoystickMove( &cmd );
 
+	// aim assist's adhesion: the turn the cgame asked for, once
+	cl.viewangles[PITCH] += cl.aimAssistTurn[PITCH];
+	cl.viewangles[YAW] += cl.aimAssistTurn[YAW];
+	VectorClear( cl.aimAssistTurn );
+
 	// check to make sure the angles haven't wrapped
 	if ( cl.viewangles[PITCH] - oldAngles[PITCH] > 90 ) {
 		cl.viewangles[PITCH] = oldAngles[PITCH] + 90;
diff --git a/SP/code/client/client.h b/SP/code/client/client.h
index cf123528..c6e34e70 100644
--- a/SP/code/client/client.h
+++ b/SP/code/client/client.h
@@ -136,6 +136,13 @@ typedef struct {
 	float cgameSensitivity;
 	int cgameCld;                       // NERVE - SMF
 
+	// aim assist (cgame's cg_aimassist.c): how much it slows the
+	// stick's turning (0: not at all) as of aimAssistTime, and the turn
+	// it adds, until the next command takes it
