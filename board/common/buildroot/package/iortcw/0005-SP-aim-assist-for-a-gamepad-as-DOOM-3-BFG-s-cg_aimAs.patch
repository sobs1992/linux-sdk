+++ b/SP/code/cgame/cg_aimassist.c
@@ -0,0 +1,254 @@
+/*
+===========================================================================
+
+Aim assist for a gamepad, single player: DOOM 3 BFG Edition's (its
+AimAssist.cpp, the same rules and numbers), for iortcw.
+
+The target is the best enemy in front of the player within MAX_DIST that
+can be seen (score: 0.8 for looking at it, 0.2 for being near). An enemy
+is a living character of another team than the player's that is not
+neutral: civilians and allies (killing them fails missions) never pull the
+aim. Its point is its chest, or its head when only that can be seen.
+
+- Friction: while the line of aim passes near the target (FRICTION_RADIUS,
+  growing to FRICTION_OPTIMAL_RADIUS at FRICTION_OPTIMAL_DIST), turning with
+  the gamepad's stick slows down, to FRICTION_MAX of its speed on the
+  target.
+- Adhesion: while the player moves, the view turns towards a target near
+  the line of aim (ADHESION_RADIUS): ADHESION_PCT_MAX at most of what is
+  left, ADHESION_SPEED_MAX at most, a frame of 60 Hz (BFG's tic); other
+  frame times compound the same amounts.
+
+The client applies both (CL_JoystickMove: the stick's turning only, not the
+mouse; CL_CreateCmd: the turn) from trap_SetAimAssist each frame.
+cg_aimAssist 0 (the default; a gamepad installation's config sets 1) turns
+it off. This file is GPLv3 as the rest of the code.
+
+===========================================================================
+*/
+
+#include "cg_local.h"
+
+#define MAX_DIST                    3000.0f
+#define AIM_WEIGHT                  0.8f
+
+#define FRICTION_MAX_DIST           1024.0f
+#define FRICTION_OPTIMAL_DIST       768.0f
+#define FRICTION_RADIUS             96.0f
+#define FRICTION_OPTIMAL_RADIUS     192.0f
+#define FRICTION_MIN                1.0f    // the stick's speed at the radius
+#define FRICTION_MAX                0.4f    // and on the target
+
+#define ADHESION_RADIUS             96.0f
+#define ADHESION_SPEED_MAX          0.6f    // degrees a 60 Hz frame
+#define ADHESION_PCT_MAX            0.25f   // of what is left, a 60 Hz frame
+#define ADHESION_PLAYER_SPEED       10.0f   // units a second the player moves at least
+
+#define TIC_MSEC                    ( 1000.0f / 60.0f )
+
+// game/ai_cast.h: AITEAM_NEUTRAL (civilians); the player is AITEAM_ALLIES
+#define AA_TEAM_NEUTRAL             7
+
+/*
+==============
+AimAssist_FrictionRadius
+
+BFG's: the radius grows from FRICTION_RADIUS near the player to
+FRICTION_OPTIMAL_RADIUS at FRICTION_OPTIMAL_DIST and back to
+FRICTION_RADIUS at FRICTION_MAX_DIST, which it keeps beyond
+==============
+*/
+static float AimAssist_FrictionRadius( float dist ) {
+	float s;
+
+	if ( dist <= 0.0f || dist > FRICTION_MAX_DIST ) {
+		return FRICTION_RADIUS;
+	}
+	if ( dist > FRICTION_OPTIMAL_DIST ) {
+		s = 1.0f - ( dist - FRICTION_OPTIMAL_DIST ) / ( FRICTION_MAX_DIST - FRICTION_OPTIMAL_DIST );
+	} else {
+		s = dist / FRICTION_OPTIMAL_DIST;
+	}
+	return FRICTION_RADIUS + ( FRICTION_OPTIMAL_RADIUS - FRICTION_RADIUS ) * s;
+}
+
+/*
+==============
+CG_AimAssistCompute
+
+For a target at targetPos seen from viewOrg looking along viewAngles: the
+stick's turning speed (1: as it is) and the turn to add this frame
+(degrees, PITCH and YAW) for a frame of frameMsec while the player moves at
+playerSpeed
+==============
+*/
+void CG_AimAssistCompute( const vec3_t viewOrg, const vec3_t viewAngles, const vec3_t targetPos,
+						  float playerSpeed, int frameMsec, float *friction, vec3_t turn ) {
+	vec3_t forward, dir, aim;
+	float dist, along, delta, radius, contribution, tics, keep, maxStep;
+	int i;
+
+	*friction = 1.0f;
+	VectorClear( turn );
+
+	VectorSubtract( targetPos, viewOrg, dir );
+	dist = VectorLength( dir );
+	if ( dist <= 0.0f ) {
+		return;
+	}
+	AngleVectors( viewAngles, forward, NULL, NULL );
+
+	// the distance of the target from the line of aim
+	along = DotProduct( forward, dir ) / dist;
+	if ( along < 0.0f ) {
+		along = 0.0f;
+	} else if ( along > 1.0f ) {
+		along = 1.0f;
+	}
+	along *= dist;
+	delta = dist * dist - along * along;
+	delta = delta > 0.0f ? sqrt( delta ) : 0.0f;
+
+	radius = AimAssist_FrictionRadius( dist );
+	if ( delta < radius ) {
+		*friction = FRICTION_MIN + ( FRICTION_MAX - FRICTION_MIN ) * ( 1.0f - delta / radius );
+	}
+
+	if ( playerSpeed <= ADHESION_PLAYER_SPEED || frameMsec <= 0 ) {
+		return;
+	}
+	contribution = 1.0f - delta / ADHESION_RADIUS;
+	if ( contribution <= 0.0f ) {
+		return;
+	}
+	if ( contribution > ADHESION_PCT_MAX ) {
+		contribution = ADHESION_PCT_MAX;
+	}
+
+	// a frame of tics 60 Hz frames: what is left after them, the step at most
+	tics = frameMsec / TIC_MSEC;
+	keep = pow( 1.0f - contribution, tics );
+	maxStep = ADHESION_SPEED_MAX * tics;
+	vectoangles( dir, aim );
+	for ( i = PITCH; i <= YAW; i++ ) {
+		// exactly: AngleNormalize180 rounds to 1/65536 of a turn
+		float d = fmod( aim[i] - viewAngles[i], 360.0f );
+
+		if ( d > 180.0f ) {
+			d -= 360.0f;
+		} else if ( d < -180.0f ) {
+			d += 360.0f;
+		}
+
+		if ( d > maxStep ) {
+			d = maxStep;
+		} else if ( d < -maxStep ) {
+			d = -maxStep;
+		}
+		turn[i] = d * ( 1.0f - keep );
+	}
+}
+
+/*
+==============
+AimAssist_Point
+
+The point of a character to aim at: its chest (part = 0) or its head
+(part = 1), from its bounding box
+==============
+*/
+static void AimAssist_Point( const centity_t *cent, int part, vec3_t point ) {
+	int solid = cent->currentState.solid;
+	float down = 24.0f, up = 48.0f;
+
+	if ( solid && solid != SOLID_BMODEL ) {
+		down = ( solid >> 8 ) & 255;
+		up = ( ( solid >> 16 ) & 255 ) - 32;
+	}
+	VectorCopy( cent->lerpOrigin, point );
+	if ( part == 0 ) {
+		point[2] += ( up - down ) * 0.5f + ( up + down ) / 6.0f;
+	} else {
+		point[2] += up - 8.0f;
+	}
+}
+
+/*
+==============
+AimAssist_Visible
+==============
+*/
+static qboolean AimAssist_Visible( const vec3_t from, const vec3_t to, int entityNum ) {
+	trace_t tr;
+
+	CG_Trace( &tr, from, NULL, NULL, to, cg.snap->ps.clientNum, MASK_SHOT );
+	return tr.fraction >= 1.0f || tr.entityNum == entityNum;
+}
+
+/*
+==============
+CG_AimAssist
+
+Each frame: the target and what it does, to the client
+==============
+*/
+void CG_AimAssist( void ) {
+	const vec_t *viewOrg = cg.refdef.vieworg;
+	const vec_t *viewAngles = cg.refdefViewAngles;
+	float friction = 1.0f, best = 0.0f;
+	qboolean found = qfalse;
+	vec3_t forward, turn, targetPos;
+	int i;
+
+	VectorClear( turn );
+	if ( !cg_aimAssist.integer || cgs.gametype != GT_SINGLE_PLAYER || !cg.snap ||
+		 cg.snap->ps.pm_type == PM_DEAD || cg.snap->ps.stats[STAT_HEALTH] <= 0 ||
+		 cg.cameraMode || cg.renderingThirdPerson ) {
+		trap_SetAimAssist( friction, turn[PITCH], turn[YAW] );
+		return;
+	}
+
+	AngleVectors( viewAngles, forward, NULL, NULL );
+	for ( i = 0; i < MAX_CLIENTS; i++ ) {
+		centity_t *cent = &cg_entities[i];
+		const entityState_t *s = &cent->currentState;
+		vec3_t point, dir;
+		float dist, look, score;
+
+		if ( i == cg.snap->ps.clientNum || !cent->currentValid || s->eType != ET_PLAYER ||
+			 s->aiChar == AICHAR_NONE || ( s->eFlags & ( EF_DEAD | EF_NODRAW ) ) ||
+			 s->teamNum == cg.snap->ps.teamNum || s->teamNum == AA_TEAM_NEUTRAL ) {
+			continue;
+		}
+
+		AimAssist_Point( cent, 0, point );
+		VectorSubtract( point, viewOrg, dir );
+		dist = VectorNormalize( dir );
+		if ( dist > MAX_DIST ) {
+			continue;
+		}
+		look = DotProduct( forward, dir );
+		if ( look < 0.0f ) {
+			continue;
+		}
+		score = look * AIM_WEIGHT + ( 1.0f - dist / MAX_DIST ) * ( 1.0f - AIM_WEIGHT );
+		if ( found && score <= best ) {
+			continue;
+		}
+		if ( !AimAssist_Visible( viewOrg, point, s->number ) ) {
+			AimAssist_Point( cent, 1, point );
+			if ( !AimAssist_Visible( viewOrg, point, s->number ) ) {
+				continue;
+			}
+		}
+		found = qtrue;
+		best = score;
+		VectorCopy( point, targetPos );
+	}
+
+	if ( found ) {
+		CG_AimAssistCompute( viewOrg, viewAngles, targetPos, VectorLength( cg.snap->ps.velocity ),
+							 cg.frametime, &friction, turn );
+	}
+	trap_SetAimAssist( friction, turn[PITCH], turn[YAW] );
+}
