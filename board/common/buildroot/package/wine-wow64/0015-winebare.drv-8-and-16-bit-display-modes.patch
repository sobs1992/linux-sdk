From 208bcb3b273ebb1925a3d3d79767fc426f4c51c6 Mon Sep 17 00:00:00 2001
From: Sobs <antohasobne@gmail.com>
Date: Sun, 15 Nov 2026 03:12:26 +0100
Subject: [PATCH] winebare.drv: 8- and 16-bit display modes

Every display mode is listed at 8, 16 and 32 bits per pixel, as
winex11.drv lists its modes, and the depth asked for is kept: old
DirectDraw games switch to 16 bits (Neighbours from Hell asks for
800x600x16 and stopped with "Unknown problem" when win32u found no such
mode). The screen stays 32 bits; WineD3D converts what is drawn.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 dlls/winebare.drv/main.c | 29 +++++++++++++++++++++--------
 1 file changed, 21 insertions(+), 8 deletions(-)

diff --git a/dlls/winebare.drv/main.c b/dlls/winebare.drv/main.c
index 88241a6..e4b793b 100644
--- a/dlls/winebare.drv/main.c
+++ b/dlls/winebare.drv/main.c
@@ -51,6 +51,11 @@ static pthread_mutex_t mode_mutex = PTHREAD_MUTEX_INITIALIZER;
 static struct wb_mode modes[WB_MAX_MODES];
 static UINT mode_count;
 static struct wb_mode current_mode = { 800, 600 };
+/* The colour depths every mode is listed with, as winex11.drv's: old
+ * DirectDraw games switch to 8 or 16 bits. The screen stays 32 bits;
+ * WineD3D converts what a game draws at a lower depth. */
+static const DWORD depths[] = { 8, 16, 32 };
+static DWORD current_bpp = 32;
 
 void bare_send(const struct wb_msg *msg, int fd)
 {
@@ -116,14 +121,14 @@ static void set_config(const struct wb_msg *msg)
     TRACE("%u modes, current %ux%u\n", mode_count, current_mode.width, current_mode.height);
 }
 
-static void fill_devmode(DEVMODEW *mode, const struct wb_mode *m)
+static void fill_devmode(DEVMODEW *mode, const struct wb_mode *m, DWORD bpp)
 {
     memset(mode, 0, sizeof(*mode));
     mode->dmSize = sizeof(*mode);
     mode->dmFields = DM_DISPLAYORIENTATION | DM_BITSPERPEL | DM_PELSWIDTH | DM_PELSHEIGHT |
                      DM_DISPLAYFLAGS | DM_DISPLAYFREQUENCY;
     mode->dmDisplayOrientation = DMDO_DEFAULT;
-    mode->dmBitsPerPel = 32;
+    mode->dmBitsPerPel = bpp;
     mode->dmPelsWidth = m->width;
     mode->dmPelsHeight = m->height;
     mode->dmDisplayFrequency = 60;
@@ -139,13 +144,14 @@ static UINT BARE_UpdateDisplayDevices(const struct gdi_device_manager *manager,
 {
     struct pci_id pci_id = {0};
     struct gdi_monitor monitor = {0};
-    DEVMODEW current, list[WB_MAX_MODES];
-    UINT i, count;
+    DEVMODEW current, list[WB_MAX_MODES * ARRAY_SIZE(depths)];
+    UINT i, j, count = 0;
 
     pthread_mutex_lock(&mode_mutex);
-    fill_devmode(&current, &current_mode);
-    for (i = 0; i < mode_count; i++) fill_devmode(&list[i], &modes[i]);
-    count = mode_count;
+    fill_devmode(&current, &current_mode, current_bpp);
+    for (i = 0; i < mode_count; i++)
+        for (j = 0; j < ARRAY_SIZE(depths); j++)
+            fill_devmode(&list[count++], &modes[i], depths[j]);
     pthread_mutex_unlock(&mode_mutex);
 
     current.dmFields |= DM_POSITION;
@@ -163,13 +169,15 @@ static UINT BARE_UpdateDisplayDevices(const struct gdi_device_manager *manager,
 /***********************************************************************
  *           BARE_ChangeDisplaySettings
  *
- * Any listed mode is accepted at once: the screen is only scaled.
+ * Any listed mode is accepted at once: the screen is only scaled, its
+ * depth only remembered (the screen is 32 bits whatever a game asks).
  */
 static LONG BARE_ChangeDisplaySettings(DEVMODEW *displays, const WCHAR *primary_name, HWND hwnd,
                                        DWORD flags, void *lparam)
 {
     struct wb_msg msg = { .type = WB_MODE_SET };
     DEVMODEW *mode;
+    UINT i;
 
     for (mode = displays; mode->dmSize; mode = NEXT_DEVMODEW(mode))
     {
@@ -179,6 +187,11 @@ static LONG BARE_ChangeDisplaySettings(DEVMODEW *displays, const WCHAR *primary_
         pthread_mutex_lock(&mode_mutex);
         current_mode.width = mode->dmPelsWidth;
         current_mode.height = mode->dmPelsHeight;
+        if (mode->dmFields & DM_BITSPERPEL)
+        {
+            for (i = 0; i < ARRAY_SIZE(depths); i++)
+                if (mode->dmBitsPerPel == depths[i]) current_bpp = depths[i];
+        }
         pthread_mutex_unlock(&mode_mutex);
         msg.mode_set.width = mode->dmPelsWidth;
         msg.mode_set.height = mode->dmPelsHeight;
-- 
