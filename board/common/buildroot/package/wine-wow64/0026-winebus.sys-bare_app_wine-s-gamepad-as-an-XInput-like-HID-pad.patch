From c1843f57abd1a3cc7f89653f68b24577f5c91d74 Mon Sep 17 00:00:00 2001
From: Sobs <antohasobne@gmail.com>
Date: Thu, 19 Nov 2026 00:38:22 +0100
Subject: [PATCH] winebus.sys: bare_app_wine's gamepad (WB_PAD_HELLO,
 WB_INPUT_PAD) as an XInput-like HID pad.

bare_app_wine (the SDK of the ODROID-GO Ultra) turns the console's buttons
and sticks into a game's input. Where the game's wine.ini asks for a
gamepad ("stick = pad", "a = pad_a"...) it sends the pad's state over the
socket of winebare.drv. A bus of its own connects once more, says
WB_PAD_HELLO and on the first state makes an Xbox 360-like HID gamepad
(hid_device_add_gamepad(): six axes, the D-pad as a hat, the buttons in
XInput's order), which DirectInput and XInput see; analog steering in
Need for Speed: Underground. Without a pad in wine.ini the host never
answers and no device is made.
---
 dlls/winebus.sys/Makefile.in    |   1 +
 dlls/winebus.sys/bus_bare.c     | 284 ++++++++++++++++++++++++++++++++
 dlls/winebus.sys/main.c         |  15 ++
 dlls/winebus.sys/unix_private.h |   4 +
 dlls/winebus.sys/unixlib.c      |   3 +
 dlls/winebus.sys/unixlib.h      |   3 +
 6 files changed, 310 insertions(+)
 create mode 100644 dlls/winebus.sys/bus_bare.c

diff --git a/dlls/winebus.sys/Makefile.in b/dlls/winebus.sys/Makefile.in
index db32fae..91e7781 100644
--- a/dlls/winebus.sys/Makefile.in
+++ b/dlls/winebus.sys/Makefile.in
@@ -7,6 +7,7 @@ UNIX_CFLAGS  = $(UDEV_CFLAGS) $(SDL2_CFLAGS)
 EXTRADLLFLAGS = -Wl,--subsystem,native
 
 SOURCES = \
+	bus_bare.c \
 	bus_iohid.c \
 	bus_sdl.c \
 	bus_udev.c \
diff --git a/dlls/winebus.sys/bus_bare.c b/dlls/winebus.sys/bus_bare.c
new file mode 100644
index 0000000..67520d2
--- /dev/null
+++ b/dlls/winebus.sys/bus_bare.c
@@ -0,0 +1,284 @@
+/*
+ * The gamepad of bare_app_wine (the SDK of the ODROID-GO Ultra)
+ *
+ * bare_app_wine runs a Windows game on the console and turns its buttons
+ * and sticks into the game's input. Where the game's wine.ini asks for a
+ * gamepad ("stick = pad", "a = pad_a"...), it sends that pad's state over
+ * the same socket the graphics driver winebare.drv uses (WINEBARE_SOCKET):
+ * this bus connects once more, says WB_PAD_HELLO, and on the first state
+ * makes an Xbox 360-like HID gamepad of it (six axes, the D-pad as a hat,
+ * the buttons in XInput's order), which DirectInput and XInput then see.
+ * Without a pad in wine.ini the host never answers and no device is made.
+ *
