config BR2_PACKAGE_WINE_WOW64
	bool "wine-wow64"
	depends on BR2_aarch64
	depends on BR2_HOSTARCH = "x86_64" # prebuilt llvm-mingw
	depends on !BR2_STATIC_LIBS
	depends on BR2_TOOLCHAIN_HAS_THREADS_NPTL
	depends on BR2_PACKAGE_BARE_APP # winebare.drv's protocol
	select BR2_PACKAGE_ALSA_LIB
	select BR2_PACKAGE_FREETYPE
	select BR2_PACKAGE_WOWBOX64 # the x86 CPU named by wine.inf (0001)
	# winegstreamer: DirectShow and Media Foundation decoding (WMA,
	# MP3, AVI... of old games), its elements and the codecs of FFmpeg
	select BR2_PACKAGE_GSTREAMER1
	select BR2_PACKAGE_GST1_PLUGINS_BASE
	select BR2_PACKAGE_GST1_PLUGINS_BASE_PLUGIN_AUDIOCONVERT
	select BR2_PACKAGE_GST1_PLUGINS_BASE_PLUGIN_AUDIORESAMPLE
	select BR2_PACKAGE_GST1_PLUGINS_BASE_PLUGIN_PLAYBACK # decodebin
	select BR2_PACKAGE_GST1_PLUGINS_BASE_PLUGIN_TYPEFIND
	select BR2_PACKAGE_GST1_PLUGINS_BASE_PLUGIN_VIDEOCONVERTSCALE
	select BR2_PACKAGE_GST1_PLUGINS_GOOD
	select BR2_PACKAGE_GST1_PLUGINS_GOOD_PLUGIN_AUDIOPARSERS # MP3
	select BR2_PACKAGE_GST1_PLUGINS_GOOD_PLUGIN_AVI
	select BR2_PACKAGE_GST1_PLUGINS_GOOD_PLUGIN_DEINTERLACE
	select BR2_PACKAGE_GST1_PLUGINS_GOOD_PLUGIN_ID3DEMUX
	select BR2_PACKAGE_GST1_PLUGINS_GOOD_PLUGIN_VIDEOFILTER # videoflip
	select BR2_PACKAGE_GST1_PLUGINS_GOOD_PLUGIN_WAVPARSE
	select BR2_PACKAGE_GST1_PLUGINS_UGLY
	select BR2_PACKAGE_GST1_PLUGINS_UGLY_PLUGIN_ASFDEMUX # WMA, WMV
	select BR2_PACKAGE_GST1_LIBAV # aarch64: FFmpeg is there
	help
	  Wine 11 for arm64 in the WoW64 mode, for 32-bit x86 Windows
	  programs: the Unix side and the 64-bit Windows dlls native,
	  the 32-bit dlls i386, their x86 code run by Box64's
	  wowbox64.dll. PE dlls built by llvm-mingw, aarch64 ones
	  aligned to 4 KiB in the file (0002). No X11 or Wayland;
	  sound by ALSA, OpenGL through EGL with mesa-panfrost,
	  media decoding by GStreamer.

	  https://www.winehq.org

comment "wine-wow64 needs a toolchain w/ dynamic library, NPTL"
	depends on BR2_aarch64
	depends on BR2_STATIC_LIBS || !BR2_TOOLCHAIN_HAS_THREADS_NPTL
