+#include "winebare.h"
+
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(winebare);
+
+#include "wine/opengl_driver.h"
+#include "wine/list.h"
+
+static const struct egl_platform *egl;
+static const struct opengl_funcs *funcs;
+static const struct opengl_drawable_funcs bare_drawable_funcs;
+
+/* The GL calls of the read back, beyond what opengl32 has loaded */
+static PFN_glBindBuffer p_glBindBuffer;
+static PFN_glGenFramebuffers p_glGenFramebuffers;
+static PFN_glDeleteFramebuffers p_glDeleteFramebuffers;
+static PFN_glFramebufferTexture2D p_glFramebufferTexture2D;
+static PFN_glCheckFramebufferStatus p_glCheckFramebufferStatus;
+static PFN_glBlitFramebuffer p_glBlitFramebuffer;
+static BOOL async_read;         /* the GPU copies frames out, a thread reads them */
+static BOOL fps_trace;          /* $WINEBARE_FPS: frames a second on stderr */
+
+/* A frame on its way out. The swap has the GPU copy the back buffer into
+ * a texture, upside down, and returns: the CPU makes the next frame while
+ * the GPU draws this one. The copier thread, with a context of its own
+ * sharing the textures, waits for the fence and reads the texture into
+ * the shared memory. */
+#define READ_SLOTS 2
+struct read_slot
+{
+    GLuint texture;             /* of the program's context */
+    GLuint draw_fbo;            /* the program's context: the texture to blit to */
+    GLuint read_fbo;            /* the copier's context: the texture to read */
+    unsigned serial, read_serial; /* of the texture; what read_fbo has */
+    EGLSync sync;
+    BOOL busy;                  /* handed to the copier */
+};
+
+/* A window drawable: an EGL pbuffer of the client area size. Each swap
+ * reads it into one of two buffers shared with bare_app_wine, which shows
+ * it over the window's GDI pixels. */
+struct bare_gl_drawable
+{
+    struct opengl_drawable base;
+    struct list entry;          /* in gl_drawables */
+    HWND hwnd;
+    uint32_t id;                /* the GL layer of bare_app_wine */
+    int fd;
+    void *pixels;               /* 2 buffers */
+    void *read;                 /* glReadPixels lands here, bottom-up */
+    size_t size;
+    UINT width, height, buffer;
+    /* the asynchronous read back */
+    pthread_mutex_t mutex;
+    pthread_cond_t cond;
+    pthread_t copier;
+    BOOL copier_running, quit, copier_failed;
+    struct read_slot slots[READ_SLOTS];
+    unsigned next_slot, copy_slot, serial;
+    UINT slot_width, slot_height; /* of the textures, 0 if none */
+    EGLContext slot_context;    /* they belong to; the copier shares with it */
+    /* $WINEBARE_FPS */
+    unsigned frames;
+    struct timespec fps_start, last_frame;
+};
+
+static pthread_mutex_t gl_mutex = PTHREAD_MUTEX_INITIALIZER;
+static struct list gl_drawables = LIST_INIT(gl_drawables);
+
+static struct bare_gl_drawable *impl_from_opengl_drawable(struct opengl_drawable *base)
+{
+    return CONTAINING_RECORD(base, struct bare_gl_drawable, base);
+}
+
+static EGLConfig egl_config_for_format(int format)
+{
+    return egl->configs[(format - 1) % egl->config_count];
+}
+
+/* what the client surfaces do is done by WindowPosChanged */
+static void bare_client_destroy(struct client_surface *client) {}
+static void bare_client_detach(struct client_surface *client) {}
+static void bare_client_update(struct client_surface *client) {}
+static void bare_client_present(struct client_surface *client, HDC hdc) {}
+
+static const struct client_surface_funcs bare_client_funcs =
+{
+    .destroy = bare_client_destroy,
+    .detach = bare_client_detach,
+    .update = bare_client_update,
+    .present = bare_client_present,
+};
+
+static void get_client_size(HWND hwnd, UINT *width, UINT *height)
+{
+    RECT rect = {0};
+
+    NtUserGetClientRect(hwnd, &rect, NtUserGetDpiForWindow(hwnd));
+    *width = max(rect.right - rect.left, 1);
+    *height = max(rect.bottom - rect.top, 1);
+}
+
+static void send_place(struct bare_gl_drawable *gl)
+{
+    struct wb_msg msg = { .type = WB_PLACE };
+    POINT pt = { 0, 0 };
+
+    NtUserClientToScreen(gl->hwnd, &pt);
+    msg.place.id = gl->id;
+    msg.place.hwnd = (UINT_PTR)NtUserGetAncestor(gl->hwnd, GA_ROOT);
+    msg.place.x = pt.x;
+    msg.place.y = pt.y;
+    msg.place.width = gl->width;
+    msg.place.height = gl->height;
+    msg.place.visible = NtUserIsWindowVisible(gl->hwnd);
+    msg.place.layer = WB_LAYER_GL;
+    bare_send(&msg, -1);
+}
+
+/* after a frame has gone into the shared buffer not shown */
+static void frame_done(struct bare_gl_drawable *gl)
+{
+    struct wb_msg msg = { .type = WB_FLUSH };
+
+    msg.flush.id = gl->id;
+    msg.flush.buffer = gl->buffer;
+    msg.flush.right = gl->width;
+    msg.flush.bottom = gl->height;
+    bare_send(&msg, -1);
+    gl->buffer ^= 1;
+
+    if (fps_trace)
+    {
+        struct timespec now;
+        double secs;
+
+        clock_gettime(CLOCK_MONOTONIC, &now);
+        /* the stalls: a scene loading, a hitch */
+        secs = (now.tv_sec - gl->last_frame.tv_sec) + (now.tv_nsec - gl->last_frame.tv_nsec) / 1e9;
+        if (gl->frames && secs >= 0.25) fprintf(stderr, "winebare: no frame for %.2f s\n", secs);
+        gl->last_frame = now;
+        if (!gl->frames++) gl->fps_start = now;
+        secs = (now.tv_sec - gl->fps_start.tv_sec) + (now.tv_nsec - gl->fps_start.tv_nsec) / 1e9;
+        if (secs >= 5)
+        {
+            fprintf(stderr, "winebare: %.1f fps (%ux%u, %s read back)\n", (gl->frames - 1) / secs,
+                    gl->width, gl->height, gl->copier_running ? "asynchronous" : "synchronous");
+            gl->frames = 1;
+            gl->fps_start = now;
+        }
+    }
+}
+
+static char *shown_buffer(struct bare_gl_drawable *gl)
+{
+    return (char *)gl->pixels + gl->buffer * gl->size;
+}
+
+/* the rows, top-down as the GDI pixels */
+static void put_frame(struct bare_gl_drawable *gl, const char *bottom_up)
+{
+    UINT stride = gl->width * 4, y;
+    char *dst = shown_buffer(gl);
+
+    for (y = 0; y < gl->height; y++)
+        memcpy(dst + y * stride, bottom_up + (gl->height - 1 - y) * stride, stride);
+    frame_done(gl);
+}
+
+/* the texture of S, already top-down, into the shared memory */
+static void copy_slot(struct bare_gl_drawable *gl, struct read_slot *s)
+{
+    if (s->read_serial != s->serial)
+    {
+        if (!s->read_fbo) p_glGenFramebuffers(1, &s->read_fbo);
+        funcs->p_glBindFramebuffer(GL_READ_FRAMEBUFFER, s->read_fbo);
+        p_glFramebufferTexture2D(GL_READ_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, s->texture, 0);
+        funcs->p_glReadBuffer(GL_COLOR_ATTACHMENT0);
+        s->read_serial = s->serial;
+    }
+    else funcs->p_glBindFramebuffer(GL_READ_FRAMEBUFFER, s->read_fbo);
+    funcs->p_glReadPixels(0, 0, gl->width, gl->height, GL_BGRA, GL_UNSIGNED_BYTE, shown_buffer(gl));
+    frame_done(gl);
+}
+
+/* Not a Wine thread: no Wine calls, no debug output */
+static void *copier_main(void *arg)
+{
+    struct bare_gl_drawable *gl = arg;
+    EGLContext context = NULL;
+    unsigned i;
+
+    if (funcs->p_eglBindAPI(EGL_OPENGL_API))
+        context = funcs->p_eglCreateContext(egl->display, egl_config_for_format(gl->base.format),
+                                            gl->slot_context, NULL);
+    if (!context || !funcs->p_eglMakeCurrent(egl->display, EGL_NO_SURFACE, EGL_NO_SURFACE, context))
+    {
+        if (context) funcs->p_eglDestroyContext(egl->display, context);
+        pthread_mutex_lock(&gl->mutex);
+        gl->copier_failed = TRUE;
+        for (i = 0; i < READ_SLOTS; i++) gl->slots[i].busy = FALSE;
+        pthread_cond_broadcast(&gl->cond);
+        pthread_mutex_unlock(&gl->mutex);
+        funcs->p_eglReleaseThread();
+        return NULL;
+    }
+    funcs->p_glPixelStorei(GL_PACK_ALIGNMENT, 4);
+
+    pthread_mutex_lock(&gl->mutex);
+    for (;;)
+    {
+        struct read_slot *s = &gl->slots[gl->copy_slot];
+
+        while (!s->busy && !gl->quit) pthread_cond_wait(&gl->cond, &gl->mutex);
+        if (!s->busy) break;
+        pthread_mutex_unlock(&gl->mutex);
+
+        if (s->sync)
+        {
+            funcs->p_eglClientWaitSync(egl->display, s->sync, 0, EGL_FOREVER);
+            funcs->p_eglDestroySync(egl->display, s->sync);
+        }
+        copy_slot(gl, s);
+
+        pthread_mutex_lock(&gl->mutex);
+        s->sync = NULL;
+        s->busy = FALSE;
+        gl->copy_slot = (gl->copy_slot + 1) % READ_SLOTS;
+        pthread_cond_broadcast(&gl->cond);
+    }
+    pthread_mutex_unlock(&gl->mutex);
+
+    /* its framebuffer objects go with the context */
+    for (i = 0; i < READ_SLOTS; i++) gl->slots[i].read_fbo = gl->slots[i].read_serial = 0;
+    funcs->p_eglMakeCurrent(egl->display, EGL_NO_SURFACE, EGL_NO_SURFACE, EGL_NO_CONTEXT);
+    funcs->p_eglDestroyContext(egl->display, context);
+    funcs->p_eglReleaseThread();
+    return NULL;
+}
+
+/* until the copier has put out every frame handed to it */
+static void drain_copier(struct bare_gl_drawable *gl)
+{
+    unsigned i;
+
+    pthread_mutex_lock(&gl->mutex);
+    for (i = 0; i < READ_SLOTS; i++)
+        while (gl->slots[i].busy) pthread_cond_wait(&gl->cond, &gl->mutex);
+    pthread_mutex_unlock(&gl->mutex);
+}
+
+static void stop_copier(struct bare_gl_drawable *gl)
+{
+    if (!gl->copier_running) return;
+    pthread_mutex_lock(&gl->mutex);
+    gl->quit = TRUE;
+    pthread_cond_broadcast(&gl->cond);
+    pthread_mutex_unlock(&gl->mutex);
+    pthread_join(gl->copier, NULL);
+    gl->copier_running = gl->quit = FALSE;
+}
+
+/* Textures of the current context for frames of the drawable's size, with
+ * framebuffer objects to blit into them; the copier, sharing that context,
+ * running. Called with the read and draw framebuffer bindings at 0. Those
+ * of another context are left to it. */
+static BOOL make_slots(struct bare_gl_drawable *gl, EGLContext context)
+{
+    GLint texture, unpack_buffer;
+    BOOL ok = TRUE;
+    unsigned i;
+
+    drain_copier(gl);
+    if (gl->slot_context != context || gl->copier_failed) stop_copier(gl);
+    for (i = 0; i < READ_SLOTS; i++)
+    {
+        struct read_slot *s = &gl->slots[i];
+
+        if (gl->slot_context == context)
+        {
+            if (s->draw_fbo) p_glDeleteFramebuffers(1, &s->draw_fbo);
+            if (s->texture) funcs->p_glDeleteTextures(1, &s->texture);
+        }
+        s->draw_fbo = s->texture = 0;
+    }
+    gl->slot_width = gl->slot_height = 0;
+    gl->next_slot = gl->copy_slot = 0;
+    if (gl->copier_failed)
+    {
+        ERR("the copier has no context of its own, reading back synchronously\n");
+        async_read = FALSE;
+        return FALSE;
+    }
+
+    funcs->p_glGetIntegerv(GL_TEXTURE_BINDING_2D, &texture);
+    funcs->p_glGetIntegerv(GL_PIXEL_UNPACK_BUFFER_BINDING, &unpack_buffer);
+    if (unpack_buffer) p_glBindBuffer(GL_PIXEL_UNPACK_BUFFER, 0);
+    for (i = 0; i < READ_SLOTS && ok; i++)
+    {
+        struct read_slot *s = &gl->slots[i];
+
+        funcs->p_glGenTextures(1, &s->texture);
+        funcs->p_glBindTexture(GL_TEXTURE_2D, s->texture);
+        funcs->p_glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+        funcs->p_glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+        funcs->p_glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAX_LEVEL, 0);
+        /* unsized, given as BGRA: stored as BGRA, read without conversion */
+        funcs->p_glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA, gl->width, gl->height, 0, GL_BGRA, GL_UNSIGNED_BYTE, NULL);
+        p_glGenFramebuffers(1, &s->draw_fbo);
+        funcs->p_glBindFramebuffer(GL_DRAW_FRAMEBUFFER, s->draw_fbo);
+        p_glFramebufferTexture2D(GL_DRAW_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, s->texture, 0);
+        ok = p_glCheckFramebufferStatus(GL_DRAW_FRAMEBUFFER) == GL_FRAMEBUFFER_COMPLETE;
+        s->serial = ++gl->serial;
+    }
+    funcs->p_glBindFramebuffer(GL_DRAW_FRAMEBUFFER, 0);
+    if (unpack_buffer) p_glBindBuffer(GL_PIXEL_UNPACK_BUFFER, unpack_buffer);
+    funcs->p_glBindTexture(GL_TEXTURE_2D, texture);
+    gl->slot_context = context;
+
+    if (ok && !gl->copier_running)
+    {
+        gl->copier_failed = FALSE;
+        gl->copier_running = !pthread_create(&gl->copier, NULL, copier_main, gl);
+        ok = gl->copier_running;
+    }
+    if (!ok)
+    {
+        ERR("no textures of %ux%u to read back from, reading back synchronously\n", gl->width, gl->height);
+        stop_copier(gl);
+        for (i = 0; i < READ_SLOTS; i++)
+        {
+            struct read_slot *s = &gl->slots[i];
+
+            if (s->draw_fbo) p_glDeleteFramebuffers(1, &s->draw_fbo);
+            if (s->texture) funcs->p_glDeleteTextures(1, &s->texture);
+            s->draw_fbo = s->texture = 0;
+        }
+        async_read = FALSE;
+        return FALSE;
+    }
+    gl->slot_width = gl->width;
+    gl->slot_height = gl->height;
+    return TRUE;
+}
+
+static void release_buffers(struct bare_gl_drawable *gl)
+{
+    struct wb_msg msg = { .type = WB_SURFACE_DEL };
+
+    drain_copier(gl);
+    if (gl->fd < 0) return;
+    msg.surface_del.id = gl->id;
+    bare_send(&msg, -1);
+    munmap(gl->pixels, gl->size * 2);
+    close(gl->fd);
+    free(gl->read);
+    gl->fd = -1;
+}
+
+/* the shared buffers and the pbuffer for WIDTH x HEIGHT */
+static BOOL make_buffers(struct bare_gl_drawable *gl, UINT width, UINT height)
+{
+    struct wb_msg msg = { .type = WB_SURFACE };
+    EGLint attribs[] = { EGL_WIDTH, width, EGL_HEIGHT, height, EGL_NONE };
+    EGLSurface surface;
+
+    if (!(surface = funcs->p_eglCreatePbufferSurface(egl->display, egl_config_for_format(gl->base.format), attribs)))
+    {
+        ERR("no %ux%u pbuffer\n", width, height);
+        return FALSE;
+    }
+    if (gl->base.surface)
+    {
+        /* the context drawing into the old one goes on in the new one */
+        if (funcs->p_eglGetCurrentSurface(EGL_DRAW) == gl->base.surface)
+            funcs->p_eglMakeCurrent(egl->display, surface, surface, funcs->p_eglGetCurrentContext());
+        funcs->p_eglDestroySurface(egl->display, gl->base.surface);
+    }
+    gl->base.surface = surface;
+
+    release_buffers(gl);
+    gl->width = width;
+    gl->height = height;
+    gl->size = (size_t)width * height * 4;
+    gl->buffer = 0;
+    if (!(gl->read = malloc(gl->size)) || (gl->fd = bare_shm_create(gl->size * 2, &gl->pixels)) < 0)
+    {
+        ERR("no memory for %ux%u\n", width, height);
+        free(gl->read);
+        gl->read = NULL;
+        gl->fd = -1;
+        return TRUE;
+    }
+    gl->id = bare_new_id();
+    msg.surface.id = gl->id;
+    msg.surface.width = width;
+    msg.surface.height = height;
+    msg.surface.buffers = 2;
+    bare_send(&msg, gl->fd);
+    send_place(gl);
+    return TRUE;
+}
+
+static void bare_drawable_destroy(struct opengl_drawable *base)
+{
+    struct bare_gl_drawable *gl = impl_from_opengl_drawable(base);
+
+    TRACE("%s\n", debugstr_opengl_drawable(base));
+    pthread_mutex_lock(&gl_mutex);
+    list_remove(&gl->entry);
+    pthread_mutex_unlock(&gl_mutex);
+    release_buffers(gl);
+    stop_copier(gl);
+    /* the textures go with their context */
+    pthread_cond_destroy(&gl->cond);
+    pthread_mutex_destroy(&gl->mutex);
+}
+
+static void bare_drawable_flush(struct opengl_drawable *base, UINT flags)
+{
+    struct bare_gl_drawable *gl = impl_from_opengl_drawable(base);
+    UINT width, height;
+
+    if (!(flags & GL_FLUSH_UPDATED)) return;
+    get_client_size(gl->hwnd, &width, &height);
+    if (width != gl->width || height != gl->height) make_buffers(gl, width, height);
+    else send_place(gl);
+}
+
+static void load_read_funcs(void)
+{
+    const char *env;
+
+#define LOAD(f) p_##f = (void *)funcs->p_eglGetProcAddress(#f)
+    LOAD(glBindBuffer);
+    LOAD(glGenFramebuffers);
+    LOAD(glDeleteFramebuffers);
+    LOAD(glFramebufferTexture2D);
+    LOAD(glCheckFramebufferStatus);
+    LOAD(glBlitFramebuffer);
+#undef LOAD
+    async_read = p_glGenFramebuffers && p_glDeleteFramebuffers && p_glFramebufferTexture2D &&
+                 p_glCheckFramebufferStatus && p_glBlitFramebuffer &&
+                 funcs->p_eglCreateSync && funcs->p_eglClientWaitSync && funcs->p_eglDestroySync &&
+                 funcs->p_eglBindAPI && funcs->p_eglCreateContext && funcs->p_eglReleaseThread &&
+                 !((env = getenv("WINEBARE_SYNC_READ")) && *env && *env != '0');
+    fps_trace = (env = getenv("WINEBARE_FPS")) && *env && *env != '0';
+    TRACE("%s read back\n", async_read ? "asynchronous" : "synchronous");
+}
+
+static BOOL bare_drawable_swap(struct opengl_drawable *base)
+{
+    static pthread_once_t once = PTHREAD_ONCE_INIT;
+    struct bare_gl_drawable *gl = impl_from_opengl_drawable(base);
+    GLint read_fbo, draw_fbo, pack_buffer, read_buffer, alignment, row_length;
+    struct read_slot *slot = NULL;
+
+    pthread_once(&once, load_read_funcs);
+    if (gl->fd < 0 || funcs->p_eglGetCurrentSurface(EGL_READ) != gl->base.surface) return TRUE;
+
+    /* what the program has bound is put back afterwards */
+    funcs->p_glGetIntegerv(GL_READ_FRAMEBUFFER_BINDING, &read_fbo);
+    funcs->p_glGetIntegerv(GL_DRAW_FRAMEBUFFER_BINDING, &draw_fbo);
+    if (read_fbo) funcs->p_glBindFramebuffer(GL_READ_FRAMEBUFFER, 0);
+    funcs->p_glGetIntegerv(GL_READ_BUFFER, &read_buffer);
+    funcs->p_glReadBuffer(GL_BACK);
+
+    if (async_read)
+    {
+        EGLContext context = funcs->p_eglGetCurrentContext();
+
+        if (draw_fbo) funcs->p_glBindFramebuffer(GL_DRAW_FRAMEBUFFER, 0);
+        if (gl->copier_failed) make_slots(gl, context);
+        else if ((gl->slot_width == gl->width && gl->slot_height == gl->height && gl->slot_context == context) ||
+                 make_slots(gl, context))
+            slot = &gl->slots[gl->next_slot];
+    }
+
+    if (slot)
+    {
+        GLboolean scissor = funcs->p_glIsEnabled(GL_SCISSOR_TEST);
+
+        /* the copier may still have the frame before last */
+        pthread_mutex_lock(&gl->mutex);
+        while (slot->busy) pthread_cond_wait(&gl->cond, &gl->mutex);
+        pthread_mutex_unlock(&gl->mutex);
+
+        if (scissor) funcs->p_glDisable(GL_SCISSOR_TEST);
+        funcs->p_glBindFramebuffer(GL_DRAW_FRAMEBUFFER, slot->draw_fbo);
+        /* rows top-down, as the GDI pixels */
+        p_glBlitFramebuffer(0, 0, gl->width, gl->height, 0, gl->height, gl->width, 0,
+                            GL_COLOR_BUFFER_BIT, GL_NEAREST);
+        funcs->p_glBindFramebuffer(GL_DRAW_FRAMEBUFFER, draw_fbo);
+        if (scissor) funcs->p_glEnable(GL_SCISSOR_TEST);
+        if (!(slot->sync = funcs->p_eglCreateSync(egl->display, EGL_SYNC_FENCE, NULL)))
+            funcs->p_glFinish();
+        funcs->p_glFlush();
+    }
+    else
+    {
+        if (draw_fbo) funcs->p_glBindFramebuffer(GL_DRAW_FRAMEBUFFER, draw_fbo);
+        funcs->p_glGetIntegerv(GL_PIXEL_PACK_BUFFER_BINDING, &pack_buffer);
+        funcs->p_glGetIntegerv(GL_PACK_ALIGNMENT, &alignment);
+        funcs->p_glGetIntegerv(GL_PACK_ROW_LENGTH, &row_length);
+        if (pack_buffer) p_glBindBuffer(GL_PIXEL_PACK_BUFFER, 0);
+        funcs->p_glPixelStorei(GL_PACK_ALIGNMENT, 4);
+        funcs->p_glPixelStorei(GL_PACK_ROW_LENGTH, 0);
+
+        funcs->p_glReadPixels(0, 0, gl->width, gl->height, GL_BGRA, GL_UNSIGNED_BYTE, gl->read);
+
+        funcs->p_glPixelStorei(GL_PACK_ROW_LENGTH, row_length);
+        funcs->p_glPixelStorei(GL_PACK_ALIGNMENT, alignment);
+        if (pack_buffer) p_glBindBuffer(GL_PIXEL_PACK_BUFFER, pack_buffer);
+    }
+
+    funcs->p_glReadBuffer(read_buffer);
+    if (read_fbo) funcs->p_glBindFramebuffer(GL_READ_FRAMEBUFFER, read_fbo);
+
+    if (slot)
+    {
+        pthread_mutex_lock(&gl->mutex);
+        slot->busy = TRUE;
+        pthread_cond_broadcast(&gl->cond);
+        pthread_mutex_unlock(&gl->mutex);
+        gl->next_slot = (gl->next_slot + 1) % READ_SLOTS;
+    }
+    else put_frame(gl, gl->read);
+    return TRUE;
+}
+
+static const struct opengl_drawable_funcs bare_drawable_funcs =
+{
+    .destroy = bare_drawable_destroy,
+    .flush = bare_drawable_flush,
+    .swap = bare_drawable_swap,
+};
+
+static BOOL bare_surface_create(HWND hwnd, int format, struct opengl_drawable **drawable)
+{
+    struct opengl_drawable *previous;
+    struct client_surface *client;
+    struct bare_gl_drawable *gl;
+    UINT width, height;
+
+    TRACE("hwnd %p format %d\n", hwnd, format);
+
+    if ((previous = *drawable) && previous->format == format) return TRUE;
+
+    if (!(client = client_surface_create(sizeof(*client), &bare_client_funcs, hwnd))) return FALSE;
+    gl = opengl_drawable_create(sizeof(*gl), &bare_drawable_funcs, format, client);
+    client_surface_release(client);
+    if (!gl) return FALSE;
+
+    gl->hwnd = hwnd;
+    gl->fd = -1;
+    pthread_mutex_init(&gl->mutex, NULL);
+    pthread_cond_init(&gl->cond, NULL);
+    gl->base.buffer_map[0] = GL_BACK_LEFT;
+    gl->base.buffer_map[1] = GL_BACK_RIGHT;
+    gl->base.buffer_map[GL_FRONT - GL_FRONT_LEFT] = GL_BACK;
+    gl->base.buffer_map[GL_FRONT_AND_BACK - GL_FRONT_LEFT] = GL_BACK;
+    pthread_mutex_lock(&gl_mutex);
+    list_add_tail(&gl_drawables, &gl->entry);
+    pthread_mutex_unlock(&gl_mutex);
+
+    get_client_size(hwnd, &width, &height);
+    if (!make_buffers(gl, width, height))
+    {
+        opengl_drawable_release(&gl->base);
+        return FALSE;
+    }
+
+    TRACE("created %s %ux%u\n", debugstr_opengl_drawable(&gl->base), width, height);
+    if (previous) opengl_drawable_release(previous);
+    *drawable = &gl->base;
+    return TRUE;
+}
+
+/* the GL layers of HWND follow its client area */
+void bare_gl_window_moved(HWND hwnd)
+{
+    struct bare_gl_drawable *gl;
+
+    pthread_mutex_lock(&gl_mutex);
+    LIST_FOR_EACH_ENTRY(gl, &gl_drawables, struct bare_gl_drawable, entry)
+        if (gl->fd >= 0 && (gl->hwnd == hwnd || NtUserIsChild(hwnd, gl->hwnd))) send_place(gl);
+    pthread_mutex_unlock(&gl_mutex);
+}
+
+static void bare_init_egl_platform(struct egl_platform *platform)
+{
+    platform->type = EGL_PLATFORM_SURFACELESS_MESA;
+    platform->native_display = 0;
+    platform->force_pbuffer_formats = TRUE;
+    egl = platform;
+}
+
+static struct opengl_driver_funcs bare_driver_funcs;
+
+/**********************************************************************
+ *           BARE_OpenGLInit
+ */
+UINT BARE_OpenGLInit(UINT version, const struct opengl_funcs *opengl_funcs,
+                     const struct opengl_driver_funcs **driver_funcs)
+{
+    if (version != WINE_OPENGL_DRIVER_VERSION)
+    {
+        ERR("version mismatch, opengl32 wants %u but driver has %u\n", version, WINE_OPENGL_DRIVER_VERSION);
+        return STATUS_INVALID_PARAMETER;
+    }
+    if (!opengl_funcs->egl_handle) return STATUS_NOT_SUPPORTED;
+    funcs = opengl_funcs;
+
+    /* win32u's EGL driver, with windows of our own */
+    bare_driver_funcs = **driver_funcs;
+    bare_driver_funcs.p_init_egl_platform = bare_init_egl_platform;
+    bare_driver_funcs.p_surface_create = bare_surface_create;
+    *driver_funcs = &bare_driver_funcs;
+    return STATUS_SUCCESS;
+}
