--- /dev/null
+++ b/dlls/winebare.drv/main.c
@@ -0,0 +1,324 @@
+/*
+ * winebare.drv: the connection to bare_app_wine, display modes, input
+ *
+ * Copyright 2026 Sobs
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
