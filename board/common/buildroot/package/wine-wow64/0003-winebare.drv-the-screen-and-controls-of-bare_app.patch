diff --git a/dlls/winebare.drv/window.c b/dlls/winebare.drv/window.c
new file mode 100644
index 0000000..761b165
--- /dev/null
+++ b/dlls/winebare.drv/window.c
@@ -0,0 +1,244 @@
+/*
+ * winebare.drv: window surfaces
+ *
+ * Copyright 2026 Sobs
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#if 0
+#pragma makedep unix
+#endif
+
+#include "config.h"
+
+#include <pthread.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/mman.h>
+#include <unistd.h>
+
+#include "ntstatus.h"
+#define WIN32_NO_STATUS
+#include "winebare.h"
+
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(winebare);
+
+/* The GDI pixels of a top-level window, in memory shared with
+ * bare_app_wine: what win32u draws into the surface bitmap is copied there
+ * on each flush, dirty rectangle only. */
+struct bare_surface
+{
+    struct window_surface header;
+    uint32_t id;
+    int fd;
+    void *pixels;
+    size_t size;
+    UINT width, height;
+};
+
+static const struct window_surface_funcs bare_surface_funcs;
+
+static struct bare_surface *get_bare_surface(struct window_surface *surface)
+{
+    return CONTAINING_RECORD(surface, struct bare_surface, header);
+}
+
+static void bare_surface_set_clip(struct window_surface *window_surface, const RECT *rects, UINT count)
+{
+}
+
+static BOOL bare_surface_flush(struct window_surface *window_surface, const RECT *rect, const RECT *dirty,
+                               const BITMAPINFO *color_info, const void *color_bits, BOOL shape_changed,
+                               const BITMAPINFO *shape_info, const void *shape_bits)
+{
+    struct bare_surface *surface = get_bare_surface(window_surface);
+    struct wb_msg msg = { .type = WB_FLUSH };
+    UINT stride = surface->width * 4, src_stride = color_info->bmiHeader.biWidth * 4;
+    RECT r;
+    int y;
+
+    /* the dirty rectangle is relative to RECT, the surface bitmap is of RECT's size */
+    r.left = max(dirty->left, 0);
+    r.top = max(dirty->top, 0);
+    r.right = min(dirty->right, (LONG)surface->width);
+    r.bottom = min(dirty->bottom, (LONG)surface->height);
+    if (r.left >= r.right || r.top >= r.bottom) return TRUE;
+    if (color_info->bmiHeader.biBitCount != 32) return FALSE;
+
+    for (y = r.top; y < r.bottom; y++)
+        memcpy((char *)surface->pixels + y * stride + r.left * 4,
+               (const char *)color_bits + y * src_stride + r.left * 4, (r.right - r.left) * 4);
+
+    msg.flush.id = surface->id;
+    msg.flush.left = r.left;
+    msg.flush.top = r.top;
+    msg.flush.right = r.right;
+    msg.flush.bottom = r.bottom;
+    bare_send(&msg, -1);
+    return TRUE;
+}
+
+static void bare_surface_destroy(struct window_surface *window_surface)
+{
+    struct bare_surface *surface = get_bare_surface(window_surface);
+    struct wb_msg msg = { .type = WB_SURFACE_DEL };
+
+    TRACE("surface %p id %u\n", surface, surface->id);
+    msg.surface_del.id = surface->id;
+    bare_send(&msg, -1);
+    if (surface->pixels) munmap(surface->pixels, surface->size);
+    if (surface->fd >= 0) close(surface->fd);
+}
+
+static const struct window_surface_funcs bare_surface_funcs =
+{
+    bare_surface_set_clip,
+    bare_surface_flush,
+    bare_surface_destroy
+};
+
+/***********************************************************************
+ *           BARE_CreateWindowSurface
+ */
+BOOL BARE_CreateWindowSurface(HWND hwnd, BOOL layered, const RECT *surface_rect,
+                              struct window_surface **window_surface)
+{
+    char buffer[FIELD_OFFSET(BITMAPINFO, bmiColors[256])];
+    BITMAPINFO *info = (BITMAPINFO *)buffer;
+    struct wb_msg msg = { .type = WB_SURFACE };
+    UINT width = surface_rect->right - surface_rect->left;
+    UINT height = surface_rect->bottom - surface_rect->top;
+    struct window_surface *previous;
+    struct bare_surface *surface;
+
+    TRACE("hwnd %p, layered %u, rect %s\n", hwnd, layered, wine_dbgstr_rect(surface_rect));
+
+    if ((previous = *window_surface) && previous->funcs == &bare_surface_funcs) return TRUE;
+
+    memset(info, 0, sizeof(*info));
+    info->bmiHeader.biSize = sizeof(info->bmiHeader);
+    info->bmiHeader.biWidth = width;
+    info->bmiHeader.biHeight = -height; /* top-down */
+    info->bmiHeader.biPlanes = 1;
+    info->bmiHeader.biBitCount = 32;
+    info->bmiHeader.biSizeImage = width * height * 4;
+    info->bmiHeader.biCompression = BI_RGB;
+
+    if (!(previous = window_surface_create(sizeof(*surface), &bare_surface_funcs, hwnd, surface_rect, info, 0)))
+        return TRUE; /* the default surface */
+    surface = get_bare_surface(previous);
+    surface->width = width;
+    surface->height = height;
+    surface->size = (size_t)width * height * 4;
+    if ((surface->fd = bare_shm_create(surface->size, &surface->pixels)) < 0)
+    {
+        ERR("no memory for a %ux%u surface\n", width, height);
+        surface->pixels = NULL;
+        window_surface_release(previous);
+        return TRUE;
+    }
+    surface->id = bare_new_id();
+    msg.surface.id = surface->id;
+    msg.surface.width = width;
+    msg.surface.height = height;
+    msg.surface.buffers = 1;
+    bare_send(&msg, surface->fd);
+
+    if (*window_surface) window_surface_release(*window_surface);
+    *window_surface = previous;
+    return TRUE;
+}
+
+/* Visible top-level windows of all processes, top first */
+void bare_send_zorder(void)
+{
+    struct wb_msg msg = { .type = WB_ZORDER };
+    HWND list[ARRAY_SIZE(msg.zorder.hwnd) + 1];
+    ULONG count = ARRAY_SIZE(list), i;
+
+    if (NtUserBuildHwndList(0, 0, 0, 0, 0, count, list, &count)) return;
+    for (i = 0; i < count && list[i] != HWND_BOTTOM && msg.zorder.count < ARRAY_SIZE(msg.zorder.hwnd); i++)
+        if (NtUserIsWindowVisible(list[i])) msg.zorder.hwnd[msg.zorder.count++] = (UINT_PTR)list[i];
+    bare_send(&msg, -1);
+}
+
+/***********************************************************************
+ *           BARE_WindowPosChanged
+ */
+void BARE_WindowPosChanged(HWND hwnd, HWND insert_after, HWND owner_hint, UINT swp_flags,
+                           const struct window_rects *new_rects, struct window_surface *window_surface)
+{
+    struct wb_msg msg = { .type = WB_PLACE };
+
+    TRACE("hwnd %p rects %s flags %08x surface %p\n", hwnd, debugstr_window_rects(new_rects),
+          swp_flags, window_surface);
+
+    if (window_surface && window_surface->funcs == &bare_surface_funcs)
+    {
+        struct bare_surface *surface = get_bare_surface(window_surface);
+
+        msg.place.id = surface->id;
+        msg.place.hwnd = (UINT_PTR)hwnd;
+        msg.place.x = new_rects->visible.left;
+        msg.place.y = new_rects->visible.top;
+        msg.place.width = min(surface->width, new_rects->visible.right - new_rects->visible.left);
+        msg.place.height = min(surface->height, new_rects->visible.bottom - new_rects->visible.top);
+        msg.place.visible = NtUserIsWindowVisible(hwnd);
+        msg.place.layer = WB_LAYER_GDI;
+        bare_send(&msg, -1);
+    }
+    bare_gl_window_moved(hwnd);
+    bare_send_zorder();
+}
+
+/***********************************************************************
+ *           BARE_DestroyWindow
+ */
+void BARE_DestroyWindow(HWND hwnd)
+{
+    bare_send_zorder();
+}
+
+/***********************************************************************
+ *           BARE_SetCursor
+ *
+ * bare_app_wine draws an arrow while the program shows a cursor at all.
+ */
+void BARE_SetCursor(HWND hwnd, HCURSOR cursor)
+{
+    static int shown = -1;
+    struct wb_msg msg = { .type = WB_CURSOR };
+
+    if (shown == !!cursor) return;
+    shown = !!cursor;
+    msg.cursor.visible = shown;
+    bare_send(&msg, -1);
+}
+
+/***********************************************************************
+ *           BARE_SetCursorPos
+ */
+BOOL BARE_SetCursorPos(INT x, INT y)
+{
+    struct wb_msg msg = { .type = WB_CURSOR_POS };
+
+    msg.cursor_pos.x = x;
+    msg.cursor_pos.y = y;
+    bare_send(&msg, -1);
+    return TRUE;
+}
