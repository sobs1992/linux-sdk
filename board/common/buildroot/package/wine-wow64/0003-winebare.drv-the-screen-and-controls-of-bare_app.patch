+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#if 0
+#pragma makedep unix
+#endif
+
+#include "config.h"
+
+#include <errno.h>
+#include <poll.h>
+#include <pthread.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/mman.h>
+#include <sys/socket.h>
+#include <sys/un.h>
+#include <unistd.h>
+
+#include "ntstatus.h"
+#define WIN32_NO_STATUS
+#include "winebare.h"
+
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(winebare);
+
+#define NEXT_DEVMODEW(mode) ((DEVMODEW *)((char *)((mode) + 1) + (mode)->dmDriverExtra))
+
+static int host_sock = -1;
+static LONG next_id;
+
+static pthread_mutex_t mode_mutex = PTHREAD_MUTEX_INITIALIZER;
+static struct wb_mode modes[WB_MAX_MODES];
+static UINT mode_count;
+static struct wb_mode current_mode = { 800, 600 };
+
+void bare_send(const struct wb_msg *msg, int fd)
+{
+    char control[CMSG_SPACE(sizeof(int))];
+    struct iovec iov = { (void *)msg, sizeof(*msg) };
+    struct msghdr mh = { .msg_iov = &iov, .msg_iovlen = 1 };
+
+    if (fd >= 0)
+    {
+        struct cmsghdr *cm;
+
+        memset(control, 0, sizeof(control));
+        mh.msg_control = control;
+        mh.msg_controllen = sizeof(control);
+        cm = CMSG_FIRSTHDR(&mh);
+        cm->cmsg_level = SOL_SOCKET;
+        cm->cmsg_type = SCM_RIGHTS;
+        cm->cmsg_len = CMSG_LEN(sizeof(int));
+        memcpy(CMSG_DATA(cm), &fd, sizeof(int));
+    }
+    while (sendmsg(host_sock, &mh, MSG_NOSIGNAL) < 0)
+    {
+        if (errno == EINTR) continue;
+        WARN("message %u lost: %s\n", msg->type, strerror(errno));
+        break;
+    }
+}
+
+uint32_t bare_new_id(void)
+{
+    return InterlockedIncrement(&next_id);
+}
+
+int bare_shm_create(size_t size, void **map)
+{
+    int fd = memfd_create("winebare", MFD_CLOEXEC);
+
+    if (fd < 0) return -1;
+    if (ftruncate(fd, size) < 0 ||
+        (*map = mmap(NULL, size, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0)) == MAP_FAILED)
+    {
+        close(fd);
+        return -1;
+    }
+    return fd;
+}
+
+void bare_current_mode(UINT *width, UINT *height)
+{
+    pthread_mutex_lock(&mode_mutex);
+    *width = current_mode.width;
+    *height = current_mode.height;
+    pthread_mutex_unlock(&mode_mutex);
+}
+
+static void set_config(const struct wb_msg *msg)
+{
+    pthread_mutex_lock(&mode_mutex);
+    mode_count = min(msg->config.mode_count, WB_MAX_MODES);
+    memcpy(modes, msg->config.modes, mode_count * sizeof(*modes));
+    current_mode = msg->config.current;
+    pthread_mutex_unlock(&mode_mutex);
+    TRACE("%u modes, current %ux%u\n", mode_count, current_mode.width, current_mode.height);
+}
+
+static void fill_devmode(DEVMODEW *mode, const struct wb_mode *m)
+{
+    memset(mode, 0, sizeof(*mode));
+    mode->dmSize = sizeof(*mode);
+    mode->dmFields = DM_DISPLAYORIENTATION | DM_BITSPERPEL | DM_PELSWIDTH | DM_PELSHEIGHT |
+                     DM_DISPLAYFLAGS | DM_DISPLAYFREQUENCY;
+    mode->dmDisplayOrientation = DMDO_DEFAULT;
+    mode->dmBitsPerPel = 32;
+    mode->dmPelsWidth = m->width;
+    mode->dmPelsHeight = m->height;
+    mode->dmDisplayFrequency = 60;
+}
+
+/***********************************************************************
+ *           BARE_UpdateDisplayDevices
+ *
+ * One monitor whose size is the display mode; bare_app_wine scales it
+ * to bare_app's screen.
+ */
+static UINT BARE_UpdateDisplayDevices(const struct gdi_device_manager *manager, void *param)
+{
+    struct pci_id pci_id = {0};
+    struct gdi_monitor monitor = {0};
+    DEVMODEW current, list[WB_MAX_MODES];
+    UINT i, count;
+
+    pthread_mutex_lock(&mode_mutex);
+    fill_devmode(&current, &current_mode);
+    for (i = 0; i < mode_count; i++) fill_devmode(&list[i], &modes[i]);
+    count = mode_count;
+    pthread_mutex_unlock(&mode_mutex);
+
+    current.dmFields |= DM_POSITION;
+    SetRect(&monitor.rc_monitor, 0, 0, current.dmPelsWidth, current.dmPelsHeight);
+    monitor.rc_work = monitor.rc_monitor;
+
+    manager->add_gpu("bare_app", &pci_id, NULL, param);
+    manager->add_source("bare_app", DISPLAY_DEVICE_ATTACHED_TO_DESKTOP | DISPLAY_DEVICE_PRIMARY_DEVICE,
+                        NtUserGetSystemDpiForProcess(NULL), param);
+    manager->add_monitor(&monitor, param);
+    manager->add_modes(&current, count, list, param);
+    return STATUS_SUCCESS;
+}
+
+/***********************************************************************
+ *           BARE_ChangeDisplaySettings
+ *
+ * Any listed mode is accepted at once: the screen is only scaled.
+ */
+static LONG BARE_ChangeDisplaySettings(DEVMODEW *displays, const WCHAR *primary_name, HWND hwnd,
+                                       DWORD flags, void *lparam)
+{
+    struct wb_msg msg = { .type = WB_MODE_SET };
+    DEVMODEW *mode;
+
+    for (mode = displays; mode->dmSize; mode = NEXT_DEVMODEW(mode))
+    {
+        if (!(mode->dmFields & DM_PELSWIDTH) || !(mode->dmFields & DM_PELSHEIGHT)) continue;
+        TRACE("%ux%u\n", (UINT)mode->dmPelsWidth, (UINT)mode->dmPelsHeight);
+        if (flags & CDS_TEST) return DISP_CHANGE_SUCCESSFUL;
+        pthread_mutex_lock(&mode_mutex);
+        current_mode.width = mode->dmPelsWidth;
+        current_mode.height = mode->dmPelsHeight;
+        pthread_mutex_unlock(&mode_mutex);
+        msg.mode_set.width = mode->dmPelsWidth;
+        msg.mode_set.height = mode->dmPelsHeight;
+        bare_send(&msg, -1);
+        break;
+    }
+    return DISP_CHANGE_SUCCESSFUL;
+}
+
+static void send_mouse(const struct wb_msg *msg)
+{
+    static const struct { UINT wb, win; } buttons[] =
+    {
+        { WB_MOUSE_LEFT_DOWN, MOUSEEVENTF_LEFTDOWN },
+        { WB_MOUSE_LEFT_UP, MOUSEEVENTF_LEFTUP },
+        { WB_MOUSE_RIGHT_DOWN, MOUSEEVENTF_RIGHTDOWN },
+        { WB_MOUSE_RIGHT_UP, MOUSEEVENTF_RIGHTUP },
+        { WB_MOUSE_MIDDLE_DOWN, MOUSEEVENTF_MIDDLEDOWN },
+        { WB_MOUSE_MIDDLE_UP, MOUSEEVENTF_MIDDLEUP },
+    };
+    INPUT input = { .type = INPUT_MOUSE };
+    UINT i;
+
+    input.mi.dx = msg->mouse.x;
+    input.mi.dy = msg->mouse.y;
+    input.mi.dwFlags = MOUSEEVENTF_MOVE | MOUSEEVENTF_ABSOLUTE;
+    for (i = 0; i < ARRAY_SIZE(buttons); i++)
+        if (msg->mouse.flags & buttons[i].wb) input.mi.dwFlags |= buttons[i].win;
+    NtUserSendHardwareInput(0, 0, &input, 0);
+
+    if ((msg->mouse.flags & WB_MOUSE_WHEEL) && msg->mouse.wheel)
+    {
+        input.mi.dwFlags = MOUSEEVENTF_WHEEL;
+        input.mi.mouseData = msg->mouse.wheel * WHEEL_DELTA;
+        NtUserSendHardwareInput(0, 0, &input, 0);
+    }
+}
+
+static void send_key(const struct wb_msg *msg)
+{
+    INPUT input = { .type = INPUT_KEYBOARD };
+    UINT scan = NtUserMapVirtualKeyEx(msg->key.vk, MAPVK_VK_TO_VSC_EX, NtUserGetKeyboardLayout(0));
+
+    input.ki.wVk = msg->key.vk;
+    input.ki.wScan = scan & 0xff;
+    if (scan & 0xff00) input.ki.dwFlags |= KEYEVENTF_EXTENDEDKEY;
+    if (!msg->key.pressed) input.ki.dwFlags |= KEYEVENTF_KEYUP;
+    NtUserSendHardwareInput(0, 0, &input, 0);
+}
+
+static const struct user_driver_funcs baredrv_funcs =
+{
+    .pChangeDisplaySettings = BARE_ChangeDisplaySettings,
+    .pCreateWindowSurface = BARE_CreateWindowSurface,
+    .pDestroyWindow = BARE_DestroyWindow,
+    .pOpenGLInit = BARE_OpenGLInit,
+    .pSetCursor = BARE_SetCursor,
+    .pSetCursorPos = BARE_SetCursorPos,
+    .pUpdateDisplayDevices = BARE_UpdateDisplayDevices,
+    .pWindowPosChanged = BARE_WindowPosChanged,
+};
+
+static NTSTATUS baredrv_unix_init(void *arg)
+{
+    const char *path = getenv(WINEBARE_SOCKET_ENV);
+    struct sockaddr_un addr = { .sun_family = AF_UNIX };
+    struct wb_msg msg = { .type = WB_HELLO };
+    struct pollfd pfd;
+    ssize_t n;
+
+    if (host_sock >= 0) return STATUS_SUCCESS;
+    if (!path || !*path || strlen(path) >= sizeof(addr.sun_path)) return STATUS_UNSUCCESSFUL;
+    strcpy(addr.sun_path, path);
+    if ((host_sock = socket(AF_UNIX, SOCK_SEQPACKET | SOCK_CLOEXEC, 0)) < 0) return STATUS_UNSUCCESSFUL;
+    if (connect(host_sock, (struct sockaddr *)&addr, sizeof(addr)) < 0)
+    {
+        ERR("cannot connect to bare_app_wine at %s: %s\n", path, strerror(errno));
+        goto fail;
+    }
+
+    msg.hello.pid = getpid();
+    msg.hello.version = WB_PROTO_VERSION;
+    bare_send(&msg, -1);
+    pfd.fd = host_sock;
+    pfd.events = POLLIN;
+    if (poll(&pfd, 1, 5000) <= 0 || (n = recv(host_sock, &msg, sizeof(msg), 0)) <= 0 ||
+        msg.type != WB_CONFIG)
+    {
+        ERR("no answer from bare_app_wine\n");
+        goto fail;
+    }
+    set_config(&msg);
+
+    __wine_set_user_driver(&baredrv_funcs, WINE_GDI_DRIVER_VERSION);
+    return STATUS_SUCCESS;
+
+fail:
+    close(host_sock);
+    host_sock = -1;
+    return STATUS_UNSUCCESSFUL;
+}
+
+static NTSTATUS baredrv_unix_read_events(void *arg)
+{
+    struct wb_msg msg;
+    ssize_t n;
+
+    for (;;)
+    {
+        n = recv(host_sock, &msg, sizeof(msg), 0);
+        if (n < 0 && errno == EINTR) continue;
+        if (n <= 0) break;
+        switch (msg.type)
+        {
+        case WB_CONFIG: set_config(&msg); break;
+        case WB_INPUT_MOUSE: send_mouse(&msg); break;
+        case WB_INPUT_KEY: send_key(&msg); break;
+        default: WARN("unknown message %u\n", msg.type); break;
+        }
+    }
+    TRACE("bare_app_wine is gone\n");
+    return STATUS_UNSUCCESSFUL;
+}
+
+const unixlib_entry_t __wine_unix_call_funcs[] =
+{
+    baredrv_unix_init,
+    baredrv_unix_read_events,
+};
+
+C_ASSERT(ARRAYSIZE(__wine_unix_call_funcs) == winebare_unix_func_count);
+
+#ifdef _WIN64
+
+const unixlib_entry_t __wine_unix_call_wow64_funcs[] =
+{
+    baredrv_unix_init,
+    baredrv_unix_read_events,
+};
+
+C_ASSERT(ARRAYSIZE(__wine_unix_call_wow64_funcs) == winebare_unix_func_count);
+
+#endif /* _WIN64 */
