+/* Reads what bare_app_wine sends (input, display mode) until it is gone */
+static DWORD WINAPI read_events_thread(void *arg)
+{
+    WINEBARE_UNIX_CALL(read_events, NULL);
+    /* bare_app_wine has ended: the game goes with it */
+    TerminateProcess(GetCurrentProcess(), 1);
+    return 0;
+}
+
+BOOL WINAPI DllMain(HINSTANCE instance, DWORD reason, void *reserved)
+{
+    if (reason != DLL_PROCESS_ATTACH) return TRUE;
+
+    DisableThreadLibraryCalls(instance);
+    if (__wine_init_unix_call()) return FALSE;
+    /* fails without WINEBARE_SOCKET: the next driver of the list is tried */
+    if (WINEBARE_UNIX_CALL(init, NULL)) return FALSE;
+
+    CloseHandle(CreateThread(NULL, 0, read_events_thread, NULL, 0, NULL));
+    return TRUE;
+}
