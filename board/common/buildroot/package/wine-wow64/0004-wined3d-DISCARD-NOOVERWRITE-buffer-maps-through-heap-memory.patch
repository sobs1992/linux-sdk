                 return false;
+            }
 
             /* Limit NOOVERWRITE maps to buffers for now; there are too many
              * ways that a texture can be invalidated to even count. */
@@ -3203,6 +3223,8 @@ static bool wined3d_cs_map_upload_bo(struct wined3d_device_context *context, str
                 /* adapter_alloc_bo() should have given us a mapped BO if we are
                  * discarding. */
                 assert(flags & WINED3D_MAP_NOOVERWRITE);
+                if (heap_map_buffer(resource, flags))
+                    goto heap;
                 WARN_(d3d_perf)("Not accelerating a NOOVERWRITE map because the BO is not mapped.\n");
                 return false;
             }
@@ -3212,6 +3234,8 @@ static bool wined3d_cs_map_upload_bo(struct wined3d_device_context *context, str
         if (!map_ptr)
         {
             assert(flags & WINED3D_MAP_NOOVERWRITE);
+            if (heap_map_buffer(resource, flags))
+                goto heap;
             WARN_(d3d_perf)("Not accelerating a NOOVERWRITE map because the sub-resource has no valid address.\n");
             return false;
         }
@@ -3242,6 +3266,72 @@ static bool wined3d_cs_map_upload_bo(struct wined3d_device_context *context, str
         return true;
     }
 
+heap:
+    if (resource->type == WINED3D_RTYPE_BUFFER && wined3d_settings.heap_maps)
+    {
+        uint8_t *mem;
+
+        /* The program writes into the buffer's heap copy, which stays valid
+         * after the unmap (programs may go on writing there, as into the
+         * driver's memory on Windows): the unmap uploads a copy of it. */
+        if (!(mem = client->heap_shadow))
+        {
+            /* Large buffers with write watches, for maps "to the end of
+             * the buffer" (see below). */
+            if (resource->size >= 65536 && (mem = VirtualAlloc(NULL, resource->size,
+                    MEM_RESERVE | MEM_COMMIT | MEM_WRITE_WATCH, PAGE_READWRITE)))
+                client->heap_vm = client->heap_watched = true;
+            else if (!(mem = malloc(resource->size)))
+            {
+                WARN_(d3d_perf)("Failed to allocate a heap memory buffer.\n");
+                return false;
+            }
+            client->heap_shadow = mem;
+        }
+        map_desc->row_pitch = map_desc->slice_pitch = resource->size;
+        map_desc->data = mem + box->left;
+        client->mapped_upload.addr.buffer_object = 0;
+        client->mapped_upload.flags = UPLOAD_BO_UPLOAD_ON_UNMAP | UPLOAD_BO_HEAP_SHADOW;
+        client->heap_scan = false;
+        client->heap_noov = !!(flags & WINED3D_MAP_NOOVERWRITE);
+        if (flags & WINED3D_MAP_DISCARD)
+        {
+            /* The whole buffer is replaced: upload all of it, which also
+             * lets the CS thread rename a busy buffer object instead of
+             * waiting. */
+            client->mapped_upload.addr.addr = mem;
+            wined3d_box_set(&client->mapped_box, 0, 0, resource->size, 1, 0, 1);
+            /* Later NOOVERWRITE maps have no client address to write to. */
+            invalidate_client_address(resource);
+        }
+        else
+        {
+            /* NOOVERWRITE (or a write-only map, HeapMaps >= 2): the range
+             * only. d3d9 passes a buffer Lock() of size 0, "to the end of
+             * the buffer", as an empty box (Daemonica locks its text vertex
+             * buffer like that), which wined3d lets through for buffers. */
+            client->mapped_upload.addr.addr = mem + box->left;
+            client->mapped_box = *box;
+            if (box->right <= box->left)
+            {
+                /* Programs write a small part of it (Daemonica: the
+                 * vertices of one line of text, into a ring): what changed
+                 * is found against a copy of what was uploaded, the
+                 * mirror. Made now, so the mirror holds everything uploaded
+                 * by earlier maps. */
+                client->mapped_box.right = resource->size;
+                if (!client->heap_mirror && (client->heap_mirror = malloc(resource->size)))
+                {
+                    memcpy(client->heap_mirror, mem, resource->size);
+                    if (client->heap_watched && ResetWriteWatch(mem, resource->size))
+                        client->heap_watched = false;
+                }
+                client->heap_scan = !!client->heap_mirror;
+            }
+        }
+        return true;
+    }
+
     get_map_pitch(format, box, map_desc, &size);
 
     if (!(map_desc->data = malloc(size)))
@@ -3261,6 +3351,105 @@ static bool wined3d_bo_address_is_null(struct wined3d_const_bo_address *addr)
     return !addr->buffer_object && !addr->addr;
 }
 
+/* HeapMaps: the part of [*left, *right) of the heap copy that differs from
+ * the mirror, found in blocks of 256 bytes from both ends; false if none. */
+static bool heap_changed(const uint8_t *shadow, const uint8_t *mirror, unsigned int *left, unsigned int *right)
+{
+    unsigned int l = *left, r = *right, n;
+
+    for (; l < r; l += n)
+    {
+        n = min(256, r - l);
+        if (memcmp(shadow + l, mirror + l, n))
+            break;
+    }
+    for (; r > l; r -= n)
+    {
+        n = min(256, r - l);
+        if (memcmp(shadow + r - n, mirror + r - n, n))
+            break;
+    }
+    *left = l;
+    *right = r;
+    return l < r;
+}
+
+/* HeapMaps: a copy of the mapped range of a buffer's heap copy for the CS
+ * thread to upload (the program keeps the heap copy). With a mirror the
+ * upload is noted there, and maps "to the end of the buffer" (heap_scan)
+ * upload only the part that changed: false if nothing did. A heap copy
+ * with write watches tells which pages were written since the last look,
+ * only those are compared; else the whole range is. */
+static bool heap_upload_copy(struct wined3d_client_resource *client, unsigned int size,
+        struct wined3d_box *box, struct upload_bo *bo)
+{
+    const uint8_t *shadow = client->heap_shadow;
+    uint8_t *mirror = client->heap_mirror;
+    unsigned int left = box->left, right = box->right;
+    void *mem;
+
+    if (mirror && client->heap_scan)
+    {
+        void *pages[64];
+        ULONG_PTR count;
+        ULONG granularity;
+        unsigned int first = right, last = left, i;
+        bool watched = client->heap_watched;
+
+        /* the pages written anywhere in the buffer since the last look */
+        for (unsigned int pos = 0; watched && pos < size; )
+        {
+            count = ARRAY_SIZE(pages);
+            if (GetWriteWatch(WRITE_WATCH_FLAG_RESET, (uint8_t *)shadow + pos, size - pos,
+                    pages, &count, &granularity))
+            {
+                WARN("GetWriteWatch failed, error %lu.\n", GetLastError());
+                watched = client->heap_watched = false;
+                break;
+            }
+            for (i = 0; i < count; ++i)
+            {
+                unsigned int l = (const uint8_t *)pages[i] - shadow, r = min(l + granularity, size);
+
+                if (heap_changed(shadow, mirror, &l, &r))
+                {
+                    first = min(first, l);
+                    last = max(last, r);
+                }
+            }
+            if (count < ARRAY_SIZE(pages))
+                break;
+            pos = (const uint8_t *)pages[count - 1] - shadow + granularity;
+        }
+        if (watched)
+        {
+            left = first;
+            right = last;
+            if (left >= right)
+                return false;
+        }
+        else if (!heap_changed(shadow, mirror, &left, &right))
+            return false;
+        box->left = left;
+        box->right = right;
+    }
+
+    if (!(mem = malloc(right - left)))
+    {
+        ERR("Failed to allocate %u bytes for a buffer upload.\n", right - left);
+        return false;
+    }
+    memcpy(mem, shadow + left, right - left);
+    if (mirror)
+        memcpy(mirror + left, mem, right - left);
+    bo->addr.buffer_object = 0;
+    bo->addr.addr = mem;
+    bo->flags = UPLOAD_BO_UPLOAD_ON_UNMAP | UPLOAD_BO_FREE_ON_UNMAP;
+    if (client->heap_noov)
+        bo->flags |= UPLOAD_BO_NOOVERWRITE;
+    return true;
+}
+
 static bool wined3d_cs_unmap_upload_bo(struct wined3d_device_context *context, struct wined3d_resource *resource,
         unsigned int sub_resource_idx, struct wined3d_box *box, struct upload_bo *upload_bo)
 {
@@ -3280,6 +3469,8 @@ static bool wined3d_cs_unmap_upload_bo(struct wined3d_device_context *context, s
 
     *upload_bo = client->mapped_upload;
     *box = client->mapped_box;
+    if ((upload_bo->flags & UPLOAD_BO_HEAP_SHADOW) && !heap_upload_copy(client, resource->size, box, upload_bo))
+        upload_bo->flags = 0;
     memset(&client->mapped_upload, 0, sizeof(client->mapped_upload));
     memset(&client->mapped_box, 0, sizeof(client->mapped_box));
     return true;
@@ -3618,6 +3809,19 @@ void CDECL wined3d_device_context_flush_mapped_buffer(struct wined3d_device_cont
     if (wined3d_bo_address_is_null(&client->mapped_upload.addr))
         return;
 
+    if (client->mapped_upload.flags & UPLOAD_BO_HEAP_SHADOW)
+    {
+        /* The buffer's heap copy (HeapMaps): the program goes on writing
+         * there. Upload a copy of what is there now. */
+        struct wined3d_box box = client->mapped_box;
+        struct upload_bo copy;
+
+        if (heap_upload_copy(client, buffer->resource.size, &box, &copy))
+            wined3d_device_context_upload_bo(context, &buffer->resource, 0,
+                    &box, &copy, buffer->resource.size, buffer->resource.size);
+        return;
+    }
+
     if (client->mapped_upload.flags & UPLOAD_BO_UPLOAD_ON_UNMAP)
         wined3d_device_context_upload_bo(context, &buffer->resource, 0,
                 &client->mapped_box, &client->mapped_upload, buffer->resource.size, buffer->resource.size);
--- a/dlls/wined3d/resource.c
+++ b/dlls/wined3d/resource.c
@@ -218,6 +218,11 @@ static void wined3d_resource_destroy_object(void *object)
