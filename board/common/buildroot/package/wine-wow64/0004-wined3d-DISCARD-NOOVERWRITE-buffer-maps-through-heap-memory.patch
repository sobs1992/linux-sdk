--- a/dlls/wined3d/context_gl.c
+++ b/dlls/wined3d/context_gl.c
@@ -3034,6 +3034,35 @@ void wined3d_context_gl_copy_bo_address(struct wined3d_context_gl *context_gl,
             memcpy(dst_ptr, src->addr, dst_bo->size);
             wined3d_context_gl_unmap_bo_address(context_gl, dst, range_count, ranges);
         }
+        else if ((map_flags & WINED3D_MAP_NOOVERWRITE) && !dst_bo->b.map_ptr && !dst_bo->memory
+                && context_gl->gl_info->supported[ARB_MAP_BUFFER_RANGE])
+        {
+            /* Nothing the GPU may still read is overwritten: an unsynchronised
+             * map of just the ranges. glBufferSubData() into a buffer that a
+             * pending draw reads makes e.g. Mesa's panfrost copy the whole
+             * buffer object; a map of the whole buffer (as above) costs a copy
+             * of all of it under WoW64. */
+            wined3d_context_gl_bind_bo(context_gl, dst_bo->binding, dst_bo->id);
+            for (i = 0; i < range_count; ++i)
+            {
+                GLintptr offset = dst_bo->b.buffer_offset + (GLintptr)dst->addr + ranges[i].offset;
