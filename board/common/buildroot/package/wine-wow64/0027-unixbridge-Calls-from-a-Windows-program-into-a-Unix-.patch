+
+#include "wine/unixlib.h"
+
+enum unixbridge_funcs
+{
+    unix_open,
+    unix_call,
+    unix_funcs_count,
+};
+
+struct open_params
+{
+    const char *path;
+    UINT handle;
+};
+
+struct call_params
+{
+    UINT handle;
+    UINT code;
+    void *args;
+};
