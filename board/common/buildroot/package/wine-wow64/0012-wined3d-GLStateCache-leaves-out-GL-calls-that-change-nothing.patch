From 05ae6689b835ecabb022d3d5c8f079f42dd3fe94 Mon Sep 17 00:00:00 2001
From: Sobs <antohasobne@gmail.com>
Date: Mon, 9 Nov 2026 12:24:13 +0100
Subject: [PATCH] wined3d: GLStateCache=1: leave out GL calls that set what is
 already set

Every GL call of a 32-bit program on a 64-bit Wine goes through the wow64
thunks, under an x86 emulator through its emulated opengl32 too, and costs
far more than the driver then spends on it. wined3d's state handlers set
much of the state again for each draw: in the sea battles of Sid Meier's
Pirates! half of ~380000 GL calls a second set what was set already
(vertex attribute divisors, framebuffer sRGB, alpha to coverage, null
uniform blocks, samplers, the same uniform values).

With WINE_D3D_CONFIG=GLStateCache=1 the wrappers in gl_info->gl_ops keep
what a context's state is known to be (enables of the caps wined3d sets
only through glEnable()/glDisable(), the current program, attribute
divisors, null uniform block bindings, samplers, the alpha function) and
uniform values per program of a device (emptied when the program is
linked again) and leave out such calls. Pirates!: 33 -> 16.5 GL calls a
draw, sea battles ~5% faster.
---
 dlls/wined3d/adapter_gl.c      |   4 +
 dlls/wined3d/context_gl.c      | 464 +++++++++++++++++++++++++++++++++
 dlls/wined3d/wined3d_gl.h      |  25 ++
 dlls/wined3d/wined3d_main.c    |   2 +
 dlls/wined3d/wined3d_private.h |   1 +
 5 files changed, 496 insertions(+)

diff --git a/dlls/wined3d/adapter_gl.c b/dlls/wined3d/adapter_gl.c
index b8eb49b..d64d9fd 100644
--- a/dlls/wined3d/adapter_gl.c
+++ b/dlls/wined3d/adapter_gl.c
@@ -4113,6 +4113,7 @@ static void adapter_gl_destroy_device(struct wined3d_device *device)
 
     wined3d_device_cleanup(&device_gl->d);
     wined3d_lock_cleanup(&device_gl->allocator_cs);
+    wined3d_gl_state_cache_device_cleanup(device_gl);
 
     free(device_gl->retired_blocks);
     free(device_gl);
@@ -5100,6 +5101,9 @@ static BOOL wined3d_adapter_gl_init(struct wined3d_adapter_gl *adapter_gl,
         return FALSE;
     }
 
+    if (wined3d_settings.gl_state_cache)
+        wined3d_gl_state_cache_install(gl_info);
+
     for (unsigned int i = 0; i < ARRAY_SIZE(required_extensions); ++i)
     {
         if (!gl_info->supported[required_extensions[i].extension])
diff --git a/dlls/wined3d/context_gl.c b/dlls/wined3d/context_gl.c
index 3a629b0..8bc6d4f 100644
--- a/dlls/wined3d/context_gl.c
+++ b/dlls/wined3d/context_gl.c
@@ -1518,6 +1518,467 @@ struct wined3d_context_gl *wined3d_context_gl_get_current(void)
     return TlsGetValue(wined3d_context_tls_idx);
 }
 
+/* GLStateCache=1: some GL calls of wined3d leave out what they would set to
+ * what it already is. Every GL call of a 32-bit program on a 64-bit Wine
+ * (wow64, and more so under an x86 emulator) costs far more than the driver
+ * spends on it, and wined3d's state handlers set many things again for each
+ * draw: framebuffer sRGB, alpha to coverage, vertex attribute divisors, null
+ * uniform blocks, the samplers, the same uniform values. The wrappers below
+ * replace these functions in gl_info->gl_ops, so every caller goes through
+ * them. Context state lives in wined3d_context_gl.cache (only for the
+ * thread's current wined3d context; without one the call goes through as
+ * is); uniform values are state of the program object, kept for the
+ * program by its name, emptied when it is linked again. */
+
+static PFN_glEnable gl_cache_real_glEnable;
+static PFN_glDisable gl_cache_real_glDisable;
+static PFN_glAlphaFunc gl_cache_real_glAlphaFunc;
+static PFN_glUseProgram gl_cache_real_glUseProgram;
+static PFN_glLinkProgram gl_cache_real_glLinkProgram;
+static PFN_glDeleteProgram gl_cache_real_glDeleteProgram;
+static PFN_glVertexAttribDivisor gl_cache_real_glVertexAttribDivisor;
+static PFN_glBindBufferBase gl_cache_real_glBindBufferBase;
+static PFN_glBindBufferRange gl_cache_real_glBindBufferRange;
+static PFN_glBindSampler gl_cache_real_glBindSampler;
+static PFN_glDeleteSamplers gl_cache_real_glDeleteSamplers;
+static PFN_glUniform1f gl_cache_real_glUniform1f;
+static PFN_glUniform1fv gl_cache_real_glUniform1fv;
+static PFN_glUniform1i gl_cache_real_glUniform1i;
+static PFN_glUniform1iv gl_cache_real_glUniform1iv;
+static PFN_glUniform2f gl_cache_real_glUniform2f;
+static PFN_glUniform3fv gl_cache_real_glUniform3fv;
+static PFN_glUniform4fv gl_cache_real_glUniform4fv;
+static PFN_glUniform4iv gl_cache_real_glUniform4iv;
+static PFN_glUniformMatrix2fv gl_cache_real_glUniformMatrix2fv;
+static PFN_glUniformMatrix4fv gl_cache_real_glUniformMatrix4fv;
+
+static LONG gl_cache_sampler_generation;
+
+/* The thread's current wined3d context, without the call of TlsGetValue(). */
+static inline struct wined3d_context_gl *gl_cache_context(void)
+{
+    DWORD idx = wined3d_context_tls_idx;
+
+    if (idx < ARRAY_SIZE(NtCurrentTeb()->TlsSlots))
+        return NtCurrentTeb()->TlsSlots[idx];
+    return TlsGetValue(idx);
+}
+
+struct gl_cache_uniform
+{
+    uint32_t tag;   /* 0: not known; else words | kind << 8 */
+    uint32_t v[16];
+};
+
+struct gl_cache_program
+{
+    unsigned int count;
+    struct gl_cache_uniform *u;
+};
+
+static uint32_t wined3d_gl_cache_cap_bit(GLenum cap)
+{
+    /* Only caps wined3d sets through glEnable() and glDisable() alone (not
+     * GL_BLEND: glEnablei(); not GL_FOG: the fog coordinate emulation). */
+    switch (cap)
+    {
+        case GL_FRAMEBUFFER_SRGB:         return 1u << 0;
+        case GL_SAMPLE_ALPHA_TO_COVERAGE: return 1u << 1;
+        case GL_SAMPLE_MASK:              return 1u << 2;
+        case GL_POLYGON_OFFSET_FILL:      return 1u << 3;
+        case GL_DEPTH_CLAMP:              return 1u << 4;
+        case GL_LINE_SMOOTH:              return 1u << 5;
+        case GL_STENCIL_TEST:             return 1u << 6;
+        case GL_DEPTH_TEST:               return 1u << 7;
+        case GL_ALPHA_TEST:               return 1u << 8;
+        case GL_CULL_FACE:                return 1u << 9;
+        case GL_SCISSOR_TEST:             return 1u << 10;
+        case GL_DITHER:                   return 1u << 11;
+        case GL_RASTERIZER_DISCARD:       return 1u << 12;
+        case GL_CLIP_DISTANCE0:           return 1u << 16;
+        case GL_CLIP_DISTANCE1:           return 1u << 17;
+        case GL_CLIP_DISTANCE2:           return 1u << 18;
+        case GL_CLIP_DISTANCE3:           return 1u << 19;
+        case GL_CLIP_DISTANCE4:           return 1u << 20;
+        case GL_CLIP_DISTANCE5:           return 1u << 21;
+        case GL_CLIP_DISTANCE6:           return 1u << 22;
+        case GL_CLIP_DISTANCE7:           return 1u << 23;
+        default:                          return 0;
+    }
+}
+
+static void WINE_GLAPI gl_cache_glEnable(GLenum cap)
+{
+    struct wined3d_context_gl *context_gl;
+    uint32_t bit;
+
+    if ((bit = wined3d_gl_cache_cap_bit(cap)) && (context_gl = gl_cache_context()))
+    {
+        if ((context_gl->cache.enable_known & bit) && (context_gl->cache.enable_value & bit))
+            return;
+        gl_cache_real_glEnable(cap);
+        context_gl->cache.enable_known |= bit;
+        context_gl->cache.enable_value |= bit;
+        return;
+    }
+    gl_cache_real_glEnable(cap);
+}
+
+static void WINE_GLAPI gl_cache_glDisable(GLenum cap)
+{
+    struct wined3d_context_gl *context_gl;
+    uint32_t bit;
+
+    if ((bit = wined3d_gl_cache_cap_bit(cap)) && (context_gl = gl_cache_context()))
+    {
+        if ((context_gl->cache.enable_known & bit) && !(context_gl->cache.enable_value & bit))
+            return;
+        gl_cache_real_glDisable(cap);
+        context_gl->cache.enable_known |= bit;
+        context_gl->cache.enable_value &= ~bit;
+        return;
+    }
+    gl_cache_real_glDisable(cap);
+}
+
+static void WINE_GLAPI gl_cache_glAlphaFunc(GLenum func, GLfloat ref)
+{
+    struct wined3d_context_gl *context_gl;
+
+    if ((context_gl = gl_cache_context()))
+    {
+        if (context_gl->cache.alpha_known && context_gl->cache.alpha_func == func
+                && !memcmp(&context_gl->cache.alpha_ref, &ref, sizeof(ref)))
+            return;
+        gl_cache_real_glAlphaFunc(func, ref);
+        context_gl->cache.alpha_known = true;
+        context_gl->cache.alpha_func = func;
+        context_gl->cache.alpha_ref = ref;
+        return;
+    }
+    gl_cache_real_glAlphaFunc(func, ref);
+}
+
+static void WINE_GLAPI gl_cache_glUseProgram(GLuint program)
+{
+    struct wined3d_context_gl *context_gl;
+
+    if ((context_gl = gl_cache_context()))
+    {
+        if (context_gl->cache.program == program)
+            return;
+        gl_cache_real_glUseProgram(program);
+        context_gl->cache.program = program;
+        return;
+    }
+    gl_cache_real_glUseProgram(program);
+}
+
+/* A device's GL calls come from one thread at a time (its CS thread, or the
+ * application's under the wined3d lock): the program caches need no lock. */
+static void gl_cache_forget_program(struct wined3d_device_gl *device_gl, GLuint program, bool free_it)
+{
+    struct gl_cache_program *p;
+
+    if (program >= device_gl->gl_cache_program_count)
+        return;
+    p = &device_gl->gl_cache_programs[program];
+    if (free_it)
+    {
+        free(p->u);
+        p->u = NULL;
+        p->count = 0;
+    }
+    else if (p->u)
+    {
+        memset(p->u, 0, p->count * sizeof(*p->u));
+    }
+}
+
+static void WINE_GLAPI gl_cache_glLinkProgram(GLuint program)
+{
+    struct wined3d_context_gl *context_gl;
+
+    gl_cache_real_glLinkProgram(program);
+    if (!(context_gl = gl_cache_context()))
+    {
+        /* wined3d's own tests on the adapter's temporary context: no device,
+         * nothing cached. */
+        TRACE("No current context for program %u.\n", program);
+        return;
+    }
+    gl_cache_forget_program(wined3d_device_gl(context_gl->c.device), program, false);
+}
+
+static void WINE_GLAPI gl_cache_glDeleteProgram(GLuint program)
+{
+    struct wined3d_context_gl *context_gl;
+
+    gl_cache_real_glDeleteProgram(program);
+    if (!(context_gl = gl_cache_context()))
+    {
+        /* wined3d's own tests on the adapter's temporary context: no device,
+         * nothing cached. */
+        TRACE("No current context for program %u.\n", program);
+        return;
+    }
+    gl_cache_forget_program(wined3d_device_gl(context_gl->c.device), program, true);
+}
+
+/* The current program's uniform at "location" is known to hold these words
+ * already; else it is now. Only uniforms set one at a time. */
+static bool gl_cache_uniform_same(GLint location, uint32_t kind, const void *v, unsigned int words)
+{
+    struct wined3d_context_gl *context_gl;
+    struct wined3d_device_gl *device_gl;
+    struct gl_cache_program *p;
+    struct gl_cache_uniform *u;
+    uint32_t tag = words | kind << 8;
+    GLuint program;
+
+    if (location < 0 || location >= 4096 || !(context_gl = gl_cache_context())
+            || !(program = context_gl->cache.program) || program == ~0u || program >= 0x100000)
+        return false;
+
+    device_gl = wined3d_device_gl(context_gl->c.device);
+    if (program >= device_gl->gl_cache_program_count)
+    {
+        unsigned int count = max(program + 1, device_gl->gl_cache_program_count * 2);
+        struct gl_cache_program *programs;
+
+        if (!(programs = realloc(device_gl->gl_cache_programs, count * sizeof(*programs))))
+            return false;
+        memset(&programs[device_gl->gl_cache_program_count], 0,
+                (count - device_gl->gl_cache_program_count) * sizeof(*programs));
+        device_gl->gl_cache_programs = programs;
+        device_gl->gl_cache_program_count = count;
+    }
+    p = &device_gl->gl_cache_programs[program];
+    if ((unsigned int)location >= p->count)
+    {
+        unsigned int count = max(max(location + 1, p->count * 2), 16);
+        struct gl_cache_uniform *uniforms;
+
+        if (!(uniforms = realloc(p->u, count * sizeof(*uniforms))))
+            return false;
+        memset(&uniforms[p->count], 0, (count - p->count) * sizeof(*uniforms));
+        p->u = uniforms;
+        p->count = count;
+    }
+    u = &p->u[location];
+    if (u->tag == tag)
+    {
+        const uint32_t *w = v;
+        unsigned int i;
+
+        for (i = 0; i < words; ++i)
+            if (u->v[i] != w[i])
+                break;
+        if (i == words)
+            return true;
+        for (; i < words; ++i)
+            u->v[i] = w[i];
+        return false;
+    }
+    u->tag = tag;
+    memcpy(u->v, v, words * sizeof(uint32_t));
+    return false;
+}
+
+/* An array set at once: its elements are no longer known. */
+static void gl_cache_uniforms_forget(GLint location, GLsizei count)
+{
+    struct wined3d_context_gl *context_gl;
+    struct wined3d_device_gl *device_gl;
+    struct gl_cache_program *p;
+    GLuint program;
+    unsigned int i;
+
+    if (location < 0 || count <= 0 || !(context_gl = gl_cache_context())
+            || !(program = context_gl->cache.program) || program == ~0u)
+        return;
+    device_gl = wined3d_device_gl(context_gl->c.device);
+    if (program < device_gl->gl_cache_program_count)
+    {
+        p = &device_gl->gl_cache_programs[program];
+        for (i = location; i < p->count && i < (unsigned int)location + count; ++i)
+            p->u[i].tag = 0;
+    }
+}
+
+static void WINE_GLAPI gl_cache_glUniform1f(GLint location, GLfloat v0)
+{
+    if (gl_cache_uniform_same(location, 1, &v0, 1))
+        return;
+    gl_cache_real_glUniform1f(location, v0);
+}
+
+static void WINE_GLAPI gl_cache_glUniform2f(GLint location, GLfloat v0, GLfloat v1)
+{
+    GLfloat v[2] = {v0, v1};
+
+    if (gl_cache_uniform_same(location, 1, v, 2))
+        return;
+    gl_cache_real_glUniform2f(location, v0, v1);
+}
+
+static void WINE_GLAPI gl_cache_glUniform1i(GLint location, GLint v0)
+{
+    if (gl_cache_uniform_same(location, 2, &v0, 1))
+        return;
+    gl_cache_real_glUniform1i(location, v0);
+}
+
+#define GL_CACHE_UNIFORM_V(name, type, kind, words) \
+static void WINE_GLAPI gl_cache_##name(GLint location, GLsizei count, const type *value) \
+{ \
+    if (count == 1 && gl_cache_uniform_same(location, kind, value, words)) \
+        return; \
+    if (count != 1) \
+        gl_cache_uniforms_forget(location, count); \
+    gl_cache_real_##name(location, count, value); \
+}
+GL_CACHE_UNIFORM_V(glUniform1fv, GLfloat, 1, 1)
+GL_CACHE_UNIFORM_V(glUniform3fv, GLfloat, 1, 3)
+GL_CACHE_UNIFORM_V(glUniform4fv, GLfloat, 1, 4)
+GL_CACHE_UNIFORM_V(glUniform1iv, GLint, 2, 1)
+GL_CACHE_UNIFORM_V(glUniform4iv, GLint, 2, 4)
+#undef GL_CACHE_UNIFORM_V
+
+#define GL_CACHE_UNIFORM_MATRIX(name, words) \
+static void WINE_GLAPI gl_cache_##name(GLint location, GLsizei count, GLboolean transpose, const GLfloat *value) \
+{ \
+    if (count == 1 && gl_cache_uniform_same(location, transpose ? 4 : 3, value, words)) \
+        return; \
+    if (count != 1) \
+        gl_cache_uniforms_forget(location, count); \
+    gl_cache_real_##name(location, count, transpose, value); \
+}
+GL_CACHE_UNIFORM_MATRIX(glUniformMatrix2fv, 4)
+GL_CACHE_UNIFORM_MATRIX(glUniformMatrix4fv, 16)
+#undef GL_CACHE_UNIFORM_MATRIX
+
+static void WINE_GLAPI gl_cache_glVertexAttribDivisor(GLuint index, GLuint divisor)
+{
+    struct wined3d_context_gl *context_gl;
+
+    if (index < 32 && (context_gl = gl_cache_context()))
+    {
+        if ((context_gl->cache.divisor_known & (1u << index)) && context_gl->cache.divisor[index] == divisor)
+            return;
+        gl_cache_real_glVertexAttribDivisor(index, divisor);
+        context_gl->cache.divisor_known |= 1u << index;
+        context_gl->cache.divisor[index] = divisor;
+        return;
+    }
+    gl_cache_real_glVertexAttribDivisor(index, divisor);
+}
+
+static void WINE_GLAPI gl_cache_glBindBufferBase(GLenum target, GLuint index, GLuint buffer)
+{
+    struct wined3d_context_gl *context_gl;
+
+    if (target == GL_UNIFORM_BUFFER && index < 32 && (context_gl = gl_cache_context()))
+    {
+        if (!buffer && (context_gl->cache.ubo_null & (1u << index)))
+            return;
+        gl_cache_real_glBindBufferBase(target, index, buffer);
+        if (buffer)
+            context_gl->cache.ubo_null &= ~(1u << index);
+        else
+            context_gl->cache.ubo_null |= 1u << index;
+        return;
+    }
+    gl_cache_real_glBindBufferBase(target, index, buffer);
+}
+
+static void WINE_GLAPI gl_cache_glBindBufferRange(GLenum target, GLuint index, GLuint buffer,
+        GLintptr offset, GLsizeiptr size)
+{
+    struct wined3d_context_gl *context_gl;
+
+    gl_cache_real_glBindBufferRange(target, index, buffer, offset, size);
+    if (target == GL_UNIFORM_BUFFER && index < 32 && (context_gl = gl_cache_context()))
+        context_gl->cache.ubo_null &= ~(1u << index);
+}
+
+static void WINE_GLAPI gl_cache_glBindSampler(GLuint unit, GLuint sampler)
+{
+    struct wined3d_context_gl *context_gl;
+    unsigned int generation;
+
+    if (unit < 32 && (context_gl = gl_cache_context()))
+    {
+        /* A sampler deleted anywhere may have its name taken again. */
+        generation = ReadNoFence(&gl_cache_sampler_generation);
+        if (context_gl->cache.sampler_generation != generation)
+        {
+            context_gl->cache.sampler_known = 0;
+            context_gl->cache.sampler_generation = generation;
+        }
+        if ((context_gl->cache.sampler_known & (1u << unit)) && context_gl->cache.sampler[unit] == sampler)
+            return;
+        gl_cache_real_glBindSampler(unit, sampler);
+        context_gl->cache.sampler_known |= 1u << unit;
+        context_gl->cache.sampler[unit] = sampler;
+        return;
+    }
+    gl_cache_real_glBindSampler(unit, sampler);
+}
+
+static void WINE_GLAPI gl_cache_glDeleteSamplers(GLsizei count, const GLuint *samplers)
+{
+    gl_cache_real_glDeleteSamplers(count, samplers);
+    InterlockedIncrement(&gl_cache_sampler_generation);
+}
+
+void wined3d_gl_state_cache_device_cleanup(struct wined3d_device_gl *device_gl)
+{
+    unsigned int i;
+
+    for (i = 0; i < device_gl->gl_cache_program_count; ++i)
+        free(device_gl->gl_cache_programs[i].u);
+    free(device_gl->gl_cache_programs);
+    device_gl->gl_cache_programs = NULL;
+    device_gl->gl_cache_program_count = 0;
+}
+
+void wined3d_gl_state_cache_install(struct wined3d_gl_info *gl_info)
+{
+#define GL_CACHE_WRAP(table, name) \
+    do \
+    { \
+        if (gl_info->gl_ops.table.p_##name && gl_info->gl_ops.table.p_##name != gl_cache_##name) \
+        { \
+            gl_cache_real_##name = gl_info->gl_ops.table.p_##name; \
+            gl_info->gl_ops.table.p_##name = gl_cache_##name; \
+        } \
+    } while (0)
+
+    GL_CACHE_WRAP(gl, glEnable);
+    GL_CACHE_WRAP(gl, glDisable);
+    GL_CACHE_WRAP(gl, glAlphaFunc);
+    GL_CACHE_WRAP(ext, glUseProgram);
+    GL_CACHE_WRAP(ext, glLinkProgram);
+    GL_CACHE_WRAP(ext, glDeleteProgram);
+    GL_CACHE_WRAP(ext, glVertexAttribDivisor);
+    GL_CACHE_WRAP(ext, glBindBufferBase);
+    GL_CACHE_WRAP(ext, glBindBufferRange);
+    GL_CACHE_WRAP(ext, glBindSampler);
+    GL_CACHE_WRAP(ext, glDeleteSamplers);
+    GL_CACHE_WRAP(ext, glUniform1f);
+    GL_CACHE_WRAP(ext, glUniform1fv);
+    GL_CACHE_WRAP(ext, glUniform1i);
+    GL_CACHE_WRAP(ext, glUniform1iv);
+    GL_CACHE_WRAP(ext, glUniform2f);
+    GL_CACHE_WRAP(ext, glUniform3fv);
+    GL_CACHE_WRAP(ext, glUniform4fv);
+    GL_CACHE_WRAP(ext, glUniform4iv);
+    GL_CACHE_WRAP(ext, glUniformMatrix2fv);
+    GL_CACHE_WRAP(ext, glUniformMatrix4fv);
+#undef GL_CACHE_WRAP
+}
+
 BOOL wined3d_context_gl_set_current(struct wined3d_context_gl *context_gl)
 {
     struct wined3d_context_gl *old = wined3d_context_gl_get_current();
@@ -2064,6 +2525,9 @@ HRESULT wined3d_context_gl_init(struct wined3d_context_gl *context_gl, struct wi
     if (!wined3d_context_gl_create_wgl_ctx(context_gl, swapchain_gl, &new_drawable))
         goto fail;
 
+    memset(&context_gl->cache, 0, sizeof(context_gl->cache));
+    context_gl->cache.program = ~0u;
+
     /* Set up the context defaults. */
 
     context_gl->draw_buffers_mask = context_generate_rt_mask(GL_BACK);
diff --git a/dlls/wined3d/wined3d_gl.h b/dlls/wined3d/wined3d_gl.h
index 00c82c7..e54bf94 100644
--- a/dlls/wined3d/wined3d_gl.h
+++ b/dlls/wined3d/wined3d_gl.h
@@ -635,6 +635,23 @@ struct wined3d_context_gl
 
     uint32_t default_attrib_value_set;
 
+    /* GLStateCache: what this context's GL state is known to be, so that
+     * calls setting it to what it already is can be left out. */
+    struct
+    {
+        uint32_t enable_known, enable_value; /* wined3d_gl_cache_cap_bit() */
+        GLuint program;                      /* ~0u: not known */
+        uint32_t divisor_known;
+        GLuint divisor[32];
+        uint32_t ubo_null;                   /* uniform block binding i is 0 */
+        uint32_t sampler_known;
+        GLuint sampler[32];
+        unsigned int sampler_generation;
+        bool alpha_known;
+        GLenum alpha_func;
+        GLfloat alpha_ref;
