+/***********************************************************************
+ * Fast mutexes
+ ***********************************************************************/
+
+/* With WINE_FAST_MUTEX=1 in the environment, the unnamed, non-inheritable
+ * mutexes of a program are taken and released in user space: a
+ * WaitForSingleObject() + ReleaseMutex() pair makes no system call. Under
+ * WoW64 with an emulated x86 CPU such a pair costs microseconds; Sid
+ * Meier's Pirates! wraps every small read of its pack files in one, ~23000
+ * of them when a ship comes into view at sea.
+ *
+ * The kernel mutex is still created but stays unowned while the fast path
+ * runs the mutex. A thread that has to wait sleeps on an auto-reset event
+ * that releases set while someone waits. Waits that cannot be done here
+ * (WaitAll, alertable waits, the mutex given to another process or to a
+ * thread pool wait) hand the mutex over to the kernel for good ("demote"
+ * it): once it is free, or with the ownership of its owner when the owner
+ * itself asks. A mutex whose owner died owning it is found by its waiters
+ * (they look every 500 ms) and given out as abandoned.
+ *
+ * Only for programs known to use their mutexes through these functions:
+ * MsgWaitForMultipleObjects(), kernel32's RegisterWaitForSingleObject(),
+ * SetThreadpoolWait() and direct ntdll calls do not know fast mutexes. */
+
+struct fast_mutex
+{
+    HANDLE kernel;      /* the kernel mutex */
+    LONG owner;         /* owning thread id; 0: free; FM_DEMOTED: the kernel's */
+    LONG count;         /* recursion count, the owner's */
+    LONG waiters;       /* threads sleeping on the event, or about to */
+    LONG abandoned;     /* its owner died owning it */
+    HANDLE event;       /* auto-reset, set by releases while someone waits */
+};
+
+#define FM_DEMOTED   ((LONG)-1)
+#define FM_SLOTS     1024
+#define FM_REMOVED   ((HANDLE)(ULONG_PTR)3)   /* never a handle */
+#define FM_POLL_MS   500
+
+static struct
+{
+    HANDLE handle;      /* 0: never used, FM_REMOVED: free again */
+    struct fast_mutex *fm;
+} fm_slots[FM_SLOTS];
+static LONG fm_used;
+static int fm_enabled = -1;
+
+static CRITICAL_SECTION fm_section;
+static CRITICAL_SECTION_DEBUG fm_section_debug =
+{
+    0, 0, &fm_section,
+    { &fm_section_debug.ProcessLocksList, &fm_section_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": fm_section") }
+};
+static CRITICAL_SECTION fm_section = { &fm_section_debug, -1, 0, 0, 0, 0 };
+
+static BOOL fast_mutexes(void)
+{
+    if (fm_enabled < 0)
+    {
+        WCHAR buf[4];
+        DWORD len = GetEnvironmentVariableW( L"WINE_FAST_MUTEX", buf, ARRAY_SIZE(buf) );
+
+        fm_enabled = len && len < ARRAY_SIZE(buf) && buf[0] != '0';
+        if (fm_enabled) TRACE( "fast mutexes\n" );
+    }
+    return fm_enabled;
+}
+
+static inline LONG fm_tid(void)
+{
+    return HandleToLong( NtCurrentTeb()->ClientId.UniqueThread );
+}
+
+static inline unsigned int fm_hash( HANDLE handle )
+{
+    return ((ULONG_PTR)handle >> 2) & (FM_SLOTS - 1);
+}
+
+static struct fast_mutex *fm_get( HANDLE handle )
+{
+    unsigned int i, n;
+    HANDLE h;
+
+    if (!*(volatile LONG *)&fm_used || !handle) return NULL;
+    for (i = fm_hash( handle ), n = 0; n < FM_SLOTS; i = (i + 1) & (FM_SLOTS - 1), n++)
+    {
+        if (!(h = *(HANDLE volatile *)&fm_slots[i].handle)) return NULL;
+        if (h == handle)
+        {
+            MemoryBarrier();
+            return fm_slots[i].fm;
+        }
+    }
+    return NULL;
+}
+
+static BOOL fm_add( HANDLE handle, struct fast_mutex *fm )
+{
+    unsigned int i, n;
+    BOOL ret = FALSE;
+
+    RtlEnterCriticalSection( &fm_section );
+    for (i = fm_hash( handle ), n = 0; n < FM_SLOTS; i = (i + 1) & (FM_SLOTS - 1), n++)
+    {
+        if (fm_slots[i].handle && fm_slots[i].handle != FM_REMOVED) continue;
+        fm_slots[i].fm = fm;
+        MemoryBarrier();
+        fm_slots[i].handle = handle;
+        InterlockedIncrement( &fm_used );
+        ret = TRUE;
+        break;
+    }
+    RtlLeaveCriticalSection( &fm_section );
+    return ret;
+}
+
+/* the mutex itself is not freed: other threads may still be waiting for it */
+static void fm_remove( HANDLE handle )
+{
+    unsigned int i, n;
+
+    RtlEnterCriticalSection( &fm_section );
+    for (i = fm_hash( handle ), n = 0; n < FM_SLOTS; i = (i + 1) & (FM_SLOTS - 1), n++)
+    {
+        if (!fm_slots[i].handle) break;
+        if (fm_slots[i].handle != handle) continue;
+        fm_slots[i].handle = FM_REMOVED;
+        break;
+    }
+    RtlLeaveCriticalSection( &fm_section );
+}
+
+static HANDLE fm_create( OBJECT_ATTRIBUTES *attr, DWORD access, BOOL owned )
+{
+    struct fast_mutex *fm;
+    HANDLE handle;
+
+    if (!(fm = RtlAllocateHeap( GetProcessHeap(), HEAP_ZERO_MEMORY, sizeof(*fm) ))) return 0;
+    if (NtCreateMutant( &handle, access, attr, FALSE ))
+    {
+        RtlFreeHeap( GetProcessHeap(), 0, fm );
+        return 0;
+    }
+    fm->kernel = handle;
+    if (owned)
+    {
+        fm->owner = fm_tid();
+        fm->count = 1;
+    }
+    if (!fm_add( handle, fm ))
+    {
+        /* no room: an ordinary mutex */
+        if (owned) NtWaitForSingleObject( handle, FALSE, NULL );
+        RtlFreeHeap( GetProcessHeap(), 0, fm );
+    }
+    return handle;
+}
+
+static HANDLE fm_event( struct fast_mutex *fm )
+{
+    HANDLE event;
+
+    if (!fm->event && !NtCreateEvent( &event, EVENT_ALL_ACCESS, NULL, SynchronizationEvent, FALSE )
+            && InterlockedCompareExchangePointer( &fm->event, event, NULL ))
+        NtClose( event );
+    return fm->event;
+}
+
+/* WAIT_OBJECT_0, WAIT_ABANDONED_0, WAIT_TIMEOUT if another thread owns it,
+ * WAIT_FAILED if the kernel runs it now */
+static DWORD fm_try( struct fast_mutex *fm, LONG tid )
+{
+    LONG owner = *(volatile LONG *)&fm->owner;
+
+    if (owner == tid)
+    {
+        fm->count++;
+        return WAIT_OBJECT_0;
+    }
+    if (owner == FM_DEMOTED)
+    {
+        /* pass the news on to the next waiter */
+        if (*(volatile LONG *)&fm->waiters) NtSetEvent( fm->event, NULL );
+        return WAIT_FAILED;
+    }
+    if (owner || InterlockedCompareExchange( &fm->owner, tid, 0 )) return WAIT_TIMEOUT;
+    fm->count = 1;
+    if (!fm->abandoned) return WAIT_OBJECT_0;
+    fm->abandoned = 0;
+    return WAIT_ABANDONED_0;
+}
+
+static NTSTATUS fm_release( struct fast_mutex *fm )
+{
+    if (*(volatile LONG *)&fm->owner != fm_tid()) return STATUS_MUTANT_NOT_OWNED;
+    if (--fm->count) return STATUS_SUCCESS;
+    InterlockedExchange( &fm->owner, 0 );
+    if (*(volatile LONG *)&fm->waiters) NtSetEvent( fm->event, NULL );
+    return STATUS_SUCCESS;
+}
+
+/* frees a mutex whose owner thread is gone, as abandoned */
+static void fm_check_owner( struct fast_mutex *fm )
+{
+    LONG owner = *(volatile LONG *)&fm->owner;
+    HANDLE thread;
+    BOOL dead;
+
+    if (owner <= 0 || owner == fm_tid()) return;
+    if ((thread = OpenThread( SYNCHRONIZE, FALSE, owner )))
+    {
+        dead = !NtWaitForSingleObject( thread, FALSE, &(LARGE_INTEGER){ .QuadPart = 0 } );
+        NtClose( thread );
+    }
+    else dead = GetLastError() == ERROR_INVALID_PARAMETER;
+    if (!dead) return;
+    fm->abandoned = 1;
+    if (InterlockedCompareExchange( &fm->owner, 0, owner ) != owner) return;
+    WARN( "mutex %p abandoned by thread %04lx\n", fm->kernel, owner );
+    if (*(volatile LONG *)&fm->waiters) NtSetEvent( fm->event, NULL );
+}
+
+/* hands a mutex over to the kernel for good; FALSE if another thread owns it */
+static BOOL fm_demote( struct fast_mutex *fm )
+{
+    LONG tid = fm_tid(), owner = *(volatile LONG *)&fm->owner;
+
+    if (owner == FM_DEMOTED) return TRUE;
+    if (owner == tid)
+    {
+        /* the kernel mutex, never owned so far, takes our ownership */
+        LONG n;
+
+        for (n = fm->count; n > 0; n--) NtWaitForSingleObject( fm->kernel, FALSE, NULL );
+        fm->count = 0;
+        InterlockedExchange( &fm->owner, FM_DEMOTED );
+    }
+    else if (owner || InterlockedCompareExchange( &fm->owner, FM_DEMOTED, 0 )) return FALSE;
+    TRACE( "mutex %p demoted\n", fm->kernel );
+    if (*(volatile LONG *)&fm->waiters) NtSetEvent( fm->event, NULL );
+    return TRUE;
+}
+
+static void fm_demote_wait( struct fast_mutex *fm )
+{
+    LARGE_INTEGER poll = { .QuadPart = -FM_POLL_MS * 10000 };
+
+    while (!fm_demote( fm ))
+    {
+        if (!fm_event( fm )) return;
+        InterlockedIncrement( &fm->waiters );
+        if (*(volatile LONG *)&fm->owner > 0) NtWaitForSingleObject( fm->event, FALSE, &poll );
+        InterlockedDecrement( &fm->waiters );
+        fm_check_owner( fm );
+    }
+}
+
+/* WaitAny, not alertable, on handles of which some are fast mutexes (fms[i]) */
+static DWORD fm_wait_any( DWORD count, const HANDLE *handles, struct fast_mutex **fms, DWORD timeout )
+{
+    LONG tid = fm_tid();
+    HANDLE harr[MAXIMUM_WAIT_OBJECTS];
+    ULONGLONG end = 0;
+    LARGE_INTEGER time;
+    NTSTATUS status;
+    DWORD i, ret, slice;
+
+    for (;;)
+    {
+        for (i = 0; i < count; i++)
+        {
+            if (!fms[i]) continue;
+            if ((ret = fm_try( fms[i], tid )) == WAIT_FAILED) fms[i] = NULL;
+            else if (ret != WAIT_TIMEOUT) return ret + i;
+        }
+        if (!end) end = timeout == INFINITE ? ~(ULONGLONG)0 : GetTickCount64() + timeout;
+
+        for (i = 0; i < count; i++)
+        {
+            if (!fms[i])
+                harr[i] = handles[i];
+            else if (!(harr[i] = fm_event( fms[i] )))
+            {
+                SetLastError( ERROR_NOT_ENOUGH_MEMORY );
+                return WAIT_FAILED;
+            }
+        }
+        /* waiters first, then a last look: a release in between sets the event */
+        for (i = 0; i < count; i++) if (fms[i]) InterlockedIncrement( &fms[i]->waiters );
+        ret = WAIT_TIMEOUT;
+        for (i = 0; i < count && ret == WAIT_TIMEOUT; i++)
+            if (fms[i] && (ret = fm_try( fms[i], tid )) == WAIT_FAILED) ret = WAIT_TIMEOUT;
+        status = STATUS_WAIT_0 + count;
+        if (ret == WAIT_TIMEOUT)
+        {
+            ULONGLONG now = GetTickCount64();
+
+            slice = now >= end ? 0 : min( end - now, FM_POLL_MS );
+            status = NtWaitForMultipleObjects( count, harr, WaitAny, FALSE, get_nt_timeout( &time, slice ));
+        }
+        for (i = 0; i < count; i++) if (fms[i]) InterlockedDecrement( &fms[i]->waiters );
+
+        if (ret != WAIT_TIMEOUT) return ret + i - 1;
+        if (status < STATUS_WAIT_0 + count)
+        {
+            if (!fms[status]) return status;
+            continue;  /* a release */
+        }
+        if (status >= STATUS_ABANDONED_WAIT_0 && status < STATUS_ABANDONED_WAIT_0 + count) return status;
+        if (status == STATUS_TIMEOUT)
+        {
+            if (GetTickCount64() >= end) return WAIT_TIMEOUT;
+            for (i = 0; i < count; i++) if (fms[i]) fm_check_owner( fms[i] );
+            continue;
+        }
+        SetLastError( RtlNtStatusToDosError( status ));
+        return WAIT_FAILED;
+    }
+}
+
+/* fast mutexes among handles in fms[]; demotes them if the wait cannot use them */
+static BOOL fm_find( DWORD count, const HANDLE *handles, struct fast_mutex **fms, BOOL kernel_wait )
+{
+    BOOL found = FALSE;
+    DWORD i;
+
+    if (!*(volatile LONG *)&fm_used) return FALSE;
+    for (i = 0; i < count; i++)
+    {
+        if (!(fms[i] = fm_get( handles[i] ))) continue;
+        if (kernel_wait)
+        {
+            fm_demote_wait( fms[i] );
+            fms[i] = NULL;
+        }
+        else found = TRUE;
+    }
+    return found;
+}
+
+
