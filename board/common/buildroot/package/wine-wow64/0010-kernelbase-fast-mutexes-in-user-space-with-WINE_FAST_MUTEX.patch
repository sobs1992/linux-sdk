                                                          BOOL wait_all, DWORD timeout, BOOL alertable )
 {
+    struct fast_mutex *fms[MAXIMUM_WAIT_OBJECTS];
     NTSTATUS status;
     HANDLE hloc[MAXIMUM_WAIT_OBJECTS];
     LARGE_INTEGER time;
@@ -446,6 +803,7 @@ DWORD WINAPI DECLSPEC_HOTPATCH WaitForMultipleObjectsEx( DWORD count, const HAND
         return WAIT_FAILED;
     }
     for (i = 0; i < count; i++) hloc[i] = normalize_std_handle( handles[i] );
+    if (fm_find( count, hloc, fms, wait_all || alertable )) return fm_wait_any( count, hloc, fms, timeout );
 
     status = NtWaitForMultipleObjects( count, hloc, wait_all ? WaitAll : WaitAny, alertable,
                                        get_nt_timeout( &time, timeout ) );
@@ -750,6 +1108,13 @@ HANDLE WINAPI DECLSPEC_HOTPATCH CreateMutexExW( SECURITY_ATTRIBUTES *sa, LPCWSTR
 
     get_create_object_attributes( &attr, &nameW, sa, name );
 
+    if (!name && !(sa && sa->bInheritHandle) && (access & SYNCHRONIZE) && fast_mutexes()
+            && (ret = fm_create( &attr, access, (flags & CREATE_MUTEX_INITIAL_OWNER) != 0 )))
+    {
+        SetLastError( ERROR_SUCCESS );
+        return ret;
+    }
+
     status = NtCreateMutant( &ret, access, &attr, (flags & CREATE_MUTEX_INITIAL_OWNER) != 0 );
     if (status == STATUS_OBJECT_NAME_EXISTS)
         SetLastError( ERROR_ALREADY_EXISTS );
@@ -782,10 +1147,56 @@ HANDLE WINAPI DECLSPEC_HOTPATCH OpenMutexW( DWORD access, BOOL inherit, LPCWSTR
  */
 BOOL WINAPI DECLSPEC_HOTPATCH ReleaseMutex( HANDLE handle )
 {
+    struct fast_mutex *fm;
+
+    if ((fm = fm_get( handle )) && *(volatile LONG *)&fm->owner != FM_DEMOTED)
+        return set_ntstatus( fm_release( fm ));
     return set_ntstatus( NtReleaseMutant( handle, NULL ));
 }
 
 
+/***********************************************************************
+ *           fast_mutex_close
+ *
+ * CloseHandle(): forgets a fast mutex handle.
+ */
+void fast_mutex_close( HANDLE handle )
+{
+    if (fm_get( handle )) fm_remove( handle );
+}
+
+
+/***********************************************************************
+ *           fast_mutex_duplicate
+ *
+ * DuplicateHandle(): returns the fast mutex of a handle to duplicate in
+ * this process, or NULL (a duplicate for another process demotes it).
+ */
+void *fast_mutex_duplicate( HANDLE source_process, HANDLE source, HANDLE dest_process, BOOL inherit )
+{
+    struct fast_mutex *fm;
+
+    if (source_process != GetCurrentProcess() || !(fm = fm_get( source ))) return NULL;
+    if (dest_process == GetCurrentProcess() && !inherit) return fm;
+    fm_demote_wait( fm );
+    return NULL;
+}
+
+
+/***********************************************************************
+ *           fast_mutex_duplicated
+ *
+ * DuplicateHandle(): the duplicate of a fast mutex is one too.
+ */
+void fast_mutex_duplicated( void *ptr, HANDLE source, HANDLE dest, DWORD options )
+{
+    struct fast_mutex *fm = ptr;
+
+    if (dest && !fm_add( dest, fm )) fm_demote_wait( fm );
+    if (options & DUPLICATE_CLOSE_SOURCE) fm_remove( source );
+}
+
+
