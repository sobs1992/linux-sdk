# ODROID-GO Advance / Super: options on top of arm64 defconfig.
# Display stack is built in so the boot console shows up on the panel
# without waiting for modules.

CONFIG_LOCALVERSION="-oga"
# CONFIG_LOCALVERSION_AUTO is not set

# Display: VOP + MIPI-DSI + panels
CONFIG_DRM=y
CONFIG_DRM_ROCKCHIP=y
CONFIG_ROCKCHIP_VOP=y
CONFIG_ROCKCHIP_DW_MIPI_DSI=y
CONFIG_PHY_ROCKCHIP_INNO_DSIDPHY=y
CONFIG_DRM_PANEL_ELIDA_KD35T133=y
CONFIG_DRM_PANEL_SITRONIX_ST7701=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_PWM=y
CONFIG_FRAMEBUFFER_CONSOLE=y
# Without it fbcon=rotate: on the command line is silently ignored
CONFIG_FRAMEBUFFER_CONSOLE_ROTATION=y

# Gamepad: gpio-keys + analog stick on SARADC
CONFIG_INPUT_JOYSTICK=y
CONFIG_JOYSTICK_ADC=y
CONFIG_ROCKCHIP_SARADC=y
CONFIG_KEYBOARD_GPIO=y

# PMIC RK817: battery/charger, RTC, audio codec, power key. Built in, as
# the sound card: bare_app (S90) finds them at once, without waiting for
# the coldplug of modules (S03mdev, in the background)
CONFIG_CHARGER_RK817=y
CONFIG_RTC_DRV_RK808=y
CONFIG_INPUT_RK805_PWRKEY=y
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_SND_SOC_RK817=y
CONFIG_SND_SOC_ROCKCHIP_I2S=y
CONFIG_SND_SOC_ROCKCHIP_I2S_TDM=m
CONFIG_SND_SIMPLE_CARD=y
CONFIG_ROCKCHIP_THERMAL=y

# Wi-Fi (Black Edition, ESP8089 on SDIO; driver: board/oga/linux/esp8089).
# mmc-pwrseq-simple takes its reset-gpios through the reset-gpio driver; as a
# module it is never loaded, so the SDIO host waits on wifi-pwrseq forever.
CONFIG_RESET_GPIO=y
CONFIG_CFG80211=m
CONFIG_MAC80211=m

# A smaller kernel for a faster boot: U-Boot reads the Image from the SD
# card, and every built-in driver registers at start. Of the arm64
# defconfig, only the Rockchip platform; no ACPI, UEFI, virtualisation,
# PCI (the board has no slot), SATA, NUMA, TPM, TEE, IOMMU of other SoCs,
# no MTD (the SPI flash holds the factory boot loader: Linux leaves it be).
# CONFIG_ARCH_ACTIONS is not set
# CONFIG_ARCH_AIROHA is not set
# CONFIG_ARCH_SUNXI is not set
# CONFIG_ARCH_ALPINE is not set
# CONFIG_ARCH_APPLE is not set
# CONFIG_ARCH_ARTPEC is not set
# CONFIG_ARCH_ASPEED is not set
# CONFIG_ARCH_AXIADO is not set
# CONFIG_ARCH_BCM is not set
# CONFIG_ARCH_BERLIN is not set
# CONFIG_ARCH_BLAIZE is not set
# CONFIG_ARCH_BST is not set
# CONFIG_ARCH_CIX is not set
# CONFIG_ARCH_EXYNOS is not set
# CONFIG_ARCH_K3 is not set
# CONFIG_ARCH_LG1K is not set
# CONFIG_ARCH_HISI is not set
# CONFIG_ARCH_KEEMBAY is not set
# CONFIG_ARCH_MEDIATEK is not set
# CONFIG_ARCH_MESON is not set
# CONFIG_ARCH_MICROCHIP is not set
# CONFIG_ARCH_MVEBU is not set
# CONFIG_ARCH_NXP is not set
# CONFIG_ARCH_NPCM is not set
# CONFIG_ARCH_QCOM is not set
