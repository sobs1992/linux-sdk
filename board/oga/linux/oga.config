# ODROID-GO Advance / Super: options on top of arm64 defconfig.
# Display stack is built in so the boot console shows up on the panel
# without waiting for modules.

CONFIG_LOCALVERSION="-oga"
# CONFIG_LOCALVERSION_AUTO is not set

# Display: VOP + MIPI-DSI + panels
CONFIG_DRM=y
CONFIG_DRM_ROCKCHIP=y
CONFIG_ROCKCHIP_VOP=y
CONFIG_ROCKCHIP_DW_MIPI_DSI=y
CONFIG_PHY_ROCKCHIP_INNO_DSIDPHY=y
CONFIG_DRM_PANEL_ELIDA_KD35T133=y
CONFIG_DRM_PANEL_SITRONIX_ST7701=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_PWM=y
CONFIG_FRAMEBUFFER_CONSOLE=y

# Gamepad: gpio-keys + analog stick on SARADC
CONFIG_INPUT_JOYSTICK=y
CONFIG_JOYSTICK_ADC=y
CONFIG_ROCKCHIP_SARADC=y
CONFIG_KEYBOARD_GPIO=y

# PMIC RK817: battery/charger, RTC, audio codec
CONFIG_CHARGER_RK817=m
CONFIG_RTC_DRV_RK808=y
CONFIG_SND_SOC_RK817=m
CONFIG_SND_SOC_ROCKCHIP_I2S_TDM=m
CONFIG_SND_SIMPLE_CARD=m
