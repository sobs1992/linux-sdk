From: Sobs <antohasobne@gmail.com>
Subject: [PATCH] arm64: dts: rockchip: odroid-go2: read the stick every 10
 ms

60 ms between readings made the stick late by up to a frame and a half
of a 30 fps game and coarse when it moves fast.
---
 arch/arm64/boot/dts/rockchip/rk3326-odroid-go2-v11.dts | 2 +-
 arch/arm64/boot/dts/rockchip/rk3326-odroid-go2.dts     | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/arch/arm64/boot/dts/rockchip/rk3326-odroid-go2-v11.dts b/arch/arm64/boot/dts/rockchip/rk3326-odroid-go2-v11.dts
index d94ac81eb4e6..88b8db5624cf 100644
--- a/arch/arm64/boot/dts/rockchip/rk3326-odroid-go2-v11.dts
+++ b/arch/arm64/boot/dts/rockchip/rk3326-odroid-go2-v11.dts
@@ -20,7 +20,7 @@ analog_sticks: adc-joystick {
 		compatible = "adc-joystick";
 		io-channels = <&saradc 1>,
 			      <&saradc 2>;
-		poll-interval = <60>;
+		poll-interval = <10>;
 		#address-cells = <1>;
 		#size-cells = <0>;
 
diff --git a/arch/arm64/boot/dts/rockchip/rk3326-odroid-go2.dts b/arch/arm64/boot/dts/rockchip/rk3326-odroid-go2.dts
index aa6f5b12206b..18bd103ba45e 100644
--- a/arch/arm64/boot/dts/rockchip/rk3326-odroid-go2.dts
+++ b/arch/arm64/boot/dts/rockchip/rk3326-odroid-go2.dts
@@ -16,7 +16,7 @@ analog_sticks: adc-joystick {
 		compatible = "adc-joystick";
 		io-channels = <&saradc 1>,
 			      <&saradc 2>;
-		poll-interval = <60>;
+		poll-interval = <10>;
 		#address-cells = <1>;
 		#size-cells = <0>;
 
