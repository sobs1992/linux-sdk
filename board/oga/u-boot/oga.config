# ODROID-GO Advance: options on top of odroid-go2_defconfig.

# Same serial speed as TF-A (taken from stdout-path) and the kernel
CONFIG_BAUDRATE=115200
CONFIG_BOOTDELAY=2

# u-boot.itb at sector 2048 (1 MiB) instead of 16384: sectors 16384 and
# 24576 hold uboot.img/trust.img for the Rockchip miniloader (SPI flash)
CONFIG_SYS_MMCSD_RAW_MODE_U_BOOT_SECTOR=0x800
CONFIG_SPL_PAD_TO=0xf8000
