# Raspberry Pi 4 / 400: options on top of arm64 defconfig.
# HDMI console, USB keyboard (Pi 400) and SD are built in, so the console
# works before modules load.
CONFIG_LOCALVERSION="-rpi4"
# CONFIG_LOCALVERSION_AUTO is not set

# HDMI: VC4 KMS
CONFIG_DRM=y
CONFIG_DRM_VC4=y
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_FRAMEBUFFER_CONSOLE=y

# USB (VL805 xHCI on PCIe) and keyboard
CONFIG_PCIE_BRCMSTB=y
CONFIG_RESET_RASPBERRYPI=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PCI=y
CONFIG_USB_HID=y
CONFIG_HID_GENERIC=y

# SD card (emmc2) and Ethernet
CONFIG_MMC_SDHCI_IPROC=y
CONFIG_BCMGENET=y
CONFIG_BROADCOM_PHY=y
